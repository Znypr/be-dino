        <Item class="LocalScript" referent="RBX74">
          <Properties>
            <string name="Name">CosmeticVisuals</string>
            <ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config=require(Shared.ProgressionConfig)
local Rules=require(Shared.ProgressionRules)
local Effects=require(Shared.CosmeticEffects)
local Theme=require(Shared.UITheme)
local states={}
local elapsed=0
RunService.Heartbeat:Connect(function(dt)
    elapsed+=dt
    if elapsed&lt;1/30 then return end
    elapsed=0
    local camera=workspace.CurrentCamera
    local keep={}
    local count=0
    -- Own equipment wins the distance budget; never create unbounded particle pools.
    local players=Players:GetPlayers()
    table.sort(players,function(a,b) return a==Players.LocalPlayer and b~=Players.LocalPlayer end)
    for _,player in players do
        local character=player.Character
        local root=if character then character:FindFirstChild("HumanoidRootPart") else nil
        if root and root:IsA("BasePart") and camera and (camera.CFrame.Position-root.Position).Magnitude&lt;180 and count&lt;8 then
            count+=1 keep[player]=true
            local auraId=character:GetAttribute("EquippedAuraId") or ""
            local trailId=character:GetAttribute("EquippedTrailId") or ""
            local mutationId=character:GetAttribute("EventMutationId") or ""
            local shiny=character:GetAttribute("ShinyDinosaur")==true
            local state=states[player]
            if not state or state.root~=root or state.auraId~=auraId or state.trailId~=trailId or state.mutationId~=mutationId or state.shiny~=shiny then
                if state then state.effect:destroy() end
                state={root=root,auraId=auraId,trailId=trailId,mutationId=mutationId,shiny=shiny,effect=Effects.create(root,Rules.item(Config.Auras,auraId),Rules.item(Config.Trails,trailId),Rules.item(Config.EventMutations,mutationId),shiny)}
                states[player]=state
            end
            state.effect:update(character:GetAttribute("VisualScale") or 1,os.clock(),Theme.MotionEnabled)
        end
    end
    for player,state in states do if not keep[player] then state.effect:destroy() states[player]=nil end end
end)
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX75">
          <Properties>
            <string name="Name">PreviewTraits</string>
            <ProtectedString name="Source">--!strict
local RunService = game:GetService("RunService")
local Theme = require(game:GetService("ReplicatedStorage").Shared.UITheme)
local Appearance = require(game:GetService("ReplicatedStorage").Shared.EggAppearance)
local PreviewTraits = {}
function PreviewTraits.add(view: ViewportFrame, traits)
    if traits and traits.genes then Appearance.apply(view,traits.genes) end
    if not traits or not (traits.shiny or traits.big) then return end
    local badge = Instance.new("TextLabel")
    badge.Name = "TraitBadge"
    badge.BackgroundTransparency, badge.Size, badge.Position = 1, UDim2.new(1,0,0,26), UDim2.new(0,0,1,-26)
    badge.Font, badge.TextSize, badge.TextColor3 = Enum.Font.FredokaOne, 18, Theme.Colors.gold
    badge.TextScaled=true
    badge.Text = (if traits.shiny then "SHINY" else "") .. (if traits.shiny and traits.big then " + " else "") .. (if traits.big then "BIG" else "")
    badge.ZIndex, badge.Parent = view.ZIndex + 2, view
    if not traits.shiny then return end
    local shine = Instance.new("ImageLabel")
    shine.Name, shine.Image = "ShinyPreviewGlint", "rbxasset://textures/particles/sparkles_main.dds"
    shine.BackgroundTransparency, shine.ImageColor3 = 1, Color3.fromRGB(255,244,160)
    shine.Size, shine.Position, shine.ZIndex, shine.Parent = UDim2.fromScale(.23,.3), UDim2.fromScale(.15,.14), view.ZIndex+1, view
    local elapsed, accumulated=0,0
    local connection=RunService.Heartbeat:Connect(function(dt)
        if not Theme.MotionEnabled then shine.ImageTransparency=.3 return end
        local ancestor: Instance?=view
        while ancestor do
            if ancestor:IsA("GuiObject") and not ancestor.Visible then return end
            if ancestor:IsA("ScreenGui") and not ancestor.Enabled then return end
            ancestor=ancestor.Parent
        end
        elapsed+=dt accumulated+=dt
        if accumulated&lt;1/20 then return end
        accumulated=0
        local phase=(1-math.cos(elapsed*math.pi/1.6))*.5
        shine.Position=UDim2.fromScale(.15+.5*phase,.14+.36*phase)
        shine.Rotation=100*phase
        shine.ImageTransparency=.65*phase
    end)
    view.Destroying:Connect(function() connection:Disconnect() end)
end
return PreviewTraits
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX76">
          <Properties>
            <string name="Name">ResourceVisuals</string>
            <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local RuntimeMeshes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RuntimeMeshes"))
local Resources = require(ReplicatedStorage.Shared.ResourceModels)
local Appearance = require(ReplicatedStorage.Shared.EggAppearance)
local Http = game:GetService("HttpService")
local watched = setmetatable({}, {__mode = "k"})
local function characterVisual(character: Model)
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not root or not root:IsA("BasePart") or not humanoid then return end
    local id = character:GetAttribute("SpeciesId") or "compy"
    local scale = character:GetAttribute("VisualScale") or 1
    local mutation = character:GetAttribute("MutationVisual") or (if character:GetAttribute("GoldVisual") == true then "gold" else "base")
    local genesJson=character:GetAttribute("GenesJson") or "null"
    local previous = character:FindFirstChild("LocalMeshVisual")
    if previous and previous:GetAttribute("SpeciesId") == id and previous:GetAttribute("Scale") == scale
        and previous:GetAttribute("Mutation") == mutation and previous:GetAttribute("GenesJson")==genesJson then return end
    local overrides=ReplicatedStorage:FindFirstChild("ResourceOverrides")
    local model = if overrides and overrides:FindFirstChild(id) then Resources.clone(id) else RuntimeMeshes.clone(id)
    if not model then return end
    if previous then previous:Destroy() end
    local groundHeight = root.Size.Y / 2 + humanoid.HipHeight
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        local leg = character:FindFirstChild("Left Leg")
        groundHeight += if leg and leg:IsA("BasePart") then leg.Size.Y else 2
    end
    model.Name = "LocalMeshVisual"
    model:SetAttribute("SpeciesId", id)
    model:SetAttribute("Scale", scale)
    model:SetAttribute("Mutation", mutation)
    model:SetAttribute("GenesJson",genesJson)
    model:ScaleTo(scale)
    model:PivotTo(root.CFrame * CFrame.new(0, -groundHeight, 0))
    for _, item in model:GetDescendants() do
        if item:IsA("BasePart") then
            item.Anchored = false
            if mutation=="gold" or mutation=="diamond" then Resources.clearTextures(item) end
            if mutation == "gold" then item.Color = Color3.fromRGB(242,199,63) item.Material = Enum.Material.Metal
            elseif mutation == "diamond" then item.Color = Color3.fromRGB(85,213,245) item.Material = Enum.Material.Glass item.Reflectance=.2 end
            local weld = Instance.new("WeldConstraint")
            weld.Part0, weld.Part1, weld.Parent = root, item, item
        end
    end
    model.Parent = character
    local ok,genes=pcall(function() return Http:JSONDecode(genesJson) end)
    if ok and typeof(genes)=="table" and mutation=="base" then Appearance.apply(model,genes) end
    local fallback = character:FindFirstChild("DinoVisual")
    if fallback then
        for _, item in fallback:GetDescendants() do
            if item:IsA("BasePart") then item.LocalTransparencyModifier = 1 end
        end
    end
end
local function watchCharacter(character: Model)
    if watched[character] then return end
    watched[character] = true
    local queued = false
    local function refresh()
        if queued then return end
        queued = true
        task.defer(function()
            queued = false
            if character.Parent then characterVisual(character) end
        end)
    end
    for _, attribute in {"SpeciesId", "VisualScale", "GoldVisual", "MutationVisual", "DinoAttached","GenesJson"} do
        character:GetAttributeChangedSignal(attribute):Connect(refresh)
    end
    character.DescendantAdded:Connect(function(item)
        if item:IsA("BasePart") and item:FindFirstAncestor("DinoVisual") and character:FindFirstChild("LocalMeshVisual") then
            item.LocalTransparencyModifier = 1
        end
    end)
    refresh()
end
local function watchPlayer(player: Player)
    player.CharacterAdded:Connect(watchCharacter)
    if player.Character then watchCharacter(player.Character) end
end
Players.PlayerAdded:Connect(watchPlayer)
for _, player in Players:GetPlayers() do watchPlayer(player) end
local function propVisual(prop: Instance)
    if not prop:IsA("Model") or prop:FindFirstChild("LocalResourceMesh") then return end
    local id = prop:GetAttribute("ResourceId")
    local position = prop:GetAttribute("SourcePosition")
    if typeof(id) ~= "string" or typeof(position) ~= "Vector3" then return end
    local mesh = RuntimeMeshes.clone(id)
    if not mesh then return end
    mesh.Name = "LocalResourceMesh"
    mesh:ScaleTo(prop:GetAttribute("SourceScale") or 1)
    mesh:PivotTo(CFrame.new(position) * CFrame.Angles(0, prop:GetAttribute("SourceYaw") or 0, 0))
    for _, item in prop:GetDescendants() do
        if item:IsA("BasePart") then item.LocalTransparencyModifier = 1 end
    end
    mesh.Parent = prop
end
local function upgradeAll()
    for _, player in Players:GetPlayers() do if player.Character then characterVisual(player.Character) end end
    local arena = workspace:FindFirstChild("BeDinoArena")
    if arena then for _, item in arena:GetChildren() do propVisual(item) end end
end
RuntimeMeshes.Ready.Event:Connect(upgradeAll)
workspace.DescendantAdded:Connect(function(item)
    if item:IsA("Model") and item:GetAttribute("ResourceId") then task.defer(propVisual, item) end
end)
-- Food shares each source MeshPart; positions and visibility remain server-owned.
local foods = setmetatable({}, {__mode = "k"})
local elapsed = 0
RunService.Heartbeat:Connect(function(dt)
    elapsed += dt
    if elapsed &lt; .15 then return end
    elapsed = 0
    local folder = workspace:FindFirstChild("Food")
    if not folder then return end
    for _, item in folder:GetChildren() do
        if not item:IsA("BasePart") or not item:GetAttribute("Points") then continue end
        local model = foods[item]
        if not model then
            model = RuntimeMeshes.clone(item.Name)
            if not model then continue end
            local sourceHeight = ({berry = .61, fruit = .96, egg = 2.4, amber = 1.3})[item.Name] or 1
            model:ScaleTo(item.Size.Y / sourceHeight)
            model.Name = "LocalFoodMesh"
            model.Parent = item
            foods[item] = model
            item.LocalTransparencyModifier = 1
        end
        model:PivotTo(CFrame.new(item.Position - Vector3.new(0, item.Size.Y / 2 + .08, 0)))
        for _, piece in model:GetDescendants() do
            if piece:IsA("BasePart") then piece.Transparency = item.Transparency end
        end
    end
end)
-- Native models are packaged. Optional API meshes are no longer needed.
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX77">
          <Properties>
            <string name="Name">WeatherVisuals</string>
            <ProtectedString name="Source">--!strict
-- Client-local precipitation pool: bounded instance count and no gameplay collision.
local Lighting=game:GetService("Lighting")
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage").Shared
local Theme=require(Shared.UITheme)
local player=Players.LocalPlayer
local random=Random.new()
local folder=Instance.new("Folder") folder.Name="LocalWeatherFX" folder.Parent=workspace
local drops={}
for _=1,36 do
    local part=Instance.new("Part") part.Name="Precipitation"
    part.Anchored,part.CanCollide,part.CanTouch,part.CanQuery,part.CastShadow=true,false,false,false,false
    part.Material=Enum.Material.Neon part.Transparency=1 part.Parent=folder
    table.insert(drops,{part=part,x=random:NextNumber(-20,20),z=random:NextNumber(-20,20),y=random:NextNumber(-10,20)})
end
local flash=Instance.new("ColorCorrectionEffect") flash.Name="ThunderFlash" flash.Parent=Lighting
local nextFlash=0 local flashUntil=0
local moon=Instance.new("Part") moon.Name="EventMoon" moon.Shape=Enum.PartType.Ball
moon.Anchored,moon.CanCollide,moon.CanTouch,moon.CanQuery,moon.CastShadow=true,false,false,false,false
moon.Size,moon.Material,moon.Color,moon.Transparency,moon.Parent=Vector3.one*18,Enum.Material.Neon,Color3.fromRGB(255,95,125),1,folder
local skyPoints={} local skyBeams={}
for i=1,7 do
    local point=Instance.new("Attachment") point.Parent=workspace.Terrain table.insert(skyPoints,point)
    if i&gt;1 then
        local beam=Instance.new("Beam") beam.Attachment0,beam.Attachment1=skyPoints[i-1],point
        beam.FaceCamera,beam.Width0,beam.Width1,beam.LightEmission,beam.Segments=true,12,12,1,16
        beam.Texture="rbxasset://textures/particles/smoke_main.dds"
        beam.TextureMode,beam.TextureSpeed=Enum.TextureMode.Stretch,.05
        beam.Color=ColorSequence.new(Color3.fromRGB(84,255,189),Color3.fromRGB(168,122,255))
        beam.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.85),NumberSequenceKeypoint.new(.5,.45),NumberSequenceKeypoint.new(1,.85)})
        beam.Enabled,beam.Parent=false,folder table.insert(skyBeams,beam)
    end
end
local atmosphere=Instance.new("ColorCorrectionEffect") atmosphere.Name="LocalEventColor" atmosphere.Parent=Lighting
local elapsed=0
RunService.Heartbeat:Connect(function(dt)
    elapsed+=dt
    if elapsed&lt;1/30 then return end
    dt=elapsed elapsed=0
    local id=workspace:GetAttribute("WeatherId") or "clear"
    local c=player.Character
    local root=if c then c:FindFirstChild("HumanoidRootPart") else nil
    local on=table.find({"rain","thunder","blizzard","volcano","quake"},id)~=nil and Theme.MotionEnabled and root~=nil
    for _,drop in drops do
        local part=drop.part
        part.Transparency=if on then .35 else 1
        if on then
            drop.y-=dt*(if id=="blizzard" then 6 elseif id=="volcano" then -7 elseif id=="quake" then 4 else 48)
            if drop.y&lt; -10 then drop.y=20 drop.x=random:NextNumber(-20,20) drop.z=random:NextNumber(-20,20) end
            if drop.y&gt;20 then drop.y=-10 end
            part.Size=if id=="blizzard" or id=="volcano" then Vector3.one*.15 elseif id=="quake" then Vector3.one*.28 else Vector3.new(.04,1.7,.04)
            part.Color=if id=="blizzard" then Color3.new(1,1,1) elseif id=="volcano" then Color3.fromRGB(255,140,67) elseif id=="quake" then Color3.fromRGB(202,182,142) else Color3.fromRGB(125,197,239)
            part.Position=root.Position+Vector3.new(drop.x,drop.y,drop.z)
        end
    end
    local now=os.clock()
    if id=="thunder" and on and now&gt;=nextFlash then nextFlash=now+random:NextNumber(12,25) flashUntil=now+.12 end
    flash.Brightness=if id=="thunder" and on and now&lt;flashUntil then .25 else 0
    local skyOn=Theme.MotionEnabled and root~=nil
    moon.Transparency=if skyOn and id=="bloodmoon" then .12 else 1
    if skyOn then
        moon.Position=root.Position+Vector3.new(-80,90,-130)
        for i,point in skyPoints do point.Position=root.Position+Vector3.new((i-4)*24,65+math.sin(now*.25+i)*7,-75) end
    end
    for _,beam in skyBeams do beam.Enabled=skyOn and id=="aurora" beam.CurveSize0=math.sin(now*.3)*8 beam.CurveSize1=-beam.CurveSize0 end
    atmosphere.TintColor=if skyOn and id=="bloodmoon" then Color3.fromRGB(255,200,215) elseif skyOn and id=="volcano" then Color3.fromRGB(255,226,194) elseif skyOn and id=="aurora" then Color3.fromRGB(215,243,255) else Color3.new(1,1,1)
    if c then
        local rootPart=c:FindFirstChild("HumanoidRootPart")
        if rootPart then for _,part in rootPart:GetDescendants() do if part:IsA("ParticleEmitter") and part.Name=="AuraParticles" then part.Enabled=Theme.MotionEnabled end end end
    end
end)
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="RBX78">
    <Properties>
      <string name="Name">Workspace</string>
    </Properties>
