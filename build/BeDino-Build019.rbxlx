      <Item class="ModuleScript" referent="RBX33">
        <Properties>
          <string name="Name">IslandLayout</string>
          <ProtectedString name="Source">--!strict
-- Authored broad ramps and mountain masses; the center remains a readable chase meadow.
local IslandLayout = {}
IslandLayout.Peaks = {
    {x = -145, z = -140, height = 65, radius = 90},
    {x = 145, z = -130, height = 80, radius = 105},
    {x = -165, z = 125, height = 46, radius = 82},
    {x = 160, z = 140, height = 58, radius = 95},
}
function IslandLayout.height(x: number, z: number): number
    local h = 0
    for _, peak in IslandLayout.Peaks do
        local r2 = ((x-peak.x)^2 + (z-peak.z)^2) / peak.radius^2
        h += peak.height * math.exp(-r2 * 1.6)
    end
    local meadow = math.exp(-(x*x + (z-30)^2) / 5000)
    h *= 1 - meadow * .95
    local edge = math.max(math.abs(x), math.abs(z))
    h += math.max(0, edge - 190) * .55
    return h + math.noise(x / 65, z / 65, 14) * 2 * (1-meadow)
end
return IslandLayout
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX34">
        <Properties>
          <string name="Name">ModelPreview</string>
          <ProtectedString name="Source">--!strict
local Resources=require(script.Parent.ResourceModels)
local Egg=require(script.Parent.EggPreview)
local Camera=require(script.Parent.PreviewCamera)
local ModelPreview={}
function ModelPreview.add(parent: GuiObject,id: string,empty: boolean?): ViewportFrame
    local viewport=Instance.new("ViewportFrame")
    viewport.BackgroundTransparency,viewport.Size=1,UDim2.fromScale(1,1)
    viewport.Ambient,viewport.LightColor,viewport.LightDirection=Color3.fromRGB(193,211,220),Color3.fromRGB(255,246,220),Vector3.new(-1,-1,-1)
    viewport.ZIndex,viewport.Parent=parent.ZIndex+1,parent
    local model=if id=="egg" then Egg.create(empty) else Resources.clone(id)
    if model then
        for _,item in model:GetDescendants() do if item:IsA("BasePart") then item.Anchored=true end end
        model:PivotTo(CFrame.new())
        local world=Instance.new("WorldModel") world.Parent=viewport
        model.Parent=world
        Camera.bind(viewport,model,if id=="egg" then nil else id)
    end
    return viewport
end
return ModelPreview
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX35">
        <Properties>
          <string name="Name">MovementEnvelope</string>
          <ProtectedString name="Source">--!strict
local Config = require(script.Parent.Config)
local MovementEnvelope = {}
function MovementEnvelope.plausible(delta: Vector3, dt: number, tolerance: number, burst: number, verticalVelocity: number, speed: number?): boolean
    local horizontal = Vector2.new(delta.X, delta.Z).Magnitude
    local verticalSpeed = math.max(Config.JumpPower, math.min(120, math.abs(verticalVelocity)))
    return horizontal &lt;= (speed or Config.WalkSpeed) * dt * tolerance + burst
        and math.abs(delta.Y) &lt;= verticalSpeed * dt + workspace.Gravity * dt * dt / 2 + burst
end
return MovementEnvelope
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX36">
        <Properties>
          <string name="Name">NavigationArtwork</string>
          <ProtectedString name="Source">--!strict
-- Logical page IDs select shared artwork compositions, not flattened exports.
return {
    collection = "dinos",
    eggs = "egg",
    fusion = "fusion",
    home = "home",
    auras = "aura_meadow",
    potions = "potion_speed",
    settings = "shield",
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX37">
        <Properties>
          <string name="Name">PreviewCamera</string>
          <ProtectedString name="Source">--!strict
-- Fit actual geometry, excluding controller roots and invisible humanoid parts.
local RunService = game:GetService("RunService")
local Theme = require(script.Parent.UITheme)
local Geometry = require(script.Parent.ResourceGeometry)
local PreviewCamera = {}
function PreviewCamera.bind(viewport: ViewportFrame, model: Model, geometryId: string?)
    local camera=Instance.new("Camera")
    camera.FieldOfView,camera.Parent=32,viewport
    viewport.CurrentCamera=camera
    local bounds,size=model:GetBoundingBox()
    local points={}
    local data=if geometryId and not model:GetAttribute("UploadedModelId") then Geometry[geometryId] else nil
    local origin=model:GetAttribute("GeometryOrigin") or Vector3.zero
    if data then
        for _,v in data.vertices do table.insert(points,model:GetPivot():PointToWorldSpace(Vector3.new(v[1],v[2],v[3])-origin)) end
    else
        for _,x in {-1,1} do for _,y in {-1,1} do for _,z in {-1,1} do
            table.insert(points,bounds:PointToWorldSpace(Vector3.new(x*size.X/2,y*size.Y/2,z*size.Z/2)))
        end end end
    end
    local low,high=Vector3.new(math.huge,math.huge,math.huge),Vector3.new(-math.huge,-math.huge,-math.huge)
    for _,p in points do low=low:Min(p) high=high:Max(p) end
    local target=(low+high)/2
    local elapsed=0
    local function frame(dt: number)
        if Theme.MotionEnabled then elapsed+=dt end
        local direction=Vector3.new(1+math.sin(elapsed*.5)*.035,.2,-.65).Unit
        local basis=CFrame.lookAt(target+direction,target)
        local pixels=viewport.AbsoluteSize
        local aspect=if pixels.Y&gt;0 then pixels.X/pixels.Y else 1.4
        local vertical=math.tan(math.rad(camera.FieldOfView/2))
        local horizontal=vertical*math.max(.3,aspect)
        local distance=0
        for _,point in points do
            local corner=point-target
            local depth=corner:Dot(basis.ZVector)
            distance=math.max(distance,depth+math.abs(corner:Dot(basis.XVector))/horizontal,depth+math.abs(corner:Dot(basis.YVector))/vertical)
        end
        camera.CFrame=CFrame.lookAt(target+direction*math.max(1,distance*1.045),target)
    end
    frame(0)
    local resized=viewport:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() frame(0) end)
    local motion=RunService.RenderStepped:Connect(function(dt)
        if not Theme.MotionEnabled then return end
        local ancestor: Instance?=viewport
        while ancestor do
            if ancestor:IsA("GuiObject") and not ancestor.Visible then return end
            if ancestor:IsA("ScreenGui") and not ancestor.Enabled then return end
            ancestor=ancestor.Parent
        end
        -- Camera orbit does not need a full geometry fit on every rendered frame.
        elapsed+=dt
        if elapsed-(viewport:GetAttribute("LastOrbitUpdate") or 0)&lt;1/30 then return end
        viewport:SetAttribute("LastOrbitUpdate",elapsed)
        frame(0)
    end)
    viewport.Destroying:Connect(function() resized:Disconnect() motion:Disconnect() end)
end
return PreviewCamera
</ProtectedString>
        </Properties>
      </Item>
