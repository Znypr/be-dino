      <Item class="Script" referent="RBX53">
        <Properties>
          <string name="Name">Bootstrap</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Arena = require(script.Parent.Arena)
local ChestService = require(script.Parent.ChestService)
local CollectionService = require(script.Parent.CollectionService)
local Dinosaur = require(script.Parent.Dinosaur)
local MutationService = require(script.Parent.MutationService)
local MovementGuard = require(script.Parent.MovementGuard)
local ProfileRepository = require(script.Parent.ProfileRepository)
local RunLifecycle = require(script.Parent.RunLifecycle)
local VisualTestService = require(script.Parent.VisualTestService)
local Leaderboards = require(script.Parent.Leaderboards)

Players.CharacterAutoLoads = false

Lighting.ClockTime = 14
Lighting.Brightness = 2
Lighting.Ambient = Color3.fromRGB(130, 143, 148)
require(script.Parent.ImportedResources).load()
Arena.build()
Leaderboards.start()

ProfileRepository.start()
RunLifecycle.configureSettlement(function(player: Player, runId: string, catchScore: number, reason: string, eggEvents)
    local ok = ProfileRepository.commitRunSettlement(player, runId, catchScore, eggEvents)
    if not ok then
        warn(string.format("[Be Dino] settlement failed for %s (%s)", player.Name, reason))
        return false
    end

    if Config.DuplicateSettlementProbe then
        local retryOk, _, retryStatus = ProfileRepository.commitRunSettlement(player, runId, catchScore)
        if not retryOk or retryStatus ~= "duplicate" then
            player:SetAttribute("ProfileState", "SaveFailed")
            warn("[Be Dino] duplicate settlement probe failed for " .. player.Name)
            return false
        end
        player:SetAttribute("LastSettlementProbe", "duplicate-ok")
    end

    if not player.Parent then
        local metrics=ProfileRepository.release(player)
        if metrics then Leaderboards.publish(player,metrics) end
    end
    return true
end)
RunLifecycle.start()
CollectionService.start(ProfileRepository, Dinosaur)
ChestService.start(ProfileRepository)
MutationService.start(ProfileRepository, Dinosaur)
MovementGuard.start()
VisualTestService.start(Dinosaur)
require(script.Parent.ProgressionService).start(ProfileRepository)
require(script.Parent.LeapService).start()
game:GetService("MarketplaceService").ProcessReceipt=function(receipt)
    local player=Players:GetPlayerByUserId(receipt.PlayerId)
    if player and ProfileRepository.purchase(player,receipt) then
        task.spawn(Leaderboards.publish,player,nil)
        return Enum.ProductPurchaseDecision.PurchaseGranted
    end
    return Enum.ProductPurchaseDecision.NotProcessedYet
end

local function spawnLoadedPlayer(player: Player)
    player.CanLoadCharacterAppearance = false
    local loaded = ProfileRepository.load(player)
    if not loaded or not player.Parent then
        warn("[Be Dino] profile load blocked character spawn for " .. player.Name)
        return
    end

    local ok, err = pcall(function()
        player:LoadCharacterAsync()
    end)
    if not ok then
        player:SetAttribute("CharacterState", "SpawnFailed")
        warn("[Be Dino] initial character load failed: " .. tostring(err))
    end
end

local function setup(player: Player)
    player.CanLoadCharacterAppearance = false
    for _,attribute in {"EquippedBig","EquippedGenesJson"} do
        player:GetAttributeChangedSignal(attribute):Connect(function()
            local character=player.Character
            if character and character:GetAttribute("DinoAttached") then Dinosaur.refreshForPlayer(character,player) end
        end)
    end
    player.CharacterAdded:Connect(function(character)
        if player:GetAttribute("ProfileState") ~= "Loaded" then
            character:Destroy()
            return
        end
        RunLifecycle.prepareSanctuary(player, character)
        task.spawn(function()
            Dinosaur.attach(character, Config.WalkSpeed, player)
            if player.Character == character then character:PivotTo(CFrame.new(0, 11, 365)) end
        end)
    end)
    task.spawn(spawnLoadedPlayer, player)
end

Players.PlayerAdded:Connect(setup)
for _, player in Players:GetPlayers() do setup(player) end

Players.PlayerRemoving:Connect(function(player)
    local status = RunLifecycle.endForDisconnect(player)
    if status ~= "busy" then
        local metrics=ProfileRepository.release(player)
        if metrics then Leaderboards.publish(player,metrics) end
    end
end)

game:BindToClose(function()
    for _, player in Players:GetPlayers() do
        local status = RunLifecycle.endForDisconnect(player)
        if status ~= "busy" then
            local metrics=ProfileRepository.release(player)
            if metrics then Leaderboards.publish(player,metrics) end
        end
    end
end)

local FoodService = require(script.Parent.FoodService)
local foodReady, foodError = xpcall(function() FoodService.start(Dinosaur,ProfileRepository) end, debug.traceback)
if not foodReady then
    workspace:SetAttribute("FoodSpawnStatus", "Failed")
    workspace:SetAttribute("FoodStartupError", tostring(foodError))
    warn("[Be Dino] FOOD STARTUP FAILED: " .. tostring(foodError))
end
local PredationService = require(script.Parent.PredationService)
PredationService.start(RunLifecycle, Dinosaur)

print("[Be Dino] " .. Config.Build .. " ready. Resource redesign.")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX54">
        <Properties>
          <string name="Name">ChestService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local ChestService = {}
local lastClaim: {[Player]: number} = {}
local lastGrant: {[Player]: number} = {}

local function getRemote(folder: Folder, name: string): RemoteEvent
    local existing = folder:FindFirstChild(name)
    if existing and existing:IsA("RemoteEvent") then return existing end
    if existing then existing:Destroy() end
    local remote = Instance.new("RemoteEvent")
    remote.Name = name
    remote.Parent = folder
    return remote
end

local function allowed(bucket: {[Player]: number}, player: Player): boolean
    local now = os.clock()
    local last = bucket[player] or -math.huge
    if now - last &lt; Config.ChestClaimRequestCooldownSeconds then return false end
    bucket[player] = now
    return true
end

function ChestService.start(profileRepository)
    local folder = ReplicatedStorage:FindFirstChild("BeDinoRemotes") :: Folder?
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "BeDinoRemotes"
        folder.Parent = ReplicatedStorage
    end

    local claimChest = getRemote(folder, "ClaimChest")
    local testGrant = getRemote(folder, "TestGrantChests")

    claimChest.OnServerEvent:Connect(function(player: Player, chestId, requestToken, ...)
        if select("#", ...) ~= 0 then return end
        if typeof(chestId) ~= "string" or #chestId &lt; 1 or #chestId &gt; 80 then
            player:SetAttribute("LastChestClaimStatus", "invalid_chest_id")
            return
        end
        if typeof(requestToken) ~= "string" or #requestToken &lt; 1 or #requestToken &gt; 80 then
            player:SetAttribute("LastChestClaimStatus", "invalid_token")
            return
        end
        if not allowed(lastClaim, player) then
            player:SetAttribute("LastChestClaimStatus", "rate_limited")
            return
        end
        local _, _, status = profileRepository.claimChest(player, chestId)
        player:SetAttribute("LastChestClaimStatus", status)
    end)

    testGrant.OnServerEvent:Connect(function(player: Player, ...)
        if select("#", ...) ~= 0 then return end
        if not Config.ChestTestGrantEnabled then return end
        if not allowed(lastGrant, player) then
            player:SetAttribute("LastChestTestGrantStatus", "rate_limited")
            return
        end
        local _, status = profileRepository.grantChestTest(player)
        player:SetAttribute("LastChestTestGrantStatus", status)
    end)

    Players.PlayerRemoving:Connect(function(player)
        lastClaim[player] = nil
        lastGrant[player] = nil
    end)
end

return ChestService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX55">
        <Properties>
          <string name="Name">CollectionService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local CollectionService = {}
local lastEquipRequest: {[Player]: number} = {}
local lastGrantRequest: {[Player]: number} = {}

local function getRemote(folder: Folder, name: string): RemoteEvent
    local existing = folder:FindFirstChild(name)
    if existing and existing:IsA("RemoteEvent") then return existing end
    if existing then existing:Destroy() end
    local remote = Instance.new("RemoteEvent")
    remote.Name = name
    remote.Parent = folder
    return remote
end

local function rateAllowed(bucket: {[Player]: number}, player: Player): boolean
    local now = os.clock()
    local last = bucket[player] or -math.huge
    if now - last &lt; Config.EquipRequestCooldownSeconds then return false end
    bucket[player] = now
    return true
end

function CollectionService.start(profileRepository, dinosaur)
    local folder = ReplicatedStorage:FindFirstChild("BeDinoRemotes")
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "BeDinoRemotes"
        folder.Parent = ReplicatedStorage
    end

    local equipSpecies = getRemote(folder :: Folder, "EquipSpecies")
    local testGrant = getRemote(folder :: Folder, "TestGrantSpecies")

    equipSpecies.OnServerEvent:Connect(function(player: Player, speciesId, requestToken, ...)
        if select("#", ...) ~= 0 then return end
        if typeof(speciesId) ~= "string" or #speciesId &lt; 1 or #speciesId &gt; 32 then
            player:SetAttribute("LastEquipStatus", "invalid_species")
            return
        end
        if typeof(requestToken) ~= "string" or #requestToken &lt; 1 or #requestToken &gt; 80 then
            player:SetAttribute("LastEquipStatus", "invalid_token")
            return
        end
        if not rateAllowed(lastEquipRequest, player) then
            player:SetAttribute("LastEquipStatus", "rate_limited")
            return
        end

        local ok, status = profileRepository.equipSpecies(player, speciesId)
        player:SetAttribute("LastEquipStatus", status)
        if not ok then return end

        local character = player.Character
        if character and character:GetAttribute("DinoAttached") then
            dinosaur.refreshForPlayer(character, player)
        end
    end)

    testGrant.OnServerEvent:Connect(function(player: Player, ...)
        if select("#", ...) ~= 0 then return end
        if not Config.CollectionTestGrantEnabled then return end
        if not rateAllowed(lastGrantRequest, player) then
            player:SetAttribute("LastCollectionGrantStatus", "rate_limited")
            return
        end
        local _, status = profileRepository.grantCollectionTestSpecies(player)
        player:SetAttribute("LastCollectionGrantStatus", status)
    end)

    Players.PlayerRemoving:Connect(function(player)
        lastEquipRequest[player] = nil
        lastGrantRequest[player] = nil
    end)
end

return CollectionService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX56">
        <Properties>
          <string name="Name">Dinosaur</string>
          <ProtectedString name="Source">--!strict
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PhysicsService = game:GetService("PhysicsService")
local Dinosaur = {}
local Visual = require(ReplicatedStorage.Shared.DinosaurVisual)
local Config = require(ReplicatedStorage.Shared.Config)
function Dinosaur.render(character: Model, scale: number, speciesId: string?, gold: (boolean | string)?)
    Visual.render(character, scale, speciesId, gold)
    local collider = character:FindFirstChild("DinoCollider")
    if collider and collider:IsA("BasePart") then
        -- Match the growing torso footprint; keep floor clearance and the tail visual-only.
        collider.Size = Vector3.new(2.6 * scale, 2.4, 3.2 * scale)
    end
end
local function scaleForScore(score: number): number
    return math.min(4, math.sqrt(1 + math.max(0, score) / 50))
end
if not PhysicsService:IsCollisionGroupRegistered("DinoControllers") then
    PhysicsService:RegisterCollisionGroup("DinoControllers")
end
PhysicsService:CollisionGroupSetCollidable("DinoControllers", "DinoControllers", false)

function Dinosaur.setSpecies(character: Model, speciesId: string, isGold: (boolean | string)?)
    local scaleValue = character:GetAttribute("VisualScale")
    local scale = if typeof(scaleValue) == "number" then scaleValue else 1
    Dinosaur.render(character, scale, speciesId, isGold)
end

function Dinosaur.refreshForPlayer(character: Model, player: Player)
    local equipped = player:GetAttribute("EquippedSpeciesId")
    local speciesId = if typeof(equipped) == "string" then equipped else "compy"
    local ok, collection = pcall(function() return game:GetService("HttpService"):JSONDecode(player:GetAttribute("CollectionJson") or "{}") end)
    local entry = if ok then collection[speciesId] else nil
    local mutation = if entry and (entry.diamond or 0) &gt; 0 then "diamond" elseif entry and (entry.gold or 0) &gt; 0 then "gold" else "base"
    if player:GetAttribute("EquippedGenesJson") and player:GetAttribute("EquippedGenesJson")~="null" then mutation="base" end
    character:SetAttribute("BigDinosaur", player:GetAttribute("EquippedBig") == true)
    local factor = if character:GetAttribute("BigDinosaur") then Config.BigScaleMultiplier else 1
    Dinosaur.render(character, scaleForScore(character:GetAttribute("GrowthScore") or 0) * factor, speciesId, mutation)
end

function Dinosaur.addGrowth(character: Model, points: number)
    if points &lt;= 0 or character:GetAttribute("RunState") ~= "Active" then return end
    local current = character:GetAttribute("GrowthScore")
    local score = (if typeof(current) == "number" then current else 0) + points * math.clamp(character:GetAttribute("GrowthMultiplier") or 1,.1,8)
    character:SetAttribute("GrowthScore", score)
    local scale = scaleForScore(score) * (if character:GetAttribute("BigDinosaur") then Config.BigScaleMultiplier else 1)
    if character:GetAttribute("VisualScale") ~= scale then
        local gold = character:GetAttribute("MutationVisual") or "base"
        Dinosaur.render(character, scale, nil, gold)
    end
end

function Dinosaur.attach(character: Model, walkSpeed: number, player: Player)
    local deadline = os.clock() + 10
    while not character:IsDescendantOf(workspace) do
        if player.Character ~= character or not player.Parent then return end
        if os.clock() &gt;= deadline then return end
        RunService.Heartbeat:Wait()
    end
    local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
    local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
    if player.Character ~= character or not character:IsDescendantOf(workspace) then return end
    if not humanoid or not root or character:GetAttribute("DinoAttached") then return end

    local function hide(instance: Instance)
        if instance:FindFirstAncestor("DinoVisual") then return end
        if instance:IsA("BasePart") then instance.Transparency = 1 end
        if instance:IsA("Decal") then instance.Transparency = 1 end
    end
    for _, descendant in character:GetDescendants() do hide(descendant) end
    character.DescendantAdded:Connect(hide)

    humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    humanoid.WalkSpeed = walkSpeed
    humanoid.UseJumpPower = true
    humanoid.JumpPower = require(ReplicatedStorage.Shared.Config).JumpPower
    humanoid.MaxSlopeAngle = require(ReplicatedStorage.Shared.Config).MaxSlopeAngle
    humanoid.AutoJumpEnabled = false
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)

    -- Explicit torso collider: decorative mesh triangles never control physics.
    for _, item in character:GetDescendants() do
        if item:IsA("BasePart") then item.CollisionGroup = "DinoControllers" end
    end
    local collider = Instance.new("Part")
    collider.Name = "DinoCollider"
    collider.Size = Vector3.new(2.6, 2.4, 3.2)
    collider.Transparency = 1
    collider.Massless = true
    collider.CanCollide = true
    collider.CanTouch = false
    collider.CollisionGroup = "DinoControllers"
    local groundHeight = root.Size.Y / 2 + humanoid.HipHeight
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        local leg = character:FindFirstChild("Left Leg")
        groundHeight += if leg and leg:IsA("BasePart") then leg.Size.Y else 2
    end
    collider.CFrame = root.CFrame * CFrame.new(0, -groundHeight + 1.4, 0)
    collider.Parent = character
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = collider
    weld.Parent = collider
    Dinosaur.refreshForPlayer(character, player)
    character:SetAttribute("DinoAttached", true)
end

return Dinosaur
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX57">
        <Properties>
          <string name="Name">FoodService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local MovementEnvelope = require(ReplicatedStorage.Shared.MovementEnvelope)
local Resources = require(ReplicatedStorage.Shared.ResourceModels)
local Layout = require(ReplicatedStorage.Shared.IslandLayout)
local FoodCatchRules = require(ReplicatedStorage.Shared.FoodCatchRules)
local ProgressionRules = require(ReplicatedStorage.Shared.ProgressionRules)
local RewardMath = require(script.Parent.RewardMath)
local Http = game:GetService("HttpService")
local eventRandom = Random.new()
local FoodService = {}
local TYPES = {
    {id = "berry", weight = 78, points = 1, size = 0.7, color = Color3.fromRGB(224, 99, 118)},
    {id = "fruit", weight = 15, points = 4, size = 1.0, color = Color3.fromRGB(244, 186, 83)},
    {id = "egg", weight = 5, points = 15, size = 1.3, color = Color3.fromRGB(245, 230, 187)},
    {id = "amber", weight = 2, points = 50, size = 1.5, color = Color3.fromRGB(255, 219, 139)},
}
function FoodService.start(dinosaur,repository)
    workspace:SetAttribute("FoodSpawnStatus", "Building")
    workspace:SetAttribute("FoodCount", 0)
    workspace:SetAttribute("FoodStartupError", "")
    local folder = Instance.new("Folder")
    folder.Name = "Food"
    folder.Parent = workspace
    local foods = {}
    local random = Random.new(Config.FoodSeed)
    local groundParams = RaycastParams.new()
    groundParams.FilterType = Enum.RaycastFilterType.Include
    groundParams.FilterDescendantsInstances = {workspace.Terrain}
    local pickupParams = RaycastParams.new()
    pickupParams.FilterType = Enum.RaycastFilterType.Include
    pickupParams.FilterDescendantsInstances = {workspace.BeDinoArena, workspace.Terrain}
    local fallbackCount = 0
    local obstacleParams = RaycastParams.new()
    obstacleParams.FilterType = Enum.RaycastFilterType.Include
    obstacleParams.FilterDescendantsInstances = {workspace.BeDinoArena}
    local extent = Config.ArenaHalfWidth - 8
    local sectorWidth = 2 * extent / Config.FoodSectorCount
    local function groundAt(x: number, z: number): Vector3?
        -- Safe spawn remains clear. Ground's top is y=0.
        if (Vector2.new(x, z) - Vector2.new(0, 30)).Magnitude &lt; 11 then return nil end
        local hit = workspace:Raycast(Vector3.new(x, Config.TerrainTop + 20, z), Vector3.new(0, -Config.TerrainTop - 60, 0), groundParams)
        local ground: Vector3
        if hit then
            if hit.Material == Enum.Material.Water or hit.Normal.Y &lt; 0.62 then return nil end
            ground = hit.Position
        else
            -- Same authored heightfield that produced the terrain; never silently empty the map.
            fallbackCount += 1
            ground = Vector3.new(x, Layout.height(x,z) + Config.TerrainResolution*.5, z)
        end
        -- A second horizontal check keeps pickups away from solid rock/trunk edges.
        for _, direction in {Vector3.xAxis, -Vector3.xAxis, Vector3.zAxis, -Vector3.zAxis} do
            if workspace:Raycast(ground + Vector3.new(0, 1, 0), direction * 1.25, obstacleParams) then
                return nil
            end
        end
        return ground
    end
    local function relocate(food): boolean
        for _ = 1, 24 do
            local angle = random:NextNumber(0, 2 * math.pi)
            local radius = math.sqrt(random:NextNumber()) * Config.FoodClusterRadius
            local x = math.clamp(food.center.X + math.cos(angle) * radius, food.minX + 1, food.maxX - 1)
            local z = math.clamp(food.center.Y + math.sin(angle) * radius, food.minZ + 1, food.maxZ - 1)
            local ground = groundAt(x, z)
            if ground then
                food.part.Position = ground + Vector3.new(0, food.kind.size / 2 + 0.35, 0)
                if food.visual then food.visual:PivotTo(CFrame.new(ground + Vector3.new(0,.35,0))) end
                return true
            end
        end
        return false
    end
    local function show(food, visible: boolean)
        local hint = food.part:FindFirstChild("FoodHint")
        if hint and hint:IsA("BillboardGui") then hint.Enabled = visible end
        if food.visual then
            for _, item in food.visual:GetDescendants() do
                if item:IsA("BasePart") then item.Transparency = if visible then 0 else 1 end
            end
        else
            food.part.Transparency = if visible then 0 else 1
        end
    end
    for sx = 0, Config.FoodSectorCount - 1 do
        for sz = 0, Config.FoodSectorCount - 1 do
            local minX, minZ = -extent + sx * sectorWidth, -extent + sz * sectorWidth
            local center = Vector2.new(minX + sectorWidth / 2, minZ + sectorWidth / 2)
            -- Jitter cluster centers, including edge sectors; no one central food island.
            for _ = 1, 20 do
                local proposed = Vector2.new(random:NextNumber(minX + 3, minX + sectorWidth - 3), random:NextNumber(minZ + 3, minZ + sectorWidth - 3))
                if groundAt(proposed.X, proposed.Y) then center = proposed break end
            end
            local starter = (sx == 7 or sx == 8) and sz == 8
            if starter then center = Vector2.new(if sx == 7 then -15 else 15, 24) end
            for itemIndex = 1, Config.FoodClusterItems do
                local roll, kind = random:NextInteger(1, 100), TYPES[1]
                if roll &gt; 98 then kind = TYPES[4] elseif roll &gt; 93 then kind = TYPES[3] elseif roll &gt; 78 then kind = TYPES[2] end
                if starter then kind = if itemIndex % 3 == 0 then TYPES[2] else TYPES[1] end
                local pickup = Instance.new("Part")
                pickup.Name = kind.id
                pickup.Shape = Enum.PartType.Ball
                pickup.Size = Vector3.one * kind.size
                pickup.Color = kind.color
                pickup.Material = Enum.Material.SmoothPlastic
                pickup.Anchored = true
                pickup.CanCollide = false
                pickup.CanTouch = false
                pickup.CanQuery = false
                pickup:SetAttribute("Points", kind.points)
                pickup:SetAttribute("StarterFood", starter)
                pickup:SetAttribute("Sector", string.format("%d:%d", sx, sz))
                local visual = nil
                if kind.id == "egg" or kind.id == "amber" then
                    local ok, result = pcall(function()
                        local model = Resources.clone(kind.id)
                        if model then model:ScaleTo(kind.size / (if kind.id == "egg" then 2.4 else 1.3)) end
                        return model
                    end)
                    if ok then visual = result end -- visible native pickup survives any art failure
                end
                local food = {part = pickup, visual = visual, readyAt = 0, hidden = false, kind = kind,
                    center = center, minX = minX, maxX = minX + sectorWidth, minZ = minZ, maxZ = minZ + sectorWidth}
                if relocate(food) then
                    pickup.Parent = folder
                    if visual then
                        pickup.Transparency = 1
                        for _, item in visual:GetDescendants() do
                            if item:IsA("BasePart") then item.Anchored = true end
                        end
                        visual.Parent = pickup
                    end
                    table.insert(foods, food)
                    workspace:SetAttribute("FoodCount", #foods)
                    if starter then
                        local hint = Instance.new("BillboardGui")
                        hint.Name, hint.Size, hint.StudsOffset = "FoodHint", UDim2.fromOffset(74,24), Vector3.new(0,1.2,0)
                        hint.MaxDistance, hint.AlwaysOnTop, hint.Parent = 45,false,pickup
                        local label = Instance.new("TextLabel")
                        label.Size,label.BackgroundTransparency,label.Text = UDim2.fromScale(1,1),1,"+"..kind.points
                        label.Font,label.TextSize,label.TextColor3 = Enum.Font.FredokaOne,16,kind.color
                        label.TextStrokeTransparency,label.TextStrokeColor3,label.Parent = 0,Color3.new(0,0,0),hint
                    end
                else
                    pickup:Destroy()
                    if visual then visual:Destroy() end
                end
            end
        end
        task.wait() -- avoid one long startup frame while instancing pickup art
    end
    workspace:SetAttribute("FoodPlacementFallbacks", fallbackCount)
    workspace:SetAttribute("FoodCount", #foods)
    workspace:SetAttribute("FoodSpawnStatus", if #foods &gt; 0 then "Ready" else "No valid ground")
    if #foods == 0 then warn("[Be Dino] Food placement failed: no valid terrain hits") end
    local previous = {}
    Players.PlayerRemoving:Connect(function(player) previous[player] = nil end)
    task.spawn(function()
        while true do
            task.wait(Config.FoodTickSeconds)
            local now = os.clock()
            local candidates = {}
            for _, player in Players:GetPlayers() do
                local character = player.Character
                local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
                local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
                if character and root and root:IsA("BasePart") and humanoid and humanoid.Health &gt; 0
                    and character:GetAttribute("DinoAttached") and character:GetAttribute("RunState") == "Active" then
                    local last, position = previous[player], root.Position
                    local plausible = last and last.character == character
                        and MovementEnvelope.plausible(position - last.position, now - last.time, 2, 2, root.AssemblyLinearVelocity.Y, character:GetAttribute("MovementSpeedLimit") or humanoid.WalkSpeed)
                    previous[player] = {character = character, position = position, time = now}
                    if plausible then table.insert(candidates, {player = player, character = character, root = root, gained = 0}) end
                else previous[player] = nil end
            end
            for _, food in foods do
                if now &lt; food.readyAt then continue end
                if food.hidden then
                    relocate(food) -- original valid location remains if no replacement succeeds
                    show(food, true)
                    food.hidden = false
                end
                local winner, nearest = nil, math.huge
                for _, candidate in candidates do
                    local delta = food.part.Position - candidate.root.Position
                    local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
                    local scale = candidate.character:GetAttribute("VisualScale") or 1
                    local radius = math.min(5, Config.FoodPickupRadius + (scale - 1) * 0.75)
                    if horizontal &lt;= radius and math.abs(delta.Y) &lt; 6 then
                        local blocked = workspace:Raycast(candidate.root.Position, delta, pickupParams)
                        if not blocked and (horizontal &lt; nearest or (horizontal == nearest and winner and candidate.player.UserId &lt; winner.player.UserId)) then
                            nearest, winner = horizontal, candidate
                        end
                    end
                end
                if winner then
                    food.readyAt = now + Config.FoodRespawnSeconds
                    food.hidden = true
                    show(food, false)
                    winner.gained += food.kind.points
                end
            end
            for _, candidate in candidates do
                if candidate.gained &gt; 0 then
                    local c = candidate.character
                    local whole, carry = FoodCatchRules.award(candidate.gained, c:GetAttribute("FoodCatchCarry") or 0, c:GetAttribute("WeatherLootMultiplier") or 1)
                    c:SetAttribute("FoodCatchCarry", carry)
                    local before=c:GetAttribute("CatchScore") or 0
                    local after=math.min(Config.MaxCatchScore,before+whole)
                    c:SetAttribute("CatchScore",after)
                    local ok,events=pcall(function() return Http:JSONDecode(c:GetAttribute("RunEggEvents") or "[]") end)
                    if not ok or typeof(events)~="table" then events={} end
                    for i=1,RewardMath.earnedChests(after) do
                        if not events[i] then
                            events[i]=ProgressionRules.eventEgg(if i&gt;RewardMath.earnedChests(before) then workspace:GetAttribute("WeatherId") or "clear" else "clear",eventRandom:NextNumber())
                            if repository then events[i]=repository.prepareEgg(candidate.player,events[i]) end
                        end
                    end
                    c:SetAttribute("RunEggEvents",Http:JSONEncode(events))
                    dinosaur.addGrowth(c, candidate.gained)
                end
            end
        end
    end)
end
return FoodService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX58">
        <Properties>
          <string name="Name">ImportedResources</string>
          <ProtectedString name="Source">--!strict
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local InsertService=game:GetService("InsertService")
local Bindings=require(ReplicatedStorage.Shared.ResourceMeshAssets)
local Import={}
function Import.load()
    local folder=Instance.new("Folder") folder.Name="ResourceOverrides" folder.Parent=ReplicatedStorage
    for id,assetId in Bindings do
        if assetId=="" then continue end
        local container=nil
        local ok,result=pcall(function()
            container=InsertService:LoadAsset(tonumber(assetId))
            local model=Instance.new("Model") model.Name=id
            -- Copy geometry/appearance only; never retain executable or physics objects.
            for _,part in container:GetDescendants() do
                if part:IsA("BasePart") then
                    local copy=part:Clone()
                    for _,child in copy:GetDescendants() do
                        if not child:IsA("SurfaceAppearance") and not child:IsA("Decal") and not child:IsA("Texture") then child:Destroy() end
                    end
                    copy.Anchored,copy.CanCollide,copy.CanTouch,copy.CanQuery,copy.Massless=true,false,false,false,true
                    copy.Parent=model
                end
            end
            assert(#model:GetChildren()&gt;0,"Imported model has no geometry")
            local box,size=model:GetBoundingBox()
            local fallback=ReplicatedStorage.Resources:FindFirstChild(id)
            local targetHeight=size.Y
            if fallback and fallback:IsA("Model") then local _,bounds=fallback:GetBoundingBox() targetHeight=bounds.Y end
            local scale=targetHeight/size.Y
            local origin=box.Position-Vector3.new(0,size.Y/2,0)
            for _,part in model:GetChildren() do
                part.Size*=scale
                part.CFrame=CFrame.new((part.Position-origin)*scale)*part.CFrame.Rotation
            end
            model.WorldPivot=CFrame.new()
            model:SetAttribute("UploadedModelId",assetId)
            return model
        end)
        if container then container:Destroy() end
        if ok then result.Parent=folder else warn("[Be Dino] textured model "..id.." unavailable; keeping original: "..tostring(result)) end
    end
end
return Import
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX59">
        <Properties>
          <string name="Name">IslandTerrain</string>
          <ProtectedString name="Source">--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.IslandLayout)
local IslandTerrain = {}
function IslandTerrain.build()
    local terrain = workspace.Terrain
    terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(96, 148, 105))
    terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(114, 133, 137))
    terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(151, 124, 91))
    local resolution = Config.TerrainResolution
    local extent = Config.ArenaHalfWidth + 8
    local region = Region3.new(Vector3.new(-extent,-16,-extent), Vector3.new(extent,Config.TerrainTop,extent)):ExpandToGrid(resolution)
    local size = region.Size / resolution
    local low = region.CFrame.Position - region.Size / 2
    local materials, occupancy = {}, {}
    for x = 1, size.X do
        materials[x], occupancy[x] = {}, {}
        local wx = low.X + (x-.5)*resolution
        for y = 1, size.Y do materials[x][y], occupancy[x][y] = {}, {} end
        for z = 1, size.Z do
            local wz = low.Z + (z-.5)*resolution
            local height = Layout.height(wx,wz)
            for y = 1, size.Y do
                local wy = low.Y + (y-.5)*resolution
                occupancy[x][y][z] = math.clamp((height-wy)/resolution+.5,0,1)
                materials[x][y][z] = if wy &lt; height - 5 then Enum.Material.Rock
                    elseif height &gt; 42 and math.noise(wx/15,wz/15,2)&gt;.1 then Enum.Material.Rock else Enum.Material.Grass
            end
        end
        if x % 24 == 0 then task.wait() end
    end
    terrain:WriteVoxels(region,resolution,materials,occupancy)
    workspace:SetAttribute("IslandTerrainReady", true)
end
return IslandTerrain
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX60">
        <Properties>
          <string name="Name">Leaderboards</string>
          <ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local DataStoreService=game:GetService("DataStoreService")
local RunService=game:GetService("RunService")
local Config=require(game:GetService("ReplicatedStorage").Shared.Config)
local Theme=require(game:GetService("ReplicatedStorage").Shared.UITheme)
local Leaderboards={}
local preview=RunService:IsStudio() and game.GameId==0
local rows={}
local boards={}
local names={}
local definitions={
    {id="rarest",attribute="RarestCaught",title="RAREST DINOS",color=Theme.Colors.gold},
    {id="playSeconds",attribute="PlaySeconds",title="MOST PLAY TIME",color=Theme.Colors.accent},
    {id="robux",attribute="RobuxSpent",title="ROBUX SPENT",color=Theme.Colors.blue},
}
local stores={}
function Leaderboards.publish(player: Player, metrics)
    if not metrics and player:GetAttribute("ProfileState")~="Loaded" then return end
    names[player.UserId]=player.Name
    for _,definition in definitions do
        local value=if metrics then metrics[definition.id] else player:GetAttribute(definition.attribute) or 0
        if preview then
            rows[definition.id]=rows[definition.id] or {}
            rows[definition.id][player.UserId]=value
        else
            local ok,err=pcall(function()
                stores[definition.id]:UpdateAsync(tostring(player.UserId),function(old) return math.max(old or 0,value) end)
            end)
            if not ok then warn("[Be Dino] leaderboard publish failed: "..tostring(err)) end
        end
    end
end
local function displayValue(id: string,value: number): string
    if id=="rarest" then return ({"Common","Rare","Legendary"})[value] or "Not ranked" end
    if id=="playSeconds" then return string.format("%dh %02dm",value//3600,(value%3600)//60) end
    return tostring(value).." R$"
end
local function refresh()
    for _,definition in definitions do
        local page={}
        local ok=true
        if preview then
            for id,value in rows[definition.id] or {} do if value&gt;0 then table.insert(page,{key=tostring(id),value=value}) end end
            table.sort(page,function(a,b) return if a.value==b.value then tonumber(a.key)&lt;tonumber(b.key) else a.value&gt;b.value end)
        else
            ok=pcall(function() page=stores[definition.id]:GetSortedAsync(false,8,1):GetCurrentPage() end)
        end
        local board=boards[definition.id]
        board.Status.Text=if not ok then "Temporarily unavailable" elseif preview then "UNSAVED STUDIO PREVIEW" else "ALL-TIME"
        for rank=1,8 do
            local entry=page[rank]
            local text=""
            if entry then
                local id=tonumber(entry.key)
                if not names[id] then
                    local found,name=pcall(function() return Players:GetNameFromUserIdAsync(id) end)
                    names[id]=if found then name else "User "..entry.key
                end
                text=string.format("%d. %s  |  %s",rank,names[id],displayValue(definition.id,entry.value))
            elseif rank==1 then text=if ok then "No ranked players yet" else "Please check again later" end
            board.Rows[rank].Text=text
        end
    end
end
function Leaderboards.start()
    workspace.BeDinoArena.Sanctuary.SanctuarySign.Position=Vector3.new(0,35,402)
    local folder=Instance.new("Folder") folder.Name="Leaderboards" folder.Parent=workspace.BeDinoArena.Sanctuary
    for i,definition in definitions do
        if not preview then stores[definition.id]=DataStoreService:GetOrderedDataStore(Config.ProfileDataStoreName.."_"..definition.id.."_v1") end
        local part=Instance.new("Part")
        part.Name,part.Size,part.Position=definition.title,Vector3.new(27,23,1),Vector3.new((i-2)*30,19,399)
        part.Anchored,part.CanCollide,part.Color,part.Material,part.Parent=true,false,Theme.Colors.panel,Enum.Material.SmoothPlastic,folder
        local surface=Instance.new("SurfaceGui")
        surface.Face,surface.CanvasSize,surface.Parent=Enum.NormalId.Front,Vector2.new(540,460),part
        local function text(y,h,size,color)
            local label=Instance.new("TextLabel")
            label.Position,label.Size,label.BackgroundTransparency=UDim2.fromOffset(12,y),UDim2.fromOffset(516,h),1
            label.Font,label.TextSize,label.TextColor3,label.TextWrapped,label.Parent=Enum.Font.FredokaOne,size,color,true,surface
            return label
        end
        text(8,52,44,definition.color).Text=definition.title
        local status=text(60,22,18,Theme.Colors.text)
        local list={}
        for rank=1,8 do
            local row=text(86+(rank-1)*44,42,24,Theme.Colors.text)
            row.TextScaled=true
            local constraint=Instance.new("UITextSizeConstraint")
            constraint.MinTextSize,constraint.MaxTextSize,constraint.Parent=16,24,row
            list[rank]=row
            local rule=Instance.new("Frame")
            rule.Position,rule.Size=UDim2.fromOffset(12,128+(rank-1)*44),UDim2.fromOffset(516,1)
            rule.BackgroundColor3,rule.BackgroundTransparency,rule.BorderSizePixel,rule.Parent=Theme.Colors.text,.9,0,surface
        end
        boards[definition.id]={Status=status,Rows=list}
    end
    task.spawn(function()
        while folder.Parent do
            for _,player in Players:GetPlayers() do Leaderboards.publish(player,nil) end
            refresh()
            task.wait(60)
        end
    end)
end
return Leaderboards
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX61">
        <Properties>
          <string name="Name">LeapService</string>
          <ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local Config=require(ReplicatedStorage.Shared.ProgressionConfig)
local Leap={}
local active={}
local requests={}
function Leap.start()
    local remote=Instance.new("RemoteEvent") remote.Name="RequestLeap" remote.Parent=ReplicatedStorage.BeDinoRemotes
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances={workspace.Terrain,workspace.BeDinoArena}
    remote.OnServerEvent:Connect(function(player,...)
        if select("#",...)~=0 then return end
        local now=workspace:GetServerTimeNow()
        if now-(requests[player] or -math.huge)&lt;.3 then return end requests[player]=now
        local c=player.Character
        local h=if c then c:FindFirstChildOfClass("Humanoid") else nil
        local root=if c then c:FindFirstChild("HumanoidRootPart") else nil
        if not c or not root or not root:IsA("BasePart") or not h or h.Health&lt;=0 or c:GetAttribute("RunState")~="Active"
            or player:GetAttribute("ProfileState")~="Loaded" or h.FloorMaterial==Enum.Material.Air
            or player:GetAttribute("MovementSecurityStatus")=="REJECTED" then return end
        if now&lt;(player:GetAttribute("LeapReadyAt") or 0) then player:SetAttribute("LastLeapStatus","cooldown") return end
        local look=root.CFrame.LookVector
        local forward=Vector3.new(look.X,0,look.Z)
        if forward.Magnitude&lt;.01 then return end forward=forward.Unit
        if workspace:Blockcast(root.CFrame,Vector3.new(root.Size.X,1.5,root.Size.Z),forward*3,params) then
            player:SetAttribute("LastLeapStatus","blocked") return
        end
        local ownerOk=pcall(function() root:SetNetworkOwner(nil) end)
        if not ownerOk then return end
        player:SetAttribute("LeapReadyAt",now+Config.LeapCooldown)
        player:SetAttribute("LastLeapStatus","leaping")
        c:SetAttribute("LeapUntil",now+Config.LeapDuration)
        c:SetAttribute("MovementSpeedLimit",Config.LeapHorizontalSpeed)
        h:ChangeState(Enum.HumanoidStateType.Jumping)
        root.AssemblyLinearVelocity=forward*Config.LeapHorizontalSpeed+Vector3.new(0,Config.LeapVerticalSpeed,0)
        local a=Instance.new("Attachment") a.Position=Vector3.new(-.8,0,0) a.Parent=root
        local b=Instance.new("Attachment") b.Position=Vector3.new(.8,0,0) b.Parent=root
        local trail=Instance.new("Trail") trail.Attachment0,trail.Attachment1=a,b
        trail.Color=ColorSequence.new(Color3.fromRGB(80,214,255),Color3.new(1,1,1))
        trail.Lifetime,trail.FaceCamera,trail.Parent=.25,true,root
        active[player]={character=c,root=root,position=root.Position,endsAt=now+Config.LeapDuration,trail=trail,a=a,b=b}
    end)
    RunService.Heartbeat:Connect(function()
        local now=workspace:GetServerTimeNow()
        for player,state in active do
            local root=state.root
            if now&gt;=state.endsAt or player.Character~=state.character or state.character:GetAttribute("RunState")~="Active" then
                if root.Parent then
                    local velocity=root.AssemblyLinearVelocity
                    local h=state.character:FindFirstChildOfClass("Humanoid")
                    local speed=if h then h.WalkSpeed else 22
                    local horizontal=Vector3.new(velocity.X,0,velocity.Z)
                    if horizontal.Magnitude&gt;speed then horizontal=horizontal.Unit*speed end
                    root.AssemblyLinearVelocity=horizontal+Vector3.new(0,velocity.Y,0)
                    pcall(function() root:SetNetworkOwnershipAuto() end)
                end
                state.character:SetAttribute("LeapUntil",0)
                state.character:SetAttribute("MovementSpeedLimit",nil)
                state.trail:Destroy() state.a:Destroy() state.b:Destroy()
                active[player]=nil
            else
                local delta=root.Position-state.position
                if delta.Magnitude&gt;.001 then
                    local hit=workspace:Blockcast(CFrame.new(state.position),Vector3.new(root.Size.X,1.5,root.Size.Z),delta,params)
                    if hit then root.Position=state.position root.AssemblyLinearVelocity=Vector3.zero state.endsAt=now end
                end
                state.position=root.Position
            end
        end
    end)
    Players.PlayerRemoving:Connect(function(p) requests[p]=nil if active[p] then active[p].endsAt=0 end end)
end
return Leap
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX62">
        <Properties>
          <string name="Name">MovementGuard</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MovementEnvelope = require(ReplicatedStorage.Shared.MovementEnvelope)

local MovementGuard = {}
local states: {[Player]: {
    character: Model,
    cframe: CFrame,
    position: Vector3,
    sampleAt: number,
    blockedUntil: number,
}} = {}
local started = false

local function clear(player: Player)
    states[player] = nil
end

function MovementGuard.start()
    if started then return end
    started = true
    Players.PlayerRemoving:Connect(clear)

    task.spawn(function()
        while true do
            task.wait(Config.MovementGuardTickSeconds)
            local now = os.clock()

            for _, player in Players:GetPlayers() do
                local character = player.Character
                local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
                local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil

                if not character or not root or not root:IsA("BasePart") or not humanoid
                    or humanoid.Health &lt;= 0 or character:GetAttribute("RunState") ~= "Active" then
                    clear(player)
                    continue
                end

                local state = states[player]
                if not state or state.character ~= character then
                    states[player] = {
                        character = character,
                        cframe = root.CFrame,
                        position = root.Position,
                        sampleAt = now,
                        blockedUntil = now + Config.MovementGuardTickSeconds,
                    }
                    player:SetAttribute("MovementSecurityStatus", "WARMUP")
                    continue
                end

                local dt = math.max(now - state.sampleAt, Config.MovementGuardTickSeconds * 0.5)
                local distance = (root.Position - state.position).Magnitude
                local allowed = Config.WalkSpeed * dt * Config.MovementGuardSpeedTolerance
                    + Config.MovementGuardBurstStuds

                if not MovementEnvelope.plausible(root.Position - state.position, dt, Config.MovementGuardSpeedTolerance, Config.MovementGuardBurstStuds, root.AssemblyLinearVelocity.Y, character:GetAttribute("MovementSpeedLimit") or humanoid.WalkSpeed) then
                    -- Server correction: never promote the impossible location to the trusted baseline.
                    root.CFrame = state.cframe
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    state.sampleAt = now
                    state.blockedUntil = now + Config.MovementGuardRejectCooldownSeconds
                    local rejects = player:GetAttribute("MovementRejectCount")
                    player:SetAttribute(
                        "MovementRejectCount",
                        (if typeof(rejects) == "number" then rejects else 0) + 1
                    )
                    player:SetAttribute("MovementSecurityStatus", "REJECTED")
                    continue
                end

                state.cframe = root.CFrame
                state.position = root.Position
                state.sampleAt = now
                if now &gt;= state.blockedUntil then
                    player:SetAttribute("MovementSecurityStatus", "OK")
                end
            end
        end
    end)
end

return MovementGuard
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX63">
        <Properties>
          <string name="Name">MutationService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local MutationService = {}
local lastMutation: {[Player]: number} = {}
local lastSetup: {[Player]: number} = {}

local function getRemote(folder: Folder, name: string): RemoteEvent
    local existing = folder:FindFirstChild(name)
    if existing and existing:IsA("RemoteEvent") then return existing end
    if existing then existing:Destroy() end
    local remote = Instance.new("RemoteEvent")
    remote.Name = name
    remote.Parent = folder
    return remote
end

local function allowed(bucket: {[Player]: number}, player: Player): boolean
    local now = os.clock()
    local last = bucket[player] or -math.huge
    if now - last &lt; Config.MutationRequestCooldownSeconds then return false end
    bucket[player] = now
    return true
end

function MutationService.start(profileRepository, dinosaur)
    local folder = ReplicatedStorage:FindFirstChild("BeDinoRemotes") :: Folder?
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "BeDinoRemotes"
        folder.Parent = ReplicatedStorage
    end

    local mutate = getRemote(folder, "MutateSpecies")
    local setupTest = getRemote(folder, "TestSetMutationCopies")

    mutate.OnServerEvent:Connect(function(player: Player, speciesId, targetMutation, requestToken, ...)
        if select("#", ...) ~= 0 then return end
        if typeof(speciesId) ~= "string" or #speciesId &lt; 1 or #speciesId &gt; 32 then
            player:SetAttribute("LastMutationStatus", "invalid_species")
            return
        end
        if targetMutation ~= "gold" and targetMutation ~= "diamond" then
            player:SetAttribute("LastMutationStatus", "unknown_mutation")
            return
        end
        if typeof(requestToken) ~= "string" or #requestToken &lt; 1 or #requestToken &gt; 80 then
            player:SetAttribute("LastMutationStatus", "invalid_token")
            return
        end
        if not allowed(lastMutation, player) then
            player:SetAttribute("LastMutationStatus", "rate_limited")
            return
        end

        local ok, _, status = profileRepository.mutateSpecies(player, speciesId, targetMutation, requestToken)
        player:SetAttribute("LastMutationStatus", status)
        if ok then
            player:SetAttribute("LastMutationToken", requestToken)
            local character = player.Character
            if character and character:GetAttribute("DinoAttached") then
                dinosaur.refreshForPlayer(character, player)
            end
        end
    end)

    setupTest.OnServerEvent:Connect(function(player: Player, baseCount, ...)
        if select("#", ...) ~= 0 then return end
        if not Config.MutationTestSetupEnabled then return end
        if typeof(baseCount) ~= "number" or baseCount % 1 ~= 0 then
            player:SetAttribute("LastMutationSetupStatus", "bad_count")
            return
        end
        if not allowed(lastSetup, player) then
            player:SetAttribute("LastMutationSetupStatus", "rate_limited")
            return
        end
        local ok, status = profileRepository.setMutationTestCopies(
            player, Config.MutationTestSpeciesId, baseCount
        )
        player:SetAttribute("LastMutationSetupStatus", status)
        if ok then
            local character = player.Character
            if character and character:GetAttribute("DinoAttached") then
                dinosaur.refreshForPlayer(character, player)
            end
        end
    end)

    Players.PlayerRemoving:Connect(function(player)
        lastMutation[player] = nil
        lastSetup[player] = nil
    end)
end

return MutationService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX64">
        <Properties>
          <string name="Name">PredationService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local MovementEnvelope = require(ReplicatedStorage.Shared.MovementEnvelope)

local PredationService = {}

local function numberAttribute(instance: Instance, name: string, fallback: number): number
    local value = instance:GetAttribute(name)
    return if typeof(value) == "number" then value else fallback
end

local function canEat(attackerScore: number, targetScore: number): boolean
    return attackerScore &gt; targetScore and attackerScore &gt;= targetScore * Config.PredationScoreMultiplier
end

function PredationService.start(runLifecycle, dinosaur)
    local previous = {}
    local recentPairs: {[number]: {[number]: number}} = {}
    local arenaParams = RaycastParams.new()
    arenaParams.FilterType = Enum.RaycastFilterType.Include
    arenaParams.FilterDescendantsInstances = {workspace.BeDinoArena, workspace.Terrain}

    Players.PlayerRemoving:Connect(function(player)
        previous[player] = nil
        recentPairs[player.UserId] = nil
        for _, victims in recentPairs do
            victims[player.UserId] = nil
        end
    end)

    local function awardCatch(attacker, victimUserId: number, now: number)
        local victims = recentPairs[attacker.player.UserId]
        if not victims then
            victims = {}
            recentPairs[attacker.player.UserId] = victims
        end
        local last = victims[victimUserId] or -math.huge
        if now - last &lt; Config.RepeatVictimCatchCooldownSeconds then
            return
        end
        victims[victimUserId] = now
        local catches = numberAttribute(attacker.character, "CatchScore", 0)
        if catches &lt; Config.MaxCatchScore then
            local bonus=(attacker.character:GetAttribute("WeatherLootCarry") or 0)+(attacker.character:GetAttribute("WeatherLootMultiplier") or 1)
            local whole=math.floor(bonus)
            attacker.character:SetAttribute("WeatherLootCarry",bonus-whole)
            attacker.character:SetAttribute("CatchScore", math.min(Config.MaxCatchScore,catches+whole))
        end
    end

    task.spawn(function()
        while true do
            task.wait(Config.PredationTickSeconds)
            local movementNow = os.clock()
            local serverNow = workspace:GetServerTimeNow()
            local candidates = {}

            for _, player in Players:GetPlayers() do
                local character = player.Character
                local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
                local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
                if character and root and root:IsA("BasePart") and humanoid and humanoid.Health &gt; 0
                    and character:GetAttribute("DinoAttached") and runLifecycle.isActive(character) then
                    local last = previous[player]
                    local position = root.Position
                    local plausible = last and last.character == character
                        and MovementEnvelope.plausible(position - last.position, movementNow - last.time, 2, 2, root.AssemblyLinearVelocity.Y, character:GetAttribute("MovementSpeedLimit") or humanoid.WalkSpeed)
                    previous[player] = {character = character, position = position, time = movementNow}
                    if plausible then
                        table.insert(candidates, {
                            player = player,
                            character = character,
                            root = root,
                            score = numberAttribute(character, "GrowthScore", 0),
                            scale = numberAttribute(character, "VisualScale", 1),
                        })
                    end
                else
                    previous[player] = nil
                end
            end

            table.sort(candidates, function(a, b)
                return a.player.UserId &lt; b.player.UserId
            end)

            for _, victim in candidates do
                if not runLifecycle.isActive(victim.character) or runLifecycle.isProtected(victim.character, serverNow) then
                    continue
                end

                local winner = nil
                local nearest = math.huge
                for _, attacker in candidates do
                    if attacker.player == victim.player or not runLifecycle.isActive(attacker.character)
                        or runLifecycle.isProtected(attacker.character, serverNow) then
                        continue
                    end
                    if not canEat(attacker.score, victim.score) then continue end

                    local delta = victim.root.Position - attacker.root.Position
                    local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
                    local radius = math.min(Config.PredationMaxRadius,
                        Config.PredationBaseRadius + math.max(0, attacker.scale - 1) * 1.25)
                    if horizontal &gt; radius or math.abs(delta.Y) &gt; Config.PredationVerticalLimit then continue end

                    local blocked = workspace:Raycast(attacker.root.Position, delta, arenaParams)
                    if blocked then continue end

                    if horizontal &lt; nearest or (horizontal == nearest and winner and attacker.player.UserId &lt; winner.player.UserId) then
                        nearest = horizontal
                        winner = attacker
                    end
                end

                if winner and runLifecycle.tryEnd(victim.player, victim.character, "Eaten", winner.player.UserId) then
                    awardCatch(winner, victim.player.UserId, serverNow)
                    dinosaur.addGrowth(winner.character, Config.PredationGrowthPoints)
                end
            end
        end
    end)
end

return PredationService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX65">
        <Properties>
          <string name="Name">ProfileRepository</string>
          <ProtectedString name="Source">--!strict
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local RewardMath = require(script.Parent.RewardMath)
local ProgressionRules = require(ReplicatedStorage.Shared.ProgressionRules)
local EggTraits = require(ReplicatedStorage.Shared.EggTraits)
local EggGenetics = require(ReplicatedStorage.Shared.EggGenetics)
local ProgressionConfig = require(ReplicatedStorage.Shared.ProgressionConfig)

local ProfileRepository = {}

local RunService = game:GetService("RunService")
local localPreview = RunService:IsStudio() and game.GameId == 0 and Config.StudioLocalProfilesEnabled
local store: any
if localPreview then
    -- Unpublished F5 sessions have no DataStore. Deep copies mirror transaction boundaries.
    local memory = {}
    store = {UpdateAsync = function(_, key, transform)
        local current = if memory[key] then HttpService:JSONDecode(HttpService:JSONEncode(memory[key])) else nil
        local updated = transform(current)
        if updated == nil then return nil end
        memory[key] = HttpService:JSONDecode(HttpService:JSONEncode(updated))
        return updated
    end}
else
    store = DataStoreService:GetDataStore(Config.ProfileDataStoreName)
end
local leaseId = HttpService:GenerateGUID(false)
local profiles: {[Player]: any} = {}
local renewing = false

local function keyFor(player: Player): string
    return "u:" .. tostring(player.UserId)
end

local function knownSpecies(speciesId: any): boolean
    if typeof(speciesId) ~= "string" then return false end
    for _, configuredId in Config.SpeciesOrder do
        if configuredId == speciesId then return true end
    end
    return false
end

local function upgradeCollection(profile: any)
    if typeof(profile) ~= "table" or profile.schemaVersion ~= Config.ProfileSchemaVersion
        or typeof(profile.collection) ~= "table" then return end
    for _, id in Config.SpeciesOrder do
        local entry = profile.collection[id]
        -- Add only new catalog fields. Existing malformed balances remain invalid.
        if entry == nil and table.find({"raptor", "stegosaurus", "ankylosaurus"}, id) then
            entry = {base = 0, gold = 0, diamond = 0}
            profile.collection[id] = entry
        end
        if typeof(entry) == "table" and entry.diamond == nil then entry.diamond = 0 end
        if typeof(entry) == "table" and entry.events == nil then entry.events = {} end
        if typeof(entry) == "table" and entry.variants == nil then entry.variants = {} end
    end
    if profile.metrics == nil then profile.metrics = {playSeconds = 0, rarest = 0, robux = 0} end
    if profile.purchaseReceipts == nil then profile.purchaseReceipts = {} end
end

local function defaultProfile()
    local collection = {}
    for _, id in Config.SpeciesOrder do collection[id] = {base = if id == "compy" then 1 else 0, gold = 0, diamond = 0} end
    return {
        schemaVersion = Config.ProfileSchemaVersion,
        revision = 0,
        session = nil,
        equippedSpeciesId = "compy",
        collection = collection,
        pendingChestGrants = 0,
        eggs = {},
        recentOperations = {},
        lastCheckpoint = {
            committedAt = 0,
            lastSettledRunId = nil,
        },
    }
end

local function isValidProfile(profile: any): boolean
    upgradeCollection(profile)
    if typeof(profile) ~= "table" then return false end
    if profile.schemaVersion ~= Config.ProfileSchemaVersion then return false end
    if typeof(profile.revision) ~= "number" or profile.revision &lt; 0 then return false end
    if typeof(profile.collection) ~= "table" then return false end
    if typeof(profile.recentOperations) ~= "table" then return false end
    if typeof(profile.eggs) ~= "table" then return false end
    if typeof(profile.pendingChestGrants) ~= "number"
        or profile.pendingChestGrants &lt; 0 or profile.pendingChestGrants % 1 ~= 0 then
        return false
    end
    if not knownSpecies(profile.equippedSpeciesId) then return false end
    local function validEgg(egg, active: boolean?)
        if not ProgressionRules.validEgg(egg) then return false end
        if active and (typeof(egg.eggId) ~= "string" or #egg.eggId &lt; 1 or #egg.eggId &gt; 80
            or typeof(egg.readyAt) ~= "number" or egg.readyAt ~= egg.readyAt
            or egg.readyAt &lt; 0 or egg.readyAt % 1 ~= 0 or egg.readyAt == math.huge) then return false end
        if egg.big ~= nil and typeof(egg.big) ~= "boolean" then return false end
        if egg.shiny ~= nil and typeof(egg.shiny) ~= "boolean" then return false end
        local reward = egg.reward
        return reward == nil or (typeof(reward) == "table" and knownSpecies(reward.speciesId)
            and typeof(reward.count) == "number" and reward.count &gt;= 1 and reward.count &lt;= 3 and reward.count % 1 == 0)
    end
    for _,egg in profile.eggs do if not validEgg(egg,true) then return false end end
    if profile.pendingEggEvents~=nil then
        if typeof(profile.pendingEggEvents)~="table" or #profile.pendingEggEvents~=profile.pendingChestGrants then return false end
        for _,metadata in profile.pendingEggEvents do if not validEgg(metadata) then return false end end
    end
    for _, speciesId in Config.SpeciesOrder do
        local entry = profile.collection[speciesId]
        if typeof(entry) ~= "table"
            or typeof(entry.base) ~= "number" or entry.base &lt; 0 or entry.base % 1 ~= 0
            or typeof(entry.gold) ~= "number" or entry.gold &lt; 0 or entry.gold % 1 ~= 0
            or typeof(entry.diamond) ~= "number" or entry.diamond &lt; 0 or entry.diamond % 1 ~= 0
            or entry.base &gt; 2000000000 or entry.gold &gt; 2000000000 or entry.diamond &gt; 2000000000 then
            return false
        end
        if not ProgressionRules.validEvents(entry.events) then return false end
        if not EggTraits.valid(entry.variants) then return false end
        for _,variant in entry.variants do
            if variant.mutationId ~= "" and not ProgressionRules.knownEventMutation(variant.mutationId) then return false end
        end
    end
    if typeof(profile.metrics) ~= "table" or typeof(profile.purchaseReceipts) ~= "table" then return false end
    for id,processed in profile.purchaseReceipts do
        if typeof(id) ~= "string" or #id &lt; 1 or #id &gt; 120 or processed ~= true then return false end
    end
    if typeof(profile.session) == "table" and profile.session.metricsAt ~= nil then
        local at=profile.session.metricsAt
        if typeof(at) ~= "number" or at ~= at or at &lt; 0 or at % 1 ~= 0 or at == math.huge then return false end
    end
    for _,key in {"playSeconds", "rarest", "robux"} do
        local n = profile.metrics[key]
        if typeof(n) ~= "number" or n ~= n or n &lt; 0 or n % 1 ~= 0 or n &gt; 2000000000 then return false end
    end
    if profile.metrics.rarest &gt; 3 then return false end
    return ProgressionRules.valid(profile.progression)
end

local function retry(label: string, fn)
    local lastError = nil
    for attempt = 1, Config.ProfileMaxAttempts do
        local ok, result = pcall(fn)
        if ok then
            return true, result
        end
        lastError = result
        warn(string.format("[Be Dino] %s attempt %d failed: %s", label, attempt, tostring(result)))
        if attempt &lt; Config.ProfileMaxAttempts then
            task.wait(0.5 * (2 ^ (attempt - 1)))
        end
    end
    return false, lastError
end

local function syncAttributes(player: Player, profile: any)
    local progress=ProgressionRules.upgrade(profile)
    player:SetAttribute("StudioTestWallet", localPreview and Config.StudioTestWalletEnabled)
    player:SetAttribute("CollectionJson", HttpService:JSONEncode(profile.collection))
    player:SetAttribute("Crystals",progress.crystals)
    player:SetAttribute("ProgressionJson",HttpService:JSONEncode(progress))
    player:SetAttribute("EquippedAura",progress.equippedAura)
    local collection = profile.collection
    player:SetAttribute("CompyCopies", collection.compy.base)
    player:SetAttribute("CompyGold", collection.compy.gold)
    player:SetAttribute("TriceratopsCopies", collection.triceratops.base)
    player:SetAttribute("TriceratopsGold", collection.triceratops.gold)
    player:SetAttribute("TyrannosaurusCopies", collection.tyrannosaurus.base)
    player:SetAttribute("TyrannosaurusGold", collection.tyrannosaurus.gold)
    player:SetAttribute("PendingChestGrants", profile.pendingChestGrants or 0)
    player:SetAttribute("ProfileRevision", profile.revision or 0)
    player:SetAttribute("EquippedSpeciesId", profile.equippedSpeciesId)
    local traits = EggTraits.selected(collection[profile.equippedSpeciesId])
    player:SetAttribute("EquippedBig", traits ~= nil and traits.big)
    player:SetAttribute("EquippedShiny", traits ~= nil and traits.shiny)
    player:SetAttribute("EquippedGenesJson",HttpService:JSONEncode(if traits then traits.genes else nil))
    player:SetAttribute("EquippedCondition",if traits and traits.genes then traits.genes.conditionId else "normal")
    player:SetAttribute("AccountLevel",ProgressionRules.level(progress))
    player:SetAttribute("PlaySeconds", profile.metrics.playSeconds)
    player:SetAttribute("RarestCaught", profile.metrics.rarest)
    player:SetAttribute("RobuxSpent", profile.metrics.robux)
    local eventMutation=if traits then ProgressionRules.item(ProgressionConfig.EventMutations,traits.mutationId) else ProgressionRules.eventMutation(collection[profile.equippedSpeciesId])
    player:SetAttribute("EquippedEventMutation",if eventMutation then eventMutation.id else "")
    player:SetAttribute("ActiveChestCount", #profile.eggs)
    local chestSummary = {}
    for index, chest in profile.eggs do
        if index &gt; Config.ChestQueueCapacity then break end
        table.insert(chestSummary, {
            id = chest.eggId,
            readyAt = chest.readyAt,
            eventId=chest.eventId or "clear",
            mutationId=chest.mutationId or "",
            rarity=if chest.reward then Config.SpeciesRarities[chest.reward.speciesId] else 1,
            shiny=chest.shiny or false,
            big=chest.big or false,
            genes=chest.genes,
        })
    end
    player:SetAttribute("ChestQueueJson", HttpService:JSONEncode(chestSummary))
    local nextChest = profile.eggs[1]
    if typeof(nextChest) == "table" then
        player:SetAttribute("NextChestId", nextChest.eggId)
        player:SetAttribute("NextChestReadyAt", nextChest.readyAt)
    else
        player:SetAttribute("NextChestId", "")
        player:SetAttribute("NextChestReadyAt", 0)
    end
end

local function ownSession(profile: any): boolean
    local session = profile.session
    return typeof(session) == "table" and session.leaseId == leaseId
end

local function findOperation(profile: any, operationId: string)
    for _, entry in profile.recentOperations do
        if entry.id == operationId then
            return entry
        end
    end
    return nil
end

local function trimOperations(profile: any)
    while #profile.recentOperations &gt; Config.ProfileMaxRecentOperations do
        table.remove(profile.recentOperations, 1)
    end
end

local function lastChestReadyAt(profile: any, now: number): number
    local result = now
    for _, chest in profile.eggs do
        if typeof(chest) == "table" and typeof(chest.readyAt) == "number" then
            result = math.max(result, chest.readyAt)
        end
    end
    return result
end

local function availableChestCapacity(profile: any): number
    return (Config.ChestQueueCapacity - #profile.eggs)
        + (Config.ChestOverflowCapacity - profile.pendingChestGrants)
end

local function enqueueChestIds(profile: any, chestIds: {string}, now: number, events)
    local nextReadyAt = if Config.ChestTimerSeconds == 0 then now else lastChestReadyAt(profile, now)
    if not profile.pendingEggEvents then
        profile.pendingEggEvents={}
        for _=1,profile.pendingChestGrants do table.insert(profile.pendingEggEvents,{eventId="clear",mutationId=""}) end
    end
    for i, chestId in chestIds do
        local metadata=if events then events[i] else nil
        metadata=metadata or {eventId="clear",mutationId=""}
        if #profile.eggs &lt; Config.ChestQueueCapacity then
            nextReadyAt += Config.ChestTimerSeconds
            table.insert(profile.eggs, {
                eggId = chestId,
                kind = "alpha_chest",
                readyAt = nextReadyAt,
                eventId=metadata.eventId,
                mutationId=metadata.mutationId,
                reward=metadata.reward,
                shiny=metadata.shiny,
                big=metadata.big,
                genes=metadata.genes,
            })
        else
            profile.pendingChestGrants += 1
            table.insert(profile.pendingEggEvents,metadata)
        end
    end
end

function ProfileRepository.isLoaded(player: Player): boolean
    return profiles[player] ~= nil and player:GetAttribute("ProfileState") == "Loaded"
end

-- Catch-time assignment is immutable; upgraded odds only affect future eggs.
function ProfileRepository.prepareEgg(player: Player,tag)
    local rng=Random.new()
    local p=ProfileRepository.progression(player)
    local result=table.clone(tag)
    result.genes=EggGenetics.roll(if p then p.conditionLevel else 0,rng)
    local traits=EggTraits.roll(tag.eventId or "clear",rng:NextNumber(),rng:NextNumber())
    result.shiny,result.big=traits.shiny,traits.big
    return result
end

function ProfileRepository.load(player: Player): boolean
    if profiles[player] then return true end
    player:SetAttribute("ProfileMode", if localPreview then "Studio preview (not saved)" else "Persistent")
    player:SetAttribute("ProfileState", "Loading")

    local blockedByLease = false
    local invalidSchema = false
    local now = os.time()

    local ok, updated = retry("profile load", function()
        return store:UpdateAsync(keyFor(player), function(current)
            local profileValue = current
            if profileValue == nil then
                profileValue = defaultProfile()
            end
            if not isValidProfile(profileValue) then
                invalidSchema = true
                return nil
            end

            local progress = ProgressionRules.upgrade(profileValue)
            if localPreview and Config.StudioTestWalletEnabled then progress.crystals = Config.StudioTestCrystals end
            local session = profileValue.session
            if typeof(session) == "table"
                and session.leaseId ~= leaseId
                and typeof(session.expiresAt) == "number"
                and session.expiresAt &gt; now then
                blockedByLease = true
                return nil
            end

            profileValue.session = {
                leaseId = leaseId,
                jobId = game.JobId,
                expiresAt = now + Config.ProfileLeaseSeconds,
                metricsAt = now,
            }
            profileValue.revision += 1
            return profileValue
        end)
    end)

    if not ok or updated == nil or blockedByLease or invalidSchema then
        if blockedByLease then
            player:SetAttribute("ProfileState", "SessionBusy")
        elseif invalidSchema then
            player:SetAttribute("ProfileState", "SchemaError")
        else
            player:SetAttribute("ProfileState", "LoadFailed")
        end
        return false
    end

    if not profiles[player] or updated.revision &gt;= profiles[player].revision then profiles[player] = updated end
    player:SetAttribute("ProfileState", "Loaded")
    syncAttributes(player, profiles[player])
    return true
end

function ProfileRepository.commitRunSettlement(player: Player, runId: string, catchScore: number, eggEvents)
    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, nil, "profile_not_loaded"
    end
    if typeof(runId) ~= "string" or #runId &lt; 1 or #runId &gt; 80 then
        return false, nil, "invalid_run_id"
    end

    local outcome = RewardMath.computeRunReward(catchScore)
    local rng=Random.new()
    local box=0
    if catchScore&gt;0 then
        local total=0 for _,row in ProgressionConfig.CrystalBoxes do total+=row.weight end
        local roll=rng:NextNumber()*total
        for _,row in ProgressionConfig.CrystalBoxes do roll-=row.weight if roll&lt;0 then box=row.amount break end end
        if box==0 then box=ProgressionConfig.CrystalBoxes[#ProgressionConfig.CrystalBoxes].amount end
    end
    outcome.crystalBox=box
    outcome.crystals=math.min(ProgressionConfig.RunCrystalCap,catchScore*ProgressionConfig.RunCrystalPerCatch)+box
    if eggEvents~=nil then
        if typeof(eggEvents)~="table" or #eggEvents&gt;outcome.chestCount then return false,nil,"invalid_egg_events" end
        for _,metadata in eggEvents do if not ProgressionRules.validEgg(metadata) then return false,nil,"invalid_egg_events" end end
    end
    local operationId = "run:" .. runId
    -- Commit all random draws before UpdateAsync. Catch-time event tags stay authoritative.
    local prepared = {}
    for i = 1, outcome.chestCount do
        local tag = (eggEvents and eggEvents[i]) or {eventId = "clear", mutationId = ""}
        local traits = if tag.genes then tag else ProfileRepository.prepareEgg(player,tag)
        table.insert(prepared, {
            eventId = tag.eventId, mutationId = tag.mutationId,
            reward = RewardMath.computeChestReward(rng, outcome.chestCount),
            shiny = traits.shiny, big = traits.big, ordinal = i,
            genes=traits.genes,
        })
    end
    table.sort(prepared, function(a,b)
        local ar, br = Config.SpeciesRarities[a.reward.speciesId], Config.SpeciesRarities[b.reward.speciesId]
        return if ar == br then a.ordinal &lt; b.ordinal else ar &lt; br
    end)
    local chestIds = {}
    for _ = 1, outcome.chestCount do
        table.insert(chestIds, HttpService:GenerateGUID(false))
    end
    outcome.chestIds = chestIds
    local leaseLost = false
    local queueFull = false
    local duplicateOutcome = nil
    local now = os.time()

    local ok, updated = retry("run settlement", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end

            local existing = findOperation(profileValue, operationId)
            if existing then
                duplicateOutcome = existing.outcome
                return profileValue
            end

            if outcome.chestCount &gt; availableChestCapacity(profileValue) then
                queueFull = true
                return nil
            end

            for _, stack in outcome.stacks do
                local species = profileValue.collection[stack.speciesId]
                if typeof(species) ~= "table" or typeof(species.base) ~= "number" then
                    return nil
                end
                species.base += stack.count
                profileValue.metrics.rarest = math.max(profileValue.metrics.rarest, Config.SpeciesRarities[stack.speciesId])
            end

            enqueueChestIds(profileValue, chestIds, now, prepared)
            local progress=ProgressionRules.upgrade(profileValue)
            if progress.crystals+outcome.crystals&gt;ProgressionConfig.MaxCrystals then return nil end
            progress.crystals+=outcome.crystals
            progress.accountXP=math.min(2000000000,progress.accountXP+catchScore)
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            profileValue.lastCheckpoint = {
                committedAt = now,
                lastSettledRunId = runId,
            }
            table.insert(profileValue.recentOperations, {
                id = operationId,
                kind = "run",
                outcome = outcome,
            })
            trimOperations(profileValue)
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, nil, "lease_lost"
        end
        if queueFull then
            player:SetAttribute("LastChestClaimStatus", "queue_full")
            return false, nil, "queue_full"
        end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, nil, "save_failed"
    end

    if not profiles[player] or updated.revision &gt;= profiles[player].revision then profiles[player] = updated end
    syncAttributes(player, profiles[player])
    local committedOutcome = duplicateOutcome or outcome
    local summaryParts = {}
    for _, stack in committedOutcome.stacks do
        table.insert(summaryParts, string.format("%dx %s", stack.count, stack.speciesId))
    end
    if #summaryParts == 0 then table.insert(summaryParts, "no dinosaur copies") end
    if committedOutcome.chestCount &gt; 0 then
        table.insert(summaryParts, string.format("%d chest(s)", committedOutcome.chestCount))
    end
    player:SetAttribute("LastRewardText", table.concat(summaryParts, " | "))
    player:SetAttribute("LastRunCrystals",committedOutcome.crystals or 0)
    player:SetAttribute("LastRunCrystalBox",committedOutcome.crystalBox or 0)
    player:SetAttribute("LastSettledRunId", runId)
    return true, committedOutcome, if duplicateOutcome then "duplicate" else "committed"
end

function ProfileRepository.equipSpecies(player: Player, speciesId: string): (boolean, string)
    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, "profile_not_loaded"
    end
    if typeof(speciesId) ~= "string" or #speciesId &lt; 1 or #speciesId &gt; 32 then
        return false, "invalid_species"
    end
    if not knownSpecies(speciesId) then return false, "unknown_species" end

    local cachedEntry = cached.collection[speciesId]
    if typeof(cachedEntry) ~= "table" or (cachedEntry.base + cachedEntry.gold + cachedEntry.diamond &lt;= 0 and not ProgressionRules.eventMutation(cachedEntry) and not EggTraits.selected(cachedEntry)) then
        return false, "locked"
    end
    if cached.equippedSpeciesId == speciesId then
        syncAttributes(player, cached)
        return true, "already_equipped"
    end

    local leaseLost = false
    local locked = false
    local now = os.time()
    local ok, updated = retry("equip species", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end
            local entry = profileValue.collection[speciesId]
            if typeof(entry) ~= "table" or (entry.base + entry.gold + entry.diamond &lt;= 0 and not ProgressionRules.eventMutation(entry) and not EggTraits.selected(entry)) then
                locked = true
                return nil
            end
            profileValue.equippedSpeciesId = speciesId
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, "lease_lost"
        end
        if locked then return false, "locked" end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, "save_failed"
    end

    if not profiles[player] or updated.revision &gt;= profiles[player].revision then profiles[player] = updated end
    syncAttributes(player, profiles[player])
    return true, "equipped"
end

function ProfileRepository.grantCollectionTestSpecies(player: Player): (boolean, string)
    if not Config.CollectionTestGrantEnabled then return false, "disabled" end
    local speciesId = Config.CollectionTestGrantSpeciesId
    if not knownSpecies(speciesId) then return false, "bad_config" end

    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, "profile_not_loaded"
    end

    local operationId = string.format("test-grant:v%d:%s", Config.CollectionTestGrantVersion, speciesId)
    local duplicate = false
    local leaseLost = false
    local now = os.time()

    local ok, updated = retry("collection test grant", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end
            if findOperation(profileValue, operationId) then
                duplicate = true
                return profileValue
            end

            profileValue.collection[speciesId].base += 1
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            table.insert(profileValue.recentOperations, {
                id = operationId,
                kind = "collection_test_grant",
                outcome = {speciesId = speciesId, count = 1},
            })
            trimOperations(profileValue)
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, "lease_lost"
        end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, "save_failed"
    end

    if not profiles[player] or updated.revision &gt;= profiles[player].revision then profiles[player] = updated end
    syncAttributes(player, profiles[player])
    return true, if duplicate then "duplicate" else "granted"
end

function ProfileRepository.grantChestTest(player: Player): (boolean, string)
    if not Config.ChestTestGrantEnabled then return false, "disabled" end
    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, "profile_not_loaded"
    end

    local operationId = string.format("test-chests:v%d", Config.ChestTestGrantVersion)
    local chestIds = {}
    for _ = 1, Config.ChestTestGrantCount do
        table.insert(chestIds, HttpService:GenerateGUID(false))
    end
    local duplicate = false
    local queueFull = false
    local leaseLost = false
    local now = os.time()

    local ok, updated = retry("chest test grant", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end
            if findOperation(profileValue, operationId) then
                duplicate = true
                return profileValue
            end
            if #chestIds &gt; availableChestCapacity(profileValue) then
                queueFull = true
                return nil
            end

            enqueueChestIds(profileValue, chestIds, now)
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            table.insert(profileValue.recentOperations, {
                id = operationId,
                kind = "chest_test_grant",
                outcome = {count = #chestIds},
            })
            trimOperations(profileValue)
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, "lease_lost"
        end
        if queueFull then return false, "queue_full" end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, "save_failed"
    end

    if not profiles[player] or updated.revision &gt;= profiles[player].revision then profiles[player] = updated end
    syncAttributes(player, profiles[player])
    return true, if duplicate then "duplicate" else "granted"
end

function ProfileRepository.claimChest(player: Player, chestId: string)
    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, nil, "profile_not_loaded"
    end
    if typeof(chestId) ~= "string" or #chestId &lt; 1 or #chestId &gt; 80 then
        return false, nil, "invalid_chest_id"
    end

    local operationId = "chest:" .. chestId
    local cachedOperation = findOperation(cached, operationId)
    if cachedOperation then
        return true, cachedOperation.outcome, "duplicate"
    end

    local cachedChest = nil
    for _, chest in cached.eggs do
        if chest.eggId == chestId then
            cachedChest = chest
            break
        end
    end
    if not cachedChest then return false, nil, "missing" end

    local now = os.time()
    if now &lt; cachedChest.readyAt then return false, nil, "not_ready" end

    -- Generate once outside UpdateAsync so retries cannot reroll the reward.
    local outcome = if cachedChest.reward then table.clone(cachedChest.reward) else RewardMath.computeChestReward(Random.new())
    local refillChestId = HttpService:GenerateGUID(false)
    local duplicateOutcome = nil
    local leaseLost = false
    local notReady = false
    local missing = false

    local ok, updated = retry("chest claim", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end

            local existing = findOperation(profileValue, operationId)
            if existing then
                duplicateOutcome = existing.outcome
                return profileValue
            end

            local index = nil
            local chest = nil
            for i, candidate in profileValue.eggs do
                if candidate.eggId == chestId then
                    index = i
                    chest = candidate
                    break
                end
            end
            if not index or not chest then
                missing = true
                return nil
            end
            if now &lt; chest.readyAt then
                notReady = true
                return nil
            end
            if chest.reward and index ~= 1 then missing = true return nil end

            table.remove(profileValue.eggs, index)
            local species = profileValue.collection[outcome.speciesId]
            if typeof(species) ~= "table" then return nil end
            local mutationId=chest.mutationId or ""
            outcome.genes=chest.genes
            outcome.failed=chest.genes~=nil and not chest.genes.hatchSuccess
            if outcome.failed then
                outcome.count=0
            elseif chest.big or chest.shiny or chest.genes then
                local key = EggTraits.key(mutationId, chest.shiny == true, chest.big == true,chest.genes)
                local variant = species.variants[key] or {mutationId=mutationId, shiny=chest.shiny == true, big=chest.big == true, count=0,genes=chest.genes}
                variant.count += outcome.count
                species.variants[key] = variant
            elseif mutationId~="" then
                if not ProgressionRules.knownEventMutation(mutationId) then return nil end
                species.events[mutationId]=(species.events[mutationId] or 0)+outcome.count
            else species.base += outcome.count end
            outcome.eventMutationId=mutationId
            outcome.eventId=chest.eventId or "clear"
            outcome.big=chest.big == true
            outcome.shiny=chest.shiny == true
            if not outcome.failed then profileValue.metrics.rarest = math.max(profileValue.metrics.rarest, Config.SpeciesRarities[outcome.speciesId]) end

            if profileValue.pendingChestGrants &gt; 0 then
                profileValue.pendingChestGrants -= 1
                local readyAt = if Config.ChestTimerSeconds == 0 then now else lastChestReadyAt(profileValue, now) + Config.ChestTimerSeconds
                local metadata=if profileValue.pendingEggEvents then table.remove(profileValue.pendingEggEvents,1) else nil
                table.insert(profileValue.eggs, {
                    eggId = refillChestId,
                    kind = "alpha_chest",
                    readyAt = readyAt,
                    eventId=if metadata then metadata.eventId else "clear",
                    mutationId=if metadata then metadata.mutationId else "",
                    reward=if metadata then metadata.reward else nil,
                    shiny=if metadata then metadata.shiny else nil,
                    big=if metadata then metadata.big else nil,
                    genes=if metadata then metadata.genes else nil,
                })
            end

            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            table.insert(profileValue.recentOperations, {
                id = operationId,
                kind = "chest_claim",
                outcome = outcome,
            })
            trimOperations(profileValue)
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, nil, "lease_lost"
        end
        if notReady then return false, nil, "not_ready" end
        if missing then return false, nil, "missing" end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, nil, "save_failed"
    end

    if not profiles[player] or updated.revision &gt;= profiles[player].revision then profiles[player] = updated end
    syncAttributes(player, profiles[player])
    local committedOutcome = duplicateOutcome or outcome
    player:SetAttribute("LastChestRewardText", string.format(
        "%dx %s", committedOutcome.count, committedOutcome.speciesId
    ))
    player:SetAttribute("LastChestEventMutation",committedOutcome.eventMutationId or "")
    player:SetAttribute("LastChestBig",committedOutcome.big == true)
    player:SetAttribute("LastChestShiny",committedOutcome.shiny == true)
    player:SetAttribute("LastChestGenesJson",HttpService:JSONEncode(committedOutcome.genes))
    player:SetAttribute("LastChestFailed",committedOutcome.failed==true)
    player:SetAttribute("LastClaimedChestId", chestId)
    return true, committedOutcome, if duplicateOutcome then "duplicate" else "claimed"
end

function ProfileRepository.mutateSpecies(player: Player, speciesId: string, targetMutation: string, requestToken: string)
    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, nil, "profile_not_loaded"
    end
    if not knownSpecies(speciesId) then return false, nil, "unknown_species" end
    if targetMutation ~= "gold" and targetMutation ~= "diamond" then return false, nil, "unknown_mutation" end
    local source = if targetMutation == "diamond" then "gold" else "base"
    local cost = if targetMutation == "diamond" then Config.DiamondMutationCost else Config.GoldMutationCost
    if typeof(requestToken) ~= "string" or #requestToken &lt; 1 or #requestToken &gt; 80 then
        return false, nil, "invalid_token"
    end

    local operationId = "mutation:" .. requestToken
    local cachedOperation = findOperation(cached, operationId)
    if cachedOperation then
        if cachedOperation.outcome.speciesId ~= speciesId or cachedOperation.outcome.mutationId ~= targetMutation then return false, nil, "token_conflict" end
        return true, cachedOperation.outcome, "duplicate"
    end

    local cachedEntry = cached.collection[speciesId]
    if typeof(cachedEntry) ~= "table" or cachedEntry[source] &lt; cost then
        return false, nil, "insufficient_copies"
    end

    local outcome = {
        speciesId = speciesId,
        mutationId = targetMutation,
        spentBase = if source == "base" then cost else 0,
        gainedGold = if targetMutation == "gold" then 1 else 0,
        spentGold = if source == "gold" then cost else 0,
        gainedDiamond = if targetMutation == "diamond" then 1 else 0,
    }
    local duplicateOutcome = nil
    local leaseLost = false
    local insufficient = false
    local tokenConflict = false
    local now = os.time()

    local ok, updated = retry("mutation", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end

            local existing = findOperation(profileValue, operationId)
            if existing then
                if existing.outcome.speciesId ~= speciesId or existing.outcome.mutationId ~= targetMutation then tokenConflict = true return nil end
                duplicateOutcome = existing.outcome
                return profileValue
            end

            local entry = profileValue.collection[speciesId]
            if typeof(entry) ~= "table" or entry[source] &lt; cost then
                insufficient = true
                return nil
            end

            entry[source] -= cost
            entry[targetMutation] += 1
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            table.insert(profileValue.recentOperations, {
                id = operationId,
                kind = "mutation",
                outcome = outcome,
            })
            trimOperations(profileValue)
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, nil, "lease_lost"
        end
        if tokenConflict then return false, nil, "token_conflict" end
        if insufficient then return false, nil, "insufficient_copies" end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, nil, "save_failed"
    end

    if not profiles[player] or updated.revision &gt;= profiles[player].revision then profiles[player] = updated end
    syncAttributes(player, profiles[player])
    local committedOutcome = duplicateOutcome or outcome
    return true, committedOutcome, if duplicateOutcome then "duplicate" else "mutated"
end

function ProfileRepository.setMutationTestCopies(player: Player, speciesId: string, baseCount: number): (boolean, string)
    if not Config.MutationTestSetupEnabled then return false, "disabled" end
    if speciesId ~= Config.MutationTestSpeciesId then return false, "bad_species" end
    if baseCount ~= 49 and baseCount ~= 50 and baseCount ~= 51 then
        return false, "bad_count"
    end

    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, "profile_not_loaded"
    end

    local leaseLost = false
    local now = os.time()
    local ok, updated = retry("mutation test setup", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end
            local entry = profileValue.collection[speciesId]
            if typeof(entry) ~= "table" then return nil end
            entry.base = baseCount
            entry.gold = 0
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, "lease_lost"
        end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, "save_failed"
    end

    if not profiles[player] or updated.revision &gt;= profiles[player].revision then profiles[player] = updated end
    syncAttributes(player, profiles[player])
    return true, "set_" .. tostring(baseCount)
end

function ProfileRepository.progression(player: Player)
    if not ProfileRepository.isLoaded(player) then return nil end
    return ProgressionRules.upgrade(profiles[player])
end
function ProfileRepository.progressionAction(player: Player, action: string, id: string, token: string, replace: boolean?, amount: number?)
    if not ProfileRepository.isLoaded(player) then return false,"profile_not_loaded" end
    if typeof(token)~="string" or #token&lt;1 or #token&gt;80 then return false,"invalid_token" end
    if (action=="buyEgg" or action=="upgradeCondition") and next(Config.DeveloperProducts)~=nil
        and (not Config.PaidRandomItemsEnabled or player:GetAttribute("PaidRandomEligible")~=true) then return false,"random_items_unavailable" end
    local eggId=nil
    local egg=nil
    local purchaseConditionLevel=ProfileRepository.progression(player).conditionLevel
    if action=="buyEgg" then
        if id~="random" then return false,"unknown_item" end
        eggId=HttpService:GenerateGUID(false)
        egg=ProfileRepository.prepareEgg(player,{eventId="clear",mutationId=""})
        egg.reward=RewardMath.computeChestReward(Random.new(),1)
    end
    local operationId="progression:"..token
    local now=os.time()
    local denied="save_failed"
    local duplicate=false
    local outcome=nil
    local leaseLost=false
    local ok,updated=retry("progression",function()
        return store:UpdateAsync(keyFor(player),function(profile)
            if not isValidProfile(profile) then denied="invalid_profile" return nil end
            if not ownSession(profile) then leaseLost=true return nil end
            local existing=findOperation(profile,operationId)
            if existing then
                if existing.outcome.action~=action or existing.outcome.item~=id then denied="token_conflict" return nil end
                outcome=existing.outcome duplicate=true return profile
            end
            local progress = ProgressionRules.upgrade(profile)
            if localPreview and Config.StudioTestWalletEnabled then progress.crystals = Config.StudioTestCrystals end
            local applied,status
            if action=="buyEgg" then
                if availableChestCapacity(profile)&lt;1 then denied="queue_full" return nil end
                if progress.crystals&lt;ProgressionConfig.RandomEggPrice then denied="insufficient_crystals" return nil end
                -- Do not buy against stale odds if a concurrent condition upgrade committed.
                if progress.conditionLevel~=purchaseConditionLevel then denied="upgrade_changed" return nil end
                progress.crystals-=ProgressionConfig.RandomEggPrice
                enqueueChestIds(profile,{eggId},now,{egg})
                applied,status=true,"egg_purchased"
            else applied,status=ProgressionRules.apply(profile,action,id,now,replace,amount) end
            if localPreview and Config.StudioTestWalletEnabled then progress.crystals = Config.StudioTestCrystals end
            if not applied then denied=status return nil end
            outcome={action=action,item=id,status=status}
            profile.revision+=1
            profile.session.expiresAt=now+Config.ProfileLeaseSeconds
            table.insert(profile.recentOperations,{id=operationId,kind="progression",outcome=outcome})
            trimOperations(profile)
            return profile
        end)
    end)
    if not ok then player:SetAttribute("ProfileState","SaveFailed") return false,"save_failed" end
    if leaseLost then player:SetAttribute("ProfileState","LeaseLost") return false,"lease_lost" end
    if not updated then return false,denied end
    if not player.Parent then return true,if duplicate then "duplicate" else outcome.status end
    if not profiles[player] or updated.revision&gt;=profiles[player].revision then profiles[player]=updated end
    if player.Parent then syncAttributes(player,profiles[player]) end
    return true,if duplicate then "duplicate" else outcome.status
end

-- Only called by the server's MarketplaceService callback. Receipts are never trimmed.
function ProfileRepository.purchase(player: Player, receipt)
    if not ProfileRepository.isLoaded(player) then return false end
    local crystals = Config.DeveloperProducts[receipt.ProductId]
    if typeof(crystals) ~= "number" or crystals &lt; 1 or crystals % 1 ~= 0 then return false end
    if receipt.PlayerId ~= player.UserId or typeof(receipt.PurchaseId) ~= "string" or #receipt.PurchaseId &lt; 1 or #receipt.PurchaseId &gt; 120
        or typeof(receipt.CurrencySpent) ~= "number" or receipt.CurrencySpent ~= receipt.CurrencySpent
        or receipt.CurrencySpent &lt; 0 or receipt.CurrencySpent % 1 ~= 0 or receipt.CurrencySpent &gt; 2000000000 then return false end
    local ok, updated = retry("purchase", function()
        return store:UpdateAsync(keyFor(player),function(profile)
            if not isValidProfile(profile) or not ownSession(profile) then return nil end
            if profile.purchaseReceipts[receipt.PurchaseId] then return profile end
            local count=0 for _ in profile.purchaseReceipts do count+=1 end
            if count&gt;=10000 then return nil end -- Fail closed before the profile size limit.
            local progress=ProgressionRules.upgrade(profile)
            local maxCrystals=require(ReplicatedStorage.Shared.ProgressionConfig).MaxCrystals
            if progress.crystals+crystals&gt;maxCrystals or profile.metrics.robux+receipt.CurrencySpent&gt;2000000000 then return nil end
            progress.crystals+=crystals
            profile.metrics.robux+=receipt.CurrencySpent
            profile.purchaseReceipts[receipt.PurchaseId]=true
            profile.revision+=1
            profile.session.expiresAt=os.time()+Config.ProfileLeaseSeconds
            return profile
        end)
    end)
    if not ok or not updated then return false end
    if not profiles[player] then return true end
    if updated.revision&gt;=profiles[player].revision then profiles[player]=updated end
    syncAttributes(player,profiles[player])
    return true
end

function ProfileRepository.renew(player: Player): boolean
    if not profiles[player] or player:GetAttribute("ProfileState") ~= "Loaded" then return false end
    local leaseLost = false
    local now = os.time()
    local ok, updated = retry("lease renew", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) or not ownSession(profileValue) then
                leaseLost = true
                return nil
            end
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            local since = profileValue.session.metricsAt or now
            profileValue.metrics.playSeconds = math.min(2000000000, profileValue.metrics.playSeconds + math.max(0, now - since))
            profileValue.session.metricsAt = now
            profileValue.revision += 1
            return profileValue
        end)
    end)
    if not ok or updated == nil then
        player:SetAttribute("ProfileState", if leaseLost then "LeaseLost" else "SaveFailed")
        return false
    end
    if not profiles[player] or updated.revision &gt;= profiles[player].revision then profiles[player] = updated end
    syncAttributes(player, profiles[player])
    return true
end

function ProfileRepository.release(player: Player)
    local cached = profiles[player]
    profiles[player] = nil
    if not cached then return end

    local ok, updated = retry("lease release", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) or not ownSession(profileValue) then return nil end
            profileValue.metrics.playSeconds = math.min(2000000000, profileValue.metrics.playSeconds + math.max(0, os.time() - (profileValue.session.metricsAt or os.time())))
            profileValue.session = nil
            profileValue.revision += 1
            return profileValue
        end)
    end)
    return if ok and updated then updated.metrics else nil
end

function ProfileRepository.start()
    if renewing then return end
    renewing = true
    task.spawn(function()
        while renewing do
            task.wait(Config.ProfileRenewSeconds)
            for player in profiles do
                if player.Parent then task.spawn(ProfileRepository.renew, player) end
            end
        end
    end)
end

return ProfileRepository
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX66">
        <Properties>
          <string name="Name">ProgressionService</string>
          <ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Lighting=game:GetService("Lighting")
local Http=game:GetService("HttpService")
local Config=require(ReplicatedStorage.Shared.ProgressionConfig)
local Rules=require(ReplicatedStorage.Shared.ProgressionRules)
local Resources=require(ReplicatedStorage.Shared.ResourceModels)
local MovementEnvelope=require(ReplicatedStorage.Shared.MovementEnvelope)
local GameConfig=require(ReplicatedStorage.Shared.Config)
local Service={}
local random=Random.new()
local WeatherClock=require(ReplicatedStorage.Shared.WeatherClock)
local clock=WeatherClock.new(workspace:GetServerTimeNow())
local current=nil
local weatherEnds=0
local nextWeather=0
local buckets={}
local function weatherPick()
    local total=0 for _,event in Config.Weather do total+=event.weight end
    local roll=random:NextNumber(0,total)
    for _,event in Config.Weather do roll-=event.weight if roll&lt;=0 then return event end end
    return Config.Weather[1]
end
local function weatherAttributes()
    workspace:SetAttribute("WeatherId",if current then current.id else "clear")
    workspace:SetAttribute("WeatherName",if current then current.name else "Clear")
    workspace:SetAttribute("WeatherEndsAt",weatherEnds)
    workspace:SetAttribute("NextWeatherAt",nextWeather)
end
local function crystalSpawns(repository)
    local folder=Instance.new("Folder") folder.Name="CrystalCurrency" folder.Parent=workspace
    local entries={}
    local terrain=RaycastParams.new() terrain.FilterType=Enum.RaycastFilterType.Include terrain.FilterDescendantsInstances={workspace.Terrain}
    local obstacles=RaycastParams.new() obstacles.FilterType=Enum.RaycastFilterType.Include obstacles.FilterDescendantsInstances={workspace.BeDinoArena,workspace.Terrain}
    local function place(entry)
        for _=1,60 do
            local x,z=random:NextNumber(-245,245),random:NextNumber(-245,245)
            local hit=workspace:Raycast(Vector3.new(x,140,z),Vector3.new(0,-180,0),terrain)
            if hit and hit.Material~=Enum.Material.Water and hit.Normal.Y&gt;.65 and Vector2.new(x,z-30).Magnitude&gt;12 then
                local position=hit.Position+Vector3.new(0,1.4,0)
                if not workspace:Raycast(position,Vector3.new(0,2,0),obstacles) then
                    entry.part.Position=position
                    if entry.model then entry.model:PivotTo(CFrame.new(hit.Position+Vector3.new(0,.15,0))) end
                    return true
                end
            end
        end
        return false
    end
    local function visible(entry,on)
        entry.part.Transparency=if on and not entry.model then 0 else 1
        entry.hint.Enabled=on
        if entry.model then for _,part in entry.model:GetDescendants() do if part:IsA("BasePart") then part.Transparency=if on then 0 else 1 end end end
    end
    for i=1,Config.CrystalCount do
        local part=Instance.new("Part") part.Name="CrystalPickup" part.Shape=Enum.PartType.Ball part.Size=Vector3.one*1.3
        part.Anchored,part.CanCollide,part.CanTouch,part.CanQuery=true,false,false,false
        part.Material,part.Color=Enum.Material.Neon,Color3.fromRGB(255,200,66)
        local model=Resources.clone("amber") if model then model:ScaleTo(1.5) model.Parent=part end
        local hint=Instance.new("BillboardGui") hint.Size=UDim2.fromOffset(100,28) hint.StudsOffset=Vector3.new(0,1.5,0) hint.MaxDistance=45 hint.Parent=part
        local text=Instance.new("TextLabel") text.Size=UDim2.fromScale(1,1) text.BackgroundTransparency=1
        text.Text="+3 Crystals" text.TextColor3=part.Color text.TextSize=18 text.Font=Enum.Font.FredokaOne text.TextStrokeTransparency=0 text.Parent=hint
        local entry={part=part,model=model,hint=hint,readyAt=0,busy=false,available=true,token=Http:GenerateGUID(false)}
        if place(entry) then part.Parent=folder visible(entry,true) table.insert(entries,entry) else part:Destroy() end
    end
    workspace:SetAttribute("CrystalPickupCount",#entries)
    local previous={}
    Players.PlayerRemoving:Connect(function(p) previous[p]=nil end)
    task.spawn(function()
        while true do
            task.wait(.25)
            local now=os.clock()
            local eligible={}
            for _,player in Players:GetPlayers() do
                local c=player.Character
                local root=if c then c:FindFirstChild("HumanoidRootPart") else nil
                local h=if c then c:FindFirstChildOfClass("Humanoid") else nil
                if c and root and root:IsA("BasePart") and h and h.Health&gt;0 and c:GetAttribute("RunState")=="Active" then
                    local last=previous[player]
                    if last and last.character==c and MovementEnvelope.plausible(root.Position-last.position,now-last.time,2,2,root.AssemblyLinearVelocity.Y,c:GetAttribute("MovementSpeedLimit") or h.WalkSpeed)
                        and player:GetAttribute("MovementSecurityStatus")=="OK" and repository.isLoaded(player) then eligible[player]=true end
                    previous[player]={character=c,position=root.Position,time=now}
                else previous[player]=nil end
            end
            for _,entry in entries do
                if entry.busy then continue end
                if not entry.available and now&gt;=entry.readyAt then
                    if place(entry) then entry.available=true entry.token=Http:GenerateGUID(false) visible(entry,true) end
                end
                if not entry.available then continue end
                local winner=nil local nearest=math.huge
                for _,player in Players:GetPlayers() do
                    local c=player.Character
                    local root=if c then c:FindFirstChild("HumanoidRootPart") else nil
                    local h=if c then c:FindFirstChildOfClass("Humanoid") else nil
                    if c and root and root:IsA("BasePart") and h and h.Health&gt;0 and c:GetAttribute("RunState")=="Active"
                        and eligible[player] then
                        local delta=entry.part.Position-root.Position
                        local distance=Vector3.new(delta.X,0,delta.Z).Magnitude
                        if distance&lt;math.min(5,2.5+(c:GetAttribute("VisualScale") or 1)*.5) and math.abs(delta.Y)&lt;6
                            and distance&lt;nearest and not workspace:Raycast(root.Position,delta,obstacles) then winner=player nearest=distance end
                    end
                end
                if winner then
                    entry.busy=true visible(entry,false)
                    local claimant=winner
                    task.spawn(function()
                        local ok,status=repository.progressionAction(claimant,"grant","crystal",entry.token,false,Config.CrystalValue)
                        if ok then entry.available=false entry.readyAt=os.clock()+Config.CrystalRespawnSeconds end
                        entry.busy=false
                        visible(entry,not ok)
                        if claimant.Parent then claimant:SetAttribute("LastCrystalStatus",status) end
                    end)
                end
            end
        end
    end)
end
function Service.start(repository)
    local function policy(player)
        player:SetAttribute("PaidRandomEligible",false)
        local ok,info=pcall(function() return game:GetService("PolicyService"):GetPolicyInfoForPlayerAsync(player) end)
        if player.Parent then player:SetAttribute("PaidRandomEligible",ok and typeof(info)=="table" and info.ArePaidRandomItemsRestricted==false) end
    end
    Players.PlayerAdded:Connect(function(player) task.spawn(policy,player) end)
    for _,player in Players:GetPlayers() do task.spawn(policy,player) end
    local remote=Instance.new("RemoteEvent") remote.Name="ProgressionAction" remote.Parent=ReplicatedStorage.BeDinoRemotes
    local response=Instance.new("RemoteEvent") response.Name="ProgressionResult" response.Parent=ReplicatedStorage.BeDinoRemotes
    remote.OnServerEvent:Connect(function(player,action,id,token,replace,...)
        if select("#",...)~=0 or typeof(action)~="string" or not table.find({"buyAura","equipAura","buyTrail","equipTrail","buyPotion","usePotion","buyEgg","upgradeCondition"},action)
            or typeof(id)~="string" or #id&gt;40 or typeof(token)~="string" or #token&lt;1 or #token&gt;80
            or typeof(replace)~="boolean" then return end
        local now=os.clock() local bucket=buckets[player]
        if bucket and (bucket.busy or now-bucket.last&lt;.4) then response:FireClient(player,token,false,"busy") return end
        buckets[player]={last=now,busy=true}
        local ok,status=repository.progressionAction(player,action,id,token,replace)
        if buckets[player] then buckets[player].busy=false end
        if player.Parent then response:FireClient(player,token,ok,status) end
    end)
    nextWeather=clock.nextAt weatherAttributes()
    task.spawn(crystalSpawns,repository)
    task.spawn(function()
        while true do
            task.wait(1)
            local now=workspace:GetServerTimeNow()
            if WeatherClock.step(clock,now,weatherPick) then
                current,weatherEnds,nextWeather=clock.current,clock.endsAt,clock.nextAt
                local night=current and table.find({"thunder","bloodmoon","aurora"},current.id)~=nil
                Lighting.ClockTime=if night then 19 elseif current and current.id=="volcano" then 17 else 14
                Lighting.Brightness=if night then .9 elseif current then 1.6 else 2
                weatherAttributes()
            end
            for _,player in Players:GetPlayers() do
                local p=repository.progression(player)
                local c=player.Character
                if p and c then
                    local mutation=Rules.item(Config.EventMutations,player:GetAttribute("EquippedEventMutation") or "")
                    local growth,speed,loot=Rules.multipliers(p,player:GetAttribute("EquippedSpeciesId") or "compy",current,os.time(),player:GetAttribute("EquippedCondition"),mutation)
                    c:SetAttribute("EventMutationId",if mutation then mutation.id else "")
                    c:SetAttribute("GrowthMultiplier",growth) c:SetAttribute("WeatherLootMultiplier",loot)
                    player:SetAttribute("GrowthMultiplier",growth) player:SetAttribute("SpeedMultiplier",speed) player:SetAttribute("LootMultiplier",loot)
                    local h=c:FindFirstChildOfClass("Humanoid")
                    if h then h.WalkSpeed=GameConfig.WalkSpeed*(if c:GetAttribute("RunState")=="Active" then speed else 1) end
                    c:SetAttribute("EquippedAuraId",p.equippedAura)
                    c:SetAttribute("EquippedTrailId",p.equippedTrail or "")
                    c:SetAttribute("ShinyDinosaur",player:GetAttribute("EquippedShiny")==true)
                    c:SetAttribute("GenesJson",player:GetAttribute("EquippedGenesJson") or "null")
                end
            end
        end
    end)
    Players.PlayerRemoving:Connect(function(p) buckets[p]=nil end)
end
return Service
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX67">
        <Properties>
          <string name="Name">RewardMath</string>
          <ProtectedString name="Source">--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local RewardMath = {}

local function validateScore(catchScore: number)
    if catchScore ~= catchScore or catchScore == math.huge or catchScore == -math.huge then
        error("catchScore must be finite")
    end
    if catchScore % 1 ~= 0 or catchScore &lt; 0 or catchScore &gt; Config.MaxCatchScore then
        error("catchScore outside supported integer range")
    end
end

local function eligibleTierCount(catchScore: number): number
    local count = 0
    for _, threshold in Config.AlphaTierThresholds do
        if catchScore &gt;= threshold then
            count += 1
        end
    end
    return count
end

function RewardMath.allocateTiers(catchScore: number): {number}
    validateScore(catchScore)
    local tierCount = eligibleTierCount(catchScore)
    if catchScore == 0 or tierCount == 0 then
        return {}
    end

    local allocated = table.create(tierCount, 0)
    local weights = table.create(tierCount, 0)
    for tier = 1, tierCount do
        weights[tier] = Config.RarityQ ^ (tier - 1)
    end

    for _ = 1, catchScore do
        local bestTier = 1
        local bestValue = -math.huge
        for tier = 1, tierCount do
            local value = weights[tier] / (allocated[tier] + 1)
            if value &gt; bestValue then
                bestValue = value
                bestTier = tier
            end
        end
        allocated[bestTier] += 1
    end

    return allocated
end

function RewardMath.earnedChests(catchScore: number): number
    validateScore(catchScore)
    local result = 0
    for _, row in Config.ChestThresholds do
        if catchScore &gt;= row.score then
            result = row.count
        end
    end
    return result
end

function RewardMath.computeRunReward(catchScore: number)
    local tierCounts = RewardMath.allocateTiers(catchScore)
    local stacks = {}
    for tier, count in tierCounts do
        if count &gt; 0 then
            table.insert(stacks, {
                speciesId = Config.AlphaSpeciesByTier[tier],
                mutationId = "base",
                count = count,
            })
        end
    end
    return {
        rewardConfigVersion = 1,
        catchScore = catchScore,
        stacks = stacks,
        chestCount = RewardMath.earnedChests(catchScore),
    }
end

local function weightedChoice(rows, rng: Random)
    local total = 0
    for _, row in rows do total += row.weight end
    local roll = rng:NextNumber(0, total)
    local cumulative = 0
    for _, row in rows do
        cumulative += row.weight
        if roll &lt;= cumulative then return row end
    end
    return rows[#rows]
end

function RewardMath.computeChestReward(rng: Random?, eggCount: number?)
    local random = rng or Random.new()
    local boost = 1 + (math.clamp(eggCount or 1, 1, Config.EggRarityBoostMaxEggs) - 1) * Config.EggRarityBoostPerExtraEgg
    local rows = {}
    for _, row in Config.ChestSpeciesWeights do
        table.insert(rows, {speciesId = row.speciesId, weight = row.weight * boost ^ (Config.SpeciesRarities[row.speciesId] - 1)})
    end
    local speciesRow = weightedChoice(rows, random)
    local quantityRow = weightedChoice(Config.ChestQuantityWeights, random)
    return {
        rewardConfigVersion = 1,
        speciesId = speciesRow.speciesId,
        mutationId = "base",
        count = quantityRow.count,
    }
end

return RewardMath
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX68">
        <Properties>
          <string name="Name">RunLifecycle</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Config = require(ReplicatedStorage.Shared.Config)

local RunLifecycle = {}
local lastExitRequest: {[Player]: number} = {}
local requestEndRun: RemoteEvent? = nil
local settleRun = nil

function RunLifecycle.prepareSanctuary(player: Player, character: Model)
    character:SetAttribute("RunState", "Sanctuary")
    character:SetAttribute("GrowthScore", 0)
    character:SetAttribute("CatchScore", 0)
    character:SetAttribute("FoodCatchCarry", 0)
    character:SetAttribute("WeatherLootCarry",0)
    character:SetAttribute("RunEggEvents","[]")
    character:SetAttribute("ExitChannelEndsAt", 0)
    player:SetAttribute("Location", "Sanctuary")
end

local function activeCharacter(player: Player): Model?
    local character = player.Character
    if not character or character:GetAttribute("RunState") ~= "Active" then return nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health &lt;= 0 then return nil end
    return character
end

function RunLifecycle.configureSettlement(callback)
    settleRun = callback
end

function RunLifecycle.begin(player: Player, character: Model)
    if player:GetAttribute("ProfileState") ~= "Loaded" then return end
    if character:GetAttribute("RunId") ~= nil then return end
    character:SetAttribute("RunId", HttpService:GenerateGUID(false))
    player:SetAttribute("Location", "Island")
    character:SetAttribute("RunState", "Active")
    character:SetAttribute("GrowthScore", 0)
    character:SetAttribute("CatchScore", 0)
    character:SetAttribute("FoodCatchCarry", 0)
    character:SetAttribute("WeatherLootCarry",0)
    character:SetAttribute("RunEggEvents","[]")
    character:SetAttribute("SpawnProtectionEndsAt", workspace:GetServerTimeNow() + Config.SpawnProtectionSeconds)
    character:SetAttribute("ExitChannelEndsAt", 0)

    task.spawn(function()
        local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
        if not humanoid or player.Character ~= character then return end
        humanoid.Died:Connect(function()
            RunLifecycle.tryEnd(player, character, "Death")
        end)
    end)
end

function RunLifecycle.isActive(character: Model): boolean
    return character:GetAttribute("RunState") == "Active"
end

function RunLifecycle.isProtected(character: Model, now: number?): boolean
    local raw = character:GetAttribute("SpawnProtectionEndsAt")
    local endsAt = if typeof(raw) == "number" then raw else 0
    return endsAt &gt; (now or workspace:GetServerTimeNow())
end

local function settlementSnapshot(character: Model)
    local runId = character:GetAttribute("RunId")
    local catchScore = character:GetAttribute("CatchScore")
    if typeof(runId) ~= "string" then return nil end
    if typeof(catchScore) ~= "number" or catchScore % 1 ~= 0 then return nil end
    local ok,events=pcall(function() return HttpService:JSONDecode(character:GetAttribute("RunEggEvents") or "[]") end)
    return {
        runId = runId,
        catchScore = math.clamp(catchScore, 0, Config.MaxCatchScore),
        eggEvents=if ok and typeof(events)=="table" then events else {},
    }
end

local function respawnAfterSettlement(player: Player, character: Model, snapshot, reason: string)
    task.spawn(function()
        local ok = true
        if settleRun then
            ok = settleRun(player, snapshot.runId, snapshot.catchScore, reason, snapshot.eggEvents)
        end
        if not ok then
            if player.Parent and player:GetAttribute("ProfileState") == "Loaded" then
                player:SetAttribute("ProfileState", "SaveFailed")
            end
            return
        end

        character:SetAttribute("RunState", "Settled")
        if not player.Parent then return end
        task.wait(Config.RespawnDelaySeconds)
        if player.Parent and player:GetAttribute("ProfileState") == "Loaded" then
            local loaded, err = pcall(function()
                player:LoadCharacterAsync()
            end)
            if not loaded then
                warn("[Be Dino] respawn failed: " .. tostring(err))
            end
        end
    end)
end

function RunLifecycle.tryEnd(player: Player, character: Model, reason: string, sourceUserId: number?): boolean
    if player.Character ~= character or character:GetAttribute("RunState") ~= "Active" then
        return false
    end
    local snapshot = settlementSnapshot(character)
    if not snapshot then
        return false
    end

    character:SetAttribute("RunState", "Ending")
    character:SetAttribute("ExitChannelEndsAt", 0)
    player:SetAttribute("LastRunEndReason", reason)
    player:SetAttribute("LastRunCatchScore", snapshot.catchScore)
    local growthScore = character:GetAttribute("GrowthScore")
    player:SetAttribute("LastRunGrowthScore", if typeof(growthScore) == "number" then growthScore else 0)
    player:SetAttribute("LastRunId", snapshot.runId)
    player:SetAttribute("LastRunEndAt", workspace:GetServerTimeNow())
    player:SetAttribute("LastPredatorUserId", sourceUserId or 0)

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health &gt; 0 then
        humanoid.Health = 0
    end

    respawnAfterSettlement(player, character, snapshot, reason)
    return true
end

function RunLifecycle.endForDisconnect(player: Player): string
    local character = player.Character
    if not character then return "none" end
    if character:GetAttribute("RunState") == "Ending" then
        return "busy"
    end
    if character:GetAttribute("RunState") ~= "Active" then
        return "none"
    end
    local snapshot = settlementSnapshot(character)
    if not snapshot then return "none" end

    character:SetAttribute("RunState", "Ending")
    character:SetAttribute("ExitChannelEndsAt", 0)
    player:SetAttribute("LastRunEndReason", "Disconnect")
    player:SetAttribute("LastRunCatchScore", snapshot.catchScore)
    local growthScore = character:GetAttribute("GrowthScore")
    player:SetAttribute("LastRunGrowthScore", if typeof(growthScore) == "number" then growthScore else 0)
    if settleRun then
        local ok = settleRun(player, snapshot.runId, snapshot.catchScore, "Disconnect", snapshot.eggEvents)
        return if ok then "settled" else "failed"
    end
    return "settled"
end

local function cancelExit(character: Model)
    if character:GetAttribute("RunState") == "Active" then
        character:SetAttribute("ExitChannelEndsAt", 0)
    end
end

local function startExitChannel(player: Player, character: Model)
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root or not root:IsA("BasePart") then return end
    local currentEnd = character:GetAttribute("ExitChannelEndsAt")
    if typeof(currentEnd) == "number" and currentEnd &gt; workspace:GetServerTimeNow() then return end

    local origin = root.Position
    character:SetAttribute("ExitChannelEndsAt", workspace:GetServerTimeNow() + Config.ExitChannelSeconds)
    task.spawn(function()
        local deadline = os.clock() + Config.ExitChannelSeconds
        while os.clock() &lt; deadline do
            task.wait(0.1)
            if player.Character ~= character or character:GetAttribute("RunState") ~= "Active" then
                return
            end
            local currentRoot = character:FindFirstChild("HumanoidRootPart")
            if not currentRoot or not currentRoot:IsA("BasePart") then
                cancelExit(character)
                return
            end
            if (currentRoot.Position - origin).Magnitude &gt; Config.ExitMoveCancelDistance then
                cancelExit(character)
                return
            end
        end
        RunLifecycle.tryEnd(player, character, "ManualExit")
    end)
end

function RunLifecycle.start()
    local folder = ReplicatedStorage:FindFirstChild("BeDinoRemotes")
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "BeDinoRemotes"
        folder.Parent = ReplicatedStorage
    end

    local startRemote = Instance.new("RemoteEvent")
    startRemote.Name = "RequestStartRun"
    startRemote.Parent = folder
    startRemote.OnServerEvent:Connect(function(player: Player, ...)
        if select("#", ...) ~= 0 or player:GetAttribute("ProfileState") ~= "Loaded" then return end
        local character = player.Character
        if not character or character:GetAttribute("RunState") ~= "Sanctuary" or not character:GetAttribute("DinoAttached") then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health &lt;= 0 then return end
        local spawn = workspace.BeDinoArena:FindFirstChild("PrototypeSpawn")
        if not spawn or not spawn:IsA("BasePart") then return end
        character:PivotTo(spawn.CFrame + Vector3.new(0,5,0))
        RunLifecycle.begin(player, character)
    end)

    local existing = folder:FindFirstChild("RequestEndRun")
    if existing and existing:IsA("RemoteEvent") then
        requestEndRun = existing
    else
        if existing then existing:Destroy() end
        local remote = Instance.new("RemoteEvent")
        remote.Name = "RequestEndRun"
        remote.Parent = folder
        requestEndRun = remote
    end

    local remote = requestEndRun :: RemoteEvent
    remote.OnServerEvent:Connect(function(player: Player, ...)
        if select("#", ...) ~= 0 then return end
        if player:GetAttribute("ProfileState") ~= "Loaded" then return end
        local now = os.clock()
        local last = lastExitRequest[player] or -math.huge
        if now - last &lt; Config.ExitRequestCooldownSeconds then return end
        lastExitRequest[player] = now
        local character = activeCharacter(player)
        if not character then return end
        startExitChannel(player, character)
    end)

    Players.PlayerRemoving:Connect(function(player)
        lastExitRequest[player] = nil
    end)
end

return RunLifecycle
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX69">
        <Properties>
          <string name="Name">VisualTestService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local VisualTestService = {}
local lastRequest: {[Player]: number} = {}

local function validSpecies(speciesId: any): boolean
    if typeof(speciesId) ~= "string" then return false end
    for _, id in Config.SpeciesOrder do
        if id == speciesId then return true end
    end
    return false
end

function VisualTestService.start(dinosaur)
    if not Config.ArtTestHarnessEnabled then return end

    local folder = ReplicatedStorage:FindFirstChild("BeDinoRemotes") :: Folder?
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "BeDinoRemotes"
        folder.Parent = ReplicatedStorage
    end

    local preview = Instance.new("RemoteEvent")
    preview.Name = "PreviewDinosaurArt"
    preview.Parent = folder

    preview.OnServerEvent:Connect(function(player: Player, speciesId, gold, restore, ...)
        if select("#", ...) ~= 0 then return end
        if typeof(restore) ~= "boolean" then return end

        local now = os.clock()
        local last = lastRequest[player] or -math.huge
        if now - last &lt; Config.ArtPreviewRequestCooldownSeconds then return end
        lastRequest[player] = now

        local character = player.Character
        if not character or not character:GetAttribute("DinoAttached")
            or character:GetAttribute("RunState") ~= "Active" then
            return
        end

        if restore then
            dinosaur.refreshForPlayer(character, player)
            player:SetAttribute("ArtPreviewStatus", "SAVED EQUIP")
            return
        end
        if not validSpecies(speciesId) or typeof(gold) ~= "boolean" then return end

        dinosaur.setSpecies(character, speciesId, gold)
        player:SetAttribute("ArtPreviewStatus",
            (if gold then "GOLD " else "") .. string.upper(speciesId))
    end)

    Players.PlayerRemoving:Connect(function(player)
        lastRequest[player] = nil
    end)
end

return VisualTestService
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX70">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX71">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX72">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="RBX73">
          <Properties>
            <string name="Name">Bootstrap</string>
            <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Input = game:GetService("UserInputService")
local Http = game:GetService("HttpService")
local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(Shared.UITheme)
local NavigationArtwork = require(Shared.NavigationArtwork)
local Preview = require(Shared.DinosaurPreview)
local ModelPreview = require(Shared.ModelPreview)
local HatchPresentation = require(Shared.HatchPresentation)
local ProgressionConfig=require(Shared.ProgressionConfig)
local ProgressionRules=require(Shared.ProgressionRules)
local EggTraits=require(Shared.EggTraits)
local PreviewTraits=require(script.Parent.PreviewTraits)
local EggGenetics=require(Shared.EggGenetics)
local EggAppearance=require(Shared.EggAppearance)
local ShopOdds=require(Shared.ShopOdds)
local Marketplace=game:GetService("MarketplaceService")
local C = Theme.Colors
local remotes = ReplicatedStorage:WaitForChild("BeDinoRemotes")
local startRun = remotes:WaitForChild("RequestStartRun") :: RemoteEvent
local endRun = remotes:WaitForChild("RequestEndRun") :: RemoteEvent
local equip = remotes:WaitForChild("EquipSpecies") :: RemoteEvent
local hatch = remotes:WaitForChild("ClaimChest") :: RemoteEvent
local fuse = remotes:WaitForChild("MutateSpecies") :: RemoteEvent
local shopAction=remotes:WaitForChild("ProgressionAction") :: RemoteEvent
local shopResult=remotes:WaitForChild("ProgressionResult") :: RemoteEvent
local leapRemote=remotes:WaitForChild("RequestLeap") :: RemoteEvent
local gui = Instance.new("ScreenGui")
gui.Name,gui.ResetOnSpawn,gui.ZIndexBehavior = "BeDinoUI",false,Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")
local blur = Instance.new("BlurEffect")
blur.Name,blur.Size,blur.Parent = "BeDinoModalBlur",0,Lighting
local motion = true
local active = ""
local selected = "compy"
local seenTutorial = false
local lastGrowth = 0
local lastEggCount = 0
local function num(id: string): number return player:GetAttribute(id) or 0 end
local function str(id: string,fallback: string?): string return player:GetAttribute(id) or fallback or "" end
local jsonCache = {}
local function decoded(attribute: string, fallback: string)
    local raw=str(attribute,fallback)
    local cached=jsonCache[attribute]
    if cached and cached.raw==raw then return cached.data end
    local ok,data=pcall(function() return Http:JSONDecode(raw) end)
    local result=if ok and typeof(data)=="table" then data else {}
    jsonCache[attribute]={raw=raw,data=result}
    return result
end
local function copies(id: string): (number,number,number)
    local entry = decoded("CollectionJson","{}")[id]
    return if entry then entry.base or 0 else 0, if entry then entry.gold or 0 else 0, if entry then entry.diamond or 0 else 0
end
local function bestMutation(id: string): string
    local _,gold,diamond = copies(id)
    return if diamond&gt;0 then "diamond" elseif gold&gt;0 then "gold" else "base"
end
local function eventMutation(id: string)
    return ProgressionRules.eventMutation(decoded("CollectionJson","{}")[id])
end
local fusionTarget = "gold"
local hatchPending = false
local autoHatching = false
local hatchCancelSerial = 0
local function ownedTraits(id: string)
    return EggTraits.selected(decoded("CollectionJson","{}")[id])
end
local function label(parent: Instance,text: string,x: number,y: number,w: number,h: number,size: number,color: Color3?): TextLabel
    local t = Instance.new("TextLabel")
    t.BackgroundTransparency,t.Position,t.Size = 1,UDim2.fromOffset(x,y),UDim2.fromOffset(w,h)
    t.Font,t.TextSize,t.Text,t.TextColor3 = Enum.Font.FredokaOne,size,text,color or C.text
    t.TextStrokeTransparency,t.TextStrokeColor3 = 0,C.outline
    t.TextWrapped,t.ZIndex,t.Parent = true,if parent:IsA("GuiObject") then parent.ZIndex+1 else 1,parent
    local outline = Instance.new("UIStroke")
    outline.ApplyStrokeMode,outline.Color,outline.Thickness,outline.Parent = Enum.ApplyStrokeMode.Contextual,C.outline,2,t
    return t
end
local function box(parent: Instance,x: number,y: number,w: number,h: number,color: Color3,z: number): Frame
    local b = Instance.new("Frame")
    b.Position,b.Size,b.BackgroundColor3,b.ZIndex,b.Parent = UDim2.fromOffset(x,y),UDim2.fromOffset(w,h),color,z,parent
    Theme.decorate(b,5)
    return b
end
local function button(parent: Instance,text: string,x: number,y: number,w: number,h: number,color: Color3,callback): TextButton
    local b = Instance.new("TextButton")
    b.Position,b.Size,b.BackgroundColor3 = UDim2.fromOffset(x,y),UDim2.fromOffset(w,h),color
    b.Text,b.TextColor3,b.TextSize,b.ZIndex,b.Parent = text,C.text,23,if parent:IsA("GuiObject") then parent.ZIndex+2 else 2,parent
    Theme.decorate(b,4)
    b.Activated:Connect(callback)
    return b
end
local function art(parent: GuiObject,id: string,x: number,y: number,size: number)
    local icon = Theme.icon(parent,id)
    if icon then icon.Position,icon.Size = UDim2.fromOffset(x,y),UDim2.fromOffset(size,size) end
end
local shade = Instance.new("TextButton")
shade.Name,shade.Text,shade.Size = "ModalScrim","",UDim2.fromScale(1,1)
shade.BackgroundColor3,shade.BackgroundTransparency,shade.Visible,shade.AutoButtonColor = Color3.new(0,0,0),.42,false,false
shade.ZIndex,shade.Parent = 20,gui
local panel = box(shade,0,0,860,520,C.panel,21)
panel.AnchorPoint,panel.Position = Vector2.new(.5,.5),UDim2.fromScale(.5,.5)
panel.Active=true
Theme.texture(panel,860,520)
local scale = Instance.new("UIScale")
scale.Parent = panel
local header = box(panel,4,4,852,78,C.blue,22)
Theme.texture(header,852,78)
local heading = label(header,"Dino Index",22,4,730,68,40)
heading.TextXAlignment = Enum.TextXAlignment.Left
local body = Instance.new("Frame")
body.Position,body.Size,body.BackgroundTransparency,body.ZIndex,body.Parent = UDim2.fromOffset(18,98),UDim2.fromOffset(824,402),1,23,panel
local modalVersion=0
local updateNavigation=function() end
local function close()
    autoHatching=false
    hatchCancelSerial+=1
    modalVersion+=1
    local version=modalVersion
    active=""
    updateNavigation()
    Theme.animate(scale,.12,{Scale=scale.Scale*.96})
    Theme.animate(shade,.12,{BackgroundTransparency=1})
    Theme.animate(panel,.12,{Position=UDim2.fromScale(.5,.52)})
    task.delay(if motion then .13 else 0,function() if modalVersion==version then shade.Visible=false end end)
    Theme.animate(blur,.12,{Size=0})
end
local closeButton=button(header,"X",770,1,80,76,C.red,close)
closeButton.AnchorPoint,closeButton.Position=Vector2.new(1,0),UDim2.new(1,-2,0,1)
shade.Activated:Connect(close)
local toast = box(gui,0,0,440,56,C.card,50)
toast.AnchorPoint,toast.Position,toast.Visible = Vector2.new(.5,0),UDim2.new(.5,0,0,80),false
local toastScale=Instance.new("UIScale") toastScale.Parent=toast
local toastText = label(toast,"",10,5,420,46,22)
local toastSerial = 0
local function notify(text: string,color: Color3?)
    toastSerial+=1
    local serial=toastSerial
    toast.BackgroundColor3,toastText.Text,toast.Visible = color or C.card,text,true
    if not toast:GetAttribute("Showing") then toast.Position=UDim2.new(.5,0,0,68) end
    toast:SetAttribute("Showing",true)
    Theme.animate(toast,.14,{Position=UDim2.new(.5,0,0,80)})
    task.delay(3,function()
        if serial~=toastSerial then return end
        Theme.animate(toast,.12,{Position=UDim2.new(.5,0,0,68)})
        task.delay(if motion then .12 else 0,function()
            if serial==toastSerial then toast.Visible=false toast:SetAttribute("Showing",false) end
        end)
    end)
end
local function viewportScale(): number
    local camera=workspace.CurrentCamera
    local size=gui.AbsoluteSize
    return math.max(.05,math.min(1,(size.X-40)/860,(size.Y-40)/520))
end
local function celebrate()
    if not motion then return end
    for i=1,24 do
        local confetti=Instance.new("Frame")
        confetti.Size,confetti.Position=UDim2.fromOffset(9,16),UDim2.fromScale(.5,.42)
        confetti.BackgroundColor3,confetti.BorderSizePixel,confetti.Rotation,confetti.ZIndex,confetti.Parent=({C.gold,C.accent,C.blue,C.purple})[i%4+1],0,i*17,45,gui
        TweenService:Create(confetti,TweenInfo.new(.9,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position=UDim2.fromScale(.15+(i%8)*.1,.7+(i%3)*.06),Rotation=i*65,BackgroundTransparency=1}):Play()
        task.delay(1,function() confetti:Destroy() end)
    end
end
local render
local function open(name: string)
    local wasVisible=shade.Visible and active~=""
    modalVersion+=1
    active=name
    updateNavigation()
    body:ClearAllChildren()
    shade.Visible=true
    if not wasVisible then
        scale.Scale=viewportScale()*(if motion then .96 else 1)
        shade.BackgroundTransparency=1
        panel.Position=UDim2.fromScale(.5,.52)
    end
    Theme.animate(scale,.16,{Scale=viewportScale()})
    Theme.animate(panel,.16,{Position=UDim2.fromScale(.5,.5)})
    Theme.animate(shade,.14,{BackgroundTransparency=.42})
    Theme.animate(blur,.16,{Size=if motion then 8 else 0})
    render(name)
    -- Animate the content as one layer, keeping large collections inexpensive.
    body.Position=UDim2.fromOffset(18,if motion then 106 else 98)
    Theme.animate(body,.14,{Position=UDim2.fromOffset(18,98)})
end
local function hero(parent: GuiObject,id: string,x: number,y: number,w: number,h: number,gold: (boolean | string)?,fusionPreview: boolean?)
    local traits=if fusionPreview then nil else ownedTraits(id)
    local view=Preview.add(parent,id,if traits and traits.genes then "base" else gold or "base")
    view.Position,view.Size = UDim2.fromOffset(x,y),UDim2.fromOffset(w,h)
    PreviewTraits.add(view,traits)
    return view
end
local rarityColors={C.accent,C.blue,C.gold}
local rarityNames={"Common","Rare","Legendary"}
local function speciesIndex(id: string): number return Config.SpeciesRarities[id] or 1 end
local function meter(parent: GuiObject,x: number,y: number,w: number,value: number,maxValue: number,color: Color3,text: string)
    local b=box(parent,x,y,w,34,C.outline,parent.ZIndex+1)
    local fill=Instance.new("Frame")
    local fraction=if maxValue&gt;0 then math.clamp(value/maxValue,0,1) else 0
    fill.Size,fill.BorderSizePixel,fill.BackgroundColor3,fill.ZIndex,fill.Parent=UDim2.new(if motion then 0 else fraction,0,1,0),0,color,b.ZIndex+1,b
    Theme.animate(fill,.22,{Size=UDim2.new(fraction,0,1,0)})
    label(b,text,0,0,w,34,20)
end
local function queue()
    return decoded("ChestQueueJson","[]")
end
local function hatchNext()
    local id=str("NextChestId")
    if id=="" or workspace:GetServerTimeNow()&lt;num("NextChestReadyAt") then
        autoHatching=false
        open("eggs")
        return
    end
    if hatchPending then return end
    hatchPending=true
    hatch:FireServer(id,Http:GenerateGUID(false))
    task.delay(8,function()
        if hatchPending then hatchPending=false autoHatching=false notify("Hatching did not finish. Please retry.",C.red) end
    end)
end
local function progression()
    local data=decoded("ProgressionJson","{}")
    if typeof(data.auras)~="table" or typeof(data.potions)~="table" or typeof(data.buffs)~="table" then return {crystals=0,auras={},equippedAura="",potions={},buffs={}} end
    return data
end
local chosenAura="meadow"
local cosmeticTab="auras"
local trailPage=1
local chosenPotion="speed_common"
local pendingShop=nil
local function transact(action,id,replace)
    if pendingShop then notify("Purchase is still processing",C.gold) return end
    local token=Http:GenerateGUID(false)
    pendingShop={token=token,action=action,id=id,replace=replace==true,started=os.clock()}
    notify("Processing...",C.blue)
    shopAction:FireServer(action,id,token,replace==true)
end
shopResult.OnClientEvent:Connect(function(token,ok,status)
    if pendingShop and pendingShop.token==token then pendingShop=nil end
    notify(if ok then "Success!" else tostring(status):gsub("_"," "),if ok then C.accent else C.red)
    if active=="auras" or active=="potions" then body:ClearAllChildren() render(active) end
end)
local refreshEggs
render=function(name: string)
    if name=="home" then
        heading.Text,header.BackgroundColor3="Sanctuary",C.accent
        local heroCard=box(body,0,0,290,330,C.card,24)
        local id=str("EquippedSpeciesId","compy")
        hero(heroCard,id,8,8,274,230,bestMutation(id))
        label(heroCard,Config.SpeciesDisplayNames[id],0,244,290,42,30)
        label(heroCard,"Equipped dinosaur",0,296,290,26,18,C.accent)
        label(body,"Ready for an adventure?",320,0,495,58,32)
        label(body,"Eat small food clusters, jump mountain paths and avoid bigger dinosaurs.",330,74,474,85,22)
        label(body,"Bank catches and reward eggs by returning to your sanctuary.",330,170,474,75,22,C.gold)
        button(body,"EXPLORE ISLAND",340,280,460,68,C.accent,function()
            local character=player.Character
            if character and character:GetAttribute("RunState")=="Sanctuary" then startRun:FireServer() close()
            else close() notify("You are already exploring",C.blue) end
        end)
        
    elseif name=="auras" then
        heading.Text,header.BackgroundColor3="Crystal Shops",C.purple
        local p=progression()
        p.trails=p.trails or {}
        local isTrail=cosmeticTab=="trails"
        local touch=Input.TouchEnabled
        local targetHeight=if touch then math.max(45,45/viewportScale()) else 44
        local tabsHeight=if touch then targetHeight else 40
        local cardsY=tabsHeight+12
        local cardsHeight=if touch then 402-cardsY-targetHeight-12 else 270
        local buyY=cardsHeight-targetHeight-10
        for i,tab in {"auras","trails","eggs","conditions","crystals"} do
            button(body,string.upper(tab),(i-1)*165,0,155,tabsHeight,if cosmeticTab==tab then C.blue else C.card,function() cosmeticTab=tab open("auras") end).TextSize=20
        end
        if cosmeticTab=="eggs" then
            art(body,"egg",20,cardsY+12,220)
            label(body,"Random Egg",270,cardsY,535,40,30,C.gold)
            label(body,ProgressionConfig.RandomEggPrice.." Crystals\nBalance: "..num("Crystals").."  •  Level "..num("AccountLevel"),270,cardsY+45,535,60,22)
            button(body,"VIEW ODDS",270,cardsY+119,535,targetHeight,C.blue,function() open("eggOdds") end)
            button(body,"BUY EGG",270,cardsY+targetHeight+130,535,targetHeight,C.accent,function() open("eggPurchase") end)
            return
        elseif cosmeticTab=="conditions" then
            local weights=ProgressionConfig.ConditionWeights[(p.conditionLevel or 0)+1]
            local upgrade=ProgressionConfig.ConditionUpgrades[(p.conditionLevel or 0)+1]
            label(body,"Condition Level "..(p.conditionLevel or 0).."  •  Account "..num("AccountLevel"),0,cardsY,824,35,26,C.gold)
            for i,row in ProgressionConfig.Conditions do
                local x=(i-1)*165
                label(body,row.name,x,cardsY+50,155,35,22)
                label(body,weights[i].."%\n"..row.stats.."x stats",x,cardsY+87,155,60,21,C.blue)
            end
            button(body,"VIEW ODDS",0,cardsY+166,330,targetHeight,C.blue,function() open("eggOdds") end)
            button(body,if upgrade then "UPGRADE: "..upgrade.price.." CRYSTALS" else "MAX LEVEL",348,cardsY+166,476,targetHeight,C.accent,function() if upgrade then open("conditionConfirm") end end).TextSize=20
            label(body,if upgrade then "Next tier: account level "..upgrade.requiredLevel.."  •  Future eggs only" else "Maximum condition upgrade",0,360,824,35,19,C.gold)
            return
        elseif cosmeticTab=="crystals" then
            art(body,"amber",20,cardsY+12,220)
            label(body,num("Crystals").." Crystals",270,cardsY,535,50,30,C.gold)
            if not Config.CrystalPacksEnabled then label(body,"COMING SOON",270,cardsY+38,535,20,16,C.gold) end
            local products={} for id,amount in Config.DeveloperProducts do table.insert(products,{id=id,amount=amount}) end
            table.sort(products,function(a,b) return a.amount&lt;b.amount end)
            if #products==0 then label(body,"Robux packs unavailable",270,cardsY+70,535,80,27)
            else
                local list=Instance.new("ScrollingFrame") list.BackgroundTransparency,list.BorderSizePixel,list.Size,list.Position,list.CanvasSize,list.ZIndex,list.Parent=1,0,UDim2.fromOffset(535,250),UDim2.fromOffset(270,cardsY+60),UDim2.fromOffset(0,#products*(targetHeight+12)),24,body
                for i,product in products do
                    local saleReady=false
                    local rowY=(i-1)*(targetHeight+12)
                    art(list,"amber",4,rowY+6,targetHeight-12)
                    local b=button(list,product.amount.." CRYSTALS",targetHeight+4,rowY,516-targetHeight,targetHeight,C.gold,function() if saleReady then Marketplace:PromptProductPurchase(player,product.id) end end)
                    task.spawn(function()
                        local ok,info=pcall(function() return Marketplace:GetProductInfo(product.id,Enum.InfoType.Product) end)
                        if b.Parent then
                            if ok and info.IsForSale~=false and typeof(info.PriceInRobux)=="number" then
                                saleReady=Config.CrystalPacksEnabled==true
                                b.Text=product.amount.." CRYSTALS • R$ "..info.PriceInRobux
                                b.Active=saleReady
                                if not saleReady then b.BackgroundColor3=C.card end
                            else b.Text=product.amount.." CRYSTALS • UNAVAILABLE" b.Active=false end
                        end
                    end)
                end
            end
            return
        end
        local owned=if isTrail then p.trails else p.auras
        local equippedId=if isTrail then p.equippedTrail or "" else p.equippedAura
        for i,item in (if isTrail then ProgressionConfig.Trails else ProgressionConfig.Auras) do
            if isTrail and (i&lt;(trailPage-1)*3+1 or i&gt;trailPage*3) then continue end
            local slot=if isTrail then (i-1)%3 else i-1
            local color=Color3.fromRGB(item.color[1],item.color[2],item.color[3])
            local card=box(body,slot*276,cardsY,264,cardsHeight,color,24)
            label(card,item.name,6,5,252,34,25)
            label(card,if isTrail then "Level "..item.level.." • "..item.speed.."x Speed" else item.growth.."x Growth",4,42,256,30,19)
            art(card,(if isTrail then "trail_" else "aura_")..item.id,102,76,60)
            label(card,if owned[item.id] then "Owned" else item.price.." Crystals",4,buyY-30,256,27,21,C.gold)
            local equipped=equippedId==item.id
            local locked=isTrail and num("AccountLevel")&lt;item.level and not owned[item.id]
            button(card,if equipped then "UNEQUIP" elseif owned[item.id] then "EQUIP" elseif locked then "LEVEL "..item.level else "BUY",12,buyY,240,targetHeight,C.card,function()
                if locked then notify("Requires account level "..item.level,C.gold) return end
                if owned[item.id] then transact(if isTrail then "equipTrail" else "equipAura",if equipped then "" else item.id)
                else chosenAura=item.id open("auraConfirm") end
            end)
        end
        local footerY=402-targetHeight
        if isTrail then
            button(body,"&lt;",0,footerY,110,targetHeight,C.blue,function() trailPage=math.max(1,trailPage-1) open("auras") end)
            button(body,"&gt;",714,footerY,110,targetHeight,C.blue,function() trailPage=math.min(4,trailPage+1) open("auras") end)
        end
        label(body,"Level "..num("AccountLevel").." • "..num("Crystals").." Crystals"..(if isTrail then " • "..trailPage.." / 4" else ""),115,footerY,590,targetHeight,21,C.gold)
    elseif name=="eggOdds" then
        heading.Text,header.BackgroundColor3="Egg Odds",C.blue
        local lines=ShopOdds.lines(progression().conditionLevel or 0)
        local list=Instance.new("ScrollingFrame") list.Name,list.BackgroundTransparency,list.BorderSizePixel,list.Size,list.CanvasSize,list.ScrollBarThickness,list.ZIndex,list.Parent="EggOdds",1,0,UDim2.fromOffset(824,308),UDim2.fromOffset(0,#lines*46),8,24,body
        for i,line in lines do label(list,line,10,(i-1)*46,790,44,21) end
        button(body,"BACK TO SHOP",212,322,400,math.max(64,45/viewportScale()),C.blue,function() open("auras") end)
    elseif name=="eggPurchase" or name=="conditionConfirm" then
        local p=progression()
        local upgrade=ProgressionConfig.ConditionUpgrades[(p.conditionLevel or 0)+1]
        local isEgg=name=="eggPurchase"
        heading.Text,header.BackgroundColor3=if isEgg then "Buy Random Egg?" else "Upgrade Conditions?",C.gold
        local price=if isEgg then ProgressionConfig.RandomEggPrice elseif upgrade then upgrade.price else 0
        art(body,"egg",20,15,200)
        label(body,price.." Crystals\nBalance after: "..(num("Crystals")-price),260,10,550,80,27,C.gold)
        label(body,if isEgg then "Cracked: 20% hatch success. A failed hatch gives no dinosaur or refund. Queue-full purchases are not charged." else "Account level "..(if upgrade then upgrade.requiredLevel else 60).." required. Existing eggs keep their conditions.",260,105,550,95,23)
        if not isEgg and upgrade then
            local parts={} for i,row in ProgressionConfig.Conditions do table.insert(parts,row.name.." "..ProgressionConfig.ConditionWeights[upgrade.level+1][i].."%") end
            label(body,table.concat(parts," • "),0,213,824,60,21,C.blue)
        end
        button(body,"VIEW ODDS",0,300,250,math.max(64,45/viewportScale()),C.blue,function() open("eggOdds") end)
        button(body,"CONFIRM",270,300,270,math.max(64,45/viewportScale()),C.accent,function()
            transact(if isEgg then "buyEgg" else "upgradeCondition",if isEgg then "random" elseif upgrade then tostring(upgrade.level) else "") open("auras")
        end)
        button(body,"CANCEL",560,300,264,math.max(64,45/viewportScale()),C.red,function() open("auras") end)
    elseif name=="auraConfirm" then
        local isTrail=cosmeticTab=="trails"
        local item=ProgressionRules.item(if isTrail then ProgressionConfig.Trails else ProgressionConfig.Auras,chosenAura)
        heading.Text,header.BackgroundColor3=if isTrail then "Buy Trail?" else "Buy Aura?",C.purple
        art(body,(if isTrail then "trail_" else "aura_")..item.id,30,25,220)
        label(body,item.name.." • "..(if isTrail then "Cosmetic trail" else item.growth.."x eating growth"),290,24,510,70,29)
        label(body,item.price.." Crystals\nBalance after purchase: "..(num("Crystals")-item.price),290,125,510,90,25,C.gold)
        button(body,if isTrail then "BUY TRAIL" else "BUY AURA",290,261,510,57,C.accent,function() transact(if isTrail then "buyTrail" else "buyAura",item.id) open("auras") end)
        button(body,"CANCEL",290,337,510,45,C.red,function() open("auras") end)
    elseif name=="potions" then
        heading.Text,header.BackgroundColor3="Potion Shop",C.accent
        local p=progression()
        label(body,"Crystals: "..num("Crystals").."  •  Select a potion to buy or use",0,0,824,32,21,C.gold)
        for i,item in ProgressionConfig.Potions do
            local x=((i-1)%3)*276 local y=43+math.floor((i-1)/3)*176
            local color=if item.rarity=="Legendary" then C.gold elseif item.rarity=="Rare" then C.blue else C.accent
            local card=box(body,x,y,264,164,C.card,24)
            art(card,"potion_"..item.kind,8,14,76)
            label(card,item.name,88,5,167,32,21,color)
            label(card,item.rarity.." • "..item.multiplier.."x\n"..(item.duration//60).." minutes",86,39,170,50,18)
            label(card,"Owned: "..(p.potions[item.id] or 0),86,88,170,24,17)
            button(card,item.price.." Crystals",8,120,144,34,color,function() chosenPotion=item.id open("potionConfirm") end).TextSize=17
            button(card,"USE",162,120,94,34,C.purple,function()
                chosenPotion=item.id
                local buff=p.buffs[item.kind]
                if buff and buff.expiresAt&gt;workspace:GetServerTimeNow() then open("potionReplace") else transact("usePotion",item.id,false) end
            end).TextSize=18
        end
    elseif name=="potionConfirm" or name=="potionReplace" then
        local item=ProgressionRules.item(ProgressionConfig.Potions,chosenPotion)
        local replacing=name=="potionReplace"
        heading.Text,header.BackgroundColor3=if replacing then "Replace Active Potion?" else "Buy Potion?",C.accent
        art(body,"potion_"..item.kind,30,22,220)
        label(body,item.name.." • "..item.multiplier.."x "..item.kind,290,15,510,62,28)
        label(body,if replacing then "Your current "..item.kind.." potion ends immediately. Its remaining time is lost. Consume 1 potion for a fresh "..(item.duration//60).." minutes?" else (item.duration//60).." minutes • "..item.price.." Crystals\nBalance after purchase: "..(num("Crystals")-item.price),290,101,510,135,24,C.gold)
        button(body,if replacing then "REPLACE &amp; USE" else "BUY POTION",290,263,510,58,C.accent,function()
            transact(if replacing then "usePotion" else "buyPotion",item.id,replacing) open("potions")
        end)
        button(body,"CANCEL",290,339,510,44,C.red,function() open("potions") end)
    elseif name=="collection" then
        heading.Text,header.BackgroundColor3="Dino Index",C.blue
        local unlocked=0
        local list=Instance.new("ScrollingFrame")
        list.Name,list.Size,list.Position="DinoCards",UDim2.fromOffset(824,326),UDim2.fromOffset(0,0)
        list.BackgroundTransparency,list.BorderSizePixel,list.ScrollBarThickness=1,0,6
        list.CanvasSize=UDim2.fromOffset(0,math.ceil(#Config.SpeciesOrder/3)*284)
        list.ZIndex,list.Parent=24,body
        for i,id in Config.SpeciesOrder do
            local base,gold,diamond=copies(id)
            local event=eventMutation(id)
            local rarity=speciesIndex(id)
            if base+gold+diamond&gt;0 or event or ownedTraits(id) then unlocked+=1 end
            local card=box(list,((i-1)%3)*276,math.floor((i-1)/3)*284,264,272,rarityColors[rarity],24)
            Theme.texture(card,264,272)
            label(card,Config.SpeciesDisplayNames[id],4,8,256,35,25)
            label(card,rarityNames[rarity],4,44,256,25,18)
            hero(card,id,7,70,250,128,bestMutation(id))
            label(card,if event then event.name.." mutation" elseif ownedTraits(id) then "Special variant" elseif base+gold+diamond&gt;0 then string.format("%d Base • %d Gold • %d Diamond",base,gold,diamond) else "Not discovered",5,201,254,25,15)
            button(card,"VIEW DINO",12,233,240,30,C.card,function() selected=id open("detail") end)
        end
        meter(body,0,356,600,unlocked,#Config.SpeciesOrder,C.accent,string.format("Discovered: %d / %d",unlocked,#Config.SpeciesOrder))
        button(body,"FUSION",624,350,200,44,C.gold,function() open("fusion") end)
    elseif name=="detail" then
        local index=speciesIndex(selected)
        local base,gold,diamond=copies(selected)
        local event=eventMutation(selected)
        local owned=base+gold+diamond&gt;0 or event~=nil or ownedTraits(selected)~=nil
        heading.Text,header.BackgroundColor3=Config.SpeciesDisplayNames[selected],rarityColors[index]
        local stage=box(body,0,0,380,360,rarityColors[index],24)
        hero(stage,selected,0,20,380,280,bestMutation(selected))
        label(stage,rarityNames[index],0,302,380,42,30)
        label(body,"YOUR COLLECTION",414,0,400,42,28)
        label(body,string.format("Base: %d • Gold: %d\nDiamond: %d",base,gold,diamond),414,62,400,92,25)
        label(body,if event then event.name.." • "..event.growth.."x Growth • "..event.speed.."x Speed" else "Cosmetic fusion: 50 Base → Gold; 50 Gold → Diamond. Highest owned variant equips.",414,173,400,76,22,C.gold)
        local equipped=str("EquippedSpeciesId","compy")==selected
        button(body,if equipped then "EQUIPPED" elseif not owned then "LOCKED" else "EQUIP",426,273,372,52,if owned then C.accent else C.card,function()
            if not owned then notify("Hatch reward eggs to discover this dino") return end
            if not equipped then notify("Equipping...",C.blue) equip:FireServer(selected,Http:GenerateGUID(false)) end
        end)
        button(body,"BACK TO INDEX",426,341,372,45,C.blue,function() open("collection") end)
    elseif name=="fusion" then
        heading.Text,header.BackgroundColor3="Dinosaur Fusion",C.purple
        local base,gold=copies(selected)
        local diamond=fusionTarget=="diamond"
        local cost=if diamond then Config.DiamondMutationCost else Config.GoldMutationCost
        local owned=if diamond then gold else base
        local source=if diamond then "Gold" else "Base"
        local target=if diamond then "Diamond" else "Gold"
        hero(body,selected,14,0,360,260,fusionTarget,true)
        art(body,"mutation_"..fusionTarget,142,242,84)
        button(body,"GOLD",388,0,200,42,C.gold,function() fusionTarget="gold" open("fusion") end)
        button(body,"DIAMOND",600,0,200,42,C.blue,function() fusionTarget="diamond" open("fusion") end)
        label(body,"MAKE IT "..string.upper(target),388,56,420,54,30,if diamond then C.blue else C.gold)
        label(body,"Consume "..cost.." "..source.." copies for 1 "..target.." "..Config.SpeciesDisplayNames[selected]..". Cosmetic only.",392,118,420,76,22)
        meter(body,400,214,400,owned,cost,C.gold,string.format("%d / %d %s copies",owned,cost,source))
        button(body,"FUSE SELECTED DINO",400,277,400,56,if owned&gt;=cost then C.accent else C.card,function()
            if owned&lt;cost then notify("You need "..cost.." "..source.." copies",C.red) return end
            open("fusionConfirm")
        end)
        button(body,"CHOOSE DINO",70,342,264,47,C.blue,function() open("collection") end)
    elseif name=="fusionConfirm" then
        local diamond=fusionTarget=="diamond"
        local cost=if diamond then Config.DiamondMutationCost else Config.GoldMutationCost
        local source=if diamond then "Gold" else "Base"
        local target=if diamond then "Diamond" else "Gold"
        heading.Text,header.BackgroundColor3="Confirm "..target.." Fusion",if diamond then C.blue else C.gold
        art(body,"mutation_"..fusionTarget,26,35,230)
        label(body,"Use "..cost.." "..source.." copies?",280,12,510,64,30)
        label(body,"Receive 1 "..target.." "..Config.SpeciesDisplayNames[selected]..". The consumed copies are removed after a successful save.",280,100,510,115,24)
        button(body,"CONFIRM FUSION",280,264,510,64,C.accent,function() fuse:FireServer(selected,fusionTarget,Http:GenerateGUID(false)) open("fusion") end)
        button(body,"CANCEL",280,340,510,44,C.red,function() open("fusion") end)
    elseif name=="eggs" then
        heading.Text,header.BackgroundColor3="Caught Eggs",C.gold
        local entries=queue()
        local timers={}
        for slot=1,Config.ChestQueueCapacity do
            local entry=entries[slot]
            local card=box(body,(slot-1)*166,0,156,280,if entry then C.card else C.outline,24)
            label(card,if entry and entry.genes then EggGenetics.condition(entry.genes.conditionId).name else "Slot "..slot,0,8,156,30,22)
            local view=ModelPreview.add(card,"egg",entry==nil)
            view.Position,view.Size=UDim2.fromOffset(18,65),UDim2.fromOffset(120,120)
            PreviewTraits.add(view,entry)
            if entry then label(card,rarityNames[entry.rarity or 1],0,37,156,24,18,rarityColors[entry.rarity or 1]) end
            local mutation=if entry then ProgressionRules.item(ProgressionConfig.EventMutations,entry.mutationId) else nil
            if mutation then
                local color=Color3.fromRGB(mutation.color[1],mutation.color[2],mutation.color[3])
                if not entry.genes then for _,part in view:GetDescendants() do if part:IsA("BasePart") then part.Color=part.Color:Lerp(color,.6) end end end
                label(card,mutation.name,0,192,156,27,18,color)
            elseif entry and entry.eventId and entry.eventId~="clear" then
                local event=ProgressionRules.item(ProgressionConfig.Weather,entry.eventId)
                label(card,if event then event.name else entry.eventId,0,192,156,27,15,C.gold)
            elseif entry and entry.genes then
                label(card,EggGenetics.condition(entry.genes.conditionId).name,0,192,156,27,18,C.gold)
            end
            timers[slot]=label(card,if entry then "Growing..." else "Empty",3,222,150,40,22,if entry then C.gold else Color3.fromRGB(156,156,174))
        end
        refreshEggs=function()
            for i,timer in timers do
                local entry=entries[i]
                if entry and typeof(entry.readyAt)=="number" then
                    local remaining=math.max(0,entry.readyAt-workspace:GetServerTimeNow())
                    timer.Text=if remaining&lt;=0 then "READY!" else string.format("%dm %02ds",remaining//60,remaining%60)
                end
            end
        end
        refreshEggs()
        button(body,"HATCH NEXT EGG",0,310,400,math.max(64,45/viewportScale()),C.accent,function()
            local id=str("NextChestId")
            if id=="" then notify("Return from a run to earn reward eggs") return end
            if workspace:GetServerTimeNow()&lt;num("NextChestReadyAt") then notify("This egg is still growing",C.gold) return end
            if hatchPending then return end
            autoHatching=true
            hatchNext()
        end)
        label(body,"Waiting for a nest slot: "..num("PendingChestGrants"),420,302,400,88,21)
    elseif name=="hatch" then
        heading.Text,header.BackgroundColor3="An egg is hatching...",C.gold
        local version=modalVersion
        local reward=str("LastChestRewardText","New dinosaur")
        local failed=player:GetAttribute("LastChestFailed")==true
        local genesOk,genes=pcall(function() return Http:JSONDecode(str("LastChestGenesJson","null")) end)
        if not genesOk or typeof(genes)~="table" then genes=nil end
        local id=string.match(reward,"x (%w+)") or "compy"
        if not Config.SpeciesDisplayNames[id] then id="compy" end
        local view=Preview.add(body,id,"base")
        view.Position,view.Size=UDim2.fromOffset(160,-12),UDim2.fromOffset(504,260)
        PreviewTraits.add(view,{big=player:GetAttribute("LastChestBig"),shiny=player:GetAttribute("LastChestShiny"),genes=genes})
        view.Visible=false
        task.spawn(function() pcall(function() game:GetService("ContentProvider"):PreloadAsync(view:GetDescendants()) end) end)
        local eggView,animateEgg,splitEgg=HatchPresentation.add(body,genes,rarityColors[speciesIndex(id)])
        eggView.Position,eggView.Size=UDim2.fromOffset(260,0),UDim2.fromOffset(304,260)
        local rewardLabel=label(body,rarityNames[speciesIndex(id)].." egg",80,240,660,58,36,rarityColors[speciesIndex(id)])
        local mutation=ProgressionRules.item(ProgressionConfig.EventMutations,str("LastChestEventMutation"))
        if genes then
            local condition=EggGenetics.condition(genes.conditionId)
            label(body,if failed then "Cracked • 20% hatch success" else condition.name.." • "..condition.stats.."x speed &amp; growth",80,295,660,25,20,C.gold)
        elseif mutation then
            local color=Color3.fromRGB(mutation.color[1],mutation.color[2],mutation.color[3])
            for _,part in view:GetDescendants() do if part:IsA("BasePart") then part.Color=part.Color:Lerp(color,.55) end end
            local perks=label(body,mutation.name.." • "..mutation.growth.."x Growth • "..mutation.speed.."x Speed",80,295,660,25,20,color)
            perks.Visible=false
            task.delay(3.4,function() if perks.Parent and modalVersion==version then perks.Visible=true end end)
        end
        local nextButton=button(body,"NEXT EGG",80,322,320,math.max(64,45/viewportScale()),C.accent,function() autoHatching=true hatchNext() end)
        local collectionButton=button(body,"COLLECTION",424,322,320,math.max(64,45/viewportScale()),C.blue,function() autoHatching=false open("collection") end)
        nextButton.Visible,collectionButton.Visible=false,false
        task.spawn(function()
            local started=os.clock()
            while os.clock()-started&lt;3.4 and modalVersion==version and eggView.Parent do
                local t=os.clock()-started
                animateEgg(t)
                task.wait(.03)
            end
            if modalVersion~=version or not view.Parent then return end
            splitEgg(not failed)
            view.Visible=not failed
            rewardLabel.Text=if failed then "The cracked egg did not hatch" else reward
            if failed then rewardLabel.TextColor3=C.red end
            heading.Text=if failed then "Cracked egg" else "You hatched a dinosaur!"
            if not failed then
                local revealScale=Instance.new("UIScale")
                revealScale.Scale,revealScale.Parent=if motion then .9 else 1,view
                Theme.animate(revealScale,.24,{Scale=1},Enum.EasingStyle.Back)
                local glow=Instance.new("UIStroke")
                glow.Color,glow.Thickness,glow.Transparency,glow.Parent=rarityColors[speciesIndex(id)],3,if motion then .1 else 1,view
                Theme.animate(glow,.65,{Transparency=1})
                task.delay(.18,function() if modalVersion==version and view.Parent then celebrate() end end)
            end
            task.wait(math.max(0,Config.HatchRevealSeconds-(os.clock()-started)))
            if modalVersion~=version or not view.Parent then return end
            if autoHatching and str("NextChestId")~="" then hatchNext()
            else autoHatching=false nextButton.Visible=true collectionButton.Visible=true end
        end)
    elseif name=="exit" then
        heading.Text,header.BackgroundColor3="Return to Sanctuary?",C.red
        art(body,"home",36,28,214)
        label(body,"Bank this run",300,12,500,54,36,C.gold)
        label(body,"Stay still for "..Config.ExitChannelSeconds.." seconds to return safely. Moving cancels the return.",300,91,500,104,24)
        button(body,"RETURN &amp; BANK",300,242,500,68,C.accent,function() endRun:FireServer() close() notify("Returning... stay still",C.gold) end)
        button(body,"KEEP EXPLORING",300,329,500,48,C.blue,close)
    elseif name=="crystalReveal" then
        heading.Text,header.BackgroundColor3="Run Crystal Box",C.gold
        local version=modalVersion
        art(body,"amber",262,8,300)
        local amount=label(body,"Opening...",70,282,684,65,38,C.gold)
        task.delay(1.2,function()
            if modalVersion~=version or not amount.Parent then return end
            amount.Text="+"..num("LastRunCrystalBox").." Crystals"
            local rewardScale=Instance.new("UIScale")
            rewardScale.Scale,rewardScale.Parent=if motion then .92 else 1,amount
            Theme.animate(rewardScale,.22,{Scale=1},Enum.EasingStyle.Back)
            celebrate()
        end)
        label(body,"Run total: +"..num("LastRunCrystals").." Crystals • already banked",70,353,684,40,22)
    elseif name=="results" then
        heading.Text,header.BackgroundColor3="Run Complete!",C.gold
        art(body,"trophy",24,42,240)
        label(body,"Growth  "..math.floor(num("LastRunGrowthScore")),300,18,500,60,34,C.accent)
        label(body,"Catches  "..num("LastRunCatchScore"),300,93,500,60,34,C.blue)
        label(body,str("LastRewardText","Saving rewards..."),290,168,510,100,24,C.gold)
        label(body,"+"..num("LastRunCrystals").." Crystals • Level "..num("AccountLevel"),30,302,760,40,21)
        button(body,"BACK TO SANCTUARY",212,348,400,48,C.accent,function() open("home") end)
    elseif name=="settings" then
        heading.Text,header.BackgroundColor3="Settings",C.purple
        label(body,"Visual effects",24,24,410,56,30)
        button(body,if motion then "ON" else "OFF",560,24,230,56,if motion then C.accent else C.card,function() motion=not motion Theme.MotionEnabled=motion open("settings") end)
        label(body,"Camera distance",24,114,410,56,30)
        button(body,"RESET CAMERA",470,114,320,56,C.blue,function() player.CameraMaxZoomDistance=Config.CameraMaxZoom notify("Camera reset",C.blue) end)
        label(body,"Hatch sounds",24,182,410,44,26)
        button(body,if Theme.HatchSoundEnabled~=false then "SOUND ON" else "SOUND OFF",560,182,230,44,C.blue,function() Theme.HatchSoundEnabled=Theme.HatchSoundEnabled==false open("settings") end).TextSize=20
        button(body,"HOW TO PLAY",24,238,370,64,C.gold,function() open("tutorial") end)
        button(body,"FOOD GUIDE",424,238,366,64,C.accent,function() open("food") end)
        label(body,"Settings apply on this device for this session.",24,342,766,40,18)
    elseif name=="food" then
        heading.Text,header.BackgroundColor3="Food &amp; Growth",C.accent
        local types={{"Berries","leaf",1,C.accent},{"Fruit","leaf",4,C.gold},{"Eggs","egg",15,C.blue},{"Crystals","amber",50,C.purple}}
        for i,food in types do
            local card=box(body,(i-1)*208,0,196,286,food[4],24)
            art(card,food[2],28,30,140)
            label(card,food[1],0,180,196,42,26)
            label(card,"+"..food[3].." Growth",0,226,196,42,26)
        end
        label(body,"500 raw food points earn 15 catches before weather bonuses. Growth boosts do not multiply catches.",18,316,788,72,23)
    elseif name=="tutorial" then
        heading.Text,header.BackgroundColor3="Welcome to Be Dino!",C.blue
        local steps={{"1","EAT &amp; GROW","Find small food clusters across the island."},{"2","JUMP &amp; EXPLORE","Space to jump, E to leap. Buttons on mobile."},{"3","BANK &amp; HATCH","Return to sanctuary to bank catches and eggs."}}
        for i,step in steps do
            local card=box(body,(i-1)*276,0,264,278,C.card,24)
            label(card,step[1],12,12,240,80,64,rarityColors[i])
            label(card,step[2],10,110,244,46,25,rarityColors[i])
            label(card,step[3],16,176,232,84,22)
        end
        button(body,"LET'S PLAY",212,324,400,62,C.accent,function() seenTutorial=true open("home") end)
    end
end
local buildBadge=label(gui,"BUILD "..Config.Build,0,0,250,24,15,C.blue)
buildBadge.Name,buildBadge.AnchorPoint,buildBadge.Position="BuildBadge",Vector2.new(.5,0),UDim2.new(.5,0,0,36)
local foodDiagnostic=label(gui,"",0,0,450,22,14,C.accent)
foodDiagnostic.AnchorPoint,foodDiagnostic.Position,foodDiagnostic.Visible=Vector2.new(.5,0),UDim2.new(.5,0,0,62),RunService:IsStudio()
local function refreshFoodDiagnostic()
    local status=workspace:GetAttribute("FoodSpawnStatus") or "Starting"
    foodDiagnostic.Text="FOOD: "..tostring(workspace:GetAttribute("FoodCount") or 0).."  •  "..tostring(status)
    foodDiagnostic.TextColor3=if status=="Failed" or status=="No valid ground" then C.red else C.accent
end
workspace:GetAttributeChangedSignal("FoodSpawnStatus"):Connect(refreshFoodDiagnostic)
workspace:GetAttributeChangedSignal("FoodCount"):Connect(refreshFoodDiagnostic)
refreshFoodDiagnostic()
local previewNotice=label(gui,"STUDIO PREVIEW • progress not saved • test currency",0,0,500,25,14,C.gold)
previewNotice.AnchorPoint,previewNotice.Position=Vector2.new(.5,0),UDim2.new(.5,0,0,8)
previewNotice.Visible=player:GetAttribute("ProfileMode")=="Studio preview (not saved)"
player:GetAttributeChangedSignal("ProfileMode"):Connect(function() previewNotice.Visible=player:GetAttribute("ProfileMode")=="Studio preview (not saved)" end)
local rail=box(gui,14,0,186,444,C.panel,2)
rail.AnchorPoint,rail.Position=Vector2.new(0,.5),UDim2.new(0,14,.5,0)
local railScale=Instance.new("UIScale") railScale.Parent=rail
local navigationButtons = {}
for i,entry in {{"DINOS","dinos","collection",C.blue},{"EGGS","egg","eggs",C.gold},{"FUSION","fusion","fusion",C.purple},{"HOME","home","home",C.accent},{"AURAS","aura","auras",C.purple},{"POTIONS","potion","potions",C.accent},{"SETTINGS","shield","settings",C.card}} do
    local b=button(rail,entry[1],7,7+(i-1)*62,172,54,entry[4],function() open(entry[3]) end)
    b.TextSize=20
    art(b,NavigationArtwork[entry[3]] or entry[2],5,6,40)
    b.Text=""
    label(b,entry[1],52,0,114,54,19)
    table.insert(navigationButtons,b)
    b:SetAttribute("Destination",entry[3])
    local marker=Instance.new("Frame")
    marker.Name,marker.Size,marker.Position="ActiveTab",UDim2.new(0,4,1,-12),UDim2.fromOffset(2,6)
    marker.BackgroundColor3,marker.BorderSizePixel,marker.Visible,marker.ZIndex,marker.Parent=C.gold,0,false,b.ZIndex+3,b
end
updateNavigation=function()
    local destination=if active=="detail" then "collection" elseif active=="hatch" then "eggs" else active
    for _,b in navigationButtons do
        local marker=b:FindFirstChild("ActiveTab") :: Frame
        marker.Visible=b:GetAttribute("Destination")==destination
    end
end
updateNavigation()
local hud=box(gui,0,0,390,94,C.panel,2)
hud.AnchorPoint,hud.Position=Vector2.new(0,1),UDim2.new(0,18,1,-18)
local hudScale=Instance.new("UIScale") hudScale.Parent=hud
art(hud,"leaf",8,12,64)
local growthLabel=label(hud,"0 GROWTH",82,3,290,42,30,C.accent)
art(hud,"catches",40,48,32)
local catchLabel=label(hud,"0 catches  •  Sanctuary",82,47,290,34,20)
local crystalHUD=box(gui,0,0,260,48,C.panel,2)
local crystalScale=Instance.new("UIScale") crystalScale.Parent=crystalHUD
crystalHUD.AnchorPoint,crystalHUD.Position=Vector2.new(1,0),UDim2.new(1,-20,0,8)
art(crystalHUD,"amber",6,4,40)
local crystalText=label(crystalHUD,"0 Crystals",50,0,203,48,24,C.gold)
local crystalValue=Instance.new("NumberValue")
crystalValue.Value=num("Crystals")
crystalText.Text=math.round(crystalValue.Value).." Crystals"
crystalValue.Parent=crystalHUD
local crystalInitialized=false
local lastCrystalAmount=num("Crystals")
crystalValue.Changed:Connect(function(value) crystalText.Text=math.round(value).." Crystals" end)
local function refreshCrystals()
    local amount=num("Crystals")
    local delta=amount-lastCrystalAmount
    lastCrystalAmount=amount
    Theme.animate(crystalValue,.28,{Value=amount})
    if crystalInitialized and delta&gt;0 then notify("+"..math.round(delta).." Crystals",C.gold) end
    crystalInitialized=true
end
player:GetAttributeChangedSignal("Crystals"):Connect(refreshCrystals)
refreshCrystals()
local timers=Instance.new("Frame")
timers.BackgroundTransparency,timers.Size,timers.AnchorPoint,timers.Position,timers.Parent=1,UDim2.fromOffset(286,220),Vector2.new(1,1),UDim2.new(1,-20,1,-100),gui
local timerScale=Instance.new("UIScale") timerScale.Parent=timers
local leapButton=button(timers,"LEAP [E]",0,0,286,60,C.blue,function()
    if shade.Visible then return end
    leapRemote:FireServer()
end)
leapButton.Text=""
art(leapButton,"leap",4,5,48)
local leapText=label(leapButton,"LEAP [E]",56,0,225,60,22)
local weatherTile=box(timers,0,72,286,62,C.panel,2)
local weatherArt=Theme.icon(weatherTile,"weather")
if weatherArt then weatherArt.Position,weatherArt.Size=UDim2.fromOffset(4,7),UDim2.fromOffset(48,48) end
local weatherText=label(weatherTile,"Weather in 10:00",56,0,226,62,20)
local buffsText=label(timers,"",0,145,286,68,16,C.gold)
local function timerText(seconds)
    local value=math.max(0,math.ceil(seconds))
    return string.format("%d:%02d",value//60,value%60)
end
local lastWeather=""
local function refreshProgressionHUD()
    local now=workspace:GetServerTimeNow()
    local left=num("LeapReadyAt")-now
    leapText.Text=if left&gt;0 then "LEAP "..timerText(left) else "LEAP [E] • READY"
    leapButton.BackgroundColor3=if left&gt;0 then C.card else C.blue
    local c=player.Character
    leapButton.Active=left&lt;=0 and c~=nil and c:GetAttribute("RunState")=="Active"
    local id=workspace:GetAttribute("WeatherId") or "clear"
    if id~=lastWeather then
        lastWeather=id
        if weatherArt then weatherArt:Destroy() end
        local event=ProgressionRules.item(ProgressionConfig.Weather,id)
        weatherArt=Theme.icon(weatherTile,if event then event.icon or id else "weather")
        if weatherArt then weatherArt.Position,weatherArt.Size=UDim2.fromOffset(4,7),UDim2.fromOffset(48,48) end
        if id~="clear" then notify((workspace:GetAttribute("WeatherName") or id).." started!",C.blue) end
    end
    weatherText.Text=if id=="clear" then "Weather in "..timerText((workspace:GetAttribute("NextWeatherAt") or now)-now) else (workspace:GetAttribute("WeatherName") or id).." "..timerText((workspace:GetAttribute("WeatherEndsAt") or now)-now)
    local p=progression() local lines={}
    for kind,buff in p.buffs do
        if buff.expiresAt&gt;now then table.insert(lines,kind.." potion "..timerText(buff.expiresAt-now)) end
    end
    table.sort(lines)
    table.insert(lines,string.format("Growth %.2fx • Speed %.2fx • Loot %.2fx",num("GrowthMultiplier"),num("SpeedMultiplier"),num("LootMultiplier")))
    buffsText.Text=table.concat(lines,"\n")
    if pendingShop and os.clock()-pendingShop.started&gt;8 then
        -- Retry the same operation token so a delayed result cannot charge twice.
        pendingShop.started=os.clock()
        shopAction:FireServer(pendingShop.action,pendingShop.id,pendingShop.token,pendingShop.replace)
    end
end
local action=button(gui,"EXPLORE",0,0,244,60,C.accent,function()
    local character=player.Character
    if character and character:GetAttribute("RunState")=="Active" then open("exit")
    elseif character and character:GetAttribute("RunState")=="Sanctuary" then startRun:FireServer() close() end
end)
action.AnchorPoint,action.Position=Vector2.new(1,1),UDim2.new(1,-20,1,-22)
local actionScale=action:FindFirstChildOfClass("UIScale") :: UIScale
local function scales()
    scale.Scale=viewportScale()
    closeButton.Size=UDim2.fromOffset(math.max(80,46/viewportScale()),math.max(62,46/viewportScale()))
    local camera=workspace.CurrentCamera
    local size=if camera then camera.ViewportSize else Vector2.new(1280,720)
    local small=math.clamp(math.min(size.X/1000,size.Y/800),.3,1)
    crystalScale.Scale=math.max(.65,small)
    railScale.Scale,hudScale.Scale,actionScale.Scale,timerScale.Scale=small,small,small,small
    hud:SetAttribute("UIScaleBase",small)
    timers.Position=UDim2.new(1,-20,1,if Input.TouchEnabled then -190 else -100)
    action.Position=UDim2.new(1,-20,1,if Input.TouchEnabled then -120 else -22)
    action:SetAttribute("UIScaleBase",small)
    if Input.TouchEnabled then
        -- Keep navigation above the joystick and retain usable touch targets.
        railScale.Scale=math.min(1,(size.X-28)/630)
        rail.AnchorPoint,rail.Position,rail.Size=Vector2.new(.5,0),UDim2.new(.5,0,0,56),UDim2.fromOffset(630,58)
        for i,b in navigationButtons do
            b.Position,b.Size=UDim2.fromOffset(7+(i-1)*88,7),UDim2.fromOffset(82,44)
            for _,child in b:GetChildren() do
                if child:IsA("TextLabel") then
                    child.Position,child.Size,child.TextSize=UDim2.fromOffset(28,0),UDim2.fromOffset(52,44),11
                elseif child:IsA("GuiObject") and child.Name~="ActiveTab" then
                    child.Position,child.Size=UDim2.fromOffset(3,10),UDim2.fromOffset(24,24)
                end
            end
        end
        hud.AnchorPoint,hud.Position=Vector2.new(0,0),UDim2.new(0,18,0,120)
        previewNotice.Text="STUDIO PREVIEW: UNSAVED"
        previewNotice.Size,previewNotice.AnchorPoint,previewNotice.Position=UDim2.fromOffset(240,25),Vector2.zero,UDim2.fromOffset(18,8)
        timerScale.Scale=math.max(small,44/60)
        timers.AnchorPoint=Vector2.new(1,0)
        timers.Position=UDim2.new(1,-20,0,120)
        foodDiagnostic.Visible=false
        actionScale.Scale=math.max(small,44/60)
        action.AnchorPoint,action.Position=Vector2.new(.5,1),UDim2.new(.5,0,1,-18)
        action:SetAttribute("UIScaleBase",actionScale.Scale)
    else
        previewNotice.Text="STUDIO PREVIEW • progress not saved • test currency"
        previewNotice.Size,previewNotice.AnchorPoint,previewNotice.Position=UDim2.fromOffset(500,25),Vector2.new(.5,0),UDim2.new(.5,0,0,8)
        rail.AnchorPoint,rail.Position,rail.Size=Vector2.new(0,.5),UDim2.new(0,14,.5,0),UDim2.fromOffset(186,444)
        for i,b in navigationButtons do
            b.Position,b.Size=UDim2.fromOffset(7,7+(i-1)*62),UDim2.fromOffset(172,54)
            for _,child in b:GetChildren() do
                if child:IsA("TextLabel") then
                    child.Position,child.Size,child.TextSize=UDim2.fromOffset(52,0),UDim2.fromOffset(114,54),19
                elseif child:IsA("GuiObject") and child.Name~="ActiveTab" then
                    child.Position,child.Size=UDim2.fromOffset(5,6),UDim2.fromOffset(40,40)
                end
            end
        end
        hud.AnchorPoint,hud.Position=Vector2.new(0,1),UDim2.new(0,18,1,-18)
        timers.AnchorPoint=Vector2.new(1,1)
        action.AnchorPoint=Vector2.new(1,1)
        foodDiagnostic.Visible=RunService:IsStudio()
    end
    toastScale.Scale=math.min(1,(size.X-20)/440)
end
local function characterAdded(character: Model)
    local humanoid=character:WaitForChild("Humanoid",10) :: Humanoid?
    if not humanoid or player.Character~=character then return end
    local camera=workspace.CurrentCamera
    if camera then camera.CameraType,camera.CameraSubject=Enum.CameraType.Custom,humanoid end
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping,true)
    lastGrowth=0
    lastEggCount=0
end
player.CameraMaxZoomDistance=Config.CameraMaxZoom
player.CharacterAdded:Connect(characterAdded)
if player.Character then task.spawn(characterAdded,player.Character) end
if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(scales) end
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(scales)
scales()
gui:SetAttribute("Ready",true)
local elapsed=0
local exitPending=false
RunService.Heartbeat:Connect(function(dt)
    elapsed+=dt
    if elapsed&lt;.15 then return end elapsed=0
    local character=player.Character
    local state=if character then character:GetAttribute("RunState") else "Loading"
    local growth=if character then character:GetAttribute("GrowthScore") or 0 else 0
    local catches=if character then character:GetAttribute("CatchScore") or 0 else 0
    growthLabel.Text=string.format("%d GROWTH",growth)
    catchLabel.Text=string.format("%d catches  •  %s",catches,if state=="Sanctuary" then "Safe sanctuary" else "Island")
    action.Text=if state=="Sanctuary" then "EXPLORE ISLAND" elseif state=="Active" then "RETURN HOME" else "SAVING..."
    action.BackgroundColor3=if state=="Active" then C.red else C.accent
    if character then
        local visualScale=character:GetAttribute("VisualScale") or 1
        player.CameraMinZoomDistance=Config.CameraMinZoom*visualScale
        local humanoid=character:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.CameraOffset=Vector3.new(0,(visualScale-1)*2,0) end
        local deadline=character:GetAttribute("ExitChannelEndsAt") or 0
        local remaining=deadline-workspace:GetServerTimeNow()
        if remaining&gt;0 then action.Text=string.format("STAY STILL %.1fs",remaining) exitPending=true
        elseif exitPending then exitPending=false if state=="Active" then notify("Return cancelled: you moved",C.red) end end
    end
    if growth&gt;lastGrowth and state=="Active" then
        notify(string.format("+%.1f Growth!",growth-lastGrowth),C.accent)
        if motion then
            hudScale.Scale=(hud:GetAttribute("UIScaleBase") or 1)*1.06
            Theme.animate(hudScale,.2,{Scale=hud:GetAttribute("UIScaleBase") or 1},Enum.EasingStyle.Back)
        end
    end
    lastGrowth=growth
    local ok,tags=pcall(function() return Http:JSONDecode(if character then character:GetAttribute("RunEggEvents") or "[]" else "[]") end)
    if ok and typeof(tags)=="table" then
        if #tags&gt;lastEggCount and state=="Active" then
            local newest=tags[#tags]
            local mutation=ProgressionRules.item(ProgressionConfig.EventMutations,newest.mutationId or "")
            notify(if mutation then mutation.name.." egg caught!" else "Reward egg caught!",if mutation then C.gold else C.blue)
        end
        lastEggCount=#tags
    end
    refreshProgressionHUD()
    if active=="eggs" and refreshEggs then refreshEggs() end
    if player:GetAttribute("ProfileState")=="Loaded" and state=="Sanctuary" and not seenTutorial then seenTutorial=true open("tutorial") end
end)
local refreshQueued=false
local function scheduleModalRefresh()
    if refreshQueued then return end
    refreshQueued=true
    task.defer(function()
        refreshQueued=false
        if table.find({"collection","detail","fusion","eggs","auras","potions"},active) then
            body:ClearAllChildren()
            render(active)
        end
    end)
end
for _,attribute in {"EquippedSpeciesId","CollectionJson","ChestQueueJson","ProgressionJson"} do
    player:GetAttributeChangedSignal(attribute):Connect(function()
        scheduleModalRefresh()
    end)
end
player:GetAttributeChangedSignal("LastClaimedChestId"):Connect(function() hatchPending=false task.defer(function() open("hatch") end) end)
player:GetAttributeChangedSignal("LastRunEndAt"):Connect(function() if not autoHatching then open("results") end end)
player:GetAttributeChangedSignal("LastSettledRunId"):Connect(function()
    local serial=hatchCancelSerial
    task.spawn(function()
        local deadline=os.clock()+15
        repeat task.wait(.1) until serial~=hatchCancelSerial or os.clock()&gt;deadline
            or (player.Character and player.Character:GetAttribute("RunState")=="Sanctuary")
        if serial==hatchCancelSerial and player.Character and player.Character:GetAttribute("RunState")=="Sanctuary" then
            if num("LastRunCrystalBox")&gt;0 then
                open("crystalReveal")
                local version=modalVersion
                task.wait(3)
                if modalVersion~=version or serial~=hatchCancelSerial then return end
            end
            if str("NextChestId")~="" then autoHatching=true hatchNext() else open("results") end
        end
    end)
end)
player:GetAttributeChangedSignal("LastRewardText"):Connect(function() if active=="results" then body:ClearAllChildren() render(active) end end)
for _,attribute in {"LastEquipStatus","LastMutationStatus","LastChestClaimStatus"} do
    player:GetAttributeChangedSignal(attribute):Connect(function()
        local status=str(attribute)
        if attribute=="LastChestClaimStatus" then hatchPending=false end
        if status=="claimed" then toast.Visible=false
        elseif status=="equipped" or status=="mutated" then notify("Success!",C.accent)
        elseif status~="" and status~="duplicate" then notify(status:gsub("_"," "),C.red) end
    end)
end
Input.InputBegan:Connect(function(input,processed)
    if processed then return end
    if (input.KeyCode==Enum.KeyCode.E or input.KeyCode==Enum.KeyCode.ButtonY) and not shade.Visible then leapRemote:FireServer()
    elseif input.KeyCode==Enum.KeyCode.Escape then close()
    elseif input.KeyCode==Enum.KeyCode.C then open("collection")
    elseif input.KeyCode==Enum.KeyCode.B then open("eggs") end
end)
</ProtectedString>
