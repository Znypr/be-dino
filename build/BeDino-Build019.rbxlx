      <Item class="ModuleScript" referent="RBX17">
        <Properties>
          <string name="Name">CosmeticEffects</string>
          <ProtectedString name="Source">--!strict
-- Cosmetic-only geometry. Server-published equipment selects bounded client-local effects.
local Effects={}
local function color(rgb) return Color3.fromRGB(rgb[1],rgb[2],rgb[3]) end
function Effects.create(root: BasePart,aura,trail,mutation,shiny: boolean?)
    local state={objects={},orbits={},emitters={},beams={},trails={},walkingEmitters={}}
    local function make(class,name)
        local object=Instance.new(class)
        object.Name,object.Parent=name,root
        table.insert(state.objects,object)
        return object
    end
    local function particles(name,primary,accent,rate,walking)
        local attachment=make("Attachment",name.."Anchor")
        attachment.Position=Vector3.new(0,-.8,1.3)
        local emitter=Instance.new("ParticleEmitter")
        emitter.Name,emitter.Parent=name,attachment
        emitter.Texture="rbxasset://textures/particles/sparkles_main.dds"
        emitter.Color=ColorSequence.new(primary,accent)
        emitter.Rate,emitter.LightEmission=rate,1
        emitter.Lifetime,emitter.Speed=NumberRange.new(.5,1),NumberRange.new(.2,.8)
        emitter.SpreadAngle=Vector2.new(180,180)
        emitter.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,.15),NumberSequenceKeypoint.new(.3,.22),NumberSequenceKeypoint.new(1,0)})
        emitter.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.1),NumberSequenceKeypoint.new(1,1)})
        table.insert(if walking then state.walkingEmitters else state.emitters,emitter)
    end
    if shiny then particles("LocalShinySparkles",Color3.fromRGB(255,239,142),Color3.new(1,1,1),8,false) end
    if not aura and mutation then aura={id="event",color=mutation.color} end
    if mutation then
        local attachment=make("Attachment","LocalMutationGlow")
        local light=Instance.new("PointLight")
        light.Color,light.Brightness,light.Range,light.Shadows,light.Parent=color(mutation.color),.65,7,false,attachment
        table.insert(state.emitters,light)
    end
    if aura then
        local primary=color(aura.color)
        local accent=if aura.id=="royal" then Color3.fromRGB(255,215,115) else primary:Lerp(Color3.new(1,1,1),.65)
        for ring=1,2 do
            local points={}
            for i=1,4 do
                local attachment=make("Attachment","LocalAuraOrbit")
                table.insert(points,attachment)
                table.insert(state.orbits,{attachment=attachment,angle=(i-1)*math.pi/2,ring=ring})
            end
            for i=1,4 do
                local beam=make("Beam","LocalAuraRibbon")
                beam.Attachment0,beam.Attachment1=points[i],points[i%4+1]
                beam.Color=ColorSequence.new(primary,accent)
                beam.Transparency=NumberSequence.new(if ring==1 then .22 else .65)
                beam.LightEmission,beam.FaceCamera,beam.Segments=1,true,12
                table.insert(state.beams,{beam=beam,ring=ring})
            end
        end
        local center=make("Attachment","LocalAuraMotes")
        local emitter=Instance.new("ParticleEmitter")
        emitter.Name,emitter.Parent="LocalAuraParticles",center
        emitter.Texture="rbxasset://textures/particles/sparkles_main.dds"
        emitter.Color=ColorSequence.new(primary,accent)
        emitter.LightEmission,emitter.Rate= .85,if aura.id=="royal" then 12 else 8
        emitter.Lifetime,emitter.Speed=NumberRange.new(.8,1.3),NumberRange.new(.4,1.2)
        emitter.SpreadAngle=Vector2.new(180,180)
        emitter.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,.08),NumberSequenceKeypoint.new(.4,.2),NumberSequenceKeypoint.new(1,0)})
        emitter.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.2,.2),NumberSequenceKeypoint.new(1,1)})
        table.insert(state.emitters,emitter)
    end
    if trail then
        local primary,accent=color(trail.color),color(trail.accent)
        if trail.particles then particles("LocalTrailGlitter",primary,accent,trail.particles,true) end
        for side=-1,1,2 do
            local a=make("Attachment","LocalTrailEdge")
            local b=make("Attachment","LocalTrailEdge")
            local ribbon=make("Trail","LocalCosmeticTrail")
            ribbon.Attachment0,ribbon.Attachment1=a,b
            ribbon.Color=ColorSequence.new(primary,accent)
            ribbon.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.12),NumberSequenceKeypoint.new(.7,.55),NumberSequenceKeypoint.new(1,1)})
            ribbon.WidthScale=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)})
            ribbon.Lifetime,ribbon.MinLength,ribbon.FaceCamera,ribbon.LightEmission=trail.lifetime,.12,true,.8
            table.insert(state.trails,{ribbon=ribbon,a=a,b=b,side=side,width=trail.width})
        end
    end
    function state:update(scale: number,time: number,enabled: boolean)
        for _,orbit in self.orbits do
            local angle=orbit.angle+time*(if orbit.ring==1 then .45 else -.3)
            local radius=(if orbit.ring==1 then 2.1 else 1.6)*scale
            local position=Vector3.new(math.cos(angle)*radius,(if orbit.ring==1 then -1.65 else -.7)*scale,math.sin(angle)*radius)
            local tangent=Vector3.new(-math.sin(angle),0,math.cos(angle))
            orbit.attachment.CFrame=CFrame.fromMatrix(position,tangent,Vector3.yAxis,tangent:Cross(Vector3.yAxis))
        end
        for _,entry in self.beams do
            entry.beam.Enabled=enabled
            local radius=(if entry.ring==1 then 2.1 else 1.6)*scale
            entry.beam.CurveSize0,entry.beam.CurveSize1=.5523*radius,.5523*radius
            entry.beam.Width0,entry.beam.Width1=.1*scale,.1*scale
        end
        for _,emitter in self.emitters do emitter.Enabled=enabled end
        local walking=enabled and Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z).Magnitude&gt;1
        for _,emitter in self.walkingEmitters do emitter.Enabled=walking end
        for _,entry in self.trails do
            entry.a.Position=Vector3.new(entry.side*1.1,-.6,1.3)*scale
            entry.b.Position=entry.a.Position+Vector3.new(0,-entry.width*scale,0)
            if not enabled and entry.ribbon.Enabled then entry.ribbon:Clear() end
            entry.ribbon.Enabled=walking
        end
    end
    function state:destroy() for _,object in self.objects do object:Destroy() end end
    return state
end
return Effects
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX18">
        <Properties>
          <string name="Name">DinosaurPreview</string>
          <ProtectedString name="Source">--!strict
local Resources=require(script.Parent.ResourceModels)
local Camera=require(script.Parent.PreviewCamera)
local ContentProvider=game:GetService("ContentProvider")
local Preview={}
function Preview.add(parent: GuiObject,speciesId: string,gold: (boolean | string)): ViewportFrame
    local viewport=Instance.new("ViewportFrame")
    viewport.Name,viewport.BackgroundTransparency="DinosaurPreview",1
    viewport.Size=UDim2.new(1,0,0,140)
    viewport.Ambient,viewport.LightColor,viewport.LightDirection=Color3.fromRGB(190,210,218),Color3.fromRGB(255,246,226),Vector3.new(-1,-1,-1)
    viewport.ZIndex,viewport.Parent=parent.ZIndex+1,parent
    local model=Resources.clone(speciesId)
    if model then
        local world=Instance.new("WorldModel") world.Parent=viewport
        for _,item in model:GetDescendants() do
            if item:IsA("BasePart") then
                item.Anchored=true
                if gold==true or gold=="gold" or gold=="diamond" then Resources.clearTextures(item) end
                if gold == "diamond" then item.Color=Color3.fromRGB(85,213,245) item.Material=Enum.Material.Glass item.Reflectance=.2
                elseif gold == true or gold == "gold" then item.Color=Color3.fromRGB(242,199,63) item.Material=Enum.Material.Metal end
            end
        end
        model:PivotTo(CFrame.new())
        model.Parent=world
        Camera.bind(viewport,model,speciesId)
        task.spawn(function()
            local assets={}
            for _,part in model:GetDescendants() do
                if part:IsA("MeshPart") and part.MeshId~="" then table.insert(assets,part) end
            end
            local uploadedId=model:GetAttribute("UploadedModelId")
            if #assets==0 or not uploadedId then return end
            local failed=false
            local ok=pcall(function() ContentProvider:PreloadAsync(assets,function(_,status)
                if status~=Enum.AssetFetchStatus.Success then failed=true end
            end) end)
            if not viewport.Parent or (ok and not failed) then return end
            -- Keep the actual species visible when the uploaded mesh is unavailable.
            local image=Instance.new("ImageLabel")
            image.Name,image.BackgroundTransparency,image.BorderSizePixel="ModelThumbnailFallback",1,0
            image.Size,image.ScaleType=UDim2.fromScale(1,1),Enum.ScaleType.Fit
            image.Image="rbxthumb://type=Asset&amp;id="..tostring(uploadedId).."&amp;w=420&amp;h=420"
            image.ZIndex,image.Parent=viewport.ZIndex+1,viewport
            pcall(function() ContentProvider:PreloadAsync({image}) end)
            if image.Parent then viewport:SetAttribute("PreviewFallback","AssetThumbnail") end
        end)
    end
    return viewport
end
return Preview
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX19">
        <Properties>
          <string name="Name">DinosaurVisual</string>
          <ProtectedString name="Source">--!strict
-- Imported mesh first; original procedural shell remains an explicit fallback.
local Dinosaur = {}
local Resources = require(script.Parent.ResourceModels)


local GOLD_PALETTE = {
    primary = Color3.fromRGB(236, 185, 52),
    light = Color3.fromRGB(255, 229, 126),
    dark = Color3.fromRGB(151, 102, 22),
    accent = Color3.fromRGB(255, 244, 183),
}

local DIAMOND_PALETTE = {primary=Color3.fromRGB(85,213,245),light=Color3.fromRGB(211,249,255),dark=Color3.fromRGB(36,115,171),accent=Color3.fromRGB(242,255,255)}
local PALETTES = {
    raptor = {primary=Color3.fromRGB(186,104,153),light=Color3.fromRGB(239,192,212),dark=Color3.fromRGB(106,54,97),accent=Color3.fromRGB(247,210,137)},
    stegosaurus = {primary=Color3.fromRGB(131,167,74),light=Color3.fromRGB(208,227,151),dark=Color3.fromRGB(72,107,56),accent=Color3.fromRGB(239,169,89)},
    ankylosaurus = {primary=Color3.fromRGB(148,115,78),light=Color3.fromRGB(221,194,142),dark=Color3.fromRGB(88,69,56),accent=Color3.fromRGB(238,218,173)},
    compy = {
        primary = Color3.fromRGB(91, 174, 114),
        light = Color3.fromRGB(191, 225, 147),
        dark = Color3.fromRGB(48, 107, 72),
        accent = Color3.fromRGB(245, 198, 92),
    },
    triceratops = {
        primary = Color3.fromRGB(92, 148, 188),
        light = Color3.fromRGB(184, 219, 222),
        dark = Color3.fromRGB(58, 91, 128),
        accent = Color3.fromRGB(239, 205, 135),
    },
    tyrannosaurus = {
        primary = Color3.fromRGB(191, 116, 69),
        light = Color3.fromRGB(232, 176, 116),
        dark = Color3.fromRGB(117, 65, 48),
        accent = Color3.fromRGB(239, 215, 152),
    },
}

local function scaleForScore(score: number): number
    return math.min(4, math.sqrt(1 + math.max(0, score) / 50))
end

local function normalizedSpecies(speciesId: any): string
    if typeof(speciesId) == "string" and PALETTES[speciesId] then
        return speciesId
    end
    return "compy"
end

function Dinosaur.render(character: Model, scale: number, requestedSpeciesId: string?, isGold: (boolean | string)?)
    local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return end

    local speciesId = normalizedSpecies(requestedSpeciesId or character:GetAttribute("SpeciesId"))
    local mutation = if isGold == "diamond" then "diamond" elseif isGold == true or isGold == "gold" then "gold" else "base"
    local gold = mutation == "gold"
    local palette = if mutation == "diamond" then DIAMOND_PALETTE elseif gold then GOLD_PALETTE else PALETTES[speciesId]

    local existing = character:FindFirstChild("DinoVisual")
    if existing and existing:GetAttribute("ResourceSpecies") == speciesId and existing:GetAttribute("ResourceMutation") == mutation then
        local previousScale = character:GetAttribute("VisualScale") or 1
        local ratio = scale / previousScale
        local floorOffset = root.Size.Y / 2 + humanoid.HipHeight
        if humanoid.RigType == Enum.HumanoidRigType.R6 then
            local leg = character:FindFirstChild("Left Leg") :: BasePart?
            floorOffset += if leg then leg.Size.Y else 2
        end
        local ground = Vector3.new(0,floorOffset,0)
        for _, item in existing:GetDescendants() do
            if item:IsA("BasePart") then
                item.Size *= ratio
                local weld = item:FindFirstChild("ResourceWeld")
                if weld and weld:IsA("Weld") then
                    weld.C0 = CFrame.new((weld.C0.Position + ground) * ratio - ground) * weld.C0.Rotation
                end
            end
        end
        character:SetAttribute("VisualScale",scale)
        return
    end

    local old = character:FindFirstChild("DinoVisual")
    if old then old:Destroy() end
    local visual = Instance.new("Model")
    visual.Name = "DinoVisual"
    visual.Parent = character

    local groundHeight = root.Size.Y / 2 + humanoid.HipHeight
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        local leg = character:FindFirstChild("Left Leg") :: BasePart?
        groundHeight += if leg then leg.Size.Y else 2
    end
    local imported = Resources.clone(speciesId)
    if imported then
        visual:Destroy()
        visual = imported
        visual.Name = "DinoVisual"
        visual:SetAttribute("ResourceSpecies",speciesId)
        visual:SetAttribute("ResourceGold",gold)
        visual:SetAttribute("ResourceMutation",mutation)
        visual:ScaleTo(scale)
        visual:PivotTo(root.CFrame * CFrame.new(0, -groundHeight, 0))
        visual.Parent = character
        for _, item in visual:GetDescendants() do
            if item:IsA("BasePart") then
                item.Anchored = false
                if mutation ~= "base" then Resources.clearTextures(item) item.Color = palette.primary item.Material = if gold then Enum.Material.Metal else Enum.Material.Glass item.Reflectance = if gold then .08 else .2 end
                local weld = Instance.new("Weld")
                weld.Name = "ResourceWeld"
                weld.C0 = root.CFrame:ToObjectSpace(item.CFrame)
                weld.Part0 = root
                weld.Part1 = item
                weld.Parent = item
            end
        end
        character:SetAttribute("SpeciesId", speciesId)
        character:SetAttribute("GoldVisual", gold)
        character:SetAttribute("MutationVisual", mutation)
        character:SetAttribute("VisualScale", scale)
        character:SetAttribute("VisualSource", "Packaged resource model")
        return
    end
    character:SetAttribute("VisualSource", "Procedural fallback: import resources/models")
    local shift = Vector3.new(0, (if speciesId == "tyrannosaurus" then 3.455 else if speciesId == "triceratops" then 3.125 else 2.98) * scale - groundHeight, 0)

    local function piece(
        name: string,
        size: Vector3,
        position: Vector3,
        color: Color3,
        rotation: Vector3?,
        shape: Enum.PartType?
    )
        local part = Instance.new("Part")
        part.Name = name
        part.Shape = shape or Enum.PartType.Ball
        part.Size = size * scale
        part.Color = color
        part.Material = if mutation == "diamond" then Enum.Material.Glass elseif gold then Enum.Material.Metal else Enum.Material.SmoothPlastic
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.Massless = true
        part.CastShadow = true

        local r = rotation or Vector3.zero
        local offset = CFrame.new(position * scale + shift)
            * CFrame.Angles(math.rad(r.X), math.rad(r.Y), math.rad(r.Z))
        part.CFrame = root.CFrame * offset
        part.Parent = visual

        local weld = Instance.new("Weld")
        weld.Name = "VisualWeld"
        weld.Part0 = root
        weld.Part1 = part
        weld.C0 = offset
        weld.Parent = part
        return part
    end

    local function eye(side: number, x: number, y: number, z: number)
        piece("EyeWhite" .. side, Vector3.new(0.34, 0.55, 0.42), Vector3.new(side * x, y, z),
            Color3.fromRGB(249, 247, 226), Vector3.zero, Enum.PartType.Ball)
        piece("Pupil" .. side, Vector3.new(0.22, 0.30, 0.22), Vector3.new(side * (x + 0.10), y, z - 0.14),
            Color3.fromRGB(25, 37, 31), Vector3.zero, Enum.PartType.Ball)
    end

    if speciesId == "compy" then
        piece("Body", Vector3.new(2.2, 1.65, 3.1), Vector3.new(0, -0.75, 0.25), palette.primary, nil, Enum.PartType.Ball)
        piece("Chest", Vector3.new(1.65, 1.15, 1.9), Vector3.new(0, -1.25, -0.65), palette.light, nil, Enum.PartType.Ball)
        piece("Head", Vector3.new(2.15, 1.55, 1.95), Vector3.new(0, 0.15, -1.85), palette.primary, nil, Enum.PartType.Ball)
        piece("Snout", Vector3.new(1.75, 0.75, 1.25), Vector3.new(0, -0.10, -3.0), palette.light, nil, Enum.PartType.Ball)
        piece("Tail", Vector3.new(0.95, 0.95, 3.4), Vector3.new(0, -0.75, 2.85), palette.primary, Vector3.new(-12,0,0))
        piece("TailTip", Vector3.new(0.48, 0.48, 2.0), Vector3.new(0, -0.15, 5.15), palette.dark, Vector3.new(-20,0,0))
        for _, side in {-1, 1} do
            piece("Leg" .. side, Vector3.new(0.68, 1.45, 0.78), Vector3.new(side * 0.78, -2.05, 0.25), palette.dark)
            piece("Foot" .. side, Vector3.new(0.8, 0.32, 1.45), Vector3.new(side * 0.78, -2.82, -0.10), palette.primary)
            piece("Arm" .. side, Vector3.new(0.38, 0.44, 0.95), Vector3.new(side * 1.0, -0.72, -1.18), palette.primary, Vector3.new(18,0,side*12))
            eye(side, 0.92, 0.45, -2.15)
        end
        for i = 1, 4 do
            piece("BackSpike" .. i, Vector3.new(0.30, 0.75, 0.42),
                Vector3.new(0, 0.22, 0.95 + (i - 1) * 0.68), palette.accent, Vector3.new(0,0,45))
        end
        piece("Crest", Vector3.new(0.50, 0.85, 0.75), Vector3.new(0, 1.02, -1.45), palette.accent, Vector3.new(0,0,45))
    elseif speciesId == "triceratops" then
        piece("Body", Vector3.new(3.35, 1.95, 3.75), Vector3.new(0, -0.95, 0.35), palette.primary, nil, Enum.PartType.Ball)
        piece("Belly", Vector3.new(2.35, 0.85, 2.7), Vector3.new(0, -1.70, 0.20), palette.light, nil, Enum.PartType.Ball)
        piece("Head", Vector3.new(2.75, 1.75, 2.0), Vector3.new(0, -0.05, -2.0), palette.primary, nil, Enum.PartType.Ball)
        piece("Muzzle", Vector3.new(2.15, 0.90, 1.25), Vector3.new(0, -0.43, -3.1), palette.light, nil, Enum.PartType.Ball)
        piece("Frill", Vector3.new(3.7, 2.75, 0.42), Vector3.new(0, 0.48, -0.95), palette.dark)
        piece("Tail", Vector3.new(1.05, 1.0, 2.25), Vector3.new(0, -1.05, 2.95), palette.primary, Vector3.new(-8,0,0))
        for _, side in {-1, 1} do
            piece("FrontLeg" .. side, Vector3.new(0.75, 1.45, 0.90), Vector3.new(side * 1.12, -2.15, -1.0), palette.dark)
            piece("RearLeg" .. side, Vector3.new(0.82, 1.55, 0.95), Vector3.new(side * 1.12, -2.15, 1.2), palette.dark)
            piece("FootA" .. side, Vector3.new(0.92, 0.35, 1.15), Vector3.new(side * 1.12, -2.95, -1.18), palette.primary)
            piece("FootB" .. side, Vector3.new(0.92, 0.35, 1.15), Vector3.new(side * 1.12, -2.95, 1.05), palette.primary)
            eye(side, 1.06, 0.33, -2.18)
            piece("BrowHorn" .. side, Vector3.new(0.30, 0.30, 1.55), Vector3.new(side * 0.72, 1.05, -2.62),
                palette.accent, Vector3.new(-26,0,0))
        end
        piece("NoseHorn", Vector3.new(0.28, 0.28, 1.20), Vector3.new(0, 0.32, -3.9), palette.accent, Vector3.new(-14,0,0))
        for _, side in {-1, 1} do
            piece("FrillDot" .. side, Vector3.new(0.35, 0.35, 0.22), Vector3.new(side * 1.25, 0.78, -1.20),
                palette.accent, nil, Enum.PartType.Ball)
        end
    else
        piece("Body", Vector3.new(3.0, 2.2, 3.8), Vector3.new(0, -0.85, 0.35), palette.primary, nil, Enum.PartType.Ball)
        piece("Belly", Vector3.new(2.0, 1.05, 2.75), Vector3.new(0, -1.55, -0.05), palette.light, nil, Enum.PartType.Ball)
        piece("Head", Vector3.new(3.05, 2.05, 2.55), Vector3.new(0, 0.18, -2.1), palette.primary, nil, Enum.PartType.Ball)
        piece("Muzzle", Vector3.new(2.65, 1.05, 1.65), Vector3.new(0, -0.15, -3.55), palette.light, nil, Enum.PartType.Ball)
        piece("Jaw", Vector3.new(2.55, 0.55, 1.65), Vector3.new(0, -0.78, -3.38), palette.dark)
        piece("Tail", Vector3.new(1.15, 1.05, 3.1), Vector3.new(0, -0.82, 3.15), palette.primary, Vector3.new(-10,0,0))
        piece("TailTip", Vector3.new(0.60, 0.60, 2.0), Vector3.new(0, -0.15, 5.35), palette.dark, Vector3.new(-18,0,0))
