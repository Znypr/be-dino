      <Item class="ModuleScript" referent="RBX48">
        <Properties>
          <string name="Name">UITheme</string>
          <ProtectedString name="Source">--!strict
local TweenService = game:GetService("TweenService")
local Vectors = require(script.Parent.IconVectors)
local EventVectors = require(script.Parent.EventIconVectors)
local Artwork = require(script.Parent.Artwork)
local IconLayout = require(script.Parent.UIIconLayout)
local TrailArtwork = require(script.Parent.TrailArtwork)
local Theme = {}
Theme.BackgroundImageId = ""
Theme.MotionEnabled = true
-- One tween per target prevents rapid input from stacking competing animations.
local tweens: {[Instance]: Tween} = setmetatable({}, {__mode="k"}) :: any
function Theme.animate(target: Instance, seconds: number, goals: any, style: Enum.EasingStyle?)
    local previous = tweens[target]
    if previous then previous:Cancel() tweens[target] = nil end
    if not Theme.MotionEnabled then
        for property, value in goals do (target :: any)[property] = value end
        return
    end
    local tween = TweenService:Create(target,TweenInfo.new(seconds,style or Enum.EasingStyle.Quad,Enum.EasingDirection.Out),goals)
    tweens[target] = tween
    tween.Completed:Once(function()
        if tweens[target] == tween then tweens[target] = nil end
    end)
    tween:Play()
end
Theme.Colors = {panel=Color3.fromRGB(42,40,53),card=Color3.fromRGB(61,58,73),outline=Color3.fromRGB(13,15,20),text=Color3.new(1,1,1),accent=Color3.fromRGB(93,237,31),gold=Color3.fromRGB(255,210,43),blue=Color3.fromRGB(46,206,255),purple=Color3.fromRGB(194,86,255),red=Color3.fromRGB(247,57,48)}
Theme.ImageIds = require(script.Parent.UIIconAssets)
function Theme.imageContent(_id: string): Content? return nil end
function Theme.decorate(object: GuiObject, radius: number)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0,radius)
    corner.Parent = object
    local border = Instance.new("UIStroke")
    border.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    border.Color, border.Thickness, border.Parent = Theme.Colors.outline,3,object
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new(Color3.new(1,1,1),Color3.fromRGB(157,168,185))
    gradient.Rotation, gradient.Parent = 90,object
    if object:IsA("TextButton") then
        object.Font, object.TextStrokeColor3, object.TextStrokeTransparency = Enum.Font.FredokaOne,Theme.Colors.outline,0
        local scale = Instance.new("UIScale")
        scale.Parent = object
        local hovered, pressed = false, false
        local function animate(value: number)
            Theme.animate(scale,.09,{Scale=value*(object:GetAttribute("UIScaleBase") or 1)})
            Theme.animate(border,.09,{Color=if hovered or pressed then Theme.Colors.gold else Theme.Colors.outline})
        end
        object.MouseEnter:Connect(function() hovered=true animate(if pressed then .96 else 1.035) end)
        object.MouseLeave:Connect(function() hovered=false pressed=false animate(1) end)
        object.SelectionGained:Connect(function() hovered=true animate(1.035) end)
        object.SelectionLost:Connect(function() hovered=false pressed=false animate(1) end)
        object.InputBegan:Connect(function(input)
            if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch or input.KeyCode==Enum.KeyCode.ButtonA then
                pressed=true animate(.96)
            end
        end)
        object.InputEnded:Connect(function(input)
            if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch or input.KeyCode==Enum.KeyCode.ButtonA then
                pressed=false animate(if hovered and input.UserInputType~=Enum.UserInputType.Touch then 1.035 else 1)
            end
        end)
        object.Destroying:Connect(function()
            local tween=tweens[scale]
            if tween then tween:Cancel() tweens[scale]=nil end
            local strokeTween=tweens[border]
            if strokeTween then strokeTween:Cancel() tweens[border]=nil end
        end)
    end
end
function Theme.texture(parent: GuiObject, width: number, height: number)
    local pattern = Instance.new("Frame")
    pattern.Name,pattern.Size,pattern.BackgroundTransparency,pattern.ClipsDescendants = "FossilTexture",UDim2.fromScale(1,1),1,true
    pattern.ZIndex,pattern.Parent = parent.ZIndex,parent
    -- Bound decoration cost on large panels instead of creating hundreds of studs.
    local step=math.max(24,math.ceil(math.sqrt(width*height/100)))
    for x=8,width,step do for y=8,height,step do
        local stud = Instance.new("Frame")
        stud.Position,stud.Size = UDim2.fromOffset(x,y),UDim2.fromOffset(7,7)
        stud.BackgroundColor3,stud.BackgroundTransparency,stud.BorderSizePixel = Color3.new(1,1,1),.95,0
        stud.ZIndex,stud.Parent = parent.ZIndex,pattern
        local edge = Instance.new("UIStroke")
        edge.Color,edge.Transparency,edge.Thickness,edge.Parent = Color3.new(0,0,0),.85,1,stud
    end end
end
-- Original scalable graphics render sharply at any card size; uploaded original PNGs override them.
local function nativeIcon(parent: GuiObject,id: string): Frame?
    local uploaded = Theme.ImageIds[id]
    if uploaded and uploaded ~= "" then
        local root = Instance.new("Frame")
        root.Name,root.BackgroundTransparency,root.Size = "Art_"..id,1,UDim2.fromOffset(42,42)
        root.Position,root.ZIndex,root.Parent = UDim2.fromOffset(8,5),parent.ZIndex+1,parent
        local image = Instance.new("ImageLabel")
        image.Name,image.ScaleType = id,Enum.ScaleType.Fit
        local imageScale = IconLayout[id] or 1
        image.AnchorPoint,image.Position = Vector2.new(.5,.5),UDim2.fromScale(.5,.5)
        image.Image,image.Size,image.BackgroundTransparency,image.ZIndex,image.Parent = uploaded,UDim2.fromScale(imageScale,imageScale),1,root.ZIndex,root
        return root
    end
    if id=="amber" then
        local root=Instance.new("Frame")
        root.Name,root.BackgroundTransparency,root.Size="Art_amber",1,UDim2.fromOffset(42,42)
        root.Position,root.ZIndex,root.Parent=UDim2.fromOffset(8,5),parent.ZIndex+1,parent
        -- Reuse the original crystal model at full geometry quality without upload IDs.
        local preview=require(script.Parent.ModelPreview).add(root,"amber")
        preview.Size=UDim2.fromScale(1,1)
        return root
    end
    local data = EventVectors[id] or Vectors[id]
    if not data then return nil end
    local root = Instance.new("Frame")
    root.Name,root.BackgroundTransparency,root.Size = "Art_"..id,1,UDim2.fromOffset(42,42)
    root.Position,root.ZIndex,root.Parent = UDim2.fromOffset(8,5),parent.ZIndex+1,parent
    for _,shape in data do
        local part=Instance.new("Frame")
        part.BorderSizePixel=0
        part.Position=UDim2.fromScale(shape.x/100,shape.y/100)
        part.Size=UDim2.fromScale(shape.w/100,shape.h/100)
        part.Rotation=shape.rotation
        part.BackgroundColor3=Color3.fromHex(shape.color:sub(2))
        part.ZIndex,part.Parent=root.ZIndex,root
        if shape.color~="#142035" then
            local sheen=Instance.new("UIGradient")
            sheen.Color=ColorSequence.new(Color3.new(1,1,1),Color3.fromRGB(184,195,214))
            sheen.Rotation,sheen.Parent=90,part
        end
        if shape.radius&gt;0 then
            local round=Instance.new("UICorner")
            round.CornerRadius=UDim.new(shape.radius/math.min(shape.w,shape.h),0)
            round.Parent=part
        end
    end
    return root
end
function Theme.icon(parent: GuiObject,id: string): Frame?
    local trail=string.match(id,"^trail_(%w+)$")
    if trail then return TrailArtwork.build(parent,trail) end
    return Artwork.build(parent,id,nativeIcon) or nativeIcon(parent,id)
end
return Theme
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX49">
        <Properties>
          <string name="Name">WeatherClock</string>
          <ProtectedString name="Source">--!strict
local Config=require(script.Parent.ProgressionConfig)
local Clock={}
function Clock.new(now: number)
    return {current=nil,endsAt=0,nextAt=now+Config.WeatherInterval}
end
function Clock.step(state,now: number,choose): boolean
    if state.current and now&gt;=state.endsAt then
        state.current=nil state.endsAt=0 state.nextAt=now+Config.WeatherInterval
        return true
    elseif not state.current and now&gt;=state.nextAt then
        state.current=choose() state.endsAt=now+Config.WeatherDuration
        return true
    end
    return false
end
return Clock
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX50">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX51">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX52">
        <Properties>
          <string name="Name">Arena</string>
          <ProtectedString name="Source">--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Resources = require(ReplicatedStorage.Shared.ResourceModels)
local Terrain = require(script.Parent.IslandTerrain)
local Layout = require(ReplicatedStorage.Shared.IslandLayout)
local Arena = {}
local function part(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3, material: Enum.Material, solid: boolean): Part
    local p = Instance.new("Part")
    p.Name, p.Size, p.Position, p.Color, p.Material = name, size, position, color, material
    p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = true, solid, false, solid
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end
local function imported(parent: Instance, id: string, position: Vector3, scale: number, yaw: number): boolean
    local model = Resources.clone(id)
    if not model then return false end
    model:ScaleTo(scale)
    model:PivotTo(CFrame.new(position) * CFrame.Angles(0, yaw, 0))
    for _, item in model:GetDescendants() do if item:IsA("BasePart") then item.Anchored = true end end
    model.Parent = parent
    return true
end
local function group(parent: Instance, id: string, position: Vector3, scale: number, yaw: number): Model
    local model = Instance.new("Model")
    model.Name = id .. "Prop"
    model:SetAttribute("ResourceId", id)
    model:SetAttribute("SourcePosition", position)
    model:SetAttribute("SourceScale", scale)
    model:SetAttribute("SourceYaw", yaw)
    model.Parent = parent
    return model
end
local function rock(parent: Instance, position: Vector3, scale: number, yaw: number)
    parent = group(parent, "rock", position, scale, yaw)
    local collider = part(parent, "RockCollider", Vector3.new(4.7, 2.8, 4.0) * scale,
        position + Vector3.new(0, 1.4 * scale, 0), Color3.fromRGB(113, 133, 139), Enum.Material.Slate, true)
    collider.CFrame = CFrame.new(collider.Position) * CFrame.Angles(0, yaw, 0)
    if imported(parent, "rock", position, scale, yaw) then collider.Transparency = 1
    else
        collider.Shape = Enum.PartType.Ball
        local chip = part(parent, "RockChip", Vector3.new(2.6, 1.6, 2.6) * scale,
            position + Vector3.new(2, 0.8, 0.8) * scale, Color3.fromRGB(83, 109, 116), Enum.Material.Slate, true)
        chip.Shape = Enum.PartType.Ball
    end
end
local function tree(parent: Instance, position: Vector3, scale: number, yaw: number)
    parent = group(parent, "tree", position, scale, yaw)
    local trunk = part(parent, "TreeCollider", Vector3.new(1.6, 7, 1.6) * scale,
        position + Vector3.new(0, 3.5 * scale, 0), Color3.fromRGB(119, 83, 65), Enum.Material.Wood, true)
    if imported(parent, "tree", position, scale, yaw) then trunk.Transparency = 1
    else
        -- Roblox cylinders run along local X; rotate the long X dimension upright.
        trunk.Size = Vector3.new(7, 1.6, 1.6) * scale
        trunk.Shape = Enum.PartType.Cylinder
        trunk.CFrame = CFrame.new(trunk.Position) * CFrame.Angles(0, yaw, math.pi / 2)
        for _, offset in {Vector3.new(0, 9, 0), Vector3.new(2.7, 8.5, 0.4), Vector3.new(-2.3, 8.9, -0.8)} do
            local crown = part(parent, "Canopy", Vector3.new(5.5, 3.5, 5.5) * scale,
                position + offset * scale, Color3.fromRGB(64, 144, 112), Enum.Material.SmoothPlastic, false)
            crown.Shape = Enum.PartType.Ball
        end
    end
end
local function fern(parent: Instance, position: Vector3, scale: number, yaw: number)
    parent = group(parent, "fern", position, scale, yaw)
    if imported(parent, "fern", position, scale, yaw) then return end
    for i = 1, 7 do
        local angle = yaw + i * math.pi * 2 / 7
        local leaf = part(parent, "FernLeaf", Vector3.new(0.45, 0.16, 2.0) * scale,
            position + Vector3.new(math.sin(angle) * .6, .6, math.cos(angle) * .6) * scale,
            Color3.fromRGB(106, 180, 125), Enum.Material.SmoothPlastic, false)
        leaf.Shape = Enum.PartType.Ball
        leaf.CFrame = CFrame.new(leaf.Position) * CFrame.Angles(-0.28, angle, 0)
    end
end
function Arena.build()
    local old = workspace:FindFirstChild("BeDinoArena")
    if old then old:Destroy() end
    local world = Instance.new("Folder")
    world.Name, world.Parent = "BeDinoArena", workspace
    Terrain.build()
    local extent = Config.ArenaHalfWidth
    -- Simple hidden boundary; irregular rock silhouettes dress it instead of a block wall.
    for _, x in {-extent - 2, extent + 2} do
        local boundary = part(world, "Boundary", Vector3.new(4, 160, extent * 2 + 8), Vector3.new(x, 60, 0),
            Color3.fromRGB(81, 106, 116), Enum.Material.Rock, true)
        boundary.Transparency = 1
    end
    for _, z in {-extent - 2, extent + 2} do
        local boundary = part(world, "Boundary", Vector3.new(extent * 2, 160, 4), Vector3.new(0, 60, z),
            Color3.fromRGB(81, 106, 116), Enum.Material.Rock, true)
        boundary.Transparency = 1
    end
    local random = Random.new(1404)
    for side = 1, 4 do
        for i = 0, 11 do
            local t = -extent + i * extent * 2 / 11
            local position = if side == 1 then Vector3.new(t, 0, -extent - 5)
                elseif side == 2 then Vector3.new(t, 0, extent + 5)
                elseif side == 3 then Vector3.new(-extent - 5, 0, t) else Vector3.new(extent + 5, 0, t)
            rock(world, Vector3.new(position.X, Layout.height(position.X,position.Z), position.Z), random:NextNumber(2.4, 3.7), random:NextNumber(0, math.pi * 2))
        end
    end
    local spawn = Instance.new("SpawnLocation")
    spawn.Name = "PrototypeSpawn"
    spawn.Size, spawn.Position = Vector3.new(12, 1, 12), Vector3.new(0, Layout.height(0,30) + .5, 30)
    spawn.Anchored, spawn.Neutral, spawn.Duration, spawn.Transparency = true, true, 0, 1
    spawn.CanCollide, spawn.CanQuery = false, false
    spawn.Parent = world
    -- Authored landmark centers; within each, offset props avoid a uniform grid.
    for _, center in {Vector3.new(-105,0,80), Vector3.new(105,0,-80), Vector3.new(-125,0,-100), Vector3.new(128,0,102), Vector3.new(-190,0,15), Vector3.new(182,0,20), Vector3.new(0,0,-180), Vector3.new(15,0,190)} do
        for i = 1, 4 do
            local angle = i * 1.65 + random:NextNumber(-.4, .4)
            local position = center + Vector3.new(math.cos(angle) * 12, 0, math.sin(angle) * 10)
            position = Vector3.new(position.X,Layout.height(position.X,position.Z),position.Z)
            tree(world, position, random:NextNumber(1.5, 2.3), angle)
            fern(world, Vector3.new(position.X+5,Layout.height(position.X+5,position.Z+4),position.Z+4), random:NextNumber(.7,1.1), angle)
        end
        for i = 1, 3 do
            local p = center + Vector3.new(random:NextNumber(-14,14),0,random:NextNumber(-12,12))
            rock(world, Vector3.new(p.X,Layout.height(p.X,p.Z),p.Z), random:NextNumber(1.0,2.0), i)
        end
    end
    -- Scattered smaller vegetation connects landmarks while the central chase lane stays open.
    for i = 1, 65 do
        local angle, radius = i * 2.4, random:NextNumber(36,230)
        local position = Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius)
        position = Vector3.new(position.X,Layout.height(position.X,position.Z),position.Z)
        if (position - Vector3.new(0,0,30)).Magnitude &gt; 14 then fern(world, position, 1.2, angle) end
    end
    -- Stone arch landmark with an open passage.
    for _, x in {-96,-64} do
        local y = Layout.height(x,-15)
        part(world,"ArchPillar",Vector3.new(7,23,8),Vector3.new(x,y+11.5,-15),Color3.fromRGB(142,153,140),Enum.Material.Rock,true)
    end
    part(world,"ArchTop",Vector3.new(42,6,9),Vector3.new(-80,Layout.height(-80,-15)+24,-15),Color3.fromRGB(148,157,139),Enum.Material.Rock,true)
    -- Shallow decorative spring; water does not block navigation.
    local poolY = Layout.height(110,-40)+.2
    local pool = part(world,"SpringWater",Vector3.new(32,.18,25),Vector3.new(110,poolY,-40),Color3.fromRGB(77,192,200),Enum.Material.Glass,false)
    pool.Transparency = .28
    local falls = part(world,"Waterfall",Vector3.new(12,16,.3),Vector3.new(113,poolY+8,-52),Color3.fromRGB(183,236,232),Enum.Material.Glass,false)
    falls.Transparency = .4
    for i = 1, 4 do
        local x,z = 30+i*10,-30
        part(world,"JumpStone",Vector3.new(6,1.2+i*.4,6),Vector3.new(x,Layout.height(x,z)+.6+i*.2,z),Color3.fromRGB(133,147,143),Enum.Material.Slate,true)
    end
    -- Separate safe hub beyond the north boundary, with explicit server-owned entry.
    local hub = Instance.new("Model")
    hub.Name, hub.Parent = "Sanctuary", world
    part(hub,"SanctuaryGround",Vector3.new(110,6,95),Vector3.new(0,3,365),Color3.fromRGB(111,178,91),Enum.Material.Grass,true)
    part(hub,"NestPlaza",Vector3.new(34,.5,30),Vector3.new(0,6.25,365),Color3.fromRGB(223,205,154),Enum.Material.Sandstone,true)
    for _, x in {-48,48} do
        part(hub,"HubFence",Vector3.new(2,10,92),Vector3.new(x,11,365),Color3.fromRGB(83,131,73),Enum.Material.Wood,true)
    end
    for _, z in {322,408} do
        part(hub,"HubFence",Vector3.new(96,10,2),Vector3.new(0,11,z),Color3.fromRGB(83,131,73),Enum.Material.Wood,true)
    end
    for _, x in {-32,32} do tree(hub,Vector3.new(x,6,380),1.2,x) end
    for i = 1,5 do
        local nest = part(hub,"EggNest",Vector3.new(5,1,5),Vector3.new(-18+i*6,6.6,385),Color3.fromRGB(174,129,70),Enum.Material.Wood,false)
        nest.Shape = Enum.PartType.Cylinder
    end
    local sign = part(hub,"SanctuarySign",Vector3.new(30,7,1),Vector3.new(0,15,402),Color3.fromRGB(27,76,51),Enum.Material.Wood,false)
    local surface = Instance.new("SurfaceGui")
    surface.Face, surface.CanvasSize, surface.Parent = Enum.NormalId.Front, Vector2.new(600,140), sign
    local label = Instance.new("TextLabel")
    label.Size, label.BackgroundTransparency, label.Text = UDim2.fromScale(1,1),1,"SANCTUARY"
    label.Font, label.TextScaled, label.TextColor3, label.Parent = Enum.Font.FredokaOne,true,Color3.new(1,1,1),surface
    workspace:SetAttribute("ArenaArtMode", if ReplicatedStorage.Resources:FindFirstChild("tree") then "Resource meshes" else "Import resources/models for mesh art")
end
return Arena
</ProtectedString>
