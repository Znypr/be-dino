      <Item class="ModuleScript" referent="RBX41">
        <Properties>
          <string name="Name">ResourceMeshAssets</string>
          <ProtectedString name="Source">--!strict
-- Generated by tools/bind_visual_assets.py; empty IDs retain native geometry.
return {
    compy = "79351996702566",
    triceratops = "90014068543889",
    tyrannosaurus = "70736222541118",
    raptor = "114284137928940",
    stegosaurus = "92865644294705",
    ankylosaurus = "74993073282146",
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX42">
        <Properties>
          <string name="Name">ResourceModels</string>
          <ProtectedString name="Source">--!strict
-- Imported meshes are optional until Studio upload; no invented asset IDs.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local RuntimeMeshes = require(script.Parent.RuntimeMeshes)
local ResourceModels = {}
function ResourceModels.clearTextures(part: BasePart)
    for _,child in part:GetChildren() do
        if child:IsA("SurfaceAppearance") or child:IsA("Decal") or child:IsA("Texture") then child:Destroy() end
    end
    if part:IsA("MeshPart") then part.TextureID="" end
end
function ResourceModels.clone(id: string): Model?
    local folder = ReplicatedStorage:FindFirstChild("Resources")
    local template = if folder then folder:FindFirstChild(id) else nil
    local overrides=ReplicatedStorage:FindFirstChild("ResourceOverrides")
    template=(if overrides then overrides:FindFirstChild(id) else nil) or template
    if not template then return if RunService:IsClient() then RuntimeMeshes.clone(id) else nil end
    local copy: Model
    if template:IsA("Model") then
        copy = template:Clone()
    elseif template:IsA("BasePart") then
        copy = Instance.new("Model")
        local part = template:Clone()
        part.Parent = copy
        copy.PrimaryPart = part
    else
        return nil
    end
    -- Only geometry and appearance survive import. Never execute imported code.
    for _, item in copy:GetDescendants() do
        if item:IsA("LuaSourceContainer") then item:Destroy()
        elseif item:IsA("BasePart") then
            item.CanCollide = false
            item.CanTouch = false
            item.CanQuery = false
            item.Massless = true
        end
    end
    -- Normalize the pivot to the ground under the bounding-box center. Keep imported -Z facing.
    copy.PrimaryPart = nil
    local box, size = copy:GetBoundingBox()
    local origin = box.Position - Vector3.new(0, size.Y / 2, 0)
    copy.WorldPivot = CFrame.new(origin)
    copy:SetAttribute("GeometryOrigin", origin)
    copy.Name = id
    return copy
end
return ResourceModels
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX43">
        <Properties>
          <string name="Name">RuntimeMeshes</string>
          <ProtectedString name="Source">--!strict
-- Build local visual MeshParts from embedded original geometry. Server collision stays separate.
local AssetService = game:GetService("AssetService")
local RunService = game:GetService("RunService")
local Geometry = require(script.Parent.ResourceGeometry)
local RuntimeMeshes = {}
local resourceIds = {}
for id in Geometry do table.insert(resourceIds,id) end
table.sort(resourceIds)
local templates: {[string]: Model} = {}
local editableMeshes: {[string]: EditableMesh} = {}
local started = false
RuntimeMeshes.Ready = Instance.new("BindableEvent")
function RuntimeMeshes.clone(id: string): Model?
    local template = templates[id]
    return if template then template:Clone() else nil
end
function RuntimeMeshes.prepare()
    if started or not RunService:IsClient() then return end
    started = true
    task.spawn(function()
        local succeeded = 0
        for _, id in resourceIds do
            local editable: EditableMesh? = nil
            local ok, result = pcall(function()
                local data = Geometry[id]
                local mesh = AssetService:CreateEditableMesh()
                if not mesh then error("EditableMesh memory unavailable") end
                editable = mesh
                local vertices, colors = {}, {}
                for _, position in data.vertices do
                    table.insert(vertices, mesh:AddVertex(Vector3.new(position[1], position[2], position[3])))
                end
                for _, color in data.colors do
                    table.insert(colors, mesh:AddColor(Color3.new(color[1], color[2], color[3]), 1))
                end
                for _, triangle in data.faces do
                    local face = mesh:AddTriangle(vertices[triangle[1]], vertices[triangle[2]], vertices[triangle[3]])
                    local color = colors[triangle[4]]
                    mesh:SetFaceColors(face, {color, color, color})
                    local a, b, c = data.vertices[triangle[1]], data.vertices[triangle[2]], data.vertices[triangle[3]]
                    local normal = (Vector3.new(b[1]-a[1],b[2]-a[2],b[3]-a[3])):Cross(Vector3.new(c[1]-a[1],c[2]-a[2],c[3]-a[3])).Unit
                    local normalId = mesh:AddNormal(normal)
                    mesh:SetFaceNormals(face, {normalId, normalId, normalId})
                end
                local part = AssetService:CreateMeshPartAsync(Content.fromObject(mesh))
                part.Name = id .. "Mesh"
                part.Color = Color3.new(1, 1, 1)
                part.Material = Enum.Material.SmoothPlastic
                part.Anchored = true
                part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
                part.Massless = true
                -- EditableMesh vertices are relative to mesh bounds center.
                local min, max = Vector3.new(math.huge,math.huge,math.huge), Vector3.new(-math.huge,-math.huge,-math.huge)
                for _, p in data.vertices do
                    local v = Vector3.new(p[1],p[2],p[3])
                    min = Vector3.new(math.min(min.X,v.X),math.min(min.Y,v.Y),math.min(min.Z,v.Z))
                    max = Vector3.new(math.max(max.X,v.X),math.max(max.Y,v.Y),math.max(max.Z,v.Z))
                end
                part.Size = max - min
                part.CFrame = CFrame.new((min + max) / 2)
                local model = Instance.new("Model")
                model.Name = id
                part.Parent = model
                model.WorldPivot = CFrame.new(0, 0, 0)
                return model
            end)
            if ok then
                editableMeshes[id] = editable :: EditableMesh -- preserve the content lifetime
                templates[id] = result
                succeeded += 1
                RuntimeMeshes.Ready:Fire(id)
            else
                if editable then editable:Destroy() end
                warn("[Be Dino] mesh " .. id .. " unavailable: " .. tostring(result))
                -- A permission failure should not cause repeated heavyweight failures.
                if succeeded == 0 then break end
            end
            task.wait()
        end
        workspace:SetAttribute("LocalMeshCount", succeeded)
        workspace:SetAttribute("LocalMeshStatus", if succeeded == #resourceIds then "Ready" else "Enable Mesh / Image APIs or import OBJ assets")
    end)
end
return RuntimeMeshes
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX44">
        <Properties>
          <string name="Name">ShopOdds</string>
          <ProtectedString name="Source">--!strict
local Config=require(script.Parent.Config)
local Progression=require(script.Parent.ProgressionConfig)
local Odds={}
function Odds.lines(level)
    local lines={"RANDOM EGG ODDS", "Species (one purchased egg; no run-batch boost):"}
    local total=0 for _,row in Config.ChestSpeciesWeights do total+=row.weight end
    for _,row in Config.ChestSpeciesWeights do table.insert(lines,string.format("%s: %.4f%%",Config.SpeciesDisplayNames[row.speciesId],100*row.weight/total)) end
    total=0 for _,row in Config.ChestQuantityWeights do total+=row.weight end
    table.insert(lines,"Copies from a successful egg:")
    for _,row in Config.ChestQuantityWeights do table.insert(lines,string.format("%d copies: %.4f%%",row.count,100*row.weight/total)) end
    table.insert(lines,"Condition upgrade "..level..":")
    local weights=Progression.ConditionWeights[level+1]
    for i,row in Progression.Conditions do table.insert(lines,string.format("%s: %g%%; hatch %g%%; speed/growth %gx",row.name,weights[i],row.hatchChance*100,row.stats)) end
    table.insert(lines,string.format("Failed egg: %.4f%% overall; no dinosaur or crystal refund",weights[1]*(1-Progression.Conditions[1].hatchChance)))
    table.insert(lines,"Colors (each slot independently):")
    total=0 for _,row in Progression.EggColors do total+=row.weight end
    for _,row in Progression.EggColors do table.insert(lines,string.format("%s: %.4f%% per slot",row.name,100*row.weight/total)) end
    table.insert(lines,"Black / Black: 0.000001% (1 in 100,000,000)")
    table.insert(lines,"Primary blend 0 through 100%: 1/101 each; secondary is the remainder")
    table.insert(lines,"Normal size: 90%; BIG: 10% (size only, 1.2x)")
    table.insert(lines,"Purchased eggs: clear-weather, Shiny 0%; event mutation 0%")
    table.insert(lines,"Earned eggs: Shiny 5% during Volcano, Northern Lights, Earthquake or Blood Moon; otherwise 0%. BIG is independent.")
    table.insert(lines,"Each combined outcome multiplies its independent probabilities; only Cracked can fail.")
    return lines
end
return Odds
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX45">
        <Properties>
          <string name="Name">TrailArtwork</string>
          <ProtectedString name="Source">--!strict
-- Shared ribbon preview uses the catalog's real colors and taper, not a fabricated upload.
local Config=require(script.Parent.ProgressionConfig)
local Rules=require(script.Parent.ProgressionRules)
local Art={}
function Art.build(parent: GuiObject,id: string): Frame?
    local item=Rules.item(Config.Trails,id)
    if not item then return nil end
    local root=Instance.new("Frame")
    root.Name,root.BackgroundTransparency,root.Size,root.ZIndex,root.Parent="TrailArtwork_"..id,1,UDim2.fromScale(1,1),parent.ZIndex+1,parent
    for lane=1,2 do for i=1,28 do
        local t=(i-1)/27
        local part=Instance.new("Frame")
        local nextT=i/27
        local x,y=.12+t*.76,.34+(lane-1)*.2+math.sin(t*math.pi*1.5)*.14
        local dx,dy=(nextT-t)*.76,(math.sin(nextT*math.pi*1.5)-math.sin(t*math.pi*1.5))*.14
        part.AnchorPoint,part.Position=Vector2.new(.5,.5),UDim2.fromScale(x,y)
        part.Size=UDim2.fromScale(math.sqrt(dx*dx+dy*dy)*2.2,.045*(1-t*.75))
        part.Rotation=math.deg(math.atan2(dy,dx))
        part.BackgroundColor3=Color3.fromRGB(item.color[1],item.color[2],item.color[3]):Lerp(Color3.fromRGB(item.accent[1],item.accent[2],item.accent[3]),t)
        part.BackgroundTransparency,part.BorderSizePixel,part.ZIndex,part.Parent=t*.7,0,root.ZIndex,root
        local corner=Instance.new("UICorner") corner.CornerRadius,corner.Parent=UDim.new(1,0),part
    end end
    return root
end
return Art
</ProtectedString>
        </Properties>
      </Item>
