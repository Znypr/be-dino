      <Item class="ModuleScript" referent="RBX20">
        <Properties>
          <string name="Name">EggAppearance</string>
          <ProtectedString name="Source">--!strict
local Genetics=require(script.Parent.EggGenetics)
local Textures=require(script.Parent.GeneTextures)
local Appearance={}
function Appearance.apply(container: Instance,genes)
    if not genes or not Genetics.valid(genes) then return end
    local tint=Genetics.tint(genes)
    for _,part in container:GetDescendants() do
        if part:IsA("BasePart") then
            local original=part:GetAttribute("GeneOriginalColor")
            if typeof(original)~="Color3" then original=part.Color part:SetAttribute("GeneOriginalColor",original) end
            -- Preserve texture detail and geometry; SurfaceAppearance needs its own tint.
            local brightness=math.max(original.R,original.G,original.B)
            part.Color=if part:IsA("MeshPart") then tint else Color3.new(tint.R*brightness,tint.G*brightness,tint.B*brightness)
            if part:IsA("MeshPart") then Textures.apply(part) end
            for _,surface in part:GetChildren() do
                if surface:IsA("SurfaceAppearance") then surface.Color=tint end
            end
        end
    end
end
return Appearance
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX21">
        <Properties>
          <string name="Name">EggGenetics</string>
          <ProtectedString name="Source">--!strict
local Config=require(script.Parent.ProgressionConfig)
local Genetics={}
local function item(rows,id)
    for _,row in rows do if row.id==id then return row end end
    return nil
end
function Genetics.condition(id) return item(Config.Conditions,id) end
function Genetics.color(id) return item(Config.EggColors,id) end
local function pick(weights,roll)
    local total=0 for _,weight in weights do total+=weight end
    local value=math.clamp(roll,0,1)*total
    for i,weight in weights do value-=weight if value&lt;0 then return i end end
    return #weights
end
function Genetics.roll(level,rng)
    local weights=Config.ConditionWeights[math.clamp(level or 0,0,#Config.ConditionWeights-1)+1]
    local condition=Config.Conditions[pick(weights,rng:NextNumber())]
    local colors={} for _,color in Config.EggColors do table.insert(colors,color.weight) end
    local hatchRoll=rng:NextNumber()
    return {conditionId=condition.id,hatchSuccess=condition.hatchChance==1 or hatchRoll&lt;condition.hatchChance,
        primaryColorId=Config.EggColors[pick(colors,rng:NextNumber())].id,
        secondaryColorId=Config.EggColors[pick(colors,rng:NextNumber())].id,
        blend=math.min(100,math.floor(rng:NextNumber()*101))}
end
function Genetics.valid(g)
    if typeof(g)~="table" or not Genetics.condition(g.conditionId) or not Genetics.color(g.primaryColorId)
        or not Genetics.color(g.secondaryColorId) or typeof(g.hatchSuccess)~="boolean"
        or typeof(g.blend)~="number" or g.blend~=g.blend or g.blend&lt;0 or g.blend&gt;100 or g.blend%1~=0 then return false end
    return g.hatchSuccess or g.conditionId=="cracked"
end
function Genetics.key(g)
    return g.conditionId..":"..g.primaryColorId..":"..g.secondaryColorId..":"..g.blend
end
function Genetics.tint(g)
    local a,b=Genetics.color(g.primaryColorId).rgb,Genetics.color(g.secondaryColorId).rgb
    return Color3.fromRGB(a[1],a[2],a[3]):Lerp(Color3.fromRGB(b[1],b[2],b[3]),1-g.blend/100)
end
return Genetics
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX22">
        <Properties>
          <string name="Name">EggPreview</string>
          <ProtectedString name="Source">--!strict
-- Smooth built-in sphere geometry, no uploaded mesh or editable APIs required.
local Egg={}
function Egg.create(empty: boolean?): Model
    local model=Instance.new("Model")
    model.Name="SmoothEggPreview"
    local function sphere(name: string,position: Vector3,scale: Vector3,color: Color3)
        local part=Instance.new("Part")
        part.Name,part.Size,part.CFrame=name,scale,CFrame.new(position)
        part.Anchored,part.CanCollide,part.CanTouch,part.CanQuery=true,false,false,false
        part.Color,part.Material= color,Enum.Material.SmoothPlastic
        part.Transparency=0
        part.Parent=model
        local mesh=Instance.new("SpecialMesh")
        mesh.MeshType,mesh.Scale,mesh.Parent=Enum.MeshType.Sphere,Vector3.one,part
        return part
    end
    sphere("Shell",Vector3.new(0,1.2,0),Vector3.new(1.55,2.3,1.55),Color3.fromRGB(255,237,182))
    do
        for i,p in {Vector3.new(.49,1.58,-.59),Vector3.new(-.32,.94,-.66),Vector3.new(.17,2.01,-.43),Vector3.new(-.68,1.48,-.21)} do
            sphere("JadePatch"..i,p,Vector3.new(.32,.36,.12),Color3.fromRGB(58,172,117))
        end
    end
    model.WorldPivot=CFrame.new()
    return model
end
return Egg
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX23">
        <Properties>
          <string name="Name">EggTraits</string>
          <ProtectedString name="Source">--!strict
local Config = require(script.Parent.Config)
local Genetics = require(script.Parent.EggGenetics)
local Traits = {}
function Traits.roll(eventId: string, shinyRoll: number, bigRoll: number)
    return {
        shiny = Config.IrregularWeather[eventId] == true and shinyRoll &lt; Config.ShinyChance,
        big = bigRoll &lt; Config.BigChance,
    }
end
function Traits.key(mutationId: string, shiny: boolean, big: boolean,genes): string
    return mutationId .. ":" .. (if shiny then "shiny" else "plain") .. ":" .. (if big then "big" else "normal") .. (if genes then ":"..Genetics.key(genes) else "")
end
function Traits.selected(entry)
    local selected = nil
    local best = -1
    for key, variant in (if entry then entry.variants or {} else {}) do
        local rank = (if variant.big then 2 else 0) + (if variant.shiny then 1 else 0)
        if variant.genes then rank+=Genetics.condition(variant.genes.conditionId).stats*10 end
        if variant.count &gt; 0 and (rank &gt; best or (rank == best and selected and key &lt; selected.key)) then
            best = rank
            selected = {key = key, big = variant.big, shiny = variant.shiny, mutationId = variant.mutationId,genes=variant.genes}
        end
    end
    return selected
end
function Traits.valid(variants): boolean
    if typeof(variants) ~= "table" then return false end
    for key, variant in variants do
        if typeof(variant) ~= "table" or typeof(variant.big) ~= "boolean" or typeof(variant.shiny) ~= "boolean"
            or typeof(variant.mutationId) ~= "string" or typeof(variant.count) ~= "number"
            or variant.count ~= variant.count or variant.count &lt; 0 or variant.count % 1 ~= 0 or variant.count &gt; 2000000000
            or (variant.genes~=nil and (not Genetics.valid(variant.genes) or not variant.genes.hatchSuccess))
            or key ~= Traits.key(variant.mutationId, variant.shiny, variant.big,variant.genes)
            or not (variant.shiny or variant.big or variant.genes) then return false end
    end
    return true
end
return Traits
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX24">
