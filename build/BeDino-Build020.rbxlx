gui:SetAttribute("Ready",true)
local elapsed=0
local lastRunState=""
local lastLevel=num("AccountLevel")
player:GetAttributeChangedSignal("AccountLevel"):Connect(function()
    local level=num("AccountLevel")
    if lastLevel&gt;0 and level&gt;lastLevel then Sfx.play("level_up") notify("Level "..level.."!",C.gold) end
    lastLevel=level
end)
RunService.Heartbeat:Connect(function(dt)
    elapsed+=dt
    if elapsed&lt;.15 then return end elapsed=0
    local character=player.Character
    local state=if character then character:GetAttribute("RunState") else "Loading"
    local growth=if character then character:GetAttribute("GrowthScore") or 0 else 0
    local catches=if character then character:GetAttribute("CatchScore") or 0 else 0
    growthLabel.Text=string.format("%d GROWTH",growth)
    catchLabel.Text=string.format("%d catches  •  %s",catches,if state=="Sanctuary" then "Safe sanctuary" else "Island")
    action.Text=if state=="Sanctuary" then "EXPLORE ISLAND" elseif state=="Active" then "HOME" else "SAVING..."
    action.BackgroundColor3=if state=="Active" then C.red else C.accent
    if actionIcon then actionIcon.Visible=state=="Active" end
    actionPadding.PaddingLeft=UDim.new(0,if actionIcon and state=="Active" then 52 else 6)
    actionPadding.PaddingRight=UDim.new(0,6)
    if active=="exit" and state~="Active" then close() end
    if character then
        local visualScale=character:GetAttribute("VisualScale") or 1
        player.CameraMinZoomDistance=Config.CameraMinZoom*visualScale
        local humanoid=character:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.CameraOffset=Vector3.new(0,(visualScale-1)*2,0) end
    end
    if growth&gt;lastGrowth and state=="Active" then
        notify(string.format("+%.1f Growth!",growth-lastGrowth),C.accent)
        Sfx.play("pickup")
        pickupPop(string.format("+%.1f",growth-lastGrowth))
        if motion then
            hudScale.Scale=(hud:GetAttribute("UIScaleBase") or 1)*1.06
            Theme.animate(hudScale,.2,{Scale=hud:GetAttribute("UIScaleBase") or 1},Enum.EasingStyle.Back)
        end
    end
    lastGrowth=growth
    if state~=lastRunState then
        if lastRunState=="Sanctuary" and state=="Active" then Sfx.play("run_start") elseif lastRunState=="Active" and state=="Sanctuary" then Sfx.play("run_end") end
        lastRunState=state
    end
    local ok,tags=pcall(function() return Http:JSONDecode(if character then character:GetAttribute("RunEggEvents") or "[]" else "[]") end)
    if ok and typeof(tags)=="table" then
        if #tags&gt;lastEggCount and state=="Active" then
            local newest=tags[#tags]
            local mutation=ProgressionRules.item(ProgressionConfig.EventMutations,newest.mutationId or "")
            notify(if mutation then mutation.name.." egg caught!" else "Reward egg caught!",if mutation then C.gold else C.blue)
        end
        lastEggCount=#tags
    end
    refreshProgressionHUD()
    if active=="eggs" and refreshEggs then refreshEggs() end
    if player:GetAttribute("ProfileState")=="Loaded" and state=="Sanctuary" and not seenTutorial then seenTutorial=true open("tutorial") end
end)
local refreshQueued=false
local function scheduleModalRefresh()
    if refreshQueued then return end
    refreshQueued=true
    task.defer(function()
        refreshQueued=false
        if table.find({"collection","detail","fusion","eggs","auras","potions","settings"},active) then
            body:ClearAllChildren()
            render(active)
        end
    end)
end
for _,attribute in {"EquippedSpeciesId","CollectionJson","ChestQueueJson","ProgressionJson","NestsJson","QueuedEggsWaiting","RevealSkipJson"} do
    player:GetAttributeChangedSignal(attribute):Connect(function()
        scheduleModalRefresh()
    end)
end
player:GetAttributeChangedSignal("LastClaimedChestId"):Connect(function()
    hatchPending=false
    -- Skippable eggs (selected rarities, nothing notable) are already credited: no animation.
    local species=string.match(str("LastChestRewardText"),"x (%w+)") or "compy"
    local okGenes,genes=pcall(function() return Http:JSONDecode(str("LastChestGenesJson","null")) end)
    local outcome={big=player:GetAttribute("LastChestBig"),shiny=player:GetAttribute("LastChestShiny"),eventMutationId=str("LastChestEventMutation"),
        genes=if okGenes and typeof(genes)=="table" then genes else nil,failed=player:GetAttribute("LastChestFailed")==true}
    local rarity=speciesIndex(species)
    if autoHatching and RevealSkip.shouldSkip(decoded("RevealSkipJson","[]"),rarity,outcome) then
        table.insert(skippedEntries,{rarity=rarity,speciesId=species,outcome=outcome})
        task.defer(hatchNext)
        return
    end
    task.defer(function() open("hatch") end)
end)
player:GetAttributeChangedSignal("LastRunEndAt"):Connect(function() if not autoHatching then open("results") end end)
player:GetAttributeChangedSignal("LastSettledRunId"):Connect(function()
    local serial=hatchCancelSerial
    task.spawn(function()
        local deadline=os.clock()+15
        repeat task.wait(.1) until serial~=hatchCancelSerial or os.clock()&gt;deadline
            or (player.Character and player.Character:GetAttribute("RunState")=="Sanctuary")
        if serial==hatchCancelSerial and player.Character and player.Character:GetAttribute("RunState")=="Sanctuary" then
            if num("LastRunCrystalBox")&gt;0 then
                open("crystalReveal")
                local version=modalVersion
                task.wait(3)
                if modalVersion~=version or serial~=hatchCancelSerial then return end
            end
            if str("NextChestId")~="" then autoHatching=true hatchNext() else open("results") end
        end
    end)
end)
player:GetAttributeChangedSignal("LastExitStatusAt"):Connect(function()
    if str("LastExitStatus")=="predator_nearby" then notify("A bigger dino is too close to go home!",C.red) end
end)
player:GetAttributeChangedSignal("LastRewardText"):Connect(function() if active=="results" then body:ClearAllChildren() render(active) end end)
for _,attribute in {"LastEquipStatus","LastMutationStatus","LastChestClaimStatus","LastNestClaimStatus","LastRunStartStatus"} do
    player:GetAttributeChangedSignal(attribute):Connect(function()
        local status=str(attribute)
        if attribute=="LastChestClaimStatus" then hatchPending=false end
        if status=="claimed" then toast.Visible=false
        elseif status=="equipped" or status=="mutated" or status=="opened" then notify("Success!",C.accent)
        elseif status~="" and status~="duplicate" then notify(status:gsub("_"," "),C.red) end
    end)
end
Input.InputBegan:Connect(function(input,processed)
    if processed then return end
    if (input.KeyCode==Enum.KeyCode.E or input.KeyCode==Enum.KeyCode.ButtonY) and not shade.Visible then leapRemote:FireServer()
    elseif input.KeyCode==Enum.KeyCode.Escape then close()
    elseif input.KeyCode==Enum.KeyCode.C then open("collection")
    elseif input.KeyCode==Enum.KeyCode.B then open("eggs") end
end)
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX255">
          <Properties>
            <string name="Name">CosmeticVisuals</string>
            <ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config=require(Shared.ProgressionConfig)
local Rules=require(Shared.ProgressionRules)
local Effects=require(Shared.CosmeticEffects)
local Theme=require(Shared.UITheme)
local Mutations=require(Shared.MutationEffects)
local Shiny=require(Shared.ShinyEffects)
local function destroy(state)
    state.effect:destroy()
    if state.mutation then state.mutation.Destroy() end
    if state.glints then state.glints.Destroy() end
end
local states={}
local elapsed=0
RunService.Heartbeat:Connect(function(dt)
    elapsed+=dt
    if elapsed&lt;1/30 then return end
    elapsed=0
    local camera=workspace.CurrentCamera
    local keep={}
    local count=0
    -- Own equipment wins the distance budget; never create unbounded particle pools.
    local players=Players:GetPlayers()
    table.sort(players,function(a,b) return a==Players.LocalPlayer and b~=Players.LocalPlayer end)
    for _,player in players do
        local character=player.Character
        local root=if character then character:FindFirstChild("HumanoidRootPart") else nil
        if root and root:IsA("BasePart") and camera and (camera.CFrame.Position-root.Position).Magnitude&lt;180 and count&lt;8 then
            count+=1 keep[player]=true
            local auraId=character:GetAttribute("EquippedAuraId") or ""
            local trailId=character:GetAttribute("EquippedTrailId") or ""
            local mutationId=character:GetAttribute("EventMutationId") or ""
            local shiny=character:GetAttribute("ShinyDinosaur")==true
            local visual=character:FindFirstChild("LocalMeshVisual") or character:FindFirstChild("DinoVisual")
            local scale=character:GetAttribute("VisualScale") or 1
            local state=states[player]
            if not state or state.root~=root or state.auraId~=auraId or state.trailId~=trailId or state.mutationId~=mutationId or state.shiny~=shiny or state.visual~=visual or state.motion~=Theme.MotionEnabled then
                if state then destroy(state) end
                state={root=root,auraId=auraId,trailId=trailId,mutationId=mutationId,shiny=shiny,visual=visual,scale=scale,motion=Theme.MotionEnabled,effect=Effects.create(root,Rules.item(Config.Auras,auraId),Rules.item(Config.Trails,trailId),nil,false)}
                if visual and visual:IsA("Model") then
                    state.mutation=Mutations.Create(visual,mutationId,"rbxassetid://105629313112163",not Theme.MotionEnabled)
                    if shiny then state.glints=Shiny.Create(visual,"rbxassetid://70885382548001",not Theme.MotionEnabled) end
                end
                states[player]=state
            end
            if state.scale~=scale then
                if state.glints then state.glints.Resize() end
                state.scale=scale
            end
            state.effect:update(character:GetAttribute("VisualScale") or 1,os.clock(),Theme.MotionEnabled)
        end
    end
    for player,state in states do if not keep[player] then destroy(state) states[player]=nil end end
end)
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX256">
          <Properties>
            <string name="Name">DinoDetails</string>
            <ProtectedString name="Source">--!strict
-- BD-062 Dino Details for ONE individual dinosaur instance. Content comes from the
-- server's `details` action and the pure FusionSelection.details view model:
-- hatched -&gt; original egg (genes, condition, event, source); fused -&gt; parent list,
-- parent eggs, recipe/odds versions and "Crafted Gold (earned)". Never a fake Gold
-- drop %, and bought cosmetics are listed separately and never count toward rarity.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Preview = require(Shared.DinosaurPreview)
local Sel = require(Shared.FusionSelection)
local PreviewTraits = require(script.Parent.PreviewTraits)
local W = require(script.Parent.FusionWidgets)
local C = W.Colors

local DinoDetails = {}

-- call(payload) -&gt; response|nil (already pcall/timeout wrapped by the caller).
function DinoDetails.show(container: GuiObject, instanceId: string, catalog, call, onBack: () -&gt; ())
    local root = Instance.new("Frame")
    root.Name, root.Size, root.BackgroundColor3, root.Active = "DinoDetails", UDim2.fromScale(1, 1), C.panel, true
    root.Parent = container
    local header = W.box(root, UDim2.new(1, 0, 0, W.Touch + 8), UDim2.new(), C.blue)
    local title = W.label(header, "Loading dino...", UDim2.new(1, -(W.Touch * 2 + 40), 1, -8), UDim2.fromOffset(12, 4), 28, nil, true)
    W.button(header, "BACK", UDim2.new(0, W.Touch * 2, 0, W.Touch), UDim2.new(1, -(W.Touch * 2 + 4), 0, 4), C.red, function()
        root:Destroy()
        onBack()
    end)
    local status = W.label(root, "Loading details...", UDim2.new(1, -24, 0, 40), UDim2.new(0, 12, 0, W.Touch + 20), 22, C.gold)
    task.spawn(function()
        local response = call({action = "details", instanceId = instanceId})
        if not root.Parent then return end
        if type(response) ~= "table" or response.ok ~= true or type(response.dinosaur) ~= "table" then
            status.Text = "Details unavailable: " .. (if type(response) == "table" then tostring(response.reason or "unknown") else "connection problem")
            status.TextColor3 = C.red
            return
        end
        status:Destroy()
        local d = response.dinosaur
        local view = Sel.details(d, catalog)
        title.Text = view.title
        -- Left: preview (stage material + shiny/BIG badges). Right: scrolling facts.
        local stage = W.box(root, UDim2.new(.38, -18, 1, -(W.Touch + 26)), UDim2.new(0, 12, 0, W.Touch + 16), W.StageColors[d.stage or "base"] or C.card)
        local preview = Preview.add(stage, d.speciesId or "compy", if d.stage == "base" or d.stage == nil then "base" else d.stage)
        preview.Size, preview.Position = UDim2.fromScale(1, .72), UDim2.fromScale(0, .02)
        -- Gold/Diamond keep their stage material; Base shows the actual gene colors.
        PreviewTraits.add(preview, {shiny = d.shiny, big = d.big, genes = if d.stage == "base" then d.genes else nil})
        W.label(stage, view.prestige or "", UDim2.new(1, -12, .12, 0), UDim2.new(0, 6, .74, 0), 22, C.text)
        W.swatch(stage, d.genes, UDim2.new(1, -24, .08, 0), UDim2.new(0, 12, .88, 0))
        local facts = W.scroll(root, UDim2.new(.62, -18, 1, -(W.Touch + 26)), UDim2.new(.38, 6, 0, W.Touch + 16))
        W.list(facts, 4)
        local order = 0
        local function line(text: string, color: Color3?, height: number?)
            order += 1
            local l = W.label(facts, text, UDim2.new(1, -14, 0, height or 28), UDim2.new(), 20, color, true)
            l.LayoutOrder = order
            return l
        end
        line("TRAITS", C.gold)
        for _, row in view.traits do line(row.label .. ": " .. row.value) end
        line("PRESTIGE: " .. (view.prestige or ""), C.gold)
        line(if view.origin.kind == "fused" then "FUSION LINEAGE" elseif view.origin.kind == "hatched" then "ORIGINAL EGG" else "ORIGIN", C.gold)
        for _, text in view.origin.lines do line(text, nil, if #text &gt; 48 then 46 else 28) end
        for i, parent in view.origin.parents do
            line(i .. ". " .. parent.text, C.blue)
            line("   Egg: " .. parent.egg, nil, if #parent.egg &gt; 44 then 46 else 28)
        end
        line("COSMETICS (THIS DINO ONLY)", C.purple)
        for _, text in view.cosmetics do line(text, nil, if #text &gt; 48 then 46 else 28) end
    end)
    return root
end

return DinoDetails
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX257">
          <Properties>
            <string name="Name">FusionMenu</string>
            <ProtectedString name="Source">--!strict
-- BD-065 Fusion Menu (client). Ten same-species + same-pattern Base dinos -&gt; ONE NEW
-- Gold. The server (ReplicatedStorage.BeDinoRemotes.FusionAction) owns every rule,
-- odds table, consumption and roll; this module only lists, explains, previews the
-- exact quoted odds, collects explicit consent and REVEALS the committed result.
-- Pure decisions live in Shared.FusionSelection (tested by tools/verify_fusion_ui.py).
-- If the remote is missing the menu shows "Fusion unavailable" and never errors.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Input = game:GetService("UserInputService")
local Http = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local ProgressionConfig = require(Shared.ProgressionConfig)
local EggGenetics = require(Shared.EggGenetics)
local Theme = require(Shared.UITheme)
local Preview = require(Shared.DinosaurPreview)
local Sel = require(Shared.FusionSelection)
local Sfx = require(Shared.Sfx)
local PreviewTraits = require(script.Parent.PreviewTraits)
local W = require(script.Parent.FusionWidgets)
local DinoDetails = require(script.Parent.DinoDetails)
local C = W.Colors
local T = W.Touch

local FusionMenu = {}
-- Client display constants (module-local by design; no Config edits).
FusionMenu.QuoteDebounce = .35
FusionMenu.RequestTimeout = 12
FusionMenu.MaxListPages = 10
FusionMenu.PageSize = 200
FusionMenu.CardBatch = 120
FusionMenu.AutoRetries = 3
FusionMenu.ReelTurns = 3
FusionMenu.ReelSeconds = 1.7

local catalog = Sel.buildCatalog(Config, ProgressionConfig, EggGenetics.Patterns)
local player = Players.LocalPlayer

local function remote(): RemoteFunction?
    local folder = ReplicatedStorage:FindFirstChild("BeDinoRemotes")
    local found = folder and folder:FindFirstChild("FusionAction")
    return if found and found:IsA("RemoteFunction") then found else nil
end
function FusionMenu.available(): boolean return remote() ~= nil end

-- InvokeServer wrapped with pcall + timeout. nil means "no answer" (retry-safe).
local function call(payload, timeout: number?)
    local fn = remote()
    if not fn then return {ok = false, reason = "unavailable"} end
    local done, response = false, nil
    task.spawn(function()
        local ok, result = pcall(function() return (fn :: RemoteFunction):InvokeServer(payload) end)
        if ok then response = result end
        done = true
    end)
    local started = os.clock()
    while not done and os.clock() - started &lt; (timeout or FusionMenu.RequestTimeout) do task.wait(.05) end
    return response
end

-- Module-level so a confirmed-but-unanswered attempt survives closing the menu.
local pendingAttempt = nil
local fuseInFlight = false
local unseenResult = nil -- committed while the menu was closed; shown on re-open

local state = {
    open = false, mode = "browse", targetStage = "gold", dinos = {}, byId = {}, nextCursor = nil,
    listError = nil, loading = false, selection = {}, filters = {}, sortKey = "eligible",
    visible = FusionMenu.CardBatch, quote = nil, quoteKey = nil, quoteStatus = "idle", quoteMessage = "",
    quoteSerial = 0, viewSerial = 0, acknowledged = false,
}

local gui: ScreenGui? = nil
local panel: Frame? = nil
local body: Frame? = nil
local titleLabel: TextLabel? = nil
local cards = {}
local column = {}

local function motion(): boolean return Theme.MotionEnabled ~= false end

local toastSerial = 0
local toastLabel: TextLabel? = nil
local function toast(text: string, color: Color3?)
    if not toastLabel then return end
    local label = toastLabel :: TextLabel
    toastSerial += 1
    local serial = toastSerial
    label.Text, label.TextColor3, label.Visible = text, color or C.text, true
    task.delay(3.2, function() if serial == toastSerial then label.Visible = false end end)
end

local function ensureGui()
    if gui then return end
    local screen = Instance.new("ScreenGui")
    screen.Name, screen.ResetOnSpawn, screen.DisplayOrder, screen.Enabled = "BeDinoFusionUI", false, 20, false
    screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pcall(function() (screen :: any).ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets end)
    screen.Parent = player:WaitForChild("PlayerGui")
    local scrim = Instance.new("TextButton")
    scrim.Name, scrim.Text, scrim.AutoButtonColor, scrim.Size = "FusionScrim", "", false, UDim2.fromScale(1, 1)
    scrim.BackgroundColor3, scrim.BackgroundTransparency = Color3.new(0, 0, 0), .42
    scrim.Parent = screen
    local frame = W.box(scrim, UDim2.fromScale(.97, .95), UDim2.fromScale(.5, .5), C.panel, 8)
    frame.Name, frame.AnchorPoint, frame.Active = "FusionPanel", Vector2.new(.5, .5), true
    local limit = Instance.new("UISizeConstraint")
    limit.MaxSize, limit.Parent = Vector2.new(1180, 680), frame
    local header = W.box(frame, UDim2.new(1, -8, 0, T + 8), UDim2.fromOffset(4, 4), C.purple)
    titleLabel = W.label(header, "Pattern Fusion", UDim2.new(1, -(T * 2 + 28), 1, -8), UDim2.fromOffset(12, 4), 30, nil, true)
    W.button(header, "X", UDim2.new(0, T + 16, 0, T), UDim2.new(1, -(T + 20), 0, 4), C.red, function() FusionMenu.close() end)
    local content = Instance.new("Frame")
    content.Name, content.BackgroundTransparency, content.ClipsDescendants = "FusionBody", 1, true
    content.Size, content.Position = UDim2.new(1, -16, 1, -(T + 22)), UDim2.fromOffset(8, T + 16)
    content.Parent = frame
    local note = W.label(frame, "", UDim2.new(.7, 0, 0, 32), UDim2.new(.15, 0, 1, -40), 20)
    note.Name, note.Visible, note.BackgroundTransparency, note.BackgroundColor3 = "FusionToast", false, .15, C.outline
    note.ZIndex = 10
    toastLabel = note
    gui, panel, body = screen, frame, content
    Input.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == Enum.KeyCode.Escape and state.open then FusionMenu.close() end
    end)
end

local function setTitle(text: string, color: Color3?)
    if titleLabel then
        titleLabel.Text = text
        local header = titleLabel.Parent :: Frame
        header.BackgroundColor3 = color or C.purple
    end
end

local function clearBody()
    state.viewSerial += 1
    cards, column = {}, {}
    if body then (body :: Frame):ClearAllChildren() end
end

local render: () -&gt; () = function() end

-- Data ------------------------------------------------------------------------------
local function pruneSelection()
    local kept = {}
    for _, id in state.selection do
        local d = state.byId[id]
        if d then
            local ctx = Sel.context(state.targetStage, kept, state.byId, nil)
            if Sel.ineligibility(d, ctx) == nil then table.insert(kept, id) end
        end
    end
    state.selection = kept
end

local scheduleQuote: () -&gt; () = function() end

local function loadList(after: (() -&gt; ())?)
    state.loading, state.listError = true, nil
    task.spawn(function()
        local all, cursor, pages = {}, nil, 0
        repeat
            local response = call({action = "list", cursor = cursor, limit = FusionMenu.PageSize})
            if type(response) ~= "table" or response.ok ~= true or type(response.dinosaurs) ~= "table" then
                state.loading = false
                state.listError = if type(response) == "table" then tostring(response.reason or "unknown") else "request_failed"
                if state.listError == "fusion_disabled" or state.listError == "unavailable" or state.listError == "identity_unavailable" or state.listError == "random_items_unavailable" then state.mode = "unavailable" end
                if state.open then render() end
                return
            end
            for _, d in response.dinosaurs do if type(d) == "table" and type(d.instanceId) == "string" then table.insert(all, d) end end
            cursor = response.nextCursor
            pages += 1
        until cursor == nil or pages &gt;= FusionMenu.MaxListPages
        state.dinos, state.byId, state.nextCursor, state.loading = all, Sel.index(all), cursor, false
        pruneSelection()
        if after then after() end
        if state.open then render() scheduleQuote() end
    end)
end

local function currentKey(): string
    return Sel.requestKey(state.targetStage, state.selection, "")
end

local updateColumn: () -&gt; () = function() end

scheduleQuote = function()
    state.quoteSerial += 1
    local serial = state.quoteSerial
    state.quote, state.quoteKey, state.acknowledged = nil, nil, false
    local recipe = Sel.stage(state.targetStage)
    if not recipe or not recipe.approved then
        state.quoteStatus, state.quoteMessage = "locked", Sel.LockedStageText
    elseif #state.selection ~= recipe.donorCount then
        -- Quotes are requested at EXACTLY the recipe count (15 / 4 / 2).
        state.quoteStatus = "need"
        state.quoteMessage = if #state.selection &lt; recipe.donorCount
            then "Select " .. (recipe.donorCount - #state.selection) .. " more matching dinos to see exact odds."
            else "Too many dinos selected: remove " .. (#state.selection - recipe.donorCount) .. "."
    else
        state.quoteStatus, state.quoteMessage = "loading", "Calculating exact odds for these " .. recipe.donorCount .. " dinos..."
        local key, donors, stage = currentKey(), table.clone(state.selection), state.targetStage
        task.delay(FusionMenu.QuoteDebounce, function()
            if serial ~= state.quoteSerial then return end
            local response = call({action = "quote", targetStage = stage, donorIds = donors})
            if serial ~= state.quoteSerial or key ~= currentKey() then return end
            if type(response) == "table" and response.ok == true and type(response.quote) == "table"
                and Sel.requestKey(stage, response.quote.donorIds or {}, "") ~= key then
                state.quoteStatus, state.quoteMessage = "error", "The server quoted different dinos. Please reselect."
            elseif type(response) == "table" and response.ok == true and type(response.quote) == "table" then
                local formatted = Sel.formatOdds(response.quote.odds, catalog)
                if formatted.ok then
                    state.quote, state.quoteKey, state.quoteStatus = response.quote, key, "ready"
                    state.quoteMessage = ""
                else
                    state.quoteStatus, state.quoteMessage = "error", "Odds could not be read (" .. tostring(formatted.error) .. "). Fusion is disabled until they are."
                end
            else
                local reason = if type(response) == "table" then response.reason else "request_failed"
                state.quoteStatus, state.quoteMessage = "error", Sel.failureMessage(reason)
                if reason == "fusion_disabled" or reason == "unavailable" then state.mode = "unavailable" render() return end
                if reason == "donor_missing" or reason == "donor_locked" or reason == "stale_quote" then
                    loadList()
                end
            end
            if state.open and state.mode == "browse" then updateColumn() end
        end)
    end
    if state.open and state.mode == "browse" then updateColumn() end
end

-- Browse screen ----------------------------------------------------------------------
local function filterValueName(field: string, value): string
    if value == nil then return "All" end
    if field == "speciesId" then return Sel.name(catalog, "species", value) end
    if field == "patternId" then return Sel.name(catalog, "patterns", value) end
    if field == "colorId" then return Sel.name(catalog, "colors", value) end
    if field == "conditionId" then return Sel.name(catalog, "conditions", value) end
    if field == "mutationId" then return if value == "none" then "None" else Sel.name(catalog, "mutations", value) end
    if field == "shiny" or field == "big" then return if value then "Yes" else "No" end
    if field == "originKind" then return ({hatch = "Hatched", fusion = "Fused", legacy_unknown = "Older"})[value] or tostring(value) end
    if field == "cosmetics" then return ({has = "Owns FX", none = "No FX", equipped = "Equipped"})[value] or tostring(value) end
    if field == "stage" then return Sel.name(nil, "x", value) end
    return tostring(value)
end
local FilterLabels = {speciesId = "Species", patternId = "Pattern", stage = "Stage", colorId = "Color", conditionId = "Condition",
    shiny = "Shiny", big = "BIG", mutationId = "Mutation", originKind = "Origin", cosmetics = "Cosmetics"}

local function cardLook(d)
    local entry = cards[d.instanceId]
    if not entry then return end
    local selected = table.find(state.selection, d.instanceId) ~= nil
    local ctx = Sel.context(state.targetStage, state.selection, state.byId, state.filters)
    local reason = if selected then nil else Sel.ineligibility(d, ctx)
    local valuable = #Sel.valuableReasons(d) &gt; 0
    entry.stroke.Color = if selected then (if valuable then C.purple else C.gold) else C.outline
    entry.stroke.Thickness = if selected then 5 else 3
    entry.button.BackgroundColor3 = if reason then C.outline else (W.StageColors[d.stage] or C.card)
    entry.status.Text = if selected then (if valuable then "SELECTED (VALUABLE)" else "SELECTED")
        elseif reason then (Sel.ReasonText[reason] or reason)
        elseif valuable then "Valuable: tap to add" else "Tap to add"
    entry.status.TextColor3 = if selected then C.gold elseif reason then C.red elseif valuable then C.purple else C.accent
end

local function refreshCards()
    for _, d in state.dinos do cardLook(d) end
end

local openDetails: (string) -&gt; () = function() end

local function toggle(d)
    local nextSelection, ok, reason = Sel.toggle(state.selection, d, state.targetStage, state.byId)
    if not ok then toast(Sel.ReasonText[reason] or tostring(reason), C.red) return end
    state.selection = nextSelection
    refreshCards()
    scheduleQuote()
end

local function buildGrid(grid: ScrollingFrame)
    for _, child in grid:GetChildren() do if not child:IsA("UIGridLayout") then child:Destroy() end end
    cards = {}
    local ctx = Sel.context(state.targetStage, state.selection, state.byId, state.filters)
    local list = Sel.sort(Sel.filter(state.dinos, state.filters), state.sortKey, ctx, Sel.selectedSet(state.selection), catalog)
    for i, d in list do
        if i &gt; state.visible then
            local more = W.button(grid, "SHOW MORE (" .. (#list - state.visible) .. ")", UDim2.new(), UDim2.new(), C.blue, function()
                state.visible += FusionMenu.CardBatch
                buildGrid(grid)
            end)
            more.LayoutOrder = i
            break
        end
        local g = d.genes or {}
        local card = Instance.new("TextButton")
        card.Name, card.Text, card.AutoButtonColor, card.LayoutOrder = "Dino_" .. i, "", false, i
        card.BackgroundColor3 = W.StageColors[d.stage] or C.card
        Theme.decorate(card, 6)
        card.Parent = grid
        card.Activated:Connect(function() toggle(d) end)
        W.label(card, Sel.name(catalog, "species", d.speciesId), UDim2.new(1, -8, 0, 20), UDim2.fromOffset(4, 3), 18)
        W.label(card, Sel.name(catalog, "patterns", g.patternId, "Unknown pattern") .. " • " .. Sel.name(nil, "x", d.stage), UDim2.new(1, -8, 0, 16), UDim2.fromOffset(4, 24), 14, C.gold)
        W.swatch(card, g, UDim2.new(1, -16, 0, 9), UDim2.fromOffset(8, 43))
        local badges = Sel.badges(d, catalog)
        W.label(card, (if #badges &gt; 0 then table.concat(badges, " • ") else Sel.name(catalog, "conditions", g.conditionId, "")), UDim2.new(1, -8, 0, 18), UDim2.fromOffset(4, 55), 15,
            if #badges &gt; 0 then C.purple else C.text)
        local status = W.label(card, "", UDim2.new(1, -(T + 8), 0, T - 4), UDim2.new(0, 4, 1, -(T + 2)), 15)
        local info = W.button(card, "i", UDim2.fromOffset(T, T), UDim2.new(1, -(T + 2), 1, -(T + 2)), C.blue, function() openDetails(d.instanceId) end)
        info.Name = "Details"
        local stroke = card:FindFirstChildOfClass("UIStroke") :: UIStroke
        cards[d.instanceId] = {button = card, stroke = stroke, status = status}
        cardLook(d)
    end
    if #list == 0 then
        local empty = W.label(grid, if state.loading then "Loading your dinos..." else "No dinos match these filters.", UDim2.new(), UDim2.new(), 20, C.gold)
        empty.LayoutOrder = 0
    end
end

updateColumn = function()
    local col = column
    if not col.slots then return end
    for _, child in col.slots:GetChildren() do if not child:IsA("UIGridLayout") then child:Destroy() end end
    local recipe = Sel.stage(state.targetStage)
    local need = (recipe and recipe.donorCount) or 0
    local stageName = if recipe then recipe.name else "?"
    local counterMode = need &gt; Sel.CompactSlotThreshold
    local slotLayout = col.slots:FindFirstChildOfClass("UIGridLayout")
    if slotLayout then
        -- One row of up to 10 slots (compact strip) or two rows of 5; 3 slots use thirds.
        local perRow = if counterMode then 1 elseif col.compact then math.max(need, 1) else math.max(math.min(need, 5), 1)
        local rows = if counterMode or col.compact then 1 else math.ceil(need / perRow)
        local height = col.slotsHeight or 40
        slotLayout.CellSize = if counterMode then UDim2.fromScale(1, 1)
            else UDim2.new(1 / perRow, -4, 0, math.max(18, math.floor(height / rows) - 6))
    end
    if counterMode then
        -- 15-donor Gold: a compact n/N progress counter (Android landscape safe); the
        -- selected dinos stay highlighted in the grid and a tap there removes them.
        local bar = W.box(col.slots, UDim2.new(), UDim2.new(), C.outline, 4)
        bar.Name = "Counter"
        local fill = W.box(bar, UDim2.fromScale(math.clamp(#state.selection / need, 0, 1), 1), UDim2.new(),
            if #state.selection == need then C.accent else C.gold, 4)
        fill.Name = "Fill"
        local counter = W.label(bar, string.format("%d/%d selected • tap a dino card to remove", #state.selection, need),
            UDim2.fromScale(1, 1), UDim2.new(), 16, C.text, true)
        counter.Name = "CounterText"
    end
    for i = 1, if counterMode then 0 else need do
        local id = state.selection[i]
        local d = id and state.byId[id]
        if d and col.compact then
            -- Phone landscape: slots are a compact read-only strip; tap the dino card to remove.
            local chip = W.box(col.slots, UDim2.new(), UDim2.new(), if #Sel.valuableReasons(d) &gt; 0 then C.purple else C.card, 3)
            chip.LayoutOrder = i
            W.swatch(chip, d.genes, UDim2.new(1, -4, 0, 6), UDim2.new(0, 2, 1, -8))
        elseif d then
            local slot = W.button(col.slots, string.sub(Sel.name(catalog, "species", d.speciesId), 1, 4), UDim2.new(), UDim2.new(), if #Sel.valuableReasons(d) &gt; 0 then C.purple else C.card, function() toggle(d) end)
            slot.LayoutOrder = i
            W.swatch(slot, d.genes, UDim2.new(1, -8, 0, 5), UDim2.new(0, 4, 1, -9))
        else
            local empty = W.box(col.slots, UDim2.new(), UDim2.new(), C.outline, 4)
            empty.LayoutOrder = i
            W.label(empty, tostring(i), UDim2.fromScale(1, 1), UDim2.new(), 16, Color3.fromRGB(120, 120, 140))
        end
    end
    local h = Sel.histogram(state.selection, state.byId)
    col.count.Text = string.format("INGREDIENTS %d/%d", #state.selection, need)
    local parts = {string.format("%d Shiny / %d", h.shiny, need), string.format("%d BIG", h.big)}
    for id, n in h.mutations do table.insert(parts, Sel.name(catalog, "mutations", id) .. " x" .. n) end
    if h.cosmetics &gt; 0 then table.insert(parts, h.cosmetics .. " with bought FX (lost)") end
    col.histogram.Text = table.concat(parts, " • ")
    local odds = col.odds :: ScrollingFrame
    for _, child in odds:GetChildren() do if not child:IsA("UIListLayout") then child:Destroy() end end
    local order = 0
    local function line(text: string, color: Color3?, height: number?)
        order += 1
        local l = W.label(odds, text, UDim2.new(1, -12, 0, height or 24), UDim2.new(), 18, color, true)
        l.LayoutOrder = order
    end
    if not (recipe and recipe.approved) then
        line(string.upper(state.targetStage) .. " LOCKED", C.gold, 30)
        line(Sel.LockedStageText .. ".", nil, 44)
    else
        line("UPGRADED (guaranteed): 1 NEW " .. stageName .. " from " .. need .. " " .. Sel.stageTitle(recipe.source) .. ", stage + stats", C.accent, 40)
        if state.selection[1] and state.byId[state.selection[1]] then
            local g = state.byId[state.selection[1]].genes or {}
            line("PATTERN LOCKED: " .. Sel.name(catalog, "patterns", g.patternId), C.gold)
        end
        line("ROLLED (exact odds from the server):", C.blue)
        if state.quoteStatus == "ready" and state.quote then
            local formatted = Sel.formatOdds(state.quote.odds, catalog)
            for _, section in formatted.sections do
                local texts = {}
                for _, row in section.rows do table.insert(texts, row.label .. " " .. row.text) end
                local text = section.title .. ": " .. table.concat(texts, " • ")
                line(text, nil, if #text &gt; 70 then 64 elseif #text &gt; 36 then 44 else 24)
            end
            line("Odds version " .. tostring(state.quote.oddsVersion) .. " • recipe " .. tostring(state.quote.recipeVersion), Color3.fromRGB(170, 170, 190))
        else
            line(state.quoteMessage, if state.quoteStatus == "error" then C.red else C.gold, 44)
        end
    end
    local ready = state.quoteStatus == "ready" and state.quote ~= nil and state.quoteKey == currentKey()
    col.fuse.BackgroundColor3 = if ready then C.accent else C.card
    col.fuse.Text = if ready then "REVIEW &amp; FUSE" else "FUSE (" .. #state.selection .. "/" .. need .. ")"
end

local function renderBrowse()
    local active = Sel.stage(state.targetStage)
    setTitle(if active then string.format("Pattern Fusion: %d %s -&gt; 1 NEW %s", active.donorCount, Sel.stageTitle(active.source), active.name)
        else "Pattern Fusion", C.purple)
    local root = body :: Frame
    local left = Instance.new("Frame")
    left.Name, left.BackgroundTransparency, left.Size, left.Parent = "Browse", 1, UDim2.new(.6, -6, 1, 0), root
    local right = W.box(root, UDim2.new(.4, -6, 1, 0), UDim2.new(.6, 6, 0, 0), C.card, 6)
    right.Name = "Ingredients"
    -- Row 1: target stage tabs + sort + auto-fill.
    local tabs = {}
    for _, s in Sel.Stages do
        table.insert(tabs, {s.id, string.upper(s.name) .. (if s.approved then " (" .. s.donorCount .. ")" else " (LOCKED)")})
    end
    for i, tab in tabs do
        local stage = Sel.stage(tab[1])
        local b = W.button(left, tab[2], UDim2.new(.17, -4, 0, T), UDim2.new((i - 1) * .17, 0, 0, 0),
            if state.targetStage == tab[1] then (W.StageColors[tab[1]] or C.gold) elseif stage and stage.approved then C.card else C.outline, function()
                if state.targetStage == tab[1] then return end
                state.targetStage = tab[1]
                if not (stage and stage.approved) then toast(string.upper(tab[2]) .. ": " .. Sel.LockedStageText, C.gold) end
                state.selection = {}
                render()
                scheduleQuote()
            end)
        b.Name = "Stage_" .. tab[1]
    end
    W.button(left, "SORT: " .. string.upper(Sel.SortNames[state.sortKey]), UDim2.new(.25, -4, 0, T), UDim2.new(.51, 0, 0, 0), C.blue, function()
        local i = table.find(Sel.SortKeys, state.sortKey) or 1
        state.sortKey = Sel.SortKeys[i % #Sel.SortKeys + 1]
        render()
    end)
    W.button(left, "AUTO-FILL PLAIN", UDim2.new(.24, 0, 0, T), UDim2.new(.76, 0, 0, 0), C.accent, function()
        local filled, added, short = Sel.autoFill(state.dinos, state.selection, state.targetStage, state.filters, catalog)
        state.selection = filled
        if added == 0 then toast("No plain matching dinos to add. Valuable dinos are never auto-filled.", C.gold)
        elseif short &gt; 0 then toast("Added " .. added .. " plain dinos; " .. short .. " more needed.", C.gold)
        else toast("Added " .. added .. " plain dinos. Valuables were skipped.", C.accent) end
        refreshCards()
        scheduleQuote()
    end)
    -- Row 2: cycling filter chips (horizontal scroll for small screens).
    local chips = Instance.new("ScrollingFrame")
    chips.Name, chips.BackgroundTransparency, chips.BorderSizePixel = "Filters", 1, 0
    chips.Size, chips.Position, chips.ScrollingDirection = UDim2.new(1, 0, 0, T + 8), UDim2.fromOffset(0, T + 6), Enum.ScrollingDirection.X
    chips.ScrollBarThickness, chips.AutomaticCanvasSize, chips.CanvasSize = 4, Enum.AutomaticSize.X, UDim2.new()
    chips.Parent = left
    W.list(chips, 6, true)
    local options = Sel.filterOptions(state.dinos, catalog)
    local reset = W.button(chips, "RESET", UDim2.fromOffset(84, T), UDim2.new(), C.red, function()
        state.filters, state.visible = {}, FusionMenu.CardBatch
        render()
    end)
    reset.LayoutOrder = 0
    for i, field in Sel.FilterFields do
        local value = state.filters[field]
        local chip = W.button(chips, FilterLabels[field] .. ": " .. filterValueName(field, value), UDim2.fromOffset(150, T), UDim2.new(),
            if value ~= nil then C.blue else C.card, function()
                state.filters[field] = Sel.cycle(options[field] or {}, state.filters[field])
                state.visible = FusionMenu.CardBatch
                render()
            end)
        chip.LayoutOrder = i
    end
    -- Grid of individual dinos.
    local grid = W.scroll(left, UDim2.new(1, 0, 1, -(T * 2 + 20)), UDim2.fromOffset(0, T * 2 + 20))
    grid.Name = "DinoGrid"
    local layout = Instance.new("UIGridLayout")
    local small = gui ~= nil and (gui :: ScreenGui).AbsoluteSize.Y &lt; 520
    layout.CellSize = if small then UDim2.fromOffset(118, 124) else UDim2.fromOffset(146, 132)
    layout.CellPadding, layout.SortOrder = UDim2.fromOffset(6, 6), Enum.SortOrder.LayoutOrder
    layout.Parent = grid
    if state.listError and state.mode == "browse" then
        W.label(grid, "Could not load dinos: " .. Sel.failureMessage(state.listError), UDim2.new(), UDim2.new(), 20, C.red)
        W.button(grid, "RETRY", UDim2.new(), UDim2.new(), C.blue, function() loadList() render() end)
    else
        buildGrid(grid)
    end
    -- Right column: slots, histogram, odds, fuse.
    -- Compact layout for short (phone landscape) safe areas: one read-only slot strip.
    local compact = gui ~= nil and (gui :: ScreenGui).AbsoluteSize.Y &lt; 450
    column.compact = compact
    local slotsHeight = if compact then 26 else T * 2 + 6
    column.slotsHeight = slotsHeight
    local slotsBottom = T + 6 + slotsHeight
    column.count = W.label(right, "", UDim2.new(1, -100, 0, T), UDim2.fromOffset(6, 2), 24, C.gold, true)
    W.button(right, "CLEAR", UDim2.fromOffset(84, T), UDim2.new(1, -88, 0, 2), C.red, function()
        state.selection = {}
        refreshCards()
        scheduleQuote()
    end).Name = "Clear"
    local slots = Instance.new("Frame")
    slots.Name, slots.BackgroundTransparency, slots.Size, slots.Position = "Slots", 1, UDim2.new(1, -12, 0, slotsHeight), UDim2.fromOffset(6, T + 6)
    slots.Parent = right
    local slotLayout = Instance.new("UIGridLayout")
    slotLayout.CellSize = if compact then UDim2.new(.1, -3, 0, slotsHeight) else UDim2.new(.2, -5, 0, T)
    slotLayout.CellPadding, slotLayout.SortOrder = if compact then UDim2.fromOffset(3, 0) else UDim2.fromOffset(5, 6), Enum.SortOrder.LayoutOrder
    slotLayout.Parent = slots
    column.slots = slots
    column.histogram = W.label(right, "", UDim2.new(1, -12, 0, 20), UDim2.fromOffset(6, slotsBottom + 2), 16, C.text, true)
    local odds = W.scroll(right, UDim2.new(1, -12, 1, -(slotsBottom + 26 + T + 14)), UDim2.fromOffset(6, slotsBottom + 24))
    odds.Name = "Odds"
    W.list(odds, 2)
    column.odds = odds
    column.fuse = W.button(right, "FUSE", UDim2.new(1, -12, 0, T + 4), UDim2.new(0, 6, 1, -(T + 10)), C.card, function()
        local ready = state.quoteStatus == "ready" and state.quote ~= nil and state.quoteKey == currentKey()
        if not ready then
            toast(if state.quoteStatus == "loading" then "Odds are still loading." else state.quoteMessage, C.gold)
            return
        end
        state.mode, state.acknowledged = "confirm", false
        render()
    end)
    column.fuse.Name = "Fuse"
    updateColumn()
end

-- Confirmation -------------------------------------------------------------------
local runFuse: (any) -&gt; () = function() end

local function donorLine(d): string
    local g = d.genes or {}
    local badges = Sel.badges(d, catalog)
    return Sel.name(catalog, "patterns", g.patternId) .. " " .. Sel.name(catalog, "species", d.speciesId) .. " • "
        .. Sel.geneLine(g, catalog) .. " • " .. Sel.name(catalog, "conditions", g.conditionId, "?")
        .. (if #badges &gt; 0 then " • " .. table.concat(badges, ", ") else "")
end

local function renderConfirm()
    local quote = state.quote
    if not quote or state.quoteKey ~= currentKey() then state.mode = "browse" render() return end
    local recipe = Sel.stage(quote.targetStage or state.targetStage)
    local stageName = if recipe then recipe.name else "?"
    local donorTotal = #(quote.donorIds or state.selection)
    setTitle("Confirm " .. stageName .. " Fusion (no undo)", C.gold)
    local root = body :: Frame
    local loss = Sel.lossSummary(quote, catalog)
    local list = W.scroll(root, UDim2.new(1, 0, 1, -(T + 14)), UDim2.new())
    W.list(list, 3)
    local order = 0
    local function line(text: string, color: Color3?, height: number?)
        order += 1
        local l = W.label(list, text, UDim2.new(1, -14, 0, height or (if #text &gt; 80 then 48 else 26)), UDim2.new(), 20, color, true)
        l.LayoutOrder = order
    end
    line("GUARANTEED: 1 NEW " .. stageName .. " " .. Sel.name(catalog, "patterns", quote.patternId) .. " " .. Sel.name(catalog, "species", quote.speciesId)
        .. " with the " .. stageName .. " stage upgrade. Its colors, condition, Shiny, BIG and mutation are freshly rolled.", C.accent, 48)
    line("PATTERN LOCKED: " .. Sel.name(catalog, "patterns", quote.patternId), C.gold)
    line("ALL " .. donorTotal .. " DINOS BELOW ARE CONSUMED:", C.red)
    for i, id in quote.donorIds or state.selection do
        local d = state.byId[id]
        line(i .. ". " .. (if d then donorLine(d) else id), if d and #Sel.valuableReasons(d) &gt; 0 then C.purple else nil)
    end
    line(loss.cosmeticText, if loss.auraCount + loss.trailCount &gt; 0 then C.red else C.text, 48)
    if #loss.valuables &gt; 0 then
        local parts = {}
        for _, v in loss.valuables do
            local d = state.byId[v.instanceId]
            table.insert(parts, (if d then Sel.name(catalog, "species", d.speciesId) else "Dino") .. " (" .. v.text .. ")")
        end
        line("Valuable donors consumed: " .. table.concat(parts, ", "), C.purple, 48)
    end
    line("EXACT ROLL ODDS FOR THIS SELECTION:", C.blue)
    for _, section in Sel.formatOdds(quote.odds, catalog).sections do
        local texts = {}
        for _, row in section.rows do table.insert(texts, row.label .. " " .. row.text) end
        line(section.title .. ": " .. table.concat(texts, " • "), nil, 48)
    end
    line("Odds version " .. tostring(quote.oddsVersion) .. " • recipe " .. tostring(quote.recipeVersion) .. ". Wheels after fusion only reveal the saved result.", Color3.fromRGB(170, 170, 190), 48)
    local needs = loss.needsConfirm
    local y = UDim2.new(0, 0, 1, -(T + 6))
    W.button(root, "CANCEL", UDim2.new(.3, -6, 0, T + 4), y, C.red, function() state.mode = "browse" render() end)
    if needs and not state.acknowledged then
        W.button(root, "I UNDERSTAND: " .. (loss.auraCount + loss.trailCount) .. " FX + " .. #loss.valuables .. " VALUABLE LOST", UDim2.new(.7, 0, 0, T + 4), UDim2.new(.3, 0, 1, -(T + 6)), C.gold, function()
            state.acknowledged = true
            render()
        end).Name = "Acknowledge"
    else
        W.button(root, "FUSE NOW (CONSUMES " .. donorTotal .. ")", UDim2.new(.7, 0, 0, T + 4), UDim2.new(.3, 0, 1, -(T + 6)), C.accent, function()
            if state.quoteKey ~= currentKey() then state.mode = "browse" render() return end
            local attempt = Sel.attempt(pendingAttempt, state.targetStage, quote.donorIds or state.selection, quote.quoteDigest, function()
                return Http:GenerateGUID(false)
            end)
            attempt.consentDigest = if quote.consentRequired then quote.consentDigest else nil
            attempt.quote = quote
            pendingAttempt = attempt
            runFuse(attempt)
        end).Name = "FuseNow"
    end
end

-- Fuse + retries -----------------------------------------------------------------
local startReveal: (any, any, string) -&gt; () = function() end

local function renderStatus(text: string, color: Color3?, buttons)
    clearBody()
    local root = body :: Frame
    W.label(root, text, UDim2.new(1, -40, .5, 0), UDim2.fromScale(0, .1) + UDim2.fromOffset(20, 0), 28, color or C.gold)
    for i, b in buttons or {} do
        W.button(root, b[1], UDim2.new(.3, 0, 0, T + 8), UDim2.new(.02 + (i - 1) * .34, 0, .7, 0), b[2], b[3]).Name = b[4] or b[1]
    end
end

runFuse = function(attempt)
    if fuseInFlight then return end
    fuseInFlight = true
    state.mode = "fusing"
    setTitle("Fusing...", C.gold)
    renderStatus("Fusing your " .. #attempt.donorIds .. " dinos...\nThis request is saved: retries reuse the same token, so it can never fuse twice.", C.gold)
    task.spawn(function()
        local tries = 0
        while true do
            tries += 1
            local response = call({action = "fuse", token = attempt.token, targetStage = attempt.targetStage,
                donorIds = attempt.donorIds, quoteDigest = attempt.quoteDigest, consentDigest = attempt.consentDigest})
            local outcome = Sel.settle(attempt, response)
            if outcome.kind == "success" then
                fuseInFlight = false
                pendingAttempt = nil
                state.selection = {}
                if state.open then startReveal(attempt.quote, outcome.result, outcome.status)
                else unseenResult = outcome.result end
                loadList()
                return
            elseif outcome.kind == "retry" and tries &lt; FusionMenu.AutoRetries and outcome.reason ~= "lease_lost" then
                if state.open then renderStatus(outcome.message .. "\n(attempt " .. (tries + 1) .. ")", C.gold) end
                task.wait(2 ^ tries)
            elseif outcome.kind == "retry" then
                fuseInFlight = false
                if not state.open then state.mode = "browse" return end
                renderStatus(outcome.message, C.red, {
                    {"RETRY (SAME REQUEST)", C.accent, function() runFuse(attempt) end, "Retry"},
                    {"BACK", C.blue, function() state.mode = "browse" loadList() render() end, "Back"},
                })
                return
            else
                fuseInFlight = false
                pendingAttempt = nil
                state.mode = if outcome.reason == "fusion_disabled" then "unavailable" else "browse"
                if state.open then render() toast(outcome.message, C.red) end
                if outcome.kind == "requote" then loadList() end
                return
            end
        end
    end)
end

-- Reveal ---------------------------------------------------------------------------
local reelPalette = {C.blue, C.purple, C.accent, C.gold, Color3.fromRGB(255, 120, 80), Color3.fromRGB(110, 120, 150)}

local function reel(parent: Instance, stage, animate: boolean)
    local frame = W.box(parent, UDim2.new(1, -24, 0, 70), UDim2.new(0, 12, .34, 0), C.outline, 6)
    frame.ClipsDescendants, frame.Name = true, "Reel"
    local strip = Instance.new("Frame")
    strip.BackgroundTransparency, strip.Size, strip.Position, strip.Parent = 1, UDim2.fromScale(1, 1), UDim2.fromScale(.5, 0), frame
    local unit = 1.5
    local total = 0
    for _, seg in stage.segments do total = math.max(total, seg.to) end
    for k = 0, FusionMenu.ReelTurns + 1 do
        for i, seg in stage.segments do
            if seg.p &gt; 0 then
                local block = Instance.new("Frame")
                block.BorderSizePixel = 0
                block.Position = UDim2.fromScale((k + seg.from / total) * unit, 0)
                block.Size = UDim2.fromScale(seg.p / total * unit, 1)
                block.BackgroundColor3 = if stage.trait == "primaryColor" or stage.trait == "secondaryColor" then W.colorOf(seg.id) else reelPalette[(i - 1) % #reelPalette + 1]
                local edge = Instance.new("UIStroke")
                edge.Color, edge.Thickness, edge.Parent = C.outline, 2, block
                block.Parent = strip
                if seg.p / total * unit &gt; .1 then
                    W.label(block, seg.label .. "\n" .. (math.floor(seg.p * 1000 + .5) / 10) .. "%", UDim2.fromScale(1, 1), UDim2.new(), 16)
                end
            end
        end
    end
    local pointer = Instance.new("Frame")
    pointer.Size, pointer.AnchorPoint, pointer.Position = UDim2.new(0, 6, 1, 8), Vector2.new(.5, .5), UDim2.fromScale(.5, .5)
    pointer.BackgroundColor3, pointer.BorderSizePixel, pointer.Parent = C.gold, 0, frame
    local goal = UDim2.fromScale(.5 - Sel.reelOffset(stage, FusionMenu.ReelTurns) * unit, 0)
    if animate then
        local tween = TweenService:Create(strip, TweenInfo.new(FusionMenu.ReelSeconds, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = goal})
        tween:Play()
    else
        strip.Position = goal
    end
end

local function finalCard(root: Frame, result, stage)
    local traits = result.traits or {}
    local g = traits.genes or {}
    local card = W.box(root, UDim2.new(.42, 0, .8, 0), UDim2.new(.03, 0, .04, 0), W.StageColors[result.targetStage or "gold"] or C.gold, 8)
    local view = Preview.add(card, result.speciesId or "compy", result.targetStage or "gold")
    view.Size, view.Position = UDim2.fromScale(1, .9), UDim2.fromScale(0, .05)
    PreviewTraits.add(view, {shiny = traits.shiny, big = traits.big})
    local info = W.scroll(root, UDim2.new(.52, 0, .8, 0), UDim2.new(.47, 0, .04, 0))
    W.list(info, 3)
    local order = 0
    local function line(text: string, color: Color3?)
        order += 1
        W.label(info, text, UDim2.new(1, -12, 0, if #text &gt; 44 then 46 else 28), UDim2.new(), 22, color, true).LayoutOrder = order
    end
    line(stage.title, C.gold)
    line("Crafted " .. Sel.stageTitle(result.targetStage or "gold") .. " (earned) • guaranteed stage", C.accent)
    line("Pattern (locked): " .. Sel.name(catalog, "patterns", result.patternId or g.patternId))
    line("Colors: " .. Sel.geneLine(g, catalog))
    line("Condition: " .. Sel.name(catalog, "conditions", g.conditionId, "?"))
    line("Shiny: " .. (if traits.shiny then "YES" else "No") .. " • BIG: " .. (if traits.big then "YES" else "No"))
    line("Mutation: " .. Sel.name(catalog, "mutations", traits.mutationId, "None"))
    line("Bought cosmetics: none (buy separately for this new dino)")
    line("Odds version " .. tostring(result.oddsVersion or "?"), Color3.fromRGB(170, 170, 190))
    if stage.replay then line("Already fused: showing your saved result.", C.blue) end
end

startReveal = function(quote, result, status)
    state.mode = "reveal"
    Sfx.play("fusion_reveal")
    clearBody()
    local serial = state.viewSerial
    local root = body :: Frame
    -- Duplicate (re-open/retry) shows the committed result without replaying odds.
    local stages = Sel.revealSequence(if status == "duplicate" then nil else quote, result, catalog)
    local index = 0
    local content = Instance.new("Frame")
    content.BackgroundTransparency, content.Size, content.Parent = 1, UDim2.new(1, 0, 1, -(T + 12)), root
    local advance: () -&gt; ()
    local auto = true
    local function show(i: number)
        if serial ~= state.viewSerial then return end
        index = i
        content:ClearAllChildren()
        local stage = stages[i]
        setTitle(if stage.kind == "final" then "Fusion complete!" else "Revealing " .. i .. " / " .. (#stages - 1), C.gold)
        if stage.kind == "final" then
            finalCard(content, result, stage)
            return
        end
        W.label(content, stage.title, UDim2.new(1, 0, 0, 44), UDim2.fromScale(0, .06), 34, C.gold)
        if stage.kind == "pattern" then
            W.label(content, "PATTERN LOCKED: " .. string.upper(stage.value), UDim2.new(1, -40, 0, 60), UDim2.new(0, 20, .34, 0), 34, C.accent)
            W.label(content, "Same-pattern recipe: the pattern is never rolled.", UDim2.new(1, -40, 0, 34), UDim2.new(0, 20, .6, 0), 20)
        elseif stage.kind == "wheel" then
            local animate = motion() and auto
            reel(content, stage, animate)
            local valueLabel = W.label(content, "", UDim2.new(1, -40, 0, 48), UDim2.new(0, 20, .66, 0), 32, C.accent)
            local reveal = function()
                if valueLabel.Parent then valueLabel.Text = string.upper(tostring(stage.value)) .. (if stage.detail then "  (" .. stage.detail .. ")" else "") end
            end
            if animate then task.delay(FusionMenu.ReelSeconds, reveal) else reveal() end
        else
            -- Committed value outside the quoted table: state it plainly.
            W.label(content, string.upper(tostring(stage.value)), UDim2.new(1, -40, 0, 60), UDim2.new(0, 20, .36, 0), 34, C.accent)
        end
        if auto then
            local wait = if motion() then FusionMenu.ReelSeconds + .9 else .6
            task.delay(wait, function() if serial == state.viewSerial and index == i and auto then advance() end end)
        end
    end
    advance = function() if index &lt; #stages then show(index + 1) end end
    local y = UDim2.new(0, 0, 1, -(T + 6))
    W.button(root, "SKIP TO RESULT", UDim2.new(.32, -6, 0, T + 4), y, C.blue, function() auto = false show(#stages) end).Name = "Skip"
    W.button(root, "NEXT", UDim2.new(.32, -6, 0, T + 4), UDim2.new(.33, 0, 1, -(T + 6)), C.accent, function() auto = false advance() end).Name = "Next"
    W.button(root, "VIEW DETAILS", UDim2.new(.34, 0, 0, T + 4), UDim2.new(.66, 0, 1, -(T + 6)), C.purple, function()
        auto = false
        if type(result.resultId) == "string" then openDetails(result.resultId) end
    end).Name = "ResultDetails"
    show(1)
end

-- Other screens -----------------------------------------------------------------
openDetails = function(instanceId: string)
    local previous = state.mode
    state.mode = "details"
    setTitle("Dino Details", C.blue)
    DinoDetails.show(body :: Frame, instanceId, catalog, call, function()
        state.mode = if previous == "reveal" then "browse" else previous
        render()
    end)
end

local function renderUnavailable()
    setTitle("Fusion unavailable", C.card)
    renderStatus("Fusion unavailable\nPattern fusion is not enabled on this server yet. Nothing was changed.", C.gold,
        {{"CLOSE", C.red, function() FusionMenu.close() end, "Close"}})
end

local function renderResume()
    local attempt = pendingAttempt
    setTitle("Checking your last fusion", C.gold)
    renderStatus("Your last confirmed fusion did not get an answer.\nCHECK RESULT resends the SAME request: it either shows the saved result or finishes that one fusion. It never fuses twice.", C.gold, {
        {"CHECK RESULT", C.accent, function() if attempt then runFuse(attempt) end end, "CheckResult"},
        {"DISCARD", C.red, function() pendingAttempt = nil state.mode = "browse" render() end, "Discard"},
    })
end

render = function()
    if not state.open or not body then return end
    if state.mode == "reveal" or state.mode == "fusing" or state.mode == "details" then return end
    clearBody()
    if state.mode == "unavailable" or not FusionMenu.available() then renderUnavailable()
    elseif state.mode == "confirm" then renderConfirm()
    elseif state.mode == "resume" then renderResume()
    else state.mode = "browse" renderBrowse() end
end

function FusionMenu.open()
    ensureGui()
    state.open = true
    local screen = gui :: ScreenGui
    screen.Enabled = true
    if panel and motion() then
        local frame = panel :: Frame
        frame.Position = UDim2.fromScale(.5, .53)
        Theme.animate(frame, .16, {Position = UDim2.fromScale(.5, .5)})
    end
    if not FusionMenu.available() then state.mode = "unavailable" render() return end
    if fuseInFlight then
        state.mode = "fusing"
        renderStatus("Your fusion is still being saved...\nRetries reuse the same token, so it can never fuse twice.", C.gold)
        return
    elseif unseenResult then
        -- Committed while closed: show the saved result without replaying odds.
        local result = unseenResult
        unseenResult = nil
        startReveal(nil, result, "duplicate")
        loadList()
        return
    end
    state.mode = if pendingAttempt and pendingAttempt.state == "pending" then "resume" else "browse"
    render()
    loadList()
end

function FusionMenu.close()
    state.open = false
    state.quoteSerial += 1
    if state.mode ~= "fusing" then state.mode = "browse" end
    clearBody()
    if gui then (gui :: ScreenGui).Enabled = false end
end

function FusionMenu.isOpen(): boolean return state.open end

return FusionMenu
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX258">
          <Properties>
            <string name="Name">FusionWidgets</string>
            <ProtectedString name="Source">--!strict
-- Small relative-layout UI helpers for the BD-065 Fusion Menu and BD-062 Dino Details.
-- Matches the Bootstrap visual style (FredokaOne, outlined text, Theme.decorate) but
-- sizes with Scale/Offset + text constraints instead of one fixed 860x520 canvas, so
-- the same screens fit a phone in landscape. Touch targets use W.Touch (&gt;= 44 px).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.UITheme)
local ProgressionConfig = require(Shared.ProgressionConfig)
local C = Theme.Colors

local W = {}
W.Colors = C
W.Touch = 44

local function textConstraint(t: TextLabel | TextButton, maxSize: number)
    t.TextScaled = true
    local limit = Instance.new("UITextSizeConstraint")
    limit.MaxTextSize, limit.MinTextSize, limit.Parent = maxSize, 9, t
end

function W.label(parent: Instance, text: string, size: UDim2, position: UDim2, maxText: number?, color: Color3?, alignLeft: boolean?): TextLabel
    local t = Instance.new("TextLabel")
    t.BackgroundTransparency, t.Size, t.Position = 1, size, position
    t.Font, t.Text, t.TextColor3 = Enum.Font.FredokaOne, text, color or C.text
    t.TextStrokeTransparency, t.TextStrokeColor3, t.TextWrapped = 0, C.outline, true
    if alignLeft then t.TextXAlignment = Enum.TextXAlignment.Left end
    textConstraint(t, maxText or 22)
    local outline = Instance.new("UIStroke")
    outline.ApplyStrokeMode, outline.Color, outline.Thickness, outline.Parent = Enum.ApplyStrokeMode.Contextual, C.outline, 1.5, t
    t.Parent = parent
    return t
end

function W.box(parent: Instance, size: UDim2, position: UDim2, color: Color3, radius: number?): Frame
    local b = Instance.new("Frame")
    b.Size, b.Position, b.BackgroundColor3 = size, position, color
    Theme.decorate(b, radius or 5)
    b.Parent = parent
    return b
end

function W.button(parent: Instance, text: string, size: UDim2, position: UDim2, color: Color3, callback: () -&gt; ()): TextButton
    local b = Instance.new("TextButton")
    b.Size, b.Position, b.BackgroundColor3 = size, position, color
    b.Font, b.Text, b.TextColor3 = Enum.Font.FredokaOne, text, C.text
    b.TextStrokeTransparency, b.TextStrokeColor3 = 0, C.outline
    textConstraint(b, 22)
    Theme.decorate(b, 4)
    b.Activated:Connect(callback)
    b.Parent = parent
    return b
end

function W.scroll(parent: Instance, size: UDim2, position: UDim2): ScrollingFrame
    local s = Instance.new("ScrollingFrame")
    s.Size, s.Position, s.BackgroundTransparency, s.BorderSizePixel = size, position, 1, 0
    s.ScrollBarThickness, s.ScrollingDirection = 8, Enum.ScrollingDirection.Y
    s.AutomaticCanvasSize, s.CanvasSize = Enum.AutomaticSize.Y, UDim2.new()
    s.Parent = parent
    return s
end

function W.list(parent: Instance, padding: number, horizontal: boolean?): UIListLayout
    local l = Instance.new("UIListLayout")
    l.Padding, l.SortOrder = UDim.new(0, padding), Enum.SortOrder.LayoutOrder
    if horizontal then l.FillDirection = Enum.FillDirection.Horizontal end
    l.Parent = parent
    return l
end

function W.colorOf(id: string?): Color3
    for _, row in ProgressionConfig.EggColors do
        if row.id == id then return Color3.fromRGB(row.rgb[1], row.rgb[2], row.rgb[3]) end
    end
    return C.card
end

-- Two-gene swatch: never the only signal; callers also print color names.
function W.swatch(parent: Instance, genes, size: UDim2, position: UDim2): Frame
    local frame = Instance.new("Frame")
    frame.Size, frame.Position, frame.BackgroundTransparency = size, position, 1
    frame.Parent = parent
    local blend = (genes and tonumber(genes.blend)) or 100
    local a = W.box(frame, UDim2.fromScale(math.clamp(blend / 100, .08, 1), 1), UDim2.new(), W.colorOf(genes and genes.primaryColorId), 3)
    a.Name = "Primary"
    if blend &lt; 100 then
        local b = W.box(frame, UDim2.fromScale(1 - math.clamp(blend / 100, .08, 1), 1), UDim2.fromScale(math.clamp(blend / 100, .08, 1), 0), W.colorOf(genes and genes.secondaryColorId), 3)
        b.Name = "Secondary"
    end
    return frame
end

W.StageColors = {base = C.card, gold = C.gold, emerald = Color3.fromRGB(46, 196, 120), diamond = C.blue}

return W
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX259">
          <Properties>
            <string name="Name">PreviewTraits</string>
            <ProtectedString name="Source">--!strict
local RunService = game:GetService("RunService")
local Theme = require(game:GetService("ReplicatedStorage").Shared.UITheme)
local Appearance = require(game:GetService("ReplicatedStorage").Shared.EggAppearance)
local PreviewTraits = {}
function PreviewTraits.add(view: ViewportFrame, traits)
    if traits then view:SetAttribute("TraitsJson",game:GetService("HttpService"):JSONEncode(traits)) end
    if traits and traits.genes then Appearance.apply(view,traits.genes) end
    if not traits or not (traits.shiny or traits.big) then return end
    local badge = Instance.new("TextLabel")
    badge.Name = "TraitBadge"
    badge.BackgroundTransparency, badge.Size, badge.Position = 1, UDim2.new(1,0,0,26), UDim2.new(0,0,1,-26)
    badge.Font, badge.TextSize, badge.TextColor3 = Enum.Font.FredokaOne, 18, Theme.Colors.gold
    badge.TextScaled=true
    badge.Text = (if traits.shiny then "SHINY" else "") .. (if traits.shiny and traits.big then " + " else "") .. (if traits.big then "BIG" else "")
    badge.ZIndex, badge.Parent = view.ZIndex + 2, view
    if not traits.shiny then return end
    local shine = Instance.new("ImageLabel")
    shine.Name, shine.Image = "ShinyPreviewGlint", "rbxassetid://70885382548001"
    shine.BackgroundTransparency, shine.ImageColor3 = 1, Color3.fromRGB(255,244,160)
    shine.Size, shine.Position, shine.ZIndex, shine.Parent = UDim2.fromScale(.38,.42), UDim2.fromScale(.15,.14), view.ZIndex+1, view
    local stars={shine}
    for _,point in {{.58,.16},{.31,.59},{.7,.51}} do
        local extra=shine:Clone()
        extra.Position=UDim2.fromScale(point[1],point[2])
        extra.Size=UDim2.fromScale(.2,.27)
        extra.Parent=view
        table.insert(stars,extra)
    end
    local elapsed, accumulated=0,0
    local connection=RunService.Heartbeat:Connect(function(dt)
        if not Theme.MotionEnabled then for _,star in stars do star.ImageTransparency=.3 end return end
        local ancestor: Instance?=view
        while ancestor do
            if ancestor:IsA("GuiObject") and not ancestor.Visible then return end
            if ancestor:IsA("ScreenGui") and not ancestor.Enabled then return end
            ancestor=ancestor.Parent
        end
        elapsed+=dt accumulated+=dt
        if accumulated&lt;1/20 then return end
        accumulated=0
        local phase=(1-math.cos(elapsed*math.pi/1.6))*.5
        shine.Position=UDim2.fromScale(.15+.5*phase,.14+.36*phase)
        shine.Rotation=100*phase
        shine.ImageTransparency=.65*phase
        for i=2,#stars do
            local pulse=(1-math.cos(elapsed*math.pi/1.6+i))*.5
            stars[i].ImageTransparency=.7*pulse
            stars[i].Rotation=12*pulse
        end
    end)
    view.Destroying:Connect(function() connection:Disconnect() end)
end
return PreviewTraits
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX260">
          <Properties>
            <string name="Name">ResourceVisuals</string>
            <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local RuntimeMeshes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RuntimeMeshes"))
local Resources = require(ReplicatedStorage.Shared.ResourceModels)
local Appearance = require(ReplicatedStorage.Shared.EggAppearance)
local Http = game:GetService("HttpService")
local watched = setmetatable({}, {__mode = "k"})
local function characterVisual(character: Model)
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not root or not root:IsA("BasePart") or not humanoid then return end
    local id = character:GetAttribute("SpeciesId") or "compy"
    local scale = character:GetAttribute("VisualScale") or 1
    local mutation = character:GetAttribute("MutationVisual") or (if character:GetAttribute("GoldVisual") == true then "gold" else "base")
    local genesJson=character:GetAttribute("GenesJson") or "null"
    local previous = character:FindFirstChild("LocalMeshVisual")
    local function groundFrame()
        local height=root.Size.Y/2+humanoid.HipHeight
        if humanoid.RigType==Enum.HumanoidRigType.R6 then
            local leg=character:FindFirstChild("Left Leg")
            height+=if leg and leg:IsA("BasePart") then leg.Size.Y else 2
        end
        return root.CFrame*CFrame.new(0,-height,0)
    end
    if previous and previous:GetAttribute("SpeciesId") == id and previous:GetAttribute("Mutation") == mutation
        and (genesJson~="null" or previous:GetAttribute("GenesJson")=="null") then
        -- Growth reuses geometry, bones and editable images instead of allocating every pickup.
        if previous:GetAttribute("Scale")~=scale then
            local welds={}
            for _,item in previous:GetDescendants() do
                if item:IsA("WeldConstraint") then item.Enabled=false;table.insert(welds,item) end
            end
            previous.WorldPivot=groundFrame()
            previous:ScaleTo(scale);previous:PivotTo(groundFrame());previous:SetAttribute("Scale",scale)
            for _,weld in welds do weld.Enabled=true end
        end
        if previous:GetAttribute("GenesJson")~=genesJson then
            local ok,genes=pcall(function() return Http:JSONDecode(genesJson) end)
            if ok and typeof(genes)=="table" and mutation=="base" then Appearance.apply(previous,genes) end
            previous:SetAttribute("GenesJson",genesJson)
        end
        return
    end
    local overrides=ReplicatedStorage:FindFirstChild("ResourceOverrides")
    local model = Resources.clone(id)
    if not model then return end
    if not character.Parent or not root.Parent then model:Destroy();return end
    if previous then previous:Destroy() end
    local groundHeight = root.Size.Y / 2 + humanoid.HipHeight
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        local leg = character:FindFirstChild("Left Leg")
        groundHeight += if leg and leg:IsA("BasePart") then leg.Size.Y else 2
    end
    model.Name = "LocalMeshVisual"
    model:SetAttribute("SpeciesId", id)
    model:SetAttribute("Scale", scale)
    model:SetAttribute("Mutation", mutation)
    model:SetAttribute("GenesJson",genesJson)
    model:ScaleTo(scale)
    model:PivotTo(root.CFrame * CFrame.new(0, -groundHeight, 0))
    for _, item in model:GetDescendants() do
        if item:IsA("BasePart") then
            item.Anchored = false
            if mutation=="gold" or mutation=="diamond" then Resources.clearTextures(item) end
            if mutation == "gold" then item.Color = Color3.fromRGB(242,199,63) item.Material = Enum.Material.Metal
            elseif mutation == "diamond" then item.Color = Color3.fromRGB(85,213,245) item.Material = Enum.Material.Glass item.Reflectance=.2 end
            local weld = Instance.new("WeldConstraint")
            weld.Part0, weld.Part1, weld.Parent = root, item, item
        end
    end
    model.Parent = character
    local ok,genes=pcall(function() return Http:JSONDecode(genesJson) end)
    if ok and typeof(genes)=="table" and mutation=="base" then Appearance.apply(model,genes) end
    local fallback = character:FindFirstChild("DinoVisual")
    if fallback then
        for _, item in fallback:GetDescendants() do
            if item:IsA("BasePart") then item.LocalTransparencyModifier = 1 end
        end
    end
end
local function watchCharacter(character: Model)
    if watched[character] then return end
    watched[character] = true
    local queued = false
    local dirty = false
    local function refresh()
        if queued then dirty=true return end
        queued = true
        task.defer(function()
            repeat
                dirty=false
                if character.Parent then characterVisual(character) end
            until not dirty or not character.Parent
            queued = false
        end)
    end
    for _, attribute in {"SpeciesId", "VisualScale", "GoldVisual", "MutationVisual", "DinoAttached","GenesJson"} do
        character:GetAttributeChangedSignal(attribute):Connect(refresh)
    end
    character.DescendantAdded:Connect(function(item)
        if item:IsA("BasePart") and item:FindFirstAncestor("DinoVisual") and character:FindFirstChild("LocalMeshVisual") then
            item.LocalTransparencyModifier = 1
        end
    end)
    refresh()
end
local function watchPlayer(player: Player)
    player.CharacterAdded:Connect(watchCharacter)
    if player.Character then watchCharacter(player.Character) end
end
Players.PlayerAdded:Connect(watchPlayer)
for _, player in Players:GetPlayers() do watchPlayer(player) end
local function propVisual(prop: Instance)
    if not prop:IsA("Model") or prop:FindFirstChild("LocalResourceMesh") then return end
    local id = prop:GetAttribute("ResourceId")
    local position = prop:GetAttribute("SourcePosition")
    if typeof(id) ~= "string" or typeof(position) ~= "Vector3" then return end
    local mesh = RuntimeMeshes.clone(id)
    if not mesh then return end
    mesh.Name = "LocalResourceMesh"
    mesh:ScaleTo(prop:GetAttribute("SourceScale") or 1)
    mesh:PivotTo(CFrame.new(position) * CFrame.Angles(0, prop:GetAttribute("SourceYaw") or 0, 0))
    for _, item in prop:GetDescendants() do
        if item:IsA("BasePart") then item.LocalTransparencyModifier = 1 end
    end
    mesh.Parent = prop
end
local function upgradeAll()
    for _, player in Players:GetPlayers() do if player.Character then characterVisual(player.Character) end end
    local arena = workspace:FindFirstChild("BeDinoArena")
    if arena then for _, item in arena:GetChildren() do propVisual(item) end end
end
RuntimeMeshes.Ready.Event:Connect(upgradeAll)
workspace.DescendantAdded:Connect(function(item)
    if item:IsA("Model") and item:GetAttribute("ResourceId") then task.defer(propVisual, item) end
end)
-- Food shares each source MeshPart; positions and visibility remain server-owned.
local foods = setmetatable({}, {__mode = "k"})
local elapsed = 0
RunService.Heartbeat:Connect(function(dt)
    elapsed += dt
    if elapsed &lt; .15 then return end
    elapsed = 0
    local folder = workspace:FindFirstChild("Food")
    if not folder then return end
    for _, item in folder:GetChildren() do
        if not item:IsA("BasePart") or not item:GetAttribute("Points") then continue end
        local model = foods[item]
        if not model then
            model = RuntimeMeshes.clone(item.Name)
            if not model then continue end
            local sourceHeight = ({berry = .61, fruit = .96, egg = 2.4, amber = 1.3})[item.Name] or 1
            model:ScaleTo(item.Size.Y / sourceHeight)
            model.Name = "LocalFoodMesh"
            model.Parent = item
            foods[item] = model
            item.LocalTransparencyModifier = 1
        end
        model:PivotTo(CFrame.new(item.Position - Vector3.new(0, item.Size.Y / 2 + .08, 0)))
        for _, piece in model:GetDescendants() do
            if piece:IsA("BasePart") then piece.Transparency = item.Transparency end
        end
    end
end)
-- Native models are packaged. Optional API meshes are no longer needed.
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX261">
          <Properties>
            <string name="Name">WeatherVisuals</string>
            <ProtectedString name="Source">--!strict
-- Client-local precipitation pool: bounded instance count and no gameplay collision.
local Lighting=game:GetService("Lighting")
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Shared=game:GetService("ReplicatedStorage").Shared
local Theme=require(Shared.UITheme)
local player=Players.LocalPlayer
local random=Random.new()
local folder=Instance.new("Folder") folder.Name="LocalWeatherFX" folder.Parent=workspace
local drops={}
for _=1,36 do
    local part=Instance.new("Part") part.Name="Precipitation"
    part.Anchored,part.CanCollide,part.CanTouch,part.CanQuery,part.CastShadow=true,false,false,false,false
    part.Material=Enum.Material.Neon part.Transparency=1 part.Parent=folder
    table.insert(drops,{part=part,x=random:NextNumber(-20,20),z=random:NextNumber(-20,20),y=random:NextNumber(-10,20)})
end
local flash=Instance.new("ColorCorrectionEffect") flash.Name="ThunderFlash" flash.Parent=Lighting
local nextFlash=0 local flashUntil=0
local moon=Instance.new("Part") moon.Name="EventMoon" moon.Shape=Enum.PartType.Ball
moon.Anchored,moon.CanCollide,moon.CanTouch,moon.CanQuery,moon.CastShadow=true,false,false,false,false
moon.Size,moon.Material,moon.Color,moon.Transparency,moon.Parent=Vector3.one*18,Enum.Material.Neon,Color3.fromRGB(255,95,125),1,folder
local skyPoints={} local skyBeams={}
for i=1,7 do
    local point=Instance.new("Attachment") point.Parent=workspace.Terrain table.insert(skyPoints,point)
    if i&gt;1 then
        local beam=Instance.new("Beam") beam.Attachment0,beam.Attachment1=skyPoints[i-1],point
        beam.FaceCamera,beam.Width0,beam.Width1,beam.LightEmission,beam.Segments=true,12,12,1,16
        beam.Texture="rbxasset://textures/particles/smoke_main.dds"
        beam.TextureMode,beam.TextureSpeed=Enum.TextureMode.Stretch,.05
        beam.Color=ColorSequence.new(Color3.fromRGB(84,255,189),Color3.fromRGB(168,122,255))
        beam.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.85),NumberSequenceKeypoint.new(.5,.45),NumberSequenceKeypoint.new(1,.85)})
        beam.Enabled,beam.Parent=false,folder table.insert(skyBeams,beam)
    end
end
local atmosphere=Instance.new("ColorCorrectionEffect") atmosphere.Name="LocalEventColor" atmosphere.Parent=Lighting
local elapsed=0
RunService.Heartbeat:Connect(function(dt)
    elapsed+=dt
    if elapsed&lt;1/30 then return end
    dt=elapsed elapsed=0
    local id=workspace:GetAttribute("WeatherId") or "clear"
    local c=player.Character
    local root=if c then c:FindFirstChild("HumanoidRootPart") else nil
    local on=table.find({"rain","thunder","blizzard","volcano","quake"},id)~=nil and Theme.MotionEnabled and root~=nil
    for _,drop in drops do
        local part=drop.part
        part.Transparency=if on then .35 else 1
        if on then
            drop.y-=dt*(if id=="blizzard" then 6 elseif id=="volcano" then -7 elseif id=="quake" then 4 else 48)
            if drop.y&lt; -10 then drop.y=20 drop.x=random:NextNumber(-20,20) drop.z=random:NextNumber(-20,20) end
            if drop.y&gt;20 then drop.y=-10 end
            part.Size=if id=="blizzard" or id=="volcano" then Vector3.one*.15 elseif id=="quake" then Vector3.one*.28 else Vector3.new(.04,1.7,.04)
            part.Color=if id=="blizzard" then Color3.new(1,1,1) elseif id=="volcano" then Color3.fromRGB(255,140,67) elseif id=="quake" then Color3.fromRGB(202,182,142) else Color3.fromRGB(125,197,239)
            part.Position=root.Position+Vector3.new(drop.x,drop.y,drop.z)
        end
    end
    local now=os.clock()
    if id=="thunder" and on and now&gt;=nextFlash then nextFlash=now+random:NextNumber(12,25) flashUntil=now+.12 end
    flash.Brightness=if id=="thunder" and on and now&lt;flashUntil then .25 else 0
    local skyOn=Theme.MotionEnabled and root~=nil
    moon.Transparency=if skyOn and id=="bloodmoon" then .12 else 1
    if skyOn then
        moon.Position=root.Position+Vector3.new(-80,90,-130)
        for i,point in skyPoints do point.Position=root.Position+Vector3.new((i-4)*24,65+math.sin(now*.25+i)*7,-75) end
    end
    for _,beam in skyBeams do beam.Enabled=skyOn and id=="aurora" beam.CurveSize0=math.sin(now*.3)*8 beam.CurveSize1=-beam.CurveSize0 end
    atmosphere.TintColor=if skyOn and id=="bloodmoon" then Color3.fromRGB(255,200,215) elseif skyOn and id=="volcano" then Color3.fromRGB(255,226,194) elseif skyOn and id=="aurora" then Color3.fromRGB(215,243,255) else Color3.new(1,1,1)
    if c then
        local rootPart=c:FindFirstChild("HumanoidRootPart")
        if rootPart then for _,part in rootPart:GetDescendants() do if part:IsA("ParticleEmitter") and part.Name=="AuraParticles" then part.Enabled=Theme.MotionEnabled end end end
    end
end)
</ProtectedString>
          </Properties>
        </Item>
      </Item>
