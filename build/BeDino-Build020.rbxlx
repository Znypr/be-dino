      <Item class="ModuleScript" referent="RBX233">
        <Properties>
          <string name="Name">Dinosaur</string>
          <ProtectedString name="Source">--!strict
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PhysicsService = game:GetService("PhysicsService")
local Dinosaur = {}
local Visual = require(ReplicatedStorage.Shared.DinosaurVisual)
local Config = require(ReplicatedStorage.Shared.Config)
local MovementEnvelope = require(ReplicatedStorage.Shared.MovementEnvelope)
local function groundHeight(character: Model, root: BasePart, humanoid: Humanoid): number
    local height = root.Size.Y / 2 + humanoid.HipHeight
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        local leg = character:FindFirstChild("Left Leg")
        height += if leg and leg:IsA("BasePart") then leg.Size.Y else 2
    end
    return height
end

-- BD-053: the footprint follows the growing torso, but the box is lifted by the slope
-- clearance from MovementEnvelope so it never wedges into walkable hills (the previous
-- fixed 0.2-stud clearance snagged on any slope above ~5 degrees and slid dinosaurs back).
local function placeCollider(character: Model, scale: number)
    local collider = character:FindFirstChild("DinoCollider")
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not collider or not collider:IsA("BasePart") or not root or not root:IsA("BasePart") or not humanoid then return end
    local width, height, length, offsetY = MovementEnvelope.collider(scale, groundHeight(character, root, humanoid))
    collider.Size = Vector3.new(width, height, length)
    local weld = collider:FindFirstChild("ColliderWeld")
    if weld and weld:IsA("Weld") then weld.C0 = CFrame.new(0, offsetY, 0) end
end

function Dinosaur.render(character: Model, scale: number, speciesId: string?, gold: (boolean | string)?)
    Visual.render(character, scale, speciesId, gold)
    placeCollider(character, scale)
end
local function scaleForScore(score: number): number
    return math.min(4, math.sqrt(1 + math.max(0, score) / 50))
end
if not PhysicsService:IsCollisionGroupRegistered("DinoControllers") then
    PhysicsService:RegisterCollisionGroup("DinoControllers")
end
PhysicsService:CollisionGroupSetCollidable("DinoControllers", "DinoControllers", false)

function Dinosaur.setSpecies(character: Model, speciesId: string, isGold: (boolean | string)?)
    local scaleValue = character:GetAttribute("VisualScale")
    local scale = if typeof(scaleValue) == "number" then scaleValue else 1
    Dinosaur.render(character, scale, speciesId, isGold)
end

function Dinosaur.refreshForPlayer(character: Model, player: Player)
    local equipped = player:GetAttribute("EquippedSpeciesId")
    local speciesId = if typeof(equipped) == "string" then equipped else "compy"
    local ok, collection = pcall(function() return game:GetService("HttpService"):JSONDecode(player:GetAttribute("CollectionJson") or "{}") end)
    local entry = if ok then collection[speciesId] else nil
    local mutation = if entry and (entry.diamond or 0) &gt; 0 then "diamond" elseif entry and (entry.gold or 0) &gt; 0 then "gold" else "base"
    if player:GetAttribute("EquippedGenesJson") and player:GetAttribute("EquippedGenesJson")~="null" then mutation="base" end
    character:SetAttribute("BigDinosaur", player:GetAttribute("EquippedBig") == true)
    local factor = if character:GetAttribute("BigDinosaur") then Config.BigScaleMultiplier else 1
    Dinosaur.render(character, scaleForScore(character:GetAttribute("GrowthScore") or 0) * factor, speciesId, mutation)
end

function Dinosaur.addGrowth(character: Model, points: number)
    if points &lt;= 0 or character:GetAttribute("RunState") ~= "Active" then return end
    local current = character:GetAttribute("GrowthScore")
    local score = (if typeof(current) == "number" then current else 0) + points * math.clamp(character:GetAttribute("GrowthMultiplier") or 1,.1,8)
    character:SetAttribute("GrowthScore", score)
    local scale = scaleForScore(score) * (if character:GetAttribute("BigDinosaur") then Config.BigScaleMultiplier else 1)
    if character:GetAttribute("VisualScale") ~= scale then
        local gold = character:GetAttribute("MutationVisual") or "base"
        Dinosaur.render(character, scale, nil, gold)
    end
end

function Dinosaur.attach(character: Model, walkSpeed: number, player: Player)
    local deadline = os.clock() + 10
    while not character:IsDescendantOf(workspace) do
        if player.Character ~= character or not player.Parent then return end
        if os.clock() &gt;= deadline then return end
        RunService.Heartbeat:Wait()
    end
    local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
    local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
    if player.Character ~= character or not character:IsDescendantOf(workspace) then return end
    if not humanoid or not root or character:GetAttribute("DinoAttached") then return end

    local function hide(instance: Instance)
        if instance:FindFirstAncestor("DinoVisual") then return end
        if instance:IsA("BasePart") then instance.Transparency = 1 end
        if instance:IsA("Decal") then instance.Transparency = 1 end
    end
    for _, descendant in character:GetDescendants() do hide(descendant) end
    character.DescendantAdded:Connect(hide)

    humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    humanoid.WalkSpeed = walkSpeed
    humanoid.UseJumpPower = true
    humanoid.JumpPower = Config.JumpPower
    humanoid.MaxSlopeAngle = Config.MaxSlopeAngle
    humanoid.AutoJumpEnabled = false
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)

    -- Explicit torso collider: decorative mesh triangles never control physics.
    for _, item in character:GetDescendants() do
        if item:IsA("BasePart") then item.CollisionGroup = "DinoControllers" end
    end
    local collider = Instance.new("Part")
    collider.Name = "DinoCollider"
    collider.Transparency = 1
    collider.Massless = true
    collider.CanCollide = true
    collider.CanTouch = false
    collider.CollisionGroup = "DinoControllers"
    local width, height, length, offsetY = MovementEnvelope.collider(1, groundHeight(character, root, humanoid))
    collider.Size = Vector3.new(width, height, length)
    collider.CFrame = root.CFrame * CFrame.new(0, offsetY, 0)
    collider.Parent = character
    -- A rigid Weld (not WeldConstraint) so growth can move the box by editing C0.
    local weld = Instance.new("Weld")
    weld.Name = "ColliderWeld"
    weld.Part0 = root
    weld.Part1 = collider
    weld.C0 = CFrame.new(0, offsetY, 0)
    weld.Parent = collider
    Dinosaur.refreshForPlayer(character, player)
    character:SetAttribute("DinoAttached", true)
end

return Dinosaur
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX234">
        <Properties>
          <string name="Name">DinosaurIdentity</string>
          <ProtectedString name="Source">--!strict
-- Additive identity sidecar. No DataStore access, RNG, economy or cosmetic grants.
local Identity = {}
Identity.Version = 1
-- Worst-case Studio serialization measured ~938 KB/1,000 identities. Keep enough
-- room for the rest of the profile and fail closed until BD-057 adds compaction or
-- sharding. This guard never truncates the grouped legacy collection.
Identity.MaxInstances = 3000

local function copy(value)
    if type(value) ~= "table" then return value end
    local result = {}
    for key, child in value do result[key] = copy(child) end
    return result
end
Identity.copy = copy

local function cosmetics()
    return {ownedAuraIds = {}, ownedTrailIds = {}, equippedAuraId = "", equippedTrailId = ""}
end

-- Sorted buckets make migration reproducible across callback retries and reconnects.
local function buckets(collection)
    local result = {}
    for speciesId, entry in collection do
        for _, stage in {"base", "gold", "diamond"} do
            result[speciesId .. "/" .. stage] = {speciesId = speciesId, stage = stage, count = entry[stage]}
        end
        -- Additive optional Emerald counter (BD-057 ladder 15/4/2): nil means 0.
        result[speciesId .. "/emerald"] = {speciesId = speciesId, stage = "emerald", count = if entry.emerald == nil then 0 else entry.emerald}
        for mutationId, count in entry.events or {} do
            result[speciesId .. "/event/" .. mutationId] = {speciesId = speciesId, stage = "base", count = count, mutationId = mutationId}
        end
        for key, variant in entry.variants or {} do
            local bucket = copy(variant)
            bucket.speciesId, bucket.stage = speciesId, "base"
            result[speciesId .. "/variant/" .. key] = bucket
        end
    end
    return result
end

local function record(id, bucketKey, bucket, origin)
    return {instanceId = id, bucketKey = bucketKey, speciesId = bucket.speciesId,
        stage = bucket.stage, genes = copy(bucket.genes), traitRollVersion = bucket.traitRollVersion, big = bucket.big or false,
        shiny = bucket.shiny or false, mutationId = bucket.mutationId or "",
        traitsKnown = bucket.genes ~= nil, origin = copy(origin), cosmetics = cosmetics()}
end

-- Returns a new sidecar or error, leaving the input profile entirely untouched.
-- Unknown legacy DNA/pattern/egg is deliberately absent, never rolled retroactively.
function Identity.reconcile(collection, existing, ownerKey)
    ownerKey = ownerKey or "fixture"
    local desired = buckets(collection)
    local total = 0
    for _, bucket in desired do
        local n = bucket.count
        if type(n) ~= "number" or n ~= n or n &lt; 0 or n % 1 ~= 0 then return nil, "invalid_count" end
        total += n
    end
    if total &gt; Identity.MaxInstances then return nil, "identity_capacity" end
    if existing ~= nil and (type(existing) ~= "table" or existing.version ~= Identity.Version
        or type(existing.instances) ~= "table" or type(existing.nextId) ~= "number"
        or existing.nextId &lt; 1 or existing.nextId % 1 ~= 0) then return nil, "invalid_identity" end
    if existing and type(existing.eggs) ~= "table" then return nil, "invalid_eggs" end
    if existing and existing.fusions ~= nil and type(existing.fusions) ~= "table" then return nil, "invalid_fusion_ledger" end
    local state = copy(existing or {version = Identity.Version, ownerKey = ownerKey, nextId = 1, instances = {}, eggs = {}})
    if state.ownerKey ~= ownerKey then return nil, "wrong_owner" end
    local fusions = state.fusions or {}
    local ids = {}
    local fused = {}
    for id, instance in state.instances do
        if type(instance) == "table" and type(instance.origin) == "table" and instance.origin.kind == "fusion" then
            -- BD-057: fused outputs are identity-authoritative. Their grouped projection is the
            -- plain stage count; genes/traits are freshly rolled and need not match a bucket.
            local entry = fusions[instance.origin.operationId]
            if type(entry) ~= "table" or entry.resultId ~= id then return nil, "missing_fusion_ledger" end
            if instance.instanceId ~= id or instance.bucketKey ~= tostring(instance.speciesId) .. "/" .. tostring(instance.stage)
                or not desired[instance.bucketKey] or type(instance.genes) ~= "table"
                or type(instance.cosmetics) ~= "table" or type(instance.cosmetics.ownedAuraIds) ~= "table"
                or type(instance.cosmetics.ownedTrailIds) ~= "table" then return nil, "invalid_instance" end
            fused[id] = true
        elseif type(instance) ~= "table" or instance.instanceId ~= id or not desired[instance.bucketKey]
            or type(instance.cosmetics) ~= "table" or type(instance.cosmetics.ownedAuraIds) ~= "table"
            or type(instance.cosmetics.ownedTrailIds) ~= "table" or type(instance.origin) ~= "table" then return nil, "invalid_instance" end
        local sequence = tonumber(string.match(id, "/d:(%d+)$"))
        if not sequence or id ~= state.ownerKey .. "/d:" .. tostring(sequence) or sequence &gt;= state.nextId then return nil, "invalid_sequence" end
        local bucket = desired[instance.bucketKey]
        if fused[id] then
            -- Validated above; skip grouped trait comparison.
        elseif instance.speciesId ~= bucket.speciesId or instance.stage ~= bucket.stage
            or instance.big ~= (bucket.big or false) or instance.shiny ~= (bucket.shiny or false)
            or instance.mutationId ~= (bucket.mutationId or "") then return nil, "trait_mismatch" end
        if not fused[id] and (instance.genes == nil) ~= (bucket.genes == nil) then return nil, "gene_mismatch" end
        if instance.genes and not fused[id] then
            for key, value in bucket.genes do if instance.genes[key] ~= value then return nil, "gene_mismatch" end end
            for key, value in instance.genes do if bucket.genes[key] ~= value then return nil, "gene_mismatch" end end
        end
        if instance.origin.kind == "hatch" then
            if not state.eggs[instance.origin.eggId] then return nil, "missing_origin" end
        elseif instance.origin.kind ~= "legacy_unknown" and not fused[id] then return nil, "unsupported_origin" end
        table.insert(ids, id)
    end
    -- Fused outputs are kept first so a grouped decrement (e.g. legacy Gold-&gt;Diamond)
    -- spends legacy copies; non-fused order is unchanged from the BD-060 contract.
    table.sort(ids, function(a, b)
        if (fused[a] == true) ~= (fused[b] == true) then return fused[a] == true end
        return a &lt; b
    end)
    local counts = {}
    for _, id in ids do
        local instance = state.instances[id]
        local key = instance.bucketKey
        counts[key] = (counts[key] or 0) + 1
        -- Existing Build 020 conversion spends only plain buckets. Never erase cosmetics
        -- or a crafted fusion result; fail closed instead.
        if counts[key] &gt; desired[key].count then
            if fused[id] or next(instance.cosmetics.ownedAuraIds) or next(instance.cosmetics.ownedTrailIds) then
                return nil, "protected_identity"
            end
            state.instances[id] = nil
        end
    end
    local keys = {}
    for key in desired do table.insert(keys, key) end
    table.sort(keys)
    for _, key in keys do
        for _ = (counts[key] or 0) + 1, desired[key].count do
            local id = state.ownerKey .. "/d:" .. tostring(state.nextId)
            state.nextId += 1 -- monotonic within an owner profile; never reuse consumed IDs
            if state.instances[id] then return nil, "identity_collision" end
            state.instances[id] = record(id, key, desired[key], {kind = "legacy_unknown"})
        end
    end
    -- Retain shared egg snapshots only while referenced by living individuals.
    -- Future fusion must archive referenced parents/eggs in its transaction ledger first.
    local referenced = {}
    for _, instance in state.instances do
        if instance.origin.kind == "hatch" then referenced[instance.origin.eggId] = true end
    end
    -- The fusion ledger archives consumed parents' original eggs (BD-057 lineage).
    for _, entry in fusions do
        if type(entry) == "table" and type(entry.parentEggIds) == "table" then
            for _, eggId in entry.parentEggIds do referenced[eggId] = true end
        end
    end
    for eggId in state.eggs do if not referenced[eggId] then state.eggs[eggId] = nil end end
    return state
end

-- Call inside the same transaction as grouped hatch credit, before reconciliation.
-- Egg payload stored once even when one egg yields three distinct dinosaurs.
function Identity.hatch(state, egg, speciesId, count, bucketKey)
    if count == 0 then return {} end
    if type(count) ~= "number" or count &lt; 1 or count &gt; 3 or count % 1 ~= 0 then error("invalid hatch count") end
    local originId = egg.eggId
    local saved = state.eggs[originId]
    if saved then error("egg already credited") end
    local eggCopy = copy(egg)
    state.eggs[originId] = eggCopy
    local ids = {}
    for _ = 1, count do
        local id = state.ownerKey .. "/d:" .. tostring(state.nextId)
        state.nextId += 1
        assert(state.instances[id] == nil, "identity collision")
        state.instances[id] = record(id, bucketKey, {speciesId = speciesId, stage = "base",
            genes = egg.genes, big = egg.big, shiny = egg.shiny, mutationId = egg.mutationId, traitRollVersion = egg.traitRollVersion},
            {kind = "hatch", eggId = originId})
        table.insert(ids, id)
    end
    return ids
end

-- Data contract only: caller supplies already rolled output. Does not consume or roll.
-- Immediate parent snapshots retain traits and origins without recursively copying trees.
-- Compact (ladder 15/4/2): speciesId, stage and genes.patternId are identical for every
-- parent (recipe-locked), so they are stored once on the record (origin.parentStage)
-- instead of 15 times. Readers fall back to the result's speciesId/pattern.
Identity.MaxFusionParents = 15
function Identity.fusionRecord(id, output, parents, operationId, recipeVersion, oddsVersion)
    assert(type(id) == "string" and #id &gt; 0 and #id &lt;= 120, "invalid result ID")
    assert(type(operationId) == "string" and #operationId &gt; 0 and #operationId &lt;= 120, "invalid operation ID")
    assert(type(recipeVersion) == "string" and #recipeVersion &gt; 0 and type(oddsVersion) == "string" and #oddsVersion &gt; 0, "versioned recipe and odds required")
    assert(type(output.genes) == "table" and output.genes.patternId ~= nil, "fresh output genes required")
    assert(output.stage == "gold" or output.stage == "emerald" or output.stage == "diamond", "invalid result stage")
    assert(#parents &gt;= 2 and #parents &lt;= Identity.MaxFusionParents, "bounded immediate parents required")
    local snapshots, seen = {}, {}
    local parentStage = parents[1] and parents[1].stage
    for _, parent in parents do
        assert(not seen[parent.instanceId] and parent.instanceId ~= id, "duplicate/cyclic parent")
        assert(parent.speciesId == output.speciesId and parent.genes
            and parent.genes.patternId == output.genes.patternId, "matching species/pattern required")
        assert(parent.stage == parentStage, "single parent stage required")
        seen[parent.instanceId] = true
        local genes = copy(parent.genes)
        genes.patternId = nil
        table.insert(snapshots, {instanceId = parent.instanceId, genes = genes, big = parent.big, shiny = parent.shiny,
            mutationId = parent.mutationId, origin = {kind = parent.origin.kind, eggId = parent.origin.eggId, operationId = parent.origin.operationId}})
    end
    -- Grouped compatibility projection: the plain stage bucket (BD-057).
    local result = record(id, output.speciesId .. "/" .. output.stage, output, {kind = "fusion", operationId = operationId,
        recipeVersion = recipeVersion, oddsVersion = oddsVersion, parentStage = parentStage, parents = snapshots})
    -- No parent cosmetic fields are copied into either output or lineage.
    return result
end
return Identity
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX235">
        <Properties>
          <string name="Name">FoodService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local MovementEnvelope = require(ReplicatedStorage.Shared.MovementEnvelope)
local Resources = require(ReplicatedStorage.Shared.ResourceModels)
local Layout = require(ReplicatedStorage.Shared.IslandLayout)
local FoodCatchRules = require(ReplicatedStorage.Shared.FoodCatchRules)
local ProgressionRules = require(ReplicatedStorage.Shared.ProgressionRules)
local Http = game:GetService("HttpService")
local eventRandom = Random.new()
local FoodService = {}
local TYPES = {
    {id = "berry", weight = 78, points = 1, size = 0.7, color = Color3.fromRGB(224, 99, 118)},
    {id = "fruit", weight = 15, points = 4, size = 1.0, color = Color3.fromRGB(244, 186, 83)},
    {id = "egg", weight = 5, points = 15, size = 1.3, color = Color3.fromRGB(245, 230, 187)},
    {id = "amber", weight = 2, points = 50, size = 1.5, color = Color3.fromRGB(255, 219, 139)},
}
function FoodService.start(dinosaur,repository)
    workspace:SetAttribute("FoodSpawnStatus", "Building")
    workspace:SetAttribute("FoodCount", 0)
    workspace:SetAttribute("FoodStartupError", "")
    local folder = Instance.new("Folder")
    folder.Name = "Food"
    folder.Parent = workspace
    local foods = {}
    local random = Random.new(Config.FoodSeed)
    local groundParams = RaycastParams.new()
    groundParams.FilterType = Enum.RaycastFilterType.Include
    groundParams.FilterDescendantsInstances = {workspace.Terrain}
    local pickupParams = RaycastParams.new()
    pickupParams.FilterType = Enum.RaycastFilterType.Include
    pickupParams.FilterDescendantsInstances = {workspace.BeDinoArena, workspace.Terrain}
    local fallbackCount = 0
    local kitVisuals = 0
    local obstacleParams = RaycastParams.new()
    obstacleParams.FilterType = Enum.RaycastFilterType.Include
    obstacleParams.FilterDescendantsInstances = {workspace.BeDinoArena}
    local extent = Config.ArenaHalfWidth - 8
    local sectorWidth = 2 * extent / Config.FoodSectorCount
    local function groundAt(x: number, z: number): Vector3?
        -- Safe spawn remains clear. Ground's top is y=0.
        if (Vector2.new(x, z) - Vector2.new(0, 30)).Magnitude &lt; 11 then return nil end
        local hit = workspace:Raycast(Vector3.new(x, Config.TerrainTop + 20, z), Vector3.new(0, -Config.TerrainTop - 60, 0), groundParams)
        local ground: Vector3
        if hit then
            if hit.Material == Enum.Material.Water or hit.Normal.Y &lt; 0.62 then return nil end
            ground = hit.Position
        else
            -- Same authored heightfield that produced the terrain; never silently empty the map.
            fallbackCount += 1
            ground = Vector3.new(x, Layout.height(x,z) + Config.TerrainResolution*.5, z)
        end
        -- A second horizontal check keeps pickups away from solid rock/trunk edges.
        for _, direction in {Vector3.xAxis, -Vector3.xAxis, Vector3.zAxis, -Vector3.zAxis} do
            if workspace:Raycast(ground + Vector3.new(0, 1, 0), direction * 1.25, obstacleParams) then
                return nil
            end
        end
        return ground
    end
    local function relocate(food): boolean
        for _ = 1, 24 do
            local angle = random:NextNumber(0, 2 * math.pi)
            local radius = math.sqrt(random:NextNumber()) * Config.FoodClusterRadius
            local x = math.clamp(food.center.X + math.cos(angle) * radius, food.minX + 1, food.maxX - 1)
            local z = math.clamp(food.center.Y + math.sin(angle) * radius, food.minZ + 1, food.maxZ - 1)
            local ground = groundAt(x, z)
            if ground then
                food.part.Position = ground + Vector3.new(0, food.kind.size / 2 + 0.35, 0)
                if food.visual then food.visual:PivotTo(CFrame.new(ground + Vector3.new(0,.35,0))) end
                return true
            end
        end
        return false
    end
    local function show(food, visible: boolean)
        local hint = food.part:FindFirstChild("FoodHint")
        if hint and hint:IsA("BillboardGui") then hint.Enabled = visible end
        if food.visual then
            for _, item in food.visual:GetDescendants() do
                if item:IsA("BasePart") then item.Transparency = if visible then 0 else 1 end
            end
        else
            food.part.Transparency = if visible then 0 else 1
        end
    end
    for sx = 0, Config.FoodSectorCount - 1 do
        for sz = 0, Config.FoodSectorCount - 1 do
            local minX, minZ = -extent + sx * sectorWidth, -extent + sz * sectorWidth
            local center = Vector2.new(minX + sectorWidth / 2, minZ + sectorWidth / 2)
            -- Jitter cluster centers, including edge sectors; no one central food island.
            for _ = 1, 20 do
                local proposed = Vector2.new(random:NextNumber(minX + 3, minX + sectorWidth - 3), random:NextNumber(minZ + 3, minZ + sectorWidth - 3))
                if groundAt(proposed.X, proposed.Y) then center = proposed break end
            end
            local starter = (sx == 7 or sx == 8) and sz == 8
            if starter then center = Vector2.new(if sx == 7 then -15 else 15, 24) end
            for itemIndex = 1, Config.FoodClusterItems do
                local roll, kind = random:NextInteger(1, 100), TYPES[1]
                if roll &gt; 98 then kind = TYPES[4] elseif roll &gt; 93 then kind = TYPES[3] elseif roll &gt; 78 then kind = TYPES[2] end
                if starter then kind = if itemIndex % 3 == 0 then TYPES[2] else TYPES[1] end
                local pickup = Instance.new("Part")
                pickup.Name = kind.id
                pickup.Shape = Enum.PartType.Ball
                pickup.Size = Vector3.one * kind.size
                pickup.Color = kind.color
                pickup.Material = Enum.Material.SmoothPlastic
                pickup.Anchored = true
                pickup.CanCollide = false
                pickup.CanTouch = false
                pickup.CanQuery = false
                pickup:SetAttribute("Points", kind.points)
                pickup:SetAttribute("StarterFood", starter)
                pickup:SetAttribute("Sector", string.format("%d:%d", sx, sz))
                local visual = nil
                -- BD-050 Kit mode is visual only: same TYPES points, pickup part and server validation.
                -- Berry/fruit keep the visible ball pickup (1,300+ native kit copies is too heavy; the ArtId variant is
                -- recorded for the MeshPart upload). Kit egg/amber models replace the ball only on a deterministic stride
                -- (amber 1/4, egg 1/20) up to Config.FoodKitVisualCap, so the part budget in docs/68 holds.
                local kitMode = Config.FoodArtMode == "Kit"
                local artId = if kitMode then string.format("food_%s_%s", kind.id, if (sx + sz + itemIndex) % 2 == 0 then "a" else "b") else kind.id
                pickup:SetAttribute("ArtId", artId)
                local useModel = kind.id == "egg" or kind.id == "amber"
                if kitMode and useModel then
                    local stride = if kind.id == "amber" then 4 else 20
                    useModel = kitVisuals &lt; Config.FoodKitVisualCap and (sx * 16 + sz + itemIndex * 7) % stride == 0
                end
                if useModel then
                    local ok, result = pcall(function()
                        local model = Resources.clone(artId)
                        if model and artId == kind.id then model:ScaleTo(kind.size / (if kind.id == "egg" then 2.4 else 1.3)) end
                        return model
                    end)
                    if ok and result and kitMode then kitVisuals += 1 end
                    if ok then visual = result end -- visible native pickup survives any art failure
                end
                local food = {part = pickup, visual = visual, readyAt = 0, hidden = false, kind = kind,
                    center = center, minX = minX, maxX = minX + sectorWidth, minZ = minZ, maxZ = minZ + sectorWidth}
                if relocate(food) then
                    pickup.Parent = folder
                    if visual then
                        pickup.Transparency = 1 -- only while the kit model is the visible pickup; show() mirrors it
                        for _, item in visual:GetDescendants() do
                            if item:IsA("BasePart") then item.Anchored = true end
                        end
                        visual.Parent = pickup
                    end
                    table.insert(foods, food)
                    workspace:SetAttribute("FoodCount", #foods)
                    if starter then
                        local hint = Instance.new("BillboardGui")
                        hint.Name, hint.Size, hint.StudsOffset = "FoodHint", UDim2.fromOffset(74,24), Vector3.new(0,1.2,0)
                        hint.MaxDistance, hint.AlwaysOnTop, hint.Parent = 45,false,pickup
                        local label = Instance.new("TextLabel")
                        label.Size,label.BackgroundTransparency,label.Text = UDim2.fromScale(1,1),1,"+"..kind.points
                        label.Font,label.TextSize,label.TextColor3 = Enum.Font.FredokaOne,16,kind.color
                        label.TextStrokeTransparency,label.TextStrokeColor3,label.Parent = 0,Color3.new(0,0,0),hint
                    end
                else
                    pickup:Destroy()
                    if visual then visual:Destroy() end
                end
            end
        end
        task.wait() -- avoid one long startup frame while instancing pickup art
    end
    workspace:SetAttribute("FoodPlacementFallbacks", fallbackCount)
    workspace:SetAttribute("FoodCount", #foods)
    workspace:SetAttribute("FoodSpawnStatus", if #foods &gt; 0 then "Ready" else "No valid ground")
    if #foods == 0 then warn("[Be Dino] Food placement failed: no valid terrain hits") end
    local previous = {}
    Players.PlayerRemoving:Connect(function(player) previous[player] = nil end)
    task.spawn(function()
        while true do
            task.wait(Config.FoodTickSeconds)
            local now = os.clock()
            local candidates = {}
            for _, player in Players:GetPlayers() do
                local character = player.Character
                local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
                local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
                if character and root and root:IsA("BasePart") and humanoid and humanoid.Health &gt; 0
                    and character:GetAttribute("DinoAttached") and character:GetAttribute("RunState") == "Active" then
                    local last, position = previous[player], root.Position
                    local plausible = last and last.character == character
                        and MovementEnvelope.plausible(position - last.position, now - last.time, 2, 2, root.AssemblyLinearVelocity.Y, character:GetAttribute("MovementSpeedLimit") or humanoid.WalkSpeed)
                    previous[player] = {character = character, position = position, time = now}
                    if plausible then table.insert(candidates, {player = player, character = character, root = root, gained = 0}) end
                else previous[player] = nil end
            end
            for _, food in foods do
                if now &lt; food.readyAt then continue end
                if food.hidden then
                    relocate(food) -- original valid location remains if no replacement succeeds
                    show(food, true)
                    food.hidden = false
                end
                local winner, nearest = nil, math.huge
                for _, candidate in candidates do
                    local delta = food.part.Position - candidate.root.Position
                    local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
                    local scale = candidate.character:GetAttribute("VisualScale") or 1
                    local radius = math.min(5, Config.FoodPickupRadius + (scale - 1) * 0.75)
                    if horizontal &lt;= radius and math.abs(delta.Y) &lt; 6 then
                        local blocked = workspace:Raycast(candidate.root.Position, delta, pickupParams)
                        if not blocked and (horizontal &lt; nearest or (horizontal == nearest and winner and candidate.player.UserId &lt; winner.player.UserId)) then
                            nearest, winner = horizontal, candidate
                        end
                    end
                end
                if winner then
                    food.readyAt = now + Config.FoodRespawnSeconds
                    food.hidden = true
                    show(food, false)
                    winner.gained += food.kind.points
                end
            end
            for _, candidate in candidates do
                if candidate.gained &gt; 0 then
                    local c = candidate.character
                    local whole, carry = FoodCatchRules.award(candidate.gained, c:GetAttribute("FoodCatchCarry") or 0, c:GetAttribute("WeatherLootMultiplier") or 1)
                    c:SetAttribute("FoodCatchCarry", carry)
                    local before=c:GetAttribute("CatchScore") or 0
                    local after=math.min(Config.MaxCatchScore,Config.RunEggMaxPerRun,before+whole)
                    c:SetAttribute("CatchScore",after)
                    -- BD-044: every catch is one run egg. Only eggs caught during weather carry a
                    -- compact catch-time tag {eventId, mutationId, n=catch ordinal}; clear-weather
                    -- eggs need none. Genes/traits are committed once at settlement.
                    local weatherId=workspace:GetAttribute("WeatherId") or "clear"
                    if after&gt;before and weatherId~="clear" then
                        local ok,events=pcall(function() return Http:JSONDecode(c:GetAttribute("RunEggEvents") or "[]") end)
                        if not ok or typeof(events)~="table" then events={} end
                        for n=before+1,after do
                            local tag=ProgressionRules.eventEgg(weatherId,eventRandom:NextNumber())
                            if tag.eventId~="clear" then tag.n=n table.insert(events,tag) end
                        end
                        c:SetAttribute("RunEggEvents",Http:JSONEncode(events))
                    end
                    dinosaur.addGrowth(c, candidate.gained)
                end
            end
        end
    end)
end
return FoodService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX236">
        <Properties>
          <string name="Name">FusionOdds</string>
          <ProtectedString name="Source">--!strict
-- BD-064 PROVISIONAL fusion trait odds. Pure module: no DataStore, remotes or UI.
--
-- PROVISIONAL (owner decision 2026-10-13: provisional numbers are allowed for the
-- private Milestone 1 playtest; NOT final balance). Every coefficient lives below and
-- the formula is versioned, so a change must bump `Version`; committed outcomes keep
-- the version they were rolled with.
--
-- Formula, for N donors from IdentityFusion's neutral ingredient summary:
--   P(Shiny)              = ShinyCoefficient    * shinyDonors / N     (2/10 -&gt; 10%)
--   P(BIG)                = BigCoefficient      * bigDonors / N
--   P(any event mutation) = MutationCoefficient * mutatedDonors / N
--     P(mutation m)       = MutationCoefficient * donorsWith(m) / N  (proportional pick)
--     P(no mutation)      = 1 - sum(P(m))
--   P(condition c)        = donorsWith(c) / N
--   P(primary color k)    = donorsWithPrimary(k) / N
--   P(secondary color k)  = donorsWithSecondary(k) / N
--   blend                 = uniform integer 1..99, or 100 when both colors are equal
--   pattern               = locked by the recipe (never rolled)
--   hatchSuccess          = true (a fusion result never fails or cracks open)
--
-- `distribution` is the EXACT distribution `roll` samples from: `roll` draws one
-- uniform per wheel in a fixed order and inverts the same tables with sorted keys, so
-- a quote shown to the player is the distribution the server commits against.
local FusionOdds = {}

FusionOdds.Version = "fusion-odds-provisional-v1"
FusionOdds.ShinyCoefficient = 0.5 -- PROVISIONAL
FusionOdds.BigCoefficient = 0.5 -- PROVISIONAL
FusionOdds.MutationCoefficient = 0.5 -- PROVISIONAL
FusionOdds.BlendMin = 1 -- PROVISIONAL (matches Build 020 egg genes)
FusionOdds.BlendMax = 99
FusionOdds.EqualColorBlend = 100
-- Fixed draw order; one uniform per wheel, always consumed (even when blend is fixed).
FusionOdds.DrawOrder = {"shiny", "big", "mutation", "condition", "primaryColor", "secondaryColor", "blend"}

local function sortedKeys(map): {string}
    local keys = {}
    for key in map do table.insert(keys, key) end
    table.sort(keys)
    return keys
end

local function proportional(counts: {[string]: number}, total: number): {[string]: number}
    local result = {}
    for key, n in counts do
        if n &gt; 0 then result[key] = n / total end
    end
    return result
end

-- Returns the exact outcome distribution for a quote summary, or nil, reason.
function FusionOdds.distribution(summary)
    if type(summary) ~= "table" then return nil, "invalid_summary" end
    local n = summary.donorCount
    if type(n) ~= "number" or n &lt; 1 or n % 1 ~= 0 or type(summary.colors) ~= "table" or #summary.colors ~= n
        or type(summary.conditionCounts) ~= "table" or type(summary.mutationCounts) ~= "table"
        or type(summary.shinyCount) ~= "number" or type(summary.bigCount) ~= "number"
        or summary.shinyCount &lt; 0 or summary.shinyCount &gt; n or summary.bigCount &lt; 0 or summary.bigCount &gt; n then
        return nil, "invalid_summary"
    end
    local mutated = 0
    for id, count in summary.mutationCounts do
        if type(id) ~= "string" or id == "" or type(count) ~= "number" or count &lt; 0 then return nil, "invalid_summary" end
        mutated += count
    end
    local conditions = 0
    for id, count in summary.conditionCounts do
        if type(id) ~= "string" or type(count) ~= "number" or count &lt; 0 then return nil, "invalid_summary" end
        conditions += count
    end
    if mutated &gt; n or conditions ~= n then return nil, "invalid_summary" end

    local mutation = {}
    local mutationTotal = 0
    for id, count in summary.mutationCounts do
        if count &gt; 0 then
            mutation[id] = FusionOdds.MutationCoefficient * count / n
            mutationTotal += mutation[id]
        end
    end
    local primary, secondary = {}, {}
    for _, colors in summary.colors do
        if type(colors) ~= "table" or type(colors.primaryColorId) ~= "string" or type(colors.secondaryColorId) ~= "string" then
            return nil, "invalid_summary"
        end
        primary[colors.primaryColorId] = (primary[colors.primaryColorId] or 0) + 1
        secondary[colors.secondaryColorId] = (secondary[colors.secondaryColorId] or 0) + 1
    end
    return {
        version = FusionOdds.Version,
        shiny = FusionOdds.ShinyCoefficient * summary.shinyCount / n,
        big = FusionOdds.BigCoefficient * summary.bigCount / n,
        mutation = mutation,
        noMutation = math.max(0, 1 - mutationTotal),
        condition = proportional(summary.conditionCounts, n),
        primaryColor = proportional(primary, n),
        secondaryColor = proportional(secondary, n),
        blend = {min = FusionOdds.BlendMin, max = FusionOdds.BlendMax, equalColors = FusionOdds.EqualColorBlend},
    }
end

-- Inverse-CDF pick over sorted keys; `u` in [0, 1). Falls back to the last key with
-- positive probability so floating-point sums slightly below 1 never return nil.
local function pick(dist: {[string]: number}, u: number): string?
    local keys = sortedKeys(dist)
    local acc, last = 0, nil
    for _, key in keys do
        local p = dist[key]
        if p &gt; 0 then
            acc += p
            last = key
            if u &lt; acc then return key end
        end
    end
    return last
end
FusionOdds.pick = pick

-- Mutation wheel including the "" (no mutation) outcome; "" sorts first.
local function mutationWheel(dist)
    local wheel = {[""] = dist.noMutation}
    for id, p in dist.mutation do wheel[id] = p end
    return wheel
end
FusionOdds.mutationWheel = mutationWheel

-- Deterministic for a given sequence of uniforms. Returns traits in the shape
-- IdentityFusion.prepareOutcome validates (pattern overwritten by the recipe there).
function FusionOdds.rollWith(summary, patternId: string, nextNumber: () -&gt; number)
    local dist, reason = FusionOdds.distribution(summary)
    if not dist then error(reason) end
    local u = {}
    for i = 1, #FusionOdds.DrawOrder do
        local value = nextNumber()
        assert(type(value) == "number" and value == value, "invalid uniform")
        -- Clamp into [0, 1): Random:NextNumber() edge values must not escape a wheel.
        u[i] = math.clamp(value, 0, 1 - 2 ^ -53)
    end
    local primary = pick(dist.primaryColor, u[5])
    local secondary = pick(dist.secondaryColor, u[6])
    local blend = FusionOdds.BlendMin + math.min(FusionOdds.BlendMax - FusionOdds.BlendMin,
        math.floor(u[7] * (FusionOdds.BlendMax - FusionOdds.BlendMin + 1)))
    if primary == secondary then blend = FusionOdds.EqualColorBlend end
    return {
        shiny = u[1] &lt; dist.shiny,
        big = u[2] &lt; dist.big,
        mutationId = pick(mutationWheel(dist), u[3]) or "",
        genes = {
            patternId = patternId,
            conditionId = pick(dist.condition, u[4]),
            primaryColorId = primary,
            secondaryColorId = secondary,
            blend = blend,
            hatchSuccess = true,
        },
    }
end

-- Roller in the IdentityFusion contract: {version, roll(summary, patternId)}, plus
-- `distribution` for quotes. `newRng` returns an object with NextNumber() in [0, 1).
function FusionOdds.roller(newRng: () -&gt; any)
    return {
        version = FusionOdds.Version,
        distribution = FusionOdds.distribution,
        roll = function(summary, patternId)
            local rng = newRng()
            return FusionOdds.rollWith(summary, patternId, function() return rng:NextNumber() end)
        end,
    }
end

return FusionOdds
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX237">
        <Properties>
          <string name="Name">FusionService</string>
          <ProtectedString name="Source">--!strict
-- BD-064/BD-065 server surface: the FusionAction RemoteFunction in
-- ReplicatedStorage.BeDinoRemotes. Contract: docs/52-fusion-remote-contract.md.
-- Every argument is validated here; ownership, recipes, odds and commits stay in
-- ProfileRepository/IdentityFusion. Clients never supply traits, odds or result IDs.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local FusionService = {}
FusionService.MaxListLimit = 200
FusionService.DefaultListLimit = 100
FusionService.MaxDonorIds = 15 -- largest recipe (Gold = 15 Base); IdentityFusion enforces the exact per-recipe count
FusionService.MaxIdLength = 120
FusionService.MaxDigestLength = 64
FusionService.MaxTokenLength = 80
FusionService.MaxStageLength = 16

local repository: any = nil
local windows: {[any]: {startedAt: number, count: number}} = {}
local clock = os.clock

-- Allowed keys per action; anything else is a bad request.
local Shapes = {
    list = {action = true, cursor = true, limit = true},
    details = {action = true, instanceId = true},
    quote = {action = true, targetStage = true, donorIds = true},
    fuse = {action = true, token = true, targetStage = true, donorIds = true, quoteDigest = true, consentDigest = true},
}

local function fail(reason: string)
    return {ok = false, reason = reason}
end

local function boundedString(value: any, maxLength: number): boolean
    return type(value) == "string" and #value &gt;= 1 and #value &lt;= maxLength
end

local function integer(value: any, min: number, max: number): boolean
    return type(value) == "number" and value == value and value % 1 == 0 and value &gt;= min and value &lt;= max
end

local function donorList(value: any): boolean
    if type(value) ~= "table" then return false end
    local n = #value
    if n &lt; 1 or n &gt; FusionService.MaxDonorIds then return false end
    local count = 0
    for key, id in value do
        count += 1
        if type(key) ~= "number" or not boundedString(id, FusionService.MaxIdLength) then return false end
    end
    return count == n
end

-- Fixed-window per-player limiter (PROVISIONAL Config values).
local function allowed(player: any): boolean
    local now = clock()
    local window = windows[player]
    if not window or now - window.startedAt &gt;= Config.FusionRateWindowSeconds then
        window = {startedAt = now, count = 0}
        windows[player] = window
    end
    window.count += 1
    return window.count &lt;= Config.FusionRequestsPerWindow
end

local function validate(request: any): string?
    if type(request) ~= "table" then return "bad_request" end
    local shape = Shapes[request.action]
    if type(request.action) ~= "string" or not shape then return "bad_request" end
    for key in request do
        if type(key) ~= "string" or not shape[key] then return "bad_request" end
    end
    local action = request.action
    if action == "list" then
        if request.cursor ~= nil and not integer(request.cursor, 0, 2 ^ 53) then return "bad_request" end
        if request.limit ~= nil and not integer(request.limit, 1, FusionService.MaxListLimit) then return "bad_request" end
    elseif action == "details" then
        if not boundedString(request.instanceId, FusionService.MaxIdLength) then return "bad_request" end
    else
        if not boundedString(request.targetStage, FusionService.MaxStageLength) or not donorList(request.donorIds) then
            return "bad_request"
        end
        if action == "fuse" then
            if not boundedString(request.token, FusionService.MaxTokenLength)
                or not boundedString(request.quoteDigest, FusionService.MaxDigestLength)
                or (request.consentDigest ~= nil and not boundedString(request.consentDigest, FusionService.MaxDigestLength)) then
                return "bad_request"
            end
        end
    end
    return nil
end

local function copyList(list: {string}): {string}
    local result = {}
    for i, id in list do result[i] = id end
    return result
end

local function exactOdds(odds: any)
    return {shiny = odds.shiny, big = odds.big, mutation = table.clone(odds.mutation), noMutation = odds.noMutation,
        condition = table.clone(odds.condition), primaryColor = table.clone(odds.primaryColor),
        secondaryColor = table.clone(odds.secondaryColor)}
end

local function handleAction(player: any, request: any)
    local action = request.action
    if action == "list" then
        local page, reason = repository.listDinosaurs(player, request.cursor, request.limit or FusionService.DefaultListLimit)
        if not page then return fail(reason or "fusion_disabled") end
        return {ok = true, dinosaurs = page.dinosaurs, nextCursor = page.nextCursor}
    elseif action == "details" then
        local details, reason = repository.fusionDetails(player, request.instanceId)
        if not details then return fail(reason or "donor_missing") end
        return {ok = true, dinosaur = details}
    elseif action == "quote" then
        local quote, reason = repository.quoteFusion(player, request.targetStage, copyList(request.donorIds))
        if not quote then return fail(reason or "bad_request") end
        if type(quote.odds) ~= "table" or type(quote.oddsVersion) ~= "string" then return fail("odds_not_approved") end
        return {ok = true, quote = {speciesId = quote.speciesId, patternId = quote.patternId, targetStage = quote.targetStage,
            donorIds = quote.donorIds, lossManifest = quote.lossManifest, consentRequired = quote.consentRequired,
            consentDigest = quote.consentDigest, quoteDigest = quote.quoteDigest, recipeVersion = quote.recipeVersion,
            oddsVersion = quote.oddsVersion, odds = exactOdds(quote.odds)}}
    end
    -- fuse: only whitelisted fields reach the repository.
    local ok, result, status = repository.fuseDinosaurs(player, {token = request.token, targetStage = request.targetStage,
        donorIds = copyList(request.donorIds), quoteDigest = request.quoteDigest, consentDigest = request.consentDigest})
    if not ok or type(result) ~= "table" then return fail(status or "save_failed") end
    return {ok = true, status = status, result = {resultId = result.resultId, targetStage = result.targetStage,
        speciesId = result.speciesId, patternId = result.patternId,
        traits = {genes = table.clone(result.traits.genes), big = result.traits.big, shiny = result.traits.shiny,
            mutationId = result.traits.mutationId}, oddsVersion = result.oddsVersion}}
end

-- Entry point for OnServerInvoke (and offline tests). Never throws to the client.
function FusionService.handle(player: any, request: any, ...)
    if not repository then return fail("fusion_disabled") end
    if select("#", ...) ~= 0 then return fail("bad_request") end
    if not allowed(player) then return fail("rate_limited") end
    local invalid = validate(request)
    if invalid then return fail(invalid) end
    local ok, response = pcall(handleAction, player, request)
    if not ok then
        warn("[Be Dino] FusionAction failed: " .. tostring(response))
        return fail("save_failed")
    end
    return response
end

-- Test hook: deterministic clock for the rate limiter.
function FusionService.setClock(fn: () -&gt; number)
    clock = fn
    windows = {}
end

function FusionService.start(profileRepository)
    repository = profileRepository
    local folder = ReplicatedStorage:FindFirstChild("BeDinoRemotes")
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "BeDinoRemotes"
        folder.Parent = ReplicatedStorage
    end
    local existing = folder:FindFirstChild("FusionAction")
    if existing and not existing:IsA("RemoteFunction") then existing:Destroy() existing = nil end
    local remote = existing or Instance.new("RemoteFunction")
    remote.Name = "FusionAction"
    remote.Parent = folder
    remote.OnServerInvoke = function(player, ...)
        return FusionService.handle(player, ...)
    end
    Players.PlayerRemoving:Connect(function(player)
        windows[player] = nil
    end)
    return remote
end

return FusionService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX238">
        <Properties>
          <string name="Name">IdentityFusion</string>
          <ProtectedString name="Source">--!strict
-- BD-057 Phase 1: server-authoritative pattern fusion over the BD-060 identity sidecar.
-- Pure module: no DataStore, RNG, remotes, currencies or UI. Callers run `apply` inside
-- one UpdateAsync transform with an outcome precommitted by `prepareOutcome`.
--
-- Trait randomness is NOT owned here. A roller `{version: string, roll(summary, patternId)}`
-- is injected. No production roller exists until BD-064 approves probabilities, so the
-- only roller in the repository lives in the offline test harness.
local Identity = require(script.Parent.DinosaurIdentity)

local Fusion = {}
Fusion.Version = "bd057-ladder-15-4-2"

-- OWNER DECISION 2026-10-14 (supersedes 50/10/3 of 2026-10-13 and the 10-donor Gold rule; docs/57, docs/58):
-- same species + same pattern at every tier, guaranteed, consumes ALL donors and
-- creates ONE new individual. Gold = 15 Base, Emerald = 4 Gold, Diamond = 2 Emerald.
-- The donor count is per recipe; nothing else may hard-code it.
Fusion.Ladder = {"base", "gold", "emerald", "diamond"}
Fusion.Recipes = {
    gold = {targetStage = "gold", sourceStage = "base", donorCount = 15, version = "gold-same-species-pattern-15-v1"},
    emerald = {targetStage = "emerald", sourceStage = "gold", donorCount = 4, version = "emerald-same-species-pattern-4-v1"},
    diamond = {targetStage = "diamond", sourceStage = "emerald", donorCount = 2, version = "diamond-same-species-pattern-2-v1"},
}
-- Largest approved donor count (remote/list bounds derive from this).
Fusion.MaxDonorCount = 15
-- Stages the grouped collection can represent. Emerald uses the additive optional
-- collection[species].emerald counter (nil == 0).
Fusion.GroupedProjection = {gold = true, emerald = true, diamond = true}

-- Byte preflight for the sidecar after fusion. BD-060 measured ~938 KB per 1,000
-- worst-case identities and a 4 MiB DataStore value limit; this leaves ~1 MiB for the
-- rest of the profile. Development safety ceiling, not a balance value.
Fusion.MaxSidecarBytes = 3200000
Fusion.MaxTokenLength = 80

local copy = Identity.copy

-- Deterministic, key-sorted serialization. Used for snapshots/digests, never persisted
-- as a security boundary on its own.
local function canonical(value): string
    local kind = type(value)
    if kind == "table" then
        local keys = {}
        for key in value do table.insert(keys, key) end
        table.sort(keys, function(a, b) return tostring(a) &lt; tostring(b) end)
        local parts = {}
        for _, key in keys do
            table.insert(parts, string.format("%q", tostring(key)) .. "=" .. canonical(value[key]))
        end
        return "{" .. table.concat(parts, ",") .. "}"
    elseif kind == "string" then
        return string.format("%q", value)
    elseif kind == "number" then
        return string.format("%.17g", value)
    end
    return tostring(value)
end
Fusion.canonical = canonical

-- Two independent 32-bit FNV-1a lanes; equality checks only, not cryptographic.
-- prime = 2^24 + 403, multiplied in two parts to stay exact in doubles.
local function fnvStep(hash: number, byte: number): number
    local x = bit32.bxor(hash, byte)
    return bit32.band(bit32.lshift(x, 24) + x * 403, 0xffffffff)
end
local function digest(text: string): string
    local a, b = 2166136261, 3735928559
    for i = 1, #text do
        local byte = string.byte(text, i)
        a = fnvStep(a, byte)
        b = fnvStep(b, (byte + i) % 256)
    end
    return string.format("%08x%08x%x", a, b, #text)
end
Fusion.digest = digest

-- JSON-equivalent byte estimate (keys, quotes, separators). Approximates Roblox
-- HttpService:JSONEncode closely enough for a conservative preflight.
local function encodedSize(value): number
    local kind = type(value)
    if kind == "table" then
        local n = #value
        local isArray = true
        local count = 0
        for key in value do
            count += 1
            if type(key) ~= "number" or key &lt; 1 or key &gt; n or key % 1 ~= 0 then isArray = false end
        end
        if count == 0 then return 2 end
        local size = 2 + (count - 1)
        for key, child in value do
            if not isArray then size += encodedSize(tostring(key)) + 1 end
            size += encodedSize(child)
        end
        return size
    elseif kind == "string" then
        local escapes = 0
        for _ in string.gmatch(value, "[\"\\%c]") do escapes += 1 end
        return #value + 2 + escapes
    elseif kind == "number" then
        return #string.format("%.14g", value)
    elseif kind == "boolean" then
        return if value then 4 else 5
    end
    return 4
end
Fusion.encodedSize = encodedSize

local function sequence(id: string, ownerKey: string): number?
    local n = tonumber(string.match(id, "^(.*)/d:%d+$") == ownerKey and string.match(id, "/d:(%d+)$") or nil)
    return n
end

-- A fused donor's origin embeds up to 15 immutable parent snapshots; the quote digest
-- needs only the origin identity (kind/operation/versions), keeping quotes O(donors).
local function compactOrigin(origin)
    if type(origin) ~= "table" then return origin end
    local slim = {}
    for key, value in origin do if key ~= "parents" then slim[key] = value end end
    return slim
end

local function hasCosmetics(instance): boolean
    local c = instance.cosmetics
    return type(c) == "table" and (next(c.ownedAuraIds or {}) ~= nil or next(c.ownedTrailIds or {}) ~= nil
        or (c.equippedAuraId or "") ~= "" or (c.equippedTrailId or "") ~= "")
end

local function sortedKeys(set): {string}
    local list = {}
    for key, owned in set or {} do if owned then table.insert(list, key) end end
    table.sort(list)
    return list
end

-- Validates the exact selection against the current sidecar and freezes it.
-- Returns nil, reason on any problem. Never mutates `state`.
function Fusion.quote(state, ownerKey: string, targetStage: any, donorIds: any)
    if type(state) ~= "table" or state.version ~= Identity.Version or type(state.instances) ~= "table" then
        return nil, "identity_unavailable"
    end
    if state.ownerKey ~= ownerKey then return nil, "wrong_owner" end
    if type(targetStage) ~= "string" or not table.find(Fusion.Ladder, targetStage) or targetStage == "base" then
        return nil, "unknown_stage"
    end
    local recipe = Fusion.Recipes[targetStage]
    if not recipe or type(recipe.donorCount) ~= "number" or type(recipe.version) ~= "string" then
        return nil, "recipe_not_approved"
    end
    if type(donorIds) ~= "table" or #donorIds ~= recipe.donorCount then return nil, "wrong_donor_count" end
    local count = 0
    for _ in donorIds do count += 1 end
    if count ~= recipe.donorCount then return nil, "wrong_donor_count" end

    local seen, donors = {}, {}
    local speciesId, patternId = nil, nil
    for _, id in donorIds do
        if type(id) ~= "string" or #id &lt; 1 or #id &gt; 120 then return nil, "invalid_donor_id" end
        if seen[id] then return nil, "duplicate_donor" end
        seen[id] = true
        if sequence(id, ownerKey) == nil then return nil, "wrong_owner" end
        local instance = state.instances[id]
        if type(instance) ~= "table" then return nil, "donor_missing" end
        if instance.instanceId ~= id then return nil, "invalid_instance" end
        if instance.stage ~= recipe.sourceStage then return nil, "wrong_stage" end
        if instance.locked == true or instance.favorited == true then return nil, "donor_locked" end
        if instance.traitsKnown ~= true or type(instance.genes) ~= "table"
            or type(instance.genes.patternId) ~= "string" or instance.genes.patternId == "" then
            return nil, "missing_pattern"
        end
        speciesId = speciesId or instance.speciesId
        patternId = patternId or instance.genes.patternId
        if instance.speciesId ~= speciesId then return nil, "species_mismatch" end
        if instance.genes.patternId ~= patternId then return nil, "pattern_mismatch" end
        table.insert(donors, instance)
    end
    table.sort(donors, function(a, b) return a.instanceId &lt; b.instanceId end)

    -- Neutral ingredient facts for a future BD-064 roller. Contains no probabilities.
    local summary = {speciesId = speciesId, patternId = patternId, targetStage = targetStage,
        donorCount = #donors, shinyCount = 0, bigCount = 0, mutationCounts = {}, conditionCounts = {}, colors = {}}
    local losses, sortedIds, snapshot = {}, {}, {}
    for _, d in donors do
        table.insert(sortedIds, d.instanceId)
        if d.shiny then summary.shinyCount += 1 end
        if d.big then summary.bigCount += 1 end
        if (d.mutationId or "") ~= "" then summary.mutationCounts[d.mutationId] = (summary.mutationCounts[d.mutationId] or 0) + 1 end
        local conditionId = d.genes.conditionId or "unknown"
        summary.conditionCounts[conditionId] = (summary.conditionCounts[conditionId] or 0) + 1
        table.insert(summary.colors, {primaryColorId = d.genes.primaryColorId, secondaryColorId = d.genes.secondaryColorId, blend = d.genes.blend})
        -- Exact frozen payload: any change to a donor (genes, traits, cosmetics,
        -- stage, protection) after quoting invalidates the quote.
        table.insert(snapshot, {instanceId = d.instanceId, bucketKey = d.bucketKey, stage = d.stage, speciesId = d.speciesId,
            genes = d.genes, big = d.big, shiny = d.shiny, mutationId = d.mutationId, cosmetics = d.cosmetics,
            locked = d.locked, favorited = d.favorited, origin = compactOrigin(d.origin)})
        -- Itemized irreversible loss: purchased looks AND valuable natural traits.
        local auras = sortedKeys(d.cosmetics and d.cosmetics.ownedAuraIds)
        local trails = sortedKeys(d.cosmetics and d.cosmetics.ownedTrailIds)
        local valuable = d.shiny == true or d.big == true or (d.mutationId or "") ~= ""
        if hasCosmetics(d) or valuable then
            table.insert(losses, {instanceId = d.instanceId, auraIds = auras, trailIds = trails,
                equippedAuraId = d.cosmetics and d.cosmetics.equippedAuraId or "",
                equippedTrailId = d.cosmetics and d.cosmetics.equippedTrailId or "",
                shiny = d.shiny == true, big = d.big == true, mutationId = d.mutationId or ""})
        end
    end
    local snapshotText = canonical(snapshot)
    return {
        targetStage = targetStage,
        recipeVersion = recipe.version,
        sourceStage = recipe.sourceStage,
        speciesId = speciesId,
        patternId = patternId,
        donorIds = sortedIds,
        summary = summary,
        lossManifest = losses,
        consentRequired = #losses &gt; 0,
        consentDigest = digest(canonical(losses)),
        -- Identifies the request independent of donor contents (idempotency/conflicts).
        requestDigest = digest(canonical({targetStage = targetStage, donorIds = sortedIds})),
        -- Identifies the exact frozen donor payloads (stale-writer detection).
        quoteDigest = digest(snapshotText),
        snapshot = snapshotText,
    }
end

local function validTraits(traits, patternId: string, validateGenes): boolean
    if type(traits) ~= "table" or traits.stage ~= nil then return false end
    if type(traits.big) ~= "boolean" or type(traits.shiny) ~= "boolean" or type(traits.mutationId) ~= "string" then return false end
    local genes = traits.genes
    if type(genes) ~= "table" or genes.patternId ~= patternId then return false end
    if type(genes.primaryColorId) ~= "string" or type(genes.secondaryColorId) ~= "string"
        or type(genes.conditionId) ~= "string" or type(genes.blend) ~= "number"
        or genes.blend ~= genes.blend or genes.blend &lt; 0 or genes.blend &gt; 100 then return false end
    for key, value in genes do
        if type(key) ~= "string" or (type(value) ~= "string" and type(value) ~= "number" and type(value) ~= "boolean") then return false end
    end
    if validateGenes and not validateGenes(genes) then return false end
    return true
end

-- Call ONCE outside UpdateAsync. Retries reuse the returned outcome, so a write retry
-- can never reroll traits. The guaranteed stage comes from the recipe, never the roller.
function Fusion.prepareOutcome(quote, roller, validateGenes)
    if type(roller) ~= "table" or type(roller.version) ~= "string" or #roller.version == 0
        or type(roller.roll) ~= "function" then return nil, "odds_not_approved" end
    local ok, traits = pcall(roller.roll, copy(quote.summary), quote.patternId)
    if not ok or not validTraits(traits, quote.patternId, validateGenes) then return nil, "invalid_outcome" end
    traits = copy(traits)
    traits.genes.patternId = quote.patternId -- pattern is recipe-locked, not rolled
    return {oddsVersion = roller.version, requestDigest = quote.requestDigest,
        quoteDigest = quote.quoteDigest, targetStage = quote.targetStage, traits = traits}
end

-- Groups a donor's bucket key back to its grouped collection counter.
local function groupedCounter(entry, bucketKey: string, speciesId: string)
    local prefix = speciesId .. "/"
    if string.sub(bucketKey, 1, #prefix) ~= prefix then return nil end
    local rest = string.sub(bucketKey, #prefix + 1)
    if rest == "base" or rest == "gold" or rest == "emerald" or rest == "diamond" then
        return function() return entry[rest] or 0 end, function(n) entry[rest] = n end
    end
    local eventId = string.match(rest, "^event/(.+)$")
    if eventId then
        return function() return (entry.events or {})[eventId] end,
            function(n) entry.events[eventId] = n end
    end
    local variantKey = string.match(rest, "^variant/(.+)$")
    if variantKey then
        local variants = entry.variants or {}
        return function() local v = variants[variantKey] return v and v.count end,
            function(n) if n == 0 then variants[variantKey] = nil else variants[variantKey].count = n end end
    end
    return nil
end

-- Copy-on-write transaction body. Returns (newProfile, "fused", result) on success,
-- (originalProfile, "duplicate", result) on an idempotent replay, or (nil, reason)
-- on any failure. The passed profile is never mutated; returning nil from an
-- UpdateAsync transform aborts the write, so every failure is a full rollback.
function Fusion.apply(profile, ownerKey: string, request, outcome, now: number?)
    if type(profile) ~= "table" or type(profile.collection) ~= "table" then return nil, "invalid_profile" end
    if type(request) ~= "table" or type(request.token) ~= "string" or #request.token &lt; 1
        or #request.token &gt; Fusion.MaxTokenLength then return nil, "invalid_token" end
    local operationId = "fusion:" .. request.token
    local state = profile.dinosaurIdentity
    if type(state) ~= "table" then return nil, "identity_unavailable" end
    local ledger = state.fusions
    if ledger ~= nil and type(ledger) ~= "table" then return nil, "invalid_fusion_ledger" end

    local requestDigest = digest(canonical({targetStage = request.targetStage,
        donorIds = (function()
            local ids = {}
            for _, id in (if type(request.donorIds) == "table" then request.donorIds else {}) do table.insert(ids, tostring(id)) end
            table.sort(ids)
            return ids
        end)()}))
    local existing = ledger and ledger[operationId]
    if existing then
        if existing.requestDigest ~= requestDigest then return nil, "token_conflict" end
        return profile, "duplicate", copy(existing.outcome)
    end

    local quote, reason = Fusion.quote(state, ownerKey, request.targetStage, request.donorIds)
    if not quote then return nil, reason end
    if type(outcome) ~= "table" or outcome.requestDigest ~= quote.requestDigest then return nil, "invalid_outcome" end
    -- Stale writer: a donor changed between quote/roll and this transaction.
    if outcome.quoteDigest ~= quote.quoteDigest or request.quoteDigest ~= quote.quoteDigest then return nil, "stale_quote" end
    if quote.consentRequired and request.consentDigest ~= quote.consentDigest then return nil, "consent_required" end
    if not validTraits(outcome.traits, quote.patternId, nil) or outcome.targetStage ~= quote.targetStage then
        return nil, "invalid_outcome"
    end
    if not Fusion.GroupedProjection[quote.targetStage] then return nil, "projection_unsupported" end

    local nextProfile = copy(profile)
    local nextState = nextProfile.dinosaurIdentity
    nextState.fusions = nextState.fusions or {}
    local entry = nextProfile.collection[quote.speciesId]
    if type(entry) ~= "table" then return nil, "grouped_mismatch" end

    -- Consume every donor exactly once, keeping the grouped projection in lockstep.
    local parents, parentEggIds, parentOperationIds = {}, {}, {}
    for _, id in quote.donorIds do
        local donor = nextState.instances[id]
        local get, set = groupedCounter(entry, donor.bucketKey, quote.speciesId)
        local current = get and get()
        if type(current) ~= "number" or current &lt; 1 then return nil, "grouped_mismatch" end
        set(current - 1)
        table.insert(parents, donor)
        if donor.origin and donor.origin.kind == "hatch" and not table.find(parentEggIds, donor.origin.eggId) then
            table.insert(parentEggIds, donor.origin.eggId) -- one entry per shared egg
        end
        if donor.origin and donor.origin.kind == "fusion" then table.insert(parentOperationIds, donor.origin.operationId) end
    end
    entry[quote.targetStage] = (entry[quote.targetStage] or 0) + 1

    -- Exactly one NEW individual; server-allocated ID from the persisted sequence.
    local resultId = nextState.ownerKey .. "/d:" .. tostring(nextState.nextId)
    nextState.nextId += 1
    if nextState.instances[resultId] then return nil, "identity_collision" end
    local traits = outcome.traits
    local built, result = pcall(Identity.fusionRecord, resultId, {
        speciesId = quote.speciesId, stage = quote.targetStage, genes = copy(traits.genes),
        big = traits.big, shiny = traits.shiny, mutationId = traits.mutationId,
        traitRollVersion = outcome.oddsVersion,
    }, parents, operationId, quote.recipeVersion, outcome.oddsVersion)
    if not built then return nil, "invalid_outcome" end
    for _, id in quote.donorIds do nextState.instances[id] = nil end
    nextState.instances[resultId] = result

    local committed = {operationId = operationId, resultId = resultId, targetStage = quote.targetStage,
        speciesId = quote.speciesId, patternId = quote.patternId, consumedIds = copy(quote.donorIds),
        recipeVersion = quote.recipeVersion, oddsVersion = outcome.oddsVersion, traits = copy(traits)}
    -- Durable, never-trimmed ledger: idempotent replay plus lineage that outlives the
    -- consumed parents (their egg snapshots stay referenced through parentEggIds).
    nextState.fusions[operationId] = {operationId = operationId, requestDigest = quote.requestDigest,
        quoteDigest = quote.quoteDigest, resultId = resultId, targetStage = quote.targetStage,
        speciesId = quote.speciesId, patternId = quote.patternId, recipeVersion = quote.recipeVersion,
        oddsVersion = outcome.oddsVersion, parentIds = copy(quote.donorIds), parentEggIds = parentEggIds,
        parentOperationIds = parentOperationIds, committedAt = now or 0, outcome = committed}

    -- Whole-state consistency check: grouped projection vs identities, ledger, eggs.
    local reconciled, reconcileReason = Identity.reconcile(nextProfile.collection, nextState, ownerKey)
    if not reconciled then return nil, reconcileReason end
    if encodedSize(reconciled) &gt; Fusion.MaxSidecarBytes then return nil, "storage_limit" end
    nextProfile.dinosaurIdentity = reconciled
    return nextProfile, "fused", copy(committed)
end

-- Read-only lineage view for later Dino Details (BD-062). Resolves parent egg
-- snapshots from the ledger even after the parents were consumed.
function Fusion.lineage(state, operationId: string)
    local entry = type(state) == "table" and type(state.fusions) == "table" and state.fusions[operationId]
    if type(entry) ~= "table" then return nil end
    local eggs = {}
    for _, eggId in entry.parentEggIds do eggs[eggId] = copy(state.eggs[eggId]) end
    return {operationId = operationId, resultId = entry.resultId, parentIds = copy(entry.parentIds),
        parentOperationIds = copy(entry.parentOperationIds), recipeVersion = entry.recipeVersion,
        oddsVersion = entry.oddsVersion, parentEggs = eggs}
end

return Fusion
</ProtectedString>
        </Properties>
