      <Item class="ModuleScript" referent="RBX182">
        <Properties>
          <string name="Name">DinosaurPreview</string>
          <ProtectedString name="Source">--!strict
local Resources=require(script.Parent.ResourceModels)
local Camera=require(script.Parent.PreviewCamera)
local ContentProvider=game:GetService("ContentProvider")
local Preview={}
local RunService=game:GetService("RunService")
local Http=game:GetService("HttpService")
local Appearance=require(script.Parent.EggAppearance)
local function visible(view)
    local low,high=view.AbsolutePosition,view.AbsolutePosition+view.AbsoluteSize
    if view.AbsoluteSize.X&lt;=0 or view.AbsoluteSize.Y&lt;=0 then return false end
    local ancestor=view
    while ancestor do
        if ancestor:IsA("GuiObject") then
            if not ancestor.Visible then return false end
            if ancestor.ClipsDescendants then
                local a,b=ancestor.AbsolutePosition,ancestor.AbsolutePosition+ancestor.AbsoluteSize
                if high.X&lt;=a.X or high.Y&lt;=a.Y or low.X&gt;=b.X or low.Y&gt;=b.Y then return false end
            end
        elseif ancestor:IsA("ScreenGui") and not ancestor.Enabled then return false end
        ancestor=ancestor.Parent
    end
    return true
end
function Preview.add(parent: GuiObject,speciesId: string,gold: (boolean | string)): ViewportFrame
    local viewport=Instance.new("ViewportFrame")
    viewport.Name,viewport.BackgroundTransparency="DinosaurPreview",1
    viewport.Size=UDim2.new(1,0,0,140)
    viewport.Ambient,viewport.LightColor,viewport.LightDirection=Color3.fromRGB(190,210,218),Color3.fromRGB(255,246,226),Vector3.new(-1,-1,-1)
    viewport.ZIndex,viewport.Parent=parent.ZIndex+1,parent
    local function load()
    local model=Resources.clone(speciesId)
    if model and not viewport.Parent then model:Destroy();return end
    if model then
        local world=Instance.new("WorldModel") world.Parent=viewport
        for _,item in model:GetDescendants() do
            if item:IsA("BasePart") then
                item.Anchored=true
                if gold==true or gold=="gold" or gold=="diamond" then Resources.clearTextures(item) end
                if gold == "diamond" then item.Color=Color3.fromRGB(85,213,245) item.Material=Enum.Material.Glass item.Reflectance=.2
                elseif gold == true or gold == "gold" then item.Color=Color3.fromRGB(242,199,63) item.Material=Enum.Material.Metal end
            end
        end
        model:PivotTo(CFrame.new())
        model.Parent=world
        local encoded=viewport:GetAttribute("TraitsJson")
        if encoded then local ok,traits=pcall(function() return Http:JSONDecode(encoded) end);if ok and traits.genes then Appearance.apply(model,traits.genes) end end
        Camera.bind(viewport,model,speciesId)
        task.spawn(function()
            local assets={}
            for _,part in model:GetDescendants() do
                if part:IsA("MeshPart") and part.MeshId~="" then table.insert(assets,part) end
            end
            local uploadedId=model:GetAttribute("UploadedModelId")
            if #assets==0 or not uploadedId then return end
            local failed=false
            local ok=pcall(function() ContentProvider:PreloadAsync(assets,function(_,status)
                if status~=Enum.AssetFetchStatus.Success then failed=true end
            end) end)
            if not viewport.Parent or (ok and not failed) then return end
            -- Keep the actual species visible when the uploaded mesh is unavailable.
            local image=Instance.new("ImageLabel")
            image.Name,image.BackgroundTransparency,image.BorderSizePixel="ModelThumbnailFallback",1,0
            image.Size,image.ScaleType=UDim2.fromScale(1,1),Enum.ScaleType.Fit
            image.Image="rbxthumb://type=Asset&amp;id="..tostring(uploadedId).."&amp;w=420&amp;h=420"
            image.ZIndex,image.Parent=viewport.ZIndex+1,viewport
            pcall(function() ContentProvider:PreloadAsync({image}) end)
            if image.Parent then viewport:SetAttribute("PreviewFallback","AssetThumbnail") end
        end)
    end
    end
    local data=script.Parent:FindFirstChild("CreatureData")
    if data and data:FindFirstChild(speciesId) then
        local elapsed=0;local loading=false
        local connection=RunService.Heartbeat:Connect(function(dt)
            elapsed+=dt;if elapsed&lt;.25 or loading then return end;elapsed=0
            local world=viewport:FindFirstChildOfClass("WorldModel")
            if visible(viewport) then
                if not world then loading=true;task.spawn(function() if viewport.Parent then load() end;loading=false end) end
            elseif world then world:Destroy() end
        end)
        viewport.Destroying:Once(function() connection:Disconnect() end)
    else load() end
    return viewport
end
return Preview
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX183">
        <Properties>
          <string name="Name">DinosaurVisual</string>
          <ProtectedString name="Source">--!strict
-- Imported mesh first; original procedural shell remains an explicit fallback.
local Dinosaur = {}
local Resources = require(script.Parent.ResourceModels)
local Config = require(script.Parent.Config)


local GOLD_PALETTE = {
    primary = Color3.fromRGB(236, 185, 52),
    light = Color3.fromRGB(255, 229, 126),
    dark = Color3.fromRGB(151, 102, 22),
    accent = Color3.fromRGB(255, 244, 183),
}

local DIAMOND_PALETTE = {primary=Color3.fromRGB(85,213,245),light=Color3.fromRGB(211,249,255),dark=Color3.fromRGB(36,115,171),accent=Color3.fromRGB(242,255,255)}
local PALETTES = {
    raptor = {primary=Color3.fromRGB(186,104,153),light=Color3.fromRGB(239,192,212),dark=Color3.fromRGB(106,54,97),accent=Color3.fromRGB(247,210,137)},
    stegosaurus = {primary=Color3.fromRGB(131,167,74),light=Color3.fromRGB(208,227,151),dark=Color3.fromRGB(72,107,56),accent=Color3.fromRGB(239,169,89)},
    ankylosaurus = {primary=Color3.fromRGB(148,115,78),light=Color3.fromRGB(221,194,142),dark=Color3.fromRGB(88,69,56),accent=Color3.fromRGB(238,218,173)},
    compy = {
        primary = Color3.fromRGB(91, 174, 114),
        light = Color3.fromRGB(191, 225, 147),
        dark = Color3.fromRGB(48, 107, 72),
        accent = Color3.fromRGB(245, 198, 92),
    },
    triceratops = {
        primary = Color3.fromRGB(92, 148, 188),
        light = Color3.fromRGB(184, 219, 222),
        dark = Color3.fromRGB(58, 91, 128),
        accent = Color3.fromRGB(239, 205, 135),
    },
    tyrannosaurus = {
        primary = Color3.fromRGB(191, 116, 69),
        light = Color3.fromRGB(232, 176, 116),
        dark = Color3.fromRGB(117, 65, 48),
        accent = Color3.fromRGB(239, 215, 152),
    },
}

local function scaleForScore(score: number): number
    return math.min(4, math.sqrt(1 + math.max(0, score) / 50))
end

local function normalizedSpecies(speciesId: any): string
    if typeof(speciesId) == "string" and Config.SpeciesRarities[speciesId] then
        return speciesId
    end
    return "compy"
end

function Dinosaur.render(character: Model, scale: number, requestedSpeciesId: string?, isGold: (boolean | string)?)
    local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return end

    local speciesId = normalizedSpecies(requestedSpeciesId or character:GetAttribute("SpeciesId"))
    local mutation = if isGold == "diamond" then "diamond" elseif isGold == true or isGold == "gold" then "gold" else "base"
    local gold = mutation == "gold"
    local palette = if mutation == "diamond" then DIAMOND_PALETTE elseif gold then GOLD_PALETTE else PALETTES[speciesId] or PALETTES.compy

    local existing = character:FindFirstChild("DinoVisual")
    if existing and existing:GetAttribute("ResourceSpecies") == speciesId and existing:GetAttribute("ResourceMutation") == mutation then
        local previousScale = character:GetAttribute("VisualScale") or 1
        local ratio = scale / previousScale
        local floorOffset = root.Size.Y / 2 + humanoid.HipHeight
        if humanoid.RigType == Enum.HumanoidRigType.R6 then
            local leg = character:FindFirstChild("Left Leg") :: BasePart?
            floorOffset += if leg then leg.Size.Y else 2
        end
        local ground = Vector3.new(0,floorOffset,0)
        for _, item in existing:GetDescendants() do
            if item:IsA("BasePart") then
                item.Size *= ratio
                local weld = item:FindFirstChild("ResourceWeld")
                if weld and weld:IsA("Weld") then
                    weld.C0 = CFrame.new((weld.C0.Position + ground) * ratio - ground) * weld.C0.Rotation
                end
            end
        end
        character:SetAttribute("VisualScale",scale)
        return
    end

    local old = character:FindFirstChild("DinoVisual")
    if old then old:Destroy() end
    local visual = Instance.new("Model")
    visual.Name = "DinoVisual"
    visual.Parent = character

    local groundHeight = root.Size.Y / 2 + humanoid.HipHeight
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        local leg = character:FindFirstChild("Left Leg") :: BasePart?
        groundHeight += if leg then leg.Size.Y else 2
    end
    local imported = Resources.clone(speciesId)
    if imported then
        visual:Destroy()
        visual = imported
        visual.Name = "DinoVisual"
        visual:SetAttribute("ResourceSpecies",speciesId)
        visual:SetAttribute("ResourceGold",gold)
        visual:SetAttribute("ResourceMutation",mutation)
        visual:ScaleTo(scale)
        visual:PivotTo(root.CFrame * CFrame.new(0, -groundHeight, 0))
        visual.Parent = character
        for _, item in visual:GetDescendants() do
            if item:IsA("BasePart") then
                item.Anchored = false
                if mutation ~= "base" then Resources.clearTextures(item) item.Color = palette.primary item.Material = if gold then Enum.Material.Metal else Enum.Material.Glass item.Reflectance = if gold then .08 else .2 end
                local weld = Instance.new("Weld")
                weld.Name = "ResourceWeld"
                weld.C0 = root.CFrame:ToObjectSpace(item.CFrame)
                weld.Part0 = root
                weld.Part1 = item
                weld.Parent = item
            end
        end
        character:SetAttribute("SpeciesId", speciesId)
        character:SetAttribute("GoldVisual", gold)
        character:SetAttribute("MutationVisual", mutation)
        character:SetAttribute("VisualScale", scale)
        character:SetAttribute("VisualSource", "Packaged resource model")
        return
    end
    character:SetAttribute("VisualSource", "Procedural fallback: import resources/models")
    local shift = Vector3.new(0, (if speciesId == "tyrannosaurus" then 3.455 else if speciesId == "triceratops" then 3.125 else 2.98) * scale - groundHeight, 0)

    local function piece(
        name: string,
        size: Vector3,
        position: Vector3,
        color: Color3,
        rotation: Vector3?,
        shape: Enum.PartType?
    )
        local part = Instance.new("Part")
        part.Name = name
        part.Shape = shape or Enum.PartType.Ball
        part.Size = size * scale
        part.Color = color
        part.Material = if mutation == "diamond" then Enum.Material.Glass elseif gold then Enum.Material.Metal else Enum.Material.SmoothPlastic
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.Massless = true
        part.CastShadow = true

        local r = rotation or Vector3.zero
        local offset = CFrame.new(position * scale + shift)
            * CFrame.Angles(math.rad(r.X), math.rad(r.Y), math.rad(r.Z))
        part.CFrame = root.CFrame * offset
        part.Parent = visual

        local weld = Instance.new("Weld")
        weld.Name = "VisualWeld"
        weld.Part0 = root
        weld.Part1 = part
        weld.C0 = offset
        weld.Parent = part
        return part
    end

    local function eye(side: number, x: number, y: number, z: number)
        piece("EyeWhite" .. side, Vector3.new(0.34, 0.55, 0.42), Vector3.new(side * x, y, z),
            Color3.fromRGB(249, 247, 226), Vector3.zero, Enum.PartType.Ball)
        piece("Pupil" .. side, Vector3.new(0.22, 0.30, 0.22), Vector3.new(side * (x + 0.10), y, z - 0.14),
            Color3.fromRGB(25, 37, 31), Vector3.zero, Enum.PartType.Ball)
    end

    if speciesId == "compy" then
        piece("Body", Vector3.new(2.2, 1.65, 3.1), Vector3.new(0, -0.75, 0.25), palette.primary, nil, Enum.PartType.Ball)
        piece("Chest", Vector3.new(1.65, 1.15, 1.9), Vector3.new(0, -1.25, -0.65), palette.light, nil, Enum.PartType.Ball)
        piece("Head", Vector3.new(2.15, 1.55, 1.95), Vector3.new(0, 0.15, -1.85), palette.primary, nil, Enum.PartType.Ball)
        piece("Snout", Vector3.new(1.75, 0.75, 1.25), Vector3.new(0, -0.10, -3.0), palette.light, nil, Enum.PartType.Ball)
        piece("Tail", Vector3.new(0.95, 0.95, 3.4), Vector3.new(0, -0.75, 2.85), palette.primary, Vector3.new(-12,0,0))
        piece("TailTip", Vector3.new(0.48, 0.48, 2.0), Vector3.new(0, -0.15, 5.15), palette.dark, Vector3.new(-20,0,0))
        for _, side in {-1, 1} do
            piece("Leg" .. side, Vector3.new(0.68, 1.45, 0.78), Vector3.new(side * 0.78, -2.05, 0.25), palette.dark)
            piece("Foot" .. side, Vector3.new(0.8, 0.32, 1.45), Vector3.new(side * 0.78, -2.82, -0.10), palette.primary)
            piece("Arm" .. side, Vector3.new(0.38, 0.44, 0.95), Vector3.new(side * 1.0, -0.72, -1.18), palette.primary, Vector3.new(18,0,side*12))
            eye(side, 0.92, 0.45, -2.15)
        end
        for i = 1, 4 do
            piece("BackSpike" .. i, Vector3.new(0.30, 0.75, 0.42),
                Vector3.new(0, 0.22, 0.95 + (i - 1) * 0.68), palette.accent, Vector3.new(0,0,45))
        end
        piece("Crest", Vector3.new(0.50, 0.85, 0.75), Vector3.new(0, 1.02, -1.45), palette.accent, Vector3.new(0,0,45))
    elseif speciesId == "triceratops" then
        piece("Body", Vector3.new(3.35, 1.95, 3.75), Vector3.new(0, -0.95, 0.35), palette.primary, nil, Enum.PartType.Ball)
        piece("Belly", Vector3.new(2.35, 0.85, 2.7), Vector3.new(0, -1.70, 0.20), palette.light, nil, Enum.PartType.Ball)
        piece("Head", Vector3.new(2.75, 1.75, 2.0), Vector3.new(0, -0.05, -2.0), palette.primary, nil, Enum.PartType.Ball)
        piece("Muzzle", Vector3.new(2.15, 0.90, 1.25), Vector3.new(0, -0.43, -3.1), palette.light, nil, Enum.PartType.Ball)
        piece("Frill", Vector3.new(3.7, 2.75, 0.42), Vector3.new(0, 0.48, -0.95), palette.dark)
        piece("Tail", Vector3.new(1.05, 1.0, 2.25), Vector3.new(0, -1.05, 2.95), palette.primary, Vector3.new(-8,0,0))
        for _, side in {-1, 1} do
            piece("FrontLeg" .. side, Vector3.new(0.75, 1.45, 0.90), Vector3.new(side * 1.12, -2.15, -1.0), palette.dark)
            piece("RearLeg" .. side, Vector3.new(0.82, 1.55, 0.95), Vector3.new(side * 1.12, -2.15, 1.2), palette.dark)
            piece("FootA" .. side, Vector3.new(0.92, 0.35, 1.15), Vector3.new(side * 1.12, -2.95, -1.18), palette.primary)
            piece("FootB" .. side, Vector3.new(0.92, 0.35, 1.15), Vector3.new(side * 1.12, -2.95, 1.05), palette.primary)
            eye(side, 1.06, 0.33, -2.18)
            piece("BrowHorn" .. side, Vector3.new(0.30, 0.30, 1.55), Vector3.new(side * 0.72, 1.05, -2.62),
                palette.accent, Vector3.new(-26,0,0))
        end
        piece("NoseHorn", Vector3.new(0.28, 0.28, 1.20), Vector3.new(0, 0.32, -3.9), palette.accent, Vector3.new(-14,0,0))
        for _, side in {-1, 1} do
            piece("FrillDot" .. side, Vector3.new(0.35, 0.35, 0.22), Vector3.new(side * 1.25, 0.78, -1.20),
                palette.accent, nil, Enum.PartType.Ball)
        end
    else
        piece("Body", Vector3.new(3.0, 2.2, 3.8), Vector3.new(0, -0.85, 0.35), palette.primary, nil, Enum.PartType.Ball)
        piece("Belly", Vector3.new(2.0, 1.05, 2.75), Vector3.new(0, -1.55, -0.05), palette.light, nil, Enum.PartType.Ball)
        piece("Head", Vector3.new(3.05, 2.05, 2.55), Vector3.new(0, 0.18, -2.1), palette.primary, nil, Enum.PartType.Ball)
        piece("Muzzle", Vector3.new(2.65, 1.05, 1.65), Vector3.new(0, -0.15, -3.55), palette.light, nil, Enum.PartType.Ball)
        piece("Jaw", Vector3.new(2.55, 0.55, 1.65), Vector3.new(0, -0.78, -3.38), palette.dark)
        piece("Tail", Vector3.new(1.15, 1.05, 3.1), Vector3.new(0, -0.82, 3.15), palette.primary, Vector3.new(-10,0,0))
        piece("TailTip", Vector3.new(0.60, 0.60, 2.0), Vector3.new(0, -0.15, 5.35), palette.dark, Vector3.new(-18,0,0))
        for _, side in {-1, 1} do
            piece("Thigh" .. side, Vector3.new(1.0, 1.45, 1.1), Vector3.new(side * 1.05, -1.85, 0.9), palette.dark, nil, Enum.PartType.Ball)
            piece("Leg" .. side, Vector3.new(0.72, 1.35, 0.75), Vector3.new(side * 1.05, -2.70, 0.45), palette.dark)
            piece("Foot" .. side, Vector3.new(1.0, 0.35, 1.55), Vector3.new(side * 1.05, -3.28, -0.05), palette.primary)
            piece("TinyArm" .. side, Vector3.new(0.30, 0.34, 0.72), Vector3.new(side * 1.35, -0.66, -1.30), palette.primary, Vector3.new(24,0,side*8))
            eye(side, 1.24, 0.63, -2.42)
        end
        for i = 1, 3 do
            piece("NeckRidge" .. i, Vector3.new(0.34, 0.65, 0.50),
                Vector3.new(0, 0.82, -0.55 + (i - 1) * 0.72), palette.accent, Vector3.new(0,0,45))
        end
    end

    if gold then
        piece("GoldBadge", Vector3.new(0.52, 0.52, 0.52), Vector3.new(0, 1.45, 0.15),
            GOLD_PALETTE.accent, Vector3.zero, Enum.PartType.Ball)
    end

    character:SetAttribute("SpeciesId", speciesId)
    character:SetAttribute("GoldVisual", gold)
        character:SetAttribute("MutationVisual", mutation)
    character:SetAttribute("VisualScale", scale)
end

return Dinosaur
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX184">
        <Properties>
          <string name="Name">EggAppearance</string>
          <ProtectedString name="Source">--!strict
local Genetics=require(script.Parent.EggGenetics)
local Textures=require(script.Parent.GeneTextures)
local Appearance={}
local Patterns=require(script.Parent.PatternGenes)
function Appearance.apply(container: Instance,genes)
    if not genes or not Genetics.valid(genes) then return end
    local tint=Genetics.tint(genes)
    for _,part in container:GetDescendants() do
        if part:IsA("BasePart") then
            if part:IsA("MeshPart") and Patterns.apply(part,genes) then continue end
            local original=part:GetAttribute("GeneOriginalColor")
            if typeof(original)~="Color3" then original=part.Color part:SetAttribute("GeneOriginalColor",original) end
            -- Preserve texture detail and geometry; SurfaceAppearance needs its own tint.
            local brightness=math.max(original.R,original.G,original.B)
            part.Color=if part:IsA("MeshPart") then tint else Color3.new(tint.R*brightness,tint.G*brightness,tint.B*brightness)
            if part:IsA("MeshPart") then Textures.apply(part) end
            for _,surface in part:GetChildren() do
                if surface:IsA("SurfaceAppearance") then surface.Color=tint end
            end
        end
    end
end
return Appearance
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX185">
        <Properties>
          <string name="Name">EggGenetics</string>
          <ProtectedString name="Source">--!strict
local Config=require(script.Parent.ProgressionConfig)
local Genetics={}
Genetics.BlendMode="uniform"
Genetics.Patterns={"01_blank","02_emerald_islands","03_round_spots","04_bold_patches","05_horizontal_bands","06_wavy_stripes","07_diamond_scales","08_freckles"}
local function item(rows,id)
    for _,row in rows do if row.id==id then return row end end
    return nil
end
function Genetics.condition(id) return item(Config.Conditions,id) end
function Genetics.color(id) return item(Config.EggColors,id) end
local function pick(weights,roll)
    local total=0 for _,weight in weights do total+=weight end
    local value=math.clamp(roll,0,1)*total
    for i,weight in weights do value-=weight if value&lt;0 then return i end end
    return #weights
end
function Genetics.roll(level,rng)
    local weights=Config.ConditionWeights[math.clamp(level or 0,0,#Config.ConditionWeights-1)+1]
    local condition=Config.Conditions[pick(weights,rng:NextNumber())]
    local colors={} for _,color in Config.EggColors do table.insert(colors,color.weight) end
    local hatchRoll=rng:NextNumber()
    local genes={conditionId=condition.id,hatchSuccess=condition.hatchChance==1 or hatchRoll&lt;condition.hatchChance,
        primaryColorId=Config.EggColors[pick(colors,rng:NextNumber())].id,
        secondaryColorId=Config.EggColors[pick(colors,rng:NextNumber())].id,
        blend=1+math.min(98,math.floor(rng:NextNumber()*99))}
    genes.patternId=Genetics.Patterns[math.min(8,math.floor(rng:NextNumber()*8)+1)]
    genes.blend=if genes.primaryColorId==genes.secondaryColorId then 100 else genes.blend
    return genes
end
function Genetics.valid(g)
    if typeof(g)~="table" or not Genetics.condition(g.conditionId) or not Genetics.color(g.primaryColorId)
        or not Genetics.color(g.secondaryColorId) or typeof(g.hatchSuccess)~="boolean"
        or typeof(g.blend)~="number" or g.blend~=g.blend or g.blend&lt;0 or g.blend&gt;100 or g.blend%1~=0 then return false end
    return (g.patternId==nil or table.find(Genetics.Patterns,g.patternId)~=nil) and (g.hatchSuccess or g.conditionId=="cracked")
end
function Genetics.key(g)
    return g.conditionId..":"..g.primaryColorId..":"..g.secondaryColorId..":"..g.blend..(if g.patternId then ":"..g.patternId else "")
end
function Genetics.tint(g)
    local a,b=Genetics.color(g.primaryColorId).rgb,Genetics.color(g.secondaryColorId).rgb
    return Color3.fromRGB(a[1],a[2],a[3]):Lerp(Color3.fromRGB(b[1],b[2],b[3]),1-g.blend/100)
end
return Genetics
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX186">
        <Properties>
          <string name="Name">EggOutcomeOdds</string>
          <ProtectedString name="Source">--!strict
local Config=require(script.Parent.Config)
local Progression=require(script.Parent.ProgressionConfig)
local Genetics=require(script.Parent.EggGenetics)
local Odds={}

local function total(rows)
    local n=0 for _,row in rows do n+=row.weight end return n
end
local function selectRows(rows,value,key)
    local result={}
    for _,row in rows do if value==nil or row[key]==value then table.insert(result,row) end end
    return result
end
function Odds.percent(probability: number): string
    if probability==0 then return "0%" end
    local value=probability*100
    local digits=math.max(4,4-math.floor(math.log10(math.abs(value))))
    return string.format("%."..math.min(20,digits).."f%%",value)
end
function Odds.blendMode(): string
    -- Legacy rolls have 101 shares. The current pattern integration clamps endpoints.
    -- A future uniform 1-99 roll must explicitly declare Genetics.BlendMode="uniform".
    return Genetics.BlendMode or (if Genetics.Patterns then "clamped" else "legacy")
end
function Odds.shareProbability(a: string,b: string,share: number): number
    local mode=Odds.blendMode()
    if mode=="legacy" then return if share&gt;=0 and share&lt;=100 then 1/101 else 0 end
    if a==b then return if share==100 then 1 else 0 end
    if share&lt;1 or share&gt;99 then return 0 end
    return if mode=="uniform" then 1/99 elseif share==1 or share==99 then 2/101 else 1/101
end
function Odds.failure(level: number): number
    local weights=Progression.ConditionWeights[math.clamp(level,0,#Progression.ConditionWeights-1)+1]
    local sum=0 for _,weight in weights do sum+=weight end
    local probability=0
    for i,condition in Progression.Conditions do probability+=weights[i]/sum*(1-condition.hatchChance) end
    return probability
end
function Odds.patterns()
    return Genetics.Patterns or {"legacy"}
end
function Odds.catalog(level: number,filters)
    filters=filters or {}
    local tier=math.clamp(level,0,#Progression.ConditionWeights-1)
    local weights=Progression.ConditionWeights[tier+1]
    local weightTotal=0 for _,w in weights do weightTotal+=w end
    local conditions={}
    for i,c in Progression.Conditions do
        if weights[i]&gt;0 and c.hatchChance&gt;0 and (not filters.condition or filters.condition==c.id) then
            table.insert(conditions,{row=c,probability=weights[i]/weightTotal*c.hatchChance})
        end
    end
    local species=selectRows(Config.ChestSpeciesWeights,filters.species,"speciesId")
    local copies=selectRows(Config.ChestQuantityWeights,filters.copies,"count")
    local patterns={}
    for _,id in Odds.patterns() do if not filters.pattern or filters.pattern==id then table.insert(patterns,id) end end
    local sizes={}
    for _,big in {false,true} do if filters.big==nil or big==filters.big then table.insert(sizes,big) end end
    local pairs={}
    local shareCount=0
    for _,a in Progression.EggColors do for _,b in Progression.EggColors do
        if (not filters.primary or filters.primary==a.id) and (not filters.secondary or filters.secondary==b.id) then
            local first,count=0,101
            if Odds.blendMode()~="legacy" then
                first,count=if a.id==b.id then 100 else 1,if a.id==b.id then 1 else 99
            end
            table.insert(pairs,{a=a,b=b,first=first,count=count,offset=shareCount})
            shareCount+=count
        end
    end end
    local includeFailure=next(filters)==nil
    local combinations=#conditions*#species*#copies*#patterns*#sizes*shareCount
    local catalog={count=combinations+(if includeFailure then 1 else 0),level=tier,
        filtered=not includeFailure,failure=Odds.failure(tier)}
    local speciesTotal,copiesTotal,colorTotal=total(Config.ChestSpeciesWeights),total(Config.ChestQuantityWeights),total(Progression.EggColors)
    function catalog.at(index: number)
        if index%1~=0 or index&lt;1 or index&gt;catalog.count then return nil end
        if includeFailure and index==1 then return {failed=true,probability=catalog.failure} end
        local n=index-1-(if includeFailure then 1 else 0)
        local function take(length)
            local i=n%length+1 n=math.floor(n/length) return i
        end
        local shareIndex=take(shareCount)-1
        local pair
        for _,p in pairs do if shareIndex&gt;=p.offset and shareIndex&lt;p.offset+p.count then pair=p break end end
        local share=pair.first+shareIndex-pair.offset
        local big=sizes[take(#sizes)]
        local pattern=patterns[take(#patterns)]
        local quantity=copies[take(#copies)]
        local sp=species[take(#species)]
        local condition=conditions[take(#conditions)]
        local probability=condition.probability*sp.weight/speciesTotal*quantity.weight/copiesTotal
            *pair.a.weight/colorTotal*pair.b.weight/colorTotal
            *Odds.shareProbability(pair.a.id,pair.b.id,share)/#Odds.patterns()
            *(if big then Config.BigChance else 1-Config.BigChance)
        return {failed=false,probability=probability,speciesId=sp.speciesId,count=quantity.count,
            conditionId=condition.row.id,conditionName=condition.row.name,stats=condition.row.stats,
            primaryId=pair.a.id,primaryName=pair.a.name,secondaryId=pair.b.id,secondaryName=pair.b.name,
            share=share,patternId=pattern,big=big}
    end
    return catalog
end
return Odds
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX187">
        <Properties>
          <string name="Name">EggOutcomeView</string>
          <ProtectedString name="Source">--!strict
local Theme=require(script.Parent.UITheme)
local Config=require(script.Parent.Config)
local Progression=require(script.Parent.ProgressionConfig)
local Odds=require(script.Parent.EggOutcomeOdds)
local C=Theme.Colors
local View={}
local patternNames={legacy="Legacy",["01_blank"]="Blank",["02_emerald_islands"]="Islands",
    ["03_round_spots"]="Round spots",["04_bold_patches"]="Bold patches",["05_horizontal_bands"]="Bands",
    ["06_wavy_stripes"]="Wavy stripes",["07_diamond_scales"]="Diamond scales",["08_freckles"]="Freckles"}
local function text(parent,value,x,y,w,h,size,color)
    local t=Instance.new("TextLabel")
    t.BackgroundTransparency,t.Position,t.Size=1,UDim2.fromOffset(x,y),UDim2.fromOffset(w,h)
    t.Text,t.TextColor3,t.TextSize,t.Font=value,color or C.text,size,Enum.Font.FredokaOne
    t.TextWrapped,t.TextXAlignment,t.ZIndex,t.Parent=true,Enum.TextXAlignment.Left,parent.ZIndex+1,parent
    return t
end
local function button(parent,value,x,y,w,h,callback)
    local b=Instance.new("TextButton")
    b.Position,b.Size,b.BackgroundColor3=UDim2.fromOffset(x,y),UDim2.fromOffset(w,h),C.card
    b.Text,b.TextColor3,b.TextSize,b.ZIndex,b.Parent=value,C.text,17,parent.ZIndex+2,parent
    Theme.decorate(b,4)
    b.Activated:Connect(callback)
    return b
end
function View.add(body,state,level,height,onChange,onBack)
    local h=math.ceil(math.max(48,height))
    local dropdown
    local dropdownKey
    local function menu(title,key,options,x,y,w)
        local value=state.filters[key]
        local selected="All"
        for _,option in options do if option.id==value then selected=option.name end end
        button(body,title..": "..selected.."  v",x,y,w,h,function()
            if dropdown then
                dropdown:Destroy() dropdown=nil
                if dropdownKey==key then dropdownKey=nil return end
            end
            dropdownKey=key
            dropdown=Instance.new("ScrollingFrame")
            dropdown.Name,dropdown.BackgroundColor3,dropdown.BorderSizePixel="OutcomeFilterMenu",C.panel,0
            dropdown.Position=UDim2.fromOffset(x,y+h)
            dropdown.Size=UDim2.fromOffset(w,math.min(220,402-y-h))
            dropdown.CanvasSize,dropdown.ScrollBarThickness=UDim2.fromOffset(0,(#options+1)*h),6
            dropdown.ZIndex,dropdown.Parent=90,body
            local choices={{name="All"}}
            for _,option in options do table.insert(choices,option) end
            for i,option in choices do
                button(dropdown,option.name,0,(i-1)*h,w-8,h,function()
                    state.filters[key]=option.id state.page=1 onChange()
                end)
            end
        end)
    end
    local species={} for _,s in Config.ChestSpeciesWeights do table.insert(species,{id=s.speciesId,name=Config.SpeciesDisplayNames[s.speciesId]}) end
    local conditions={} for _,c in Progression.Conditions do table.insert(conditions,{id=c.id,name=c.name}) end
    local colors={} for _,c in Progression.EggColors do table.insert(colors,{id=c.id,name=c.name}) end
    local patterns={} for _,p in Odds.patterns() do table.insert(patterns,{id=p,name=patternNames[p] or p}) end
    menu("Species","species",species,0,0,200)
    menu("Condition","condition",conditions,208,0,200)
    menu("Primary","primary",colors,416,0,200)
    menu("Secondary","secondary",colors,624,0,200)
    menu("Pattern","pattern",patterns,0,h+6,260)
    menu("Size","big",{{id=false,name="Normal"},{id=true,name="BIG"}},268,h+6,260)
    menu("Copies","copies",{{id=1,name="1"},{id=2,name="2"},{id=3,name="3"}},536,h+6,280-h)
    local reset=button(body,"X",824-h,h+6,h,h,function() state.filters={} state.page=1 onChange() end)
    reset.Name="ClearOutcomeFilters"
    local hint=text(body,"Clear filters",600,h*2+14,224,22,16,C.gold) hint.Visible=false
    reset.MouseEnter:Connect(function() hint.Visible=true end)
    reset.MouseLeave:Connect(function() hint.Visible=false end)
    local catalog=Odds.catalog(level,state.filters)
    local pages=math.max(1,math.ceil(catalog.count/2))
    state.page=math.clamp(state.page,1,pages)
    local y=2*h+14
    text(body,"Tier "..catalog.level.." | "..catalog.count.." outcomes | Shiny 0% | Event: None",0,y,824,22,16,C.gold)
    y+=28
    local footer=402-h
    local rowHeight=(footer-y-8)/2
    for slot=1,2 do
        local outcome=catalog.at((state.page-1)*2+slot)
        if not outcome then continue end
        local top=y+(slot-1)*rowHeight
        local description
        if outcome.failed then description="No dinosaur\nEgg consumed; no crystal refund"
        else
            description=Config.SpeciesDisplayNames[outcome.speciesId].." x"..outcome.count.." | "..outcome.conditionName.." | "..(if outcome.big then "BIG" else "Normal size")
                .."\n"..outcome.primaryName.." "..outcome.share.."% / "..outcome.secondaryName.." "..(100-outcome.share).."%"
                .." | "..(patternNames[outcome.patternId] or outcome.patternId)
        end
        text(body,description,4,top,560,rowHeight-4,18)
        text(body,Odds.percent(outcome.probability),574,top,246,rowHeight-4,19,C.gold)
    end
    if catalog.count==0 then text(body,"No matching outcomes",0,y,824,80,22) end
    local prev=button(body,"&lt;",0,footer,h,h,function() state.page=math.max(1,state.page-1) onChange() end)
    prev.Name="PreviousOutcomePage"
    local input=Instance.new("TextBox")
    input.Name,input.Position,input.Size="OutcomePage",UDim2.fromOffset(h+10,footer),UDim2.fromOffset(170,h)
    input.BackgroundColor3,input.TextColor3,input.TextSize,input.Font=C.card,C.text,18,Enum.Font.FredokaOne
    input.Text,input.ClearTextOnFocus,input.ZIndex,input.Parent=tostring(state.page),false,body.ZIndex+2,body
    Theme.decorate(input,4)
    input.FocusLost:Connect(function()
        local value=tonumber(input.Text)
        if value and value==value and value%1==0 then state.page=math.clamp(value,1,pages) end
        onChange()
    end)
    local nextButton=button(body,"&gt;",h+190,footer,h,h,function() state.page=math.min(pages,state.page+1) onChange() end)
    nextButton.Name="NextOutcomePage"
    text(body,"/ "..pages.." pages\nRounded; totals may differ from 100%",2*h+200,footer,400-2*h,h,15)
    button(body,"BACK",610,footer,214,h,onBack)
end
return View
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX188">
        <Properties>
          <string name="Name">EggPreview</string>
          <ProtectedString name="Source">--!strict
-- Canonical authored egg; built-in geometry remains the API-unavailable fallback.
local Egg={}
function Egg.create(empty: boolean?): Model
    if not empty then
        local authored=require(script.Parent.AuthoredCreatures).clone("egg")
        if authored then return authored end
    end
    local model=Instance.new("Model")
    model.Name="SmoothEggPreview"
    local function sphere(name: string,position: Vector3,scale: Vector3,color: Color3)
        local part=Instance.new("Part")
        part.Name,part.Size,part.CFrame=name,scale,CFrame.new(position)
        part.Anchored,part.CanCollide,part.CanTouch,part.CanQuery=true,false,false,false
        part.Color,part.Material= color,Enum.Material.SmoothPlastic
        part.Transparency=0
        part.Parent=model
        local mesh=Instance.new("SpecialMesh")
        mesh.MeshType,mesh.Scale,mesh.Parent=Enum.MeshType.Sphere,Vector3.one,part
        return part
    end
    sphere("Shell",Vector3.new(0,1.2,0),Vector3.new(1.55,2.3,1.55),Color3.fromRGB(255,237,182))
    do
        for i,p in {Vector3.new(.49,1.58,-.59),Vector3.new(-.32,.94,-.66),Vector3.new(.17,2.01,-.43),Vector3.new(-.68,1.48,-.21)} do
            sphere("JadePatch"..i,p,Vector3.new(.32,.36,.12),Color3.fromRGB(58,172,117))
        end
    end
    model.WorldPivot=CFrame.new()
    return model
end
return Egg
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX189">
        <Properties>
          <string name="Name">EggTraits</string>
          <ProtectedString name="Source">--!strict
local Config = require(script.Parent.Config)
local Genetics = require(script.Parent.EggGenetics)
local Traits = {}
function Traits.roll(eventId: string, shinyRoll: number, bigRoll: number)
    return {
        shiny = Config.IrregularWeather[eventId] == true and shinyRoll &lt; Config.ShinyChance,
        big = bigRoll &lt; Config.BigChance,
    }
end
function Traits.key(mutationId: string, shiny: boolean, big: boolean,genes): string
    return mutationId .. ":" .. (if shiny then "shiny" else "plain") .. ":" .. (if big then "big" else "normal") .. (if genes then ":"..Genetics.key(genes) else "")
end
function Traits.selected(entry)
    local selected = nil
    local best = -1
    for key, variant in (if entry then entry.variants or {} else {}) do
        local rank = (if variant.big then 2 else 0) + (if variant.shiny then 1 else 0)
        if variant.genes then rank+=Genetics.condition(variant.genes.conditionId).stats*10 end
        if variant.count &gt; 0 and (rank &gt; best or (rank == best and selected and key &lt; selected.key)) then
            best = rank
            selected = {key = key, big = variant.big, shiny = variant.shiny, mutationId = variant.mutationId,genes=variant.genes}
        end
    end
    return selected
end
function Traits.valid(variants): boolean
    if typeof(variants) ~= "table" then return false end
    for key, variant in variants do
        if typeof(variant) ~= "table" or typeof(variant.big) ~= "boolean" or typeof(variant.shiny) ~= "boolean"
            or typeof(variant.mutationId) ~= "string" or typeof(variant.count) ~= "number"
            or variant.count ~= variant.count or variant.count &lt; 0 or variant.count % 1 ~= 0 or variant.count &gt; 2000000000
            or (variant.genes~=nil and (not Genetics.valid(variant.genes) or not variant.genes.hatchSuccess))
            or key ~= Traits.key(variant.mutationId, variant.shiny, variant.big,variant.genes)
            or not (variant.shiny or variant.big or variant.genes) then return false end
    end
    return true
end
return Traits
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX190">
        <Properties>
          <string name="Name">EventIconVectors</string>
          <ProtectedString name="Source">--!strict
-- Native placeholders; these are not completed illustrated PNG assets.
local function shape(x,y,w,h,color,radius,rotation) return {x=x,y=y,w=w,h=h,color=color,radius=radius or 0,rotation=rotation or 0} end
return {
    volcano={shape(23,46,54,40,"#734F60",8),shape(33,31,34,30,"#FF8051",6),shape(42,8,16,26,"#FFD16B",8,-15),shape(63,17,12,17,"#FF8051",6,25)},
    aurora={shape(12,30,75,12,"#65F5C6",6,-20),shape(15,48,68,12,"#BFA3FF",6,-20),shape(25,66,53,10,"#C9FFEF",5,-20)},
    quake={shape(9,61,34,18,"#E4BF84",5,-14),shape(57,55,34,18,"#B49A7C",5,14),shape(43,20,10,24,"#FFF0CE",4,20),shape(48,41,10,22,"#FFF0CE",4,-25)},
    bloodmoon={shape(14,14,72,72,"#481C41",36),shape(20,20,60,60,"#FF668F",30),shape(35,29,16,16,"#AD3D70",8),shape(53,50,18,18,"#C74473",9)},
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX191">
        <Properties>
          <string name="Name">FoodCatchRules</string>
          <ProtectedString name="Source">--!strict
local Config = require(script.Parent.Config)
local Rules = {}
function Rules.award(points: number, carry: number, multiplier: number): (number, number)
    if points ~= points or points &lt;= 0 or points == math.huge then return 0, carry end
    local total = math.max(0, carry) + points * Config.FoodCatchRate * math.clamp(multiplier, 1, 8)
    local whole = math.floor(total + 1e-9)
    return whole, math.max(0, total - whole)
end
return Rules
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX192">
        <Properties>
          <string name="Name">FusionSelection</string>
          <ProtectedString name="Source">--!strict
-- BD-065 / BD-062 pure client-side fusion logic. No Instances, services, RNG or
-- remotes: filtering, sorting, eligibility reasons, plain-only auto-fill, odds
-- formatting, retry-token bookkeeping, reveal-wheel construction and Dino Details
-- view models. The server (FusionAction remote) stays authoritative for every rule;
-- this module only explains and previews. Exercised by tools/verify_fusion_ui.py.
local Sel = {}

-- OWNER DECISION 2026-10-14 (docs/57): Gold = 15 Base, Emerald = 4 Gold,
-- Diamond = 2 Emerald; same species + same pattern; all three tiers active. Mirrors
-- IdentityFusion.Recipes (verify_fusion_ui.py asserts they match).
Sel.Stages = {
    {id = "gold", name = "Gold", source = "base", donorCount = 15, approved = true},
    {id = "emerald", name = "Emerald", source = "gold", donorCount = 4, approved = true},
    {id = "diamond", name = "Diamond", source = "emerald", donorCount = 2, approved = true},
}
-- Largest recipe; kept for older callers. Use Sel.donorCount(stage) instead.
Sel.DonorCount = 15
function Sel.donorCount(stageId: string?): number?
    for _, s in Sel.Stages do if s.id == stageId and s.approved then return s.donorCount end end
    return nil
end
-- Above this many slots the menu shows a compact n/N counter grid instead of cards.
Sel.CompactSlotThreshold = 10
Sel.LockedStageText = "Recipe not approved yet"
Sel.ConditionOrder = {"cracked", "dirty", "normal", "rainbow", "astra"}

local function stageInfo(id: string?)
    for _, s in Sel.Stages do if s.id == id then return s end end
    return nil
end
Sel.stage = stageInfo
function Sel.stageTitle(id: string?): string
    if id == "base" then return "Base" end
    local s = stageInfo(id)
    return if s then s.name else tostring(id)
end

-- Display catalog ------------------------------------------------------------------
local function titleCase(text: string): string
    return (string.gsub(text, "(%a)([%w]*)", function(a, b) return string.upper(a) .. b end))
end
function Sel.patternName(id: string?): string
    if type(id) ~= "string" or id == "" then return "Unknown pattern" end
    local stripped = string.gsub(string.gsub(id, "^%d+_", ""), "_", " ")
    return titleCase(stripped)
end

-- Builds name lookups from the shared config tables (passed in to stay pure).
function Sel.buildCatalog(config, progression, patterns)
    local catalog = {species = {}, speciesOrder = {}, patterns = {}, patternOrder = {}, colors = {},
        colorOrder = {}, conditions = {}, mutations = {}, mutationOrder = {}, auras = {}, trails = {}}
    for id, name in (config and config.SpeciesDisplayNames) or {} do catalog.species[id] = name end
    for i, id in (config and config.SpeciesOrder) or {} do catalog.speciesOrder[id] = i end
    for i, id in patterns or {} do catalog.patterns[id] = Sel.patternName(id) catalog.patternOrder[id] = i end
    for i, row in (progression and progression.EggColors) or {} do catalog.colors[row.id] = row.name catalog.colorOrder[row.id] = i end
    for _, row in (progression and progression.Conditions) or {} do catalog.conditions[row.id] = row.name end
    for i, row in (progression and progression.EventMutations) or {} do catalog.mutations[row.id] = row.name catalog.mutationOrder[row.id] = i end
    for _, row in (progression and progression.Auras) or {} do catalog.auras[row.id] = row.name end
    for _, row in (progression and progression.Trails) or {} do catalog.trails[row.id] = row.name end
    return catalog
end

local function lookup(catalog, group: string, id: any, fallback: string?): string
    if type(id) ~= "string" or id == "" then return fallback or "None" end
    local names = catalog and catalog[group]
    local name = names and names[id]
    if name then return name end
    if group == "patterns" then return Sel.patternName(id) end
    return titleCase((string.gsub(id, "_", " ")))
end
Sel.name = lookup

local function genes(d) return if type(d) == "table" and type(d.genes) == "table" then d.genes else {} end
local function mutationOf(d): string
    return if type(d.mutationId) == "string" and d.mutationId ~= "" then d.mutationId else "none"
end

-- Donor classification -------------------------------------------------------------
-- Cosmetic-bearing means any instance-bound aura/trail ownership or equip (BD-059).
function Sel.hasCosmetics(d): boolean
    return (tonumber(d.auraCount) or 0) &gt; 0 or (tonumber(d.trailCount) or 0) &gt; 0
        or (type(d.equippedAuraId) == "string" and d.equippedAuraId ~= "")
        or (type(d.equippedTrailId) == "string" and d.equippedTrailId ~= "")
end

-- Reasons a donor is valuable: these are never auto-filled and are highlighted
-- when chosen manually. Order is stable for display.
function Sel.valuableReasons(d): {string}
    local reasons = {}
    if d.shiny == true then table.insert(reasons, "shiny") end
    if d.big == true then table.insert(reasons, "big") end
    if mutationOf(d) ~= "none" then table.insert(reasons, "mutation") end
    if Sel.hasCosmetics(d) then table.insert(reasons, "cosmetics") end
    return reasons
end
function Sel.isPlain(d): boolean
    return #Sel.valuableReasons(d) == 0 and d.locked ~= true and d.favorited ~= true
end

Sel.ReasonText = {
    wrong_stage = "Wrong stage for this recipe",
    missing_pattern = "Egg pattern unknown (older copy)",
    species_mismatch = "Different species",
    pattern_mismatch = "Different pattern",
    locked = "Locked: unlock to use",
    favorited = "Favorited: unfavorite to use",
    recipe_not_approved = "Recipe not approved yet",
    full = "All slots are filled",
}

-- Context: {targetStage, speciesId?, patternId?} where species/pattern come from the
-- current selection (anchor) or an explicit filter. Returns reason code or nil.
function Sel.ineligibility(d, ctx): string?
    local recipe = stageInfo(ctx and ctx.targetStage or "gold")
    if not recipe or not recipe.approved then return "recipe_not_approved" end
    if d.stage ~= recipe.source then return "wrong_stage" end
    local g = genes(d)
    if type(g.patternId) ~= "string" or g.patternId == "" then return "missing_pattern" end
    if d.locked == true then return "locked" end
    if d.favorited == true then return "favorited" end
    if ctx and ctx.speciesId and d.speciesId ~= ctx.speciesId then return "species_mismatch" end
    if ctx and ctx.patternId and g.patternId ~= ctx.patternId then return "pattern_mismatch" end
    return nil
end

-- The recipe anchor is defined by the first selected donor, else by explicit filters.
function Sel.context(targetStage: string, selection, byId, filters)
    local ctx = {targetStage = targetStage}
    local first = selection and selection[1] and byId[selection[1]]
    if first then
        ctx.speciesId, ctx.patternId = first.speciesId, genes(first).patternId
    elseif filters then
        ctx.speciesId = if filters.speciesId ~= nil then filters.speciesId else nil
        ctx.patternId = if filters.patternId ~= nil then filters.patternId else nil
    end
    return ctx
end

function Sel.index(dinos)
    local byId = {}
    for _, d in dinos do if type(d) == "table" and type(d.instanceId) == "string" then byId[d.instanceId] = d end end
    return byId
end

-- Filters --------------------------------------------------------------------------
-- filters fields (all optional): speciesId, patternId, stage, colorId (either gene),
-- conditionId, shiny (bool), big (bool), mutationId ("none" or id), originKind,
-- cosmetics ("has" | "none" | "equipped").
function Sel.matches(d, filters): boolean
    if not filters then return true end
    local g = genes(d)
    if filters.speciesId ~= nil and d.speciesId ~= filters.speciesId then return false end
    if filters.patternId ~= nil and g.patternId ~= filters.patternId then return false end
    if filters.stage ~= nil and d.stage ~= filters.stage then return false end
    if filters.colorId ~= nil and g.primaryColorId ~= filters.colorId and g.secondaryColorId ~= filters.colorId then return false end
    if filters.conditionId ~= nil and g.conditionId ~= filters.conditionId then return false end
    if filters.shiny ~= nil and (d.shiny == true) ~= filters.shiny then return false end
    if filters.big ~= nil and (d.big == true) ~= filters.big then return false end
    if filters.mutationId ~= nil and mutationOf(d) ~= filters.mutationId then return false end
    if filters.originKind ~= nil and d.originKind ~= filters.originKind then return false end
    if filters.cosmetics == "has" and not Sel.hasCosmetics(d) then return false end
    if filters.cosmetics == "none" and Sel.hasCosmetics(d) then return false end
    if filters.cosmetics == "equipped" and not ((d.equippedAuraId or "") ~= "" or (d.equippedTrailId or "") ~= "") then return false end
    return true
end

function Sel.filter(dinos, filters)
    local result = {}
    for _, d in dinos do if Sel.matches(d, filters) then table.insert(result, d) end end
    return result
end

-- Distinct values present in the list, for the cycling filter chips.
Sel.FilterFields = {"speciesId", "patternId", "stage", "colorId", "conditionId", "shiny", "big", "mutationId", "originKind", "cosmetics"}
function Sel.filterOptions(dinos, catalog)
    local seen = {}
    for _, field in Sel.FilterFields do seen[field] = {} end
    for _, d in dinos do
        local g = genes(d)
        seen.speciesId[d.speciesId or ""] = true
        if g.patternId then seen.patternId[g.patternId] = true end
        seen.stage[d.stage or ""] = true
        if g.primaryColorId then seen.colorId[g.primaryColorId] = true end
        if g.secondaryColorId then seen.colorId[g.secondaryColorId] = true end
        if g.conditionId then seen.conditionId[g.conditionId] = true end
        seen.mutationId[mutationOf(d)] = true
        if d.originKind then seen.originKind[d.originKind] = true end
    end
    local order = {speciesId = "speciesOrder", patternId = "patternOrder", colorId = "colorOrder", mutationId = "mutationOrder"}
    local options = {}
    for _, field in Sel.FilterFields do
        local list = {}
        for value in seen[field] do if value ~= "" then table.insert(list, value) end end
        local rank = catalog and order[field] and catalog[order[field]] or {}
        table.sort(list, function(a, b)
            local ra, rb = rank[a] or (if field == "conditionId" then table.find(Sel.ConditionOrder, a) else nil) or 999,
                rank[b] or (if field == "conditionId" then table.find(Sel.ConditionOrder, b) else nil) or 999
            if ra ~= rb then return ra &lt; rb end
            return tostring(a) &lt; tostring(b)
        end)
        options[field] = list
    end
    options.shiny, options.big = {true, false}, {true, false}
    options.cosmetics = {"has", "none", "equipped"}
    return options
end

-- Cycles nil -&gt; option1 -&gt; ... -&gt; nil.
function Sel.cycle(options, current)
    if current == nil then return options[1] end
    local i = table.find(options, current)
    if not i or i &gt;= #options then return nil end
    return options[i + 1]
end

-- Sorting --------------------------------------------------------------------------
local function serial(id: string): number
    return tonumber(string.match(id or "", "/d:(%d+)$")) or 0
end
-- Natural-trait rarity score. Cosmetics are deliberately EXCLUDED (BD-062).
function Sel.rarityScore(d): number
    local g = genes(d)
    local condition = table.find(Sel.ConditionOrder, g.conditionId or "") or 0
    return (if d.shiny == true then 40 else 0) + (if mutationOf(d) ~= "none" then 30 else 0)
        + (if d.big == true then 20 else 0) + condition
end

Sel.SortKeys = {"eligible", "rarest", "species", "pattern", "color", "condition", "recent", "selected"}
Sel.SortNames = {eligible = "Eligible first", rarest = "Rarest", species = "Species", pattern = "Pattern",
    color = "Color", condition = "Condition", recent = "Newest", selected = "Selected first"}

function Sel.sort(dinos, key: string, ctx, selectedSet, catalog)
    local list = table.clone(dinos)
    selectedSet = selectedSet or {}
    local speciesRank = catalog and catalog.speciesOrder or {}
    local colorRank = catalog and catalog.colorOrder or {}
    local function eligibleRank(d)
        if Sel.ineligibility(d, ctx) then return 2 end
        return if Sel.isPlain(d) then 0 else 1
    end
    local function compare(a, b)
        local ga, gb = genes(a), genes(b)
        local x, y
        if key == "eligible" then x, y = eligibleRank(a), eligibleRank(b)
        elseif key == "rarest" then x, y = -Sel.rarityScore(a), -Sel.rarityScore(b)
        elseif key == "species" then x, y = speciesRank[a.speciesId] or 999, speciesRank[b.speciesId] or 999
        elseif key == "pattern" then x, y = tostring(ga.patternId or "~"), tostring(gb.patternId or "~")
        elseif key == "color" then x, y = colorRank[ga.primaryColorId] or 999, colorRank[gb.primaryColorId] or 999
        elseif key == "condition" then x, y = -(table.find(Sel.ConditionOrder, ga.conditionId or "") or 0), -(table.find(Sel.ConditionOrder, gb.conditionId or "") or 0)
        elseif key == "recent" then x, y = -serial(a.instanceId), -serial(b.instanceId)
        elseif key == "selected" then x, y = if selectedSet[a.instanceId] then 0 else 1, if selectedSet[b.instanceId] then 0 else 1 end
        if x ~= nil and x ~= y then return x &lt; y end
        local sa, sb = speciesRank[a.speciesId] or 999, speciesRank[b.speciesId] or 999
        if sa ~= sb then return sa &lt; sb end
        local na, nb = serial(a.instanceId), serial(b.instanceId)
        if na ~= nb then return na &lt; nb end
        return tostring(a.instanceId) &lt; tostring(b.instanceId)
    end
    table.sort(list, compare)
    return list
end

-- Selection ------------------------------------------------------------------------
function Sel.selectedSet(selection)
    local set = {}
    for _, id in selection do set[id] = true end
    return set
end

-- Returns (newSelection, ok, reasonCode). Deselecting is always allowed.
function Sel.toggle(selection, d, targetStage: string, byId)
    local result = table.clone(selection)
    local at = table.find(result, d.instanceId)
    if at then table.remove(result, at) return result, true, nil end
    local recipe = stageInfo(targetStage)
    if not recipe or not recipe.approved then return selection, false, "recipe_not_approved" end
    if #result &gt;= recipe.donorCount then return selection, false, "full" end
    local reason = Sel.ineligibility(d, Sel.context(targetStage, result, byId, nil))
    if reason then return selection, false, reason end
    table.insert(result, d.instanceId)
    return result, true, nil
end

-- Auto-fill ONLY ordinary, unprotected, eligible copies. Never Shiny / BIG / mutated /
-- cosmetic-bearing / locked / favorited. Returns (selection, added, shortfall).
function Sel.autoFill(dinos, selection, targetStage: string, filters, catalog)
    local recipe = stageInfo(targetStage)
    if not recipe or not recipe.approved then return selection, 0, 0 end
    local need = recipe.donorCount - #selection
    local byId = Sel.index(dinos)
    local result = table.clone(selection)
    if need &lt;= 0 then return result, 0, 0 end
    local taken = Sel.selectedSet(selection)
    local ctx = Sel.context(targetStage, selection, byId, filters)
    local groups, order = {}, {}
    for _, d in Sel.sort(dinos, "recent", ctx, nil, catalog) do
        -- Oldest first so newest hatches stay; "recent" is newest-first, so reverse below.
        if not taken[d.instanceId] and Sel.isPlain(d) and Sel.ineligibility(d, ctx) == nil then
            local key = tostring(d.speciesId) .. "|" .. tostring(genes(d).patternId)
            if not groups[key] then groups[key] = {} table.insert(order, key) end
            table.insert(groups[key], 1, d)
        end
    end
    if #order == 0 then return result, 0, need end
    local speciesRank = catalog and catalog.speciesOrder or {}
    table.sort(order, function(a, b)
        if #groups[a] ~= #groups[b] then return #groups[a] &gt; #groups[b] end
        local sa, sb = speciesRank[groups[a][1].speciesId] or 999, speciesRank[groups[b][1].speciesId] or 999
        if sa ~= sb then return sa &lt; sb end
        return a &lt; b
    end)
    local added = 0
    for _, d in groups[order[1]] do
        if added &gt;= need then break end
        table.insert(result, d.instanceId)
        added += 1
    end
    return result, added, need - added
end

-- Selected-donor histogram: "2 Shiny / 15" etc. Cosmetics are listed but not rarity.
function Sel.histogram(selection, byId)
    local h = {count = 0, shiny = 0, big = 0, mutations = {}, cosmetics = 0, valuable = 0}
    for _, id in selection do
        local d = byId[id]
        if d then
            h.count += 1
            if d.shiny == true then h.shiny += 1 end
            if d.big == true then h.big += 1 end
            local m = mutationOf(d)
            if m ~= "none" then h.mutations[m] = (h.mutations[m] or 0) + 1 end
            if Sel.hasCosmetics(d) then h.cosmetics += 1 end
            if #Sel.valuableReasons(d) &gt; 0 then h.valuable += 1 end
        end
    end
    return h
end

-- Short accessible card badges (text, never color-only).
function Sel.badges(d, catalog): {string}
    local list = {}
    if d.shiny == true then table.insert(list, "SHINY") end
    if d.big == true then table.insert(list, "BIG") end
    local m = mutationOf(d)
    if m ~= "none" then table.insert(list, lookup(catalog, "mutations", m)) end
    local cosmetic = (tonumber(d.auraCount) or 0) + (tonumber(d.trailCount) or 0)
    if cosmetic &gt; 0 then table.insert(list, cosmetic .. " FX") end
    if d.locked == true then table.insert(list, "LOCKED") end
    if d.favorited == true then table.insert(list, "FAV") end
    return list
end

-- Odds formatting ------------------------------------------------------------------
local function finiteProbability(p): boolean
    return type(p) == "number" and p == p and p &gt;= 0 and p &lt;= 1 + 1e-9
end

local function trimZeros(text: string): string
    if string.find(text, "%.") then text = string.gsub(string.gsub(text, "0+$", ""), "%.$", "") end
    return text
end

-- rows: {{id, label, p}}. Returns rows with `units`, `text` and `decimals` such that the
-- integer units sum to exactly 100% at the displayed precision (largest remainder).
-- Returns nil, reason when the server distribution is malformed (UI must not offer
-- confirmation on unreadable odds).
function Sel.percentRows(rows)
    local total = 0
    for _, row in rows do
        if not finiteProbability(row.p) then return nil, "invalid_probability" end
        total += row.p
    end
    if math.abs(total - 1) &gt; 1e-6 then return nil, "odds_do_not_sum" end
    local decimals = 1
    for _, row in rows do
        if row.p &gt; 0 and row.p &lt; 0.001 then decimals = math.max(decimals, 2) end
        if row.p &gt; 0 and row.p &lt; 0.0001 then decimals = 3 end
    end
    local whole = 100 * 10 ^ decimals
    local result, sum = {}, 0
    for i, row in rows do
        local exact = row.p / total * whole
        local units = math.floor(exact + 1e-9)
        sum += units
        table.insert(result, {id = row.id, label = row.label, p = row.p, units = units, remainder = exact - units, order = i})
    end
    local ranked = table.clone(result)
    table.sort(ranked, function(a, b)
        if math.abs(a.remainder - b.remainder) &gt; 1e-12 then return a.remainder &gt; b.remainder end
        return a.order &lt; b.order
    end)
    local i = 1
    while sum &lt; whole and #ranked &gt; 0 do
        ranked[i].units += 1
        sum += 1
        i = i % #ranked + 1
    end
    for _, row in result do
        row.remainder, row.order = nil, nil
        row.decimals = decimals
        if row.units == 0 and row.p &gt; 0 then
            row.text = "&lt;" .. trimZeros(string.format("%." .. decimals .. "f", 10 ^ -decimals)) .. "%"
        else
            row.text = trimZeros(string.format("%." .. decimals .. "f", row.units / 10 ^ decimals)) .. "%"
        end
    end
    return result, nil
end

local function mapRows(map, catalog, group, extra)
    local rows = {}
    if type(map) ~= "table" then return rows end
    for id, p in map do table.insert(rows, {id = id, label = lookup(catalog, group, id), p = p}) end
    if extra then table.insert(rows, extra) end
    table.sort(rows, function(a, b)
        if type(a.p) == "number" and type(b.p) == "number" and a.p ~= b.p then return a.p &gt; b.p end
        return tostring(a.id) &lt; tostring(b.id)
    end)
    return rows
end

-- Raw (unformatted) wheel rows for one trait; shared by odds display and reveal.
function Sel.traitRows(odds, trait: string, catalog)
    if type(odds) ~= "table" then return {} end
    if trait == "shiny" or trait == "big" then
        local p = odds[trait]
        local name = if trait == "shiny" then "Shiny" else "BIG"
        if type(p) ~= "number" then return {} end
        return {{id = "yes", label = name, p = p}, {id = "no", label = "Not " .. name, p = 1 - p}}
    elseif trait == "mutation" then
        return mapRows(odds.mutation, catalog, "mutations", if type(odds.noMutation) == "number"
            then {id = "none", label = "No mutation", p = odds.noMutation} else nil)
    elseif trait == "condition" then return mapRows(odds.condition, catalog, "conditions")
    elseif trait == "primaryColor" or trait == "secondaryColor" then return mapRows(odds[trait], catalog, "colors") end
    return {}
end

Sel.OddsSections = {
    {trait = "shiny", title = "Shiny"}, {trait = "mutation", title = "Event mutation"},
    {trait = "big", title = "BIG"}, {trait = "condition", title = "Condition"},
    {trait = "primaryColor", title = "Color 1"}, {trait = "secondaryColor", title = "Color 2"},
}
-- Returns {ok, sections={{title, trait, rows}}, error?}. Any malformed section makes
-- the whole quote unusable for confirmation.
function Sel.formatOdds(odds, catalog)
    if type(odds) ~= "table" then return {ok = false, sections = {}, error = "missing_odds"} end
    local sections = {}
    for _, section in Sel.OddsSections do
        local rows, err = Sel.percentRows(Sel.traitRows(odds, section.trait, catalog))
        if not rows or #rows == 0 then return {ok = false, sections = sections, error = err or ("missing_" .. section.trait)} end
        table.insert(sections, {title = section.title, trait = section.trait, rows = rows})
    end
    return {ok = true, sections = sections}
end

-- Loss confirmation ----------------------------------------------------------------
local function plural(n: number, word: string): string
    return n .. " " .. word .. (if n == 1 then "" else "s")
end
function Sel.lossSummary(quote, catalog)
    local summary = {auraCount = 0, trailCount = 0, auraNames = {}, trailNames = {}, valuables = {},
        consentRequired = type(quote) == "table" and quote.consentRequired == true}
    local manifest = type(quote) == "table" and quote.lossManifest or {}
    for _, entry in manifest do
        for _, id in entry.auraIds or {} do
            summary.auraCount += 1
            table.insert(summary.auraNames, lookup(catalog, "auras", id))
        end
        for _, id in entry.trailIds or {} do
            summary.trailCount += 1
            table.insert(summary.trailNames, lookup(catalog, "trails", id))
        end
        local traits = {}
        if entry.shiny then table.insert(traits, "Shiny") end
        if entry.big then table.insert(traits, "BIG") end
        if type(entry.mutationId) == "string" and entry.mutationId ~= "" then table.insert(traits, lookup(catalog, "mutations", entry.mutationId)) end
        if #traits &gt; 0 then table.insert(summary.valuables, {instanceId = entry.instanceId, text = table.concat(traits, " + ")}) end
    end
    local names = {}
    for _, n in summary.auraNames do table.insert(names, n) end
    for _, n in summary.trailNames do table.insert(names, n) end
    if summary.auraCount + summary.trailCount &gt; 0 then
        summary.cosmeticText = plural(summary.auraCount, "aura") .. " and " .. plural(summary.trailCount, "trail")
            .. " will be lost: " .. table.concat(names, ", ")
    else
        summary.cosmeticText = "No bought auras or trails will be lost."
    end
    summary.needsConfirm = summary.consentRequired or #summary.valuables &gt; 0 or #names &gt; 0
    return summary
end

-- Fuse attempts and retry tokens ---------------------------------------------------
-- The same confirmed request reuses its token on retry so a delayed or duplicated
-- commit returns the SAME result ("duplicate"); a changed request gets a new token.
function Sel.requestKey(targetStage: string, donorIds, quoteDigest): string
    local ids = table.clone(donorIds or {})
    table.sort(ids)
    return tostring(targetStage) .. "#" .. table.concat(ids, ",") .. "#" .. tostring(quoteDigest)
end

function Sel.attempt(previous, targetStage: string, donorIds, quoteDigest, newToken: () -&gt; string)
    local key = Sel.requestKey(targetStage, donorIds, quoteDigest)
    if previous and previous.key == key and previous.state == "pending" then
        previous.tries += 1
        return previous, true
    end
    return {key = key, token = newToken(), state = "pending", tries = 1, targetStage = targetStage,
        donorIds = table.clone(donorIds), quoteDigest = quoteDigest}, false
end

Sel.FailureText = {
    fusion_disabled = "Fusion is unavailable right now.",
    rate_limited = "Too many requests. Retrying shortly with the same request.",
    stale_quote = "Your dinos changed. Odds were refreshed; please review and confirm again.",
    consent_required = "Please review the itemized loss list and confirm again.",
    donor_missing = "A selected dino is no longer in your collection. Selection refreshed.",
    donor_locked = "A selected dino is locked or favorited. Selection refreshed.",
    wrong_donor_count = "Exactly the recipe count of matching dinos is required (15 Base, 4 Gold or 2 Emerald).",
    species_mismatch = "All dinos must be the same species.",
    pattern_mismatch = "All dinos must share the same egg pattern.",
    recipe_not_approved = "This recipe is not approved yet.",
    odds_not_approved = "Fusion odds are not approved yet. Nothing was consumed.",
    save_failed = "Saving failed. Nothing is lost; retrying with the same request.",
    lease_lost = "Your profile session moved. Rejoin, then reopen Fusion to see the result.",
    storage_limit = "Your collection is full. Make room before fusing.",
    token_conflict = "Request mismatch. Please confirm again.",
    duplicate_donor = "A dino was selected twice. Selection refreshed.",
    wrong_stage = "A selected dino is the wrong stage. Selection refreshed.",
    missing_pattern = "A selected dino has no recorded egg pattern.",
    invalid_donor_id = "Selection invalid. Refreshed.",
    profile_not_loaded = "Your profile is still loading. Try again in a moment.",
    request_failed = "Connection problem. Retrying with the same request.",
    unavailable = "Fusion unavailable.",
    identity_unavailable = "Fusion is unavailable for this save right now.",
    random_items_unavailable = "Fusion is not available for this account.",
    bad_request = "Request was rejected. Please reopen Fusion.",
    invalid_token = "Request token invalid. Please confirm again.",
    invalid_instance = "A selected dino is invalid. Selection refreshed.",
    wrong_owner = "A selected dino is not yours. Selection refreshed.",
    unknown_stage = "Unknown fusion stage.",
    projection_unsupported = "This stage is not fusable yet.",
    identity_capacity = "Your collection is at its identity limit. Nothing was consumed.",
}
-- profile_not_loaded: after save_failed/lease_lost the server refuses until reload; the same token stays safe.
local RetrySame = {rate_limited = true, save_failed = true, request_failed = true, lease_lost = true, profile_not_loaded = true}
local Requote = {stale_quote = true, consent_required = true, donor_missing = true, donor_locked = true,
    wrong_donor_count = true, species_mismatch = true, pattern_mismatch = true, token_conflict = true,
    duplicate_donor = true, wrong_stage = true, missing_pattern = true, invalid_donor_id = true,
    invalid_instance = true, wrong_owner = true, invalid_token = true}

function Sel.failureMessage(reason: any): string
    return Sel.FailureText[reason] or ("Fusion failed: " .. string.gsub(tostring(reason), "_", " "))
end

-- Classifies a fuse response. kind: success | retry (same token) | requote | fatal.
function Sel.settle(attempt, response)
    if type(response) ~= "table" then
        return {kind = "retry", reason = "request_failed", message = Sel.failureMessage("request_failed"), attempt = attempt}
    end
    if response.ok == true and (response.status == "fused" or response.status == "duplicate") and type(response.result) == "table" then
        if attempt then attempt.state = "settled" end
        return {kind = "success", status = response.status, result = response.result, attempt = attempt}
    end
    local reason = if response.ok == true then "request_failed" else (response.reason or "request_failed")
    if RetrySame[reason] then return {kind = "retry", reason = reason, message = Sel.failureMessage(reason), attempt = attempt} end
    if attempt then attempt.state = "abandoned" end
    return {kind = if Requote[reason] then "requote" else "fatal", reason = reason, message = Sel.failureMessage(reason), attempt = nil}
end

-- Reveal sequence ------------------------------------------------------------------
-- Every wheel lands on the COMMITTED server value. Segment sizes equal the quoted
-- odds; the landing angle is the middle of the committed segment (no fake near-miss).
local function wheel(kind: string, title: string, rows, committed: string, detail: string?)
    local segments, cursor, landing = {}, 0, nil
    for i, row in rows do
        local p = if type(row.p) == "number" and row.p &gt; 0 then row.p else 0
        table.insert(segments, {id = row.id, label = row.label, p = p, from = cursor, to = cursor + p})
        if row.id == committed then landing = i end
        cursor += p
    end
    local stage = {kind = "wheel", trait = kind, title = title, segments = segments, committed = committed, detail = detail}
    if landing and segments[landing].p &gt; 0 then
        local seg = segments[landing]
        stage.landingIndex = landing
        stage.landingFraction = (seg.from + seg.to) / 2 / math.max(cursor, 1e-9)
    else
        -- Server result outside the quoted table: show it plainly, never animate a guess.
        stage.kind, stage.mismatch = "card", true
    end
    return stage
end

-- Rotation (degrees) that puts the landing fraction under a top pointer after `turns`.
function Sel.wheelRotation(stage, turns: number): number
    return turns * 360 + (1 - (stage.landingFraction or 0)) * 360
end

-- Horizontal reel variant used by the client: distance (in whole-strip units) the strip
-- travels so the centre pointer stops at the middle of the committed segment.
function Sel.reelOffset(stage, turns: number): number
    return turns + (stage.landingFraction or 0)
end

function Sel.revealSequence(quote, result, catalog)
    local traits = type(result) == "table" and result.traits or {}
    local g = traits.genes or {}
    local stages = {}
    local patternId = (type(result) == "table" and result.patternId) or g.patternId
    table.insert(stages, {kind = "pattern", title = "PATTERN LOCKED", value = lookup(catalog, "patterns", patternId)})
    local odds = type(quote) == "table" and quote.odds or nil
    if odds then
        local function add(trait, title, committed, detail)
            local rows = Sel.traitRows(odds, trait, catalog)
            if #rows &gt; 0 then table.insert(stages, wheel(trait, title, rows, committed, detail)) end
        end
        add("primaryColor", "COLOR 1", g.primaryColorId)
        add("secondaryColor", "COLOR 2", g.secondaryColorId, if type(g.blend) == "number" then ("Blend " .. g.blend .. "% / " .. (100 - g.blend) .. "%") else nil)
        add("condition", "CONDITION", g.conditionId)
        add("shiny", "SHINY", if traits.shiny then "yes" else "no")
        add("mutation", "MUTATION", if type(traits.mutationId) == "string" and traits.mutationId ~= "" then traits.mutationId else "none")
        add("big", "BIG", if traits.big then "yes" else "no")
    end
    for _, stage in stages do
        if stage.kind ~= "pattern" and stage.committed then
            local rowLabel = nil
            for _, s in stage.segments or {} do if s.id == stage.committed then rowLabel = s.label end end
            stage.value = rowLabel or stage.committed
        end
    end
    table.insert(stages, {kind = "final", title = "NEW " .. string.upper(lookup(catalog, "patterns", patternId)) .. " "
        .. string.upper(lookup(catalog, "species", type(result) == "table" and result.speciesId or nil, "DINO")),
        stage = type(result) == "table" and result.targetStage or "gold", replay = odds == nil})
    return stages
end

-- Dino Details view model (BD-062) -------------------------------------------------
Sel.DetailsParentLimit = 12
Sel.EggSourceNames = {alpha_chest = "Run reward egg", run = "Run egg", crystal_shop = "Crystal Shop egg",
    chest_claim = "Reward egg", progression = "Progression egg"}

local function geneLine(g, catalog): string
    if type(g) ~= "table" or not g.primaryColorId then return "Unknown genes" end
    local blend = tonumber(g.blend) or 100
    return lookup(catalog, "colors", g.primaryColorId) .. " " .. blend .. "% / "
        .. lookup(catalog, "colors", g.secondaryColorId) .. " " .. (100 - blend) .. "%"
end
Sel.geneLine = geneLine

local function eggLine(egg, catalog): string
    if type(egg) ~= "table" then return "Original egg not recorded" end
    local g = egg.genes or {}
    local parts = {lookup(catalog, "patterns", g.patternId), geneLine(g, catalog), lookup(catalog, "conditions", g.conditionId, "Unknown condition")}
    if type(egg.eventId) == "string" and egg.eventId ~= "" and egg.eventId ~= "clear" then table.insert(parts, "Event: " .. titleCase((string.gsub(egg.eventId, "_", " ")))) end
    table.insert(parts, Sel.EggSourceNames[egg.kind] or (if type(egg.kind) == "string" then titleCase((string.gsub(egg.kind, "_", " "))) else "Unknown source"))
    return table.concat(parts, " • ")
end
Sel.eggLine = eggLine

function Sel.details(d, catalog)
    local g = genes(d)
    local stage = d.stage or "base"
    local stageName = if stage == "base" then "Base" else titleCase(stage)
    local view = {
        title = (if stage == "base" then "" else stageName .. " ") .. lookup(catalog, "patterns", g.patternId, "Unknown pattern") .. " "
            .. lookup(catalog, "species", d.speciesId, "Dino"),
        traits = {
            {label = "Stage", value = stageName},
            {label = "Pattern", value = lookup(catalog, "patterns", g.patternId, "Unknown")},
            {label = "Colors", value = geneLine(g, catalog)},
            {label = "Condition", value = lookup(catalog, "conditions", g.conditionId, "Unknown")},
            {label = "Shiny", value = if d.shiny then "Yes" else "No"},
            {label = "BIG", value = if d.big then "Yes" else "No"},
            {label = "Mutation", value = lookup(catalog, "mutations", d.mutationId, "None")},
        },
        origin = {lines = {}, parents = {}},
    }
    local origin = type(d.origin) == "table" and d.origin or {}
    local lineage = d.lineage
    if origin.kind == "fusion" or type(lineage) == "table" then
        lineage = type(lineage) == "table" and lineage or {}
        local parentIds = lineage.parentIds or {}
        local snapshots = origin.parents or {}
        view.origin.kind = "fused"
        view.prestige = "Crafted " .. stageName .. " (earned)"
        table.insert(view.origin.lines, "Fused from " .. math.max(#parentIds, #snapshots) .. " dinos")
        table.insert(view.origin.lines, "Recipe " .. tostring(lineage.recipeVersion or origin.recipeVersion or "unknown")
            .. " • Odds " .. tostring(lineage.oddsVersion or origin.oddsVersion or "unknown"))
        table.insert(view.origin.lines, "Traits were freshly rolled at fusion; the stage is guaranteed, not a drop chance.")
        local eggs = lineage.parentEggs or {}
        local byParent = {}
        for _, snap in snapshots do byParent[snap.instanceId] = snap end
        local ids = if #parentIds &gt; 0 then parentIds else (function()
            local list = {} for _, snap in snapshots do table.insert(list, snap.instanceId) end return list end)()
        -- Bounded view: a Gold has 15 parents; list the first DetailsParentLimit.
        local shown = math.min(#ids, Sel.DetailsParentLimit)
        if #ids &gt; shown then
            table.insert(view.origin.lines, "Showing " .. shown .. " of " .. #ids .. " parents")
        end
        for i = 1, shown do
            local id = ids[i]
            local snap = byParent[id]
            local eggId = snap and snap.origin and snap.origin.eggId
            local egg = eggId and eggs[eggId]
            if not egg and #eggs &gt; 0 then for _, e in eggs do if e.eggId == eggId then egg = e end end end
            table.insert(view.origin.parents, {instanceId = id,
                text = if snap then (lookup(catalog, "patterns", (snap.genes and snap.genes.patternId) or g.patternId) .. " " .. lookup(catalog, "species", snap.speciesId or d.speciesId, "Dino")
                    .. (if snap.shiny then " • Shiny" else "") .. (if snap.big then " • BIG" else "")
                    .. (if type(snap.mutationId) == "string" and snap.mutationId ~= "" then " • " .. lookup(catalog, "mutations", snap.mutationId) else ""))
                    else id,
                egg = if egg then eggLine(egg, catalog) elseif snap and snap.origin and snap.origin.kind == "fusion" then "Fused parent (own lineage)" else "Original egg not recorded"})
        end
    elseif origin.kind == "hatch" or type(d.originalEgg) == "table" then
        view.origin.kind = "hatched"
        view.prestige = if stage == "base" then "Natural hatch" else "Natural hatch • " .. stageName .. " stage"
        table.insert(view.origin.lines, "Hatched from: " .. eggLine(d.originalEgg, catalog))
        table.insert(view.origin.lines, "Natural hatch odds: not calculated yet (needs versioned source tables)")
    else
        view.origin.kind = "unknown"
        view.prestige = if stage == "base" then "Older copy" else stageName .. " (earned, older fusion)"
        table.insert(view.origin.lines, "Original egg was not recorded for this older copy. Traits are not guessed.")
    end
    local c = type(d.cosmetics) == "table" and d.cosmetics or {}
    local auras, trails = {}, {}
    for _, id in c.ownedAuraIds or {} do table.insert(auras, lookup(catalog, "auras", id)) end
    for _, id in c.ownedTrailIds or {} do table.insert(trails, lookup(catalog, "trails", id)) end
    view.cosmetics = {
        "Auras: " .. (if #auras &gt; 0 then table.concat(auras, ", ") else "None (buy for this dino)"),
        "Trails: " .. (if #trails &gt; 0 then table.concat(trails, ", ") else "Free/default only"),
        "Equipped: " .. lookup(catalog, "auras", c.equippedAuraId, "No aura") .. " • " .. lookup(catalog, "trails", c.equippedTrailId, "No trail"),
        "Bought cosmetics never count toward rarity or prestige.",
    }
    return view
end

return Sel
</ProtectedString>
