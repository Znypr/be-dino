      <Item class="ModuleScript" referent="RBX213">
        <Properties>
          <string name="Name">ResourceModels</string>
          <ProtectedString name="Source">--!strict
-- Imported meshes are optional until Studio upload; no invented asset IDs.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local RuntimeMeshes = require(script.Parent.RuntimeMeshes)
local ResourceModels = {}
local Authored = require(script.Parent.AuthoredCreatures)
function ResourceModels.clearTextures(part: BasePart)
    for _,child in part:GetChildren() do
        if child:IsA("SurfaceAppearance") or child:IsA("Decal") or child:IsA("Texture") then child:Destroy() end
    end
    if part:IsA("MeshPart") then part.TextureID="" end
end
function ResourceModels.clone(id: string): Model?
    if RunService:IsClient() then
        local authored=Authored.clone(id)
        if authored then return authored end
    end
    local folder = ReplicatedStorage:FindFirstChild("Resources")
    local template = if folder then folder:FindFirstChild(id) else nil
    local overrides=ReplicatedStorage:FindFirstChild("ResourceOverrides")
    template=(if overrides then overrides:FindFirstChild(id) else nil) or template
    if not template then -- BD-049/050 Blender kit (native fallback until owner MeshPart uploads)
        local kit = ReplicatedStorage:FindFirstChild("WorldKit")
        template = if kit then kit:FindFirstChild(id) else nil
    end
    if not template then return if RunService:IsClient() then RuntimeMeshes.clone(id) else nil end
    local copy: Model
    if template:IsA("Model") then
        copy = template:Clone()
    elseif template:IsA("BasePart") then
        copy = Instance.new("Model")
        local part = template:Clone()
        part.Parent = copy
        copy.PrimaryPart = part
    else
        return nil
    end
    -- Only geometry and appearance survive import. Never execute imported code.
    for _, item in copy:GetDescendants() do
        if item:IsA("LuaSourceContainer") then item:Destroy()
        elseif item:IsA("BasePart") then
            item.CanCollide = false
            item.CanTouch = false
            item.CanQuery = false
            item.Massless = true
        end
    end
    -- Normalize the pivot to the ground under the bounding-box center. Keep imported -Z facing.
    copy.PrimaryPart = nil
    local box, size = copy:GetBoundingBox()
    local origin = box.Position - Vector3.new(0, size.Y / 2, 0)
    copy.WorldPivot = CFrame.new(origin)
    copy:SetAttribute("GeometryOrigin", origin)
    copy.Name = id
    return copy
end
return ResourceModels
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX214">
        <Properties>
          <string name="Name">RevealSkip</string>
          <ProtectedString name="Source">--!strict
-- BD-044 reveal skipping (PROVISIONAL). Pure client/server-neutral selection logic.
-- A skipped egg is still hatched and credited by the server; skipping only drops the
-- animation. Notable finds (Shiny, BIG, event mutation, Rainbow/Astra) are never skipped.
-- The stored selection is a UI preference: the server never uses it for rewards.
local Skip = {}
Skip.Rarities = {1, 2, 3} -- Config.SpeciesRarities values: Common / Rare / Legendary
Skip.Names = {"Common", "Rare", "Legendary"}

-- Accepts any list of rarity numbers; returns a sorted, de-duplicated, valid list.
function Skip.normalize(list: any): {number}
    local seen, result = {}, {}
    if typeof(list) ~= "table" then return result end
    for _, value in list do
        if typeof(value) == "number" and value % 1 == 0 and value &gt;= 1 and value &lt;= #Skip.Names and not seen[value] then
            seen[value] = true
            table.insert(result, value)
        end
    end
    table.sort(result)
    return result
end

function Skip.set(list: any): {[number]: boolean}
    local set = {}
    for _, rarity in Skip.normalize(list) do set[rarity] = true end
    return set
end

function Skip.toggle(list: any, rarity: number): {number}
    local set = Skip.set(list)
    if rarity &gt;= 1 and rarity &lt;= #Skip.Names and rarity % 1 == 0 then set[rarity] = if set[rarity] then nil else true end
    local result = {}
    for value in set do table.insert(result, value) end
    table.sort(result)
    return result
end

-- outcome: {big, shiny, eventMutationId, genes={conditionId}, failed}
function Skip.isNotable(outcome: any): boolean
    if typeof(outcome) ~= "table" then return true end -- unknown data is never hidden
    if outcome.shiny == true or outcome.big == true then return true end
    if typeof(outcome.eventMutationId) == "string" and outcome.eventMutationId ~= "" then return true end
    local genes = outcome.genes
    if typeof(genes) == "table" and (genes.conditionId == "rainbow" or genes.conditionId == "astra") then return true end
    return false
end

function Skip.shouldSkip(selection: any, rarity: number, outcome: any): boolean
    if not Skip.set(selection)[rarity] then return false end
    return not Skip.isNotable(outcome)
end

-- entries: {{rarity=number, outcome=table, speciesId=string?}}
function Skip.summarize(entries: {any})
    local summary = {total = #entries, byRarity = {0, 0, 0}, failed = 0, hatched = 0, notable = {}}
    for _, entry in entries do
        local rarity = math.clamp(entry.rarity or 1, 1, #Skip.Names)
        summary.byRarity[rarity] += 1
        if entry.outcome and entry.outcome.failed == true then summary.failed += 1 else summary.hatched += 1 end
        if Skip.isNotable(entry.outcome) then table.insert(summary.notable, entry) end
    end
    return summary
end

function Skip.lines(summary: any): {string}
    local lines = {string.format("%d eggs skipped (%d hatched, %d cracked)", summary.total, summary.hatched, summary.failed)}
    local parts = {}
    for rarity, count in summary.byRarity do
        if count &gt; 0 then table.insert(parts, string.format("%d %s", count, Skip.Names[rarity])) end
    end
    if #parts &gt; 0 then table.insert(lines, table.concat(parts, "  |  ")) end
    return lines
end

return Skip
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX215">
        <Properties>
          <string name="Name">RuntimeMeshes</string>
          <ProtectedString name="Source">--!strict
-- Build local visual MeshParts from embedded original geometry. Server collision stays separate.
local AssetService = game:GetService("AssetService")
local RunService = game:GetService("RunService")
local Geometry = require(script.Parent.ResourceGeometry)
local RuntimeMeshes = {}
local resourceIds = {}
for id in Geometry do table.insert(resourceIds,id) end
table.sort(resourceIds)
local templates: {[string]: Model} = {}
local editableMeshes: {[string]: EditableMesh} = {}
local started = false
RuntimeMeshes.Ready = Instance.new("BindableEvent")
function RuntimeMeshes.clone(id: string): Model?
    local template = templates[id]
    return if template then template:Clone() else nil
end
function RuntimeMeshes.prepare()
    if started or not RunService:IsClient() then return end
    started = true
    task.spawn(function()
        local succeeded = 0
        for _, id in resourceIds do
            local editable: EditableMesh? = nil
            local ok, result = pcall(function()
                local data = Geometry[id]
                local mesh = AssetService:CreateEditableMesh()
                if not mesh then error("EditableMesh memory unavailable") end
                editable = mesh
                local vertices, colors = {}, {}
                for _, position in data.vertices do
                    table.insert(vertices, mesh:AddVertex(Vector3.new(position[1], position[2], position[3])))
                end
                for _, color in data.colors do
                    table.insert(colors, mesh:AddColor(Color3.new(color[1], color[2], color[3]), 1))
                end
                for _, triangle in data.faces do
                    local face = mesh:AddTriangle(vertices[triangle[1]], vertices[triangle[2]], vertices[triangle[3]])
                    local color = colors[triangle[4]]
                    mesh:SetFaceColors(face, {color, color, color})
                    local a, b, c = data.vertices[triangle[1]], data.vertices[triangle[2]], data.vertices[triangle[3]]
                    local normal = (Vector3.new(b[1]-a[1],b[2]-a[2],b[3]-a[3])):Cross(Vector3.new(c[1]-a[1],c[2]-a[2],c[3]-a[3])).Unit
                    local normalId = mesh:AddNormal(normal)
                    mesh:SetFaceNormals(face, {normalId, normalId, normalId})
                end
                local part = AssetService:CreateMeshPartAsync(Content.fromObject(mesh))
                part.Name = id .. "Mesh"
                part.Color = Color3.new(1, 1, 1)
                part.Material = Enum.Material.SmoothPlastic
                part.Anchored = true
                part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
                part.Massless = true
                -- EditableMesh vertices are relative to mesh bounds center.
                local min, max = Vector3.new(math.huge,math.huge,math.huge), Vector3.new(-math.huge,-math.huge,-math.huge)
                for _, p in data.vertices do
                    local v = Vector3.new(p[1],p[2],p[3])
                    min = Vector3.new(math.min(min.X,v.X),math.min(min.Y,v.Y),math.min(min.Z,v.Z))
                    max = Vector3.new(math.max(max.X,v.X),math.max(max.Y,v.Y),math.max(max.Z,v.Z))
                end
                part.Size = max - min
                part.CFrame = CFrame.new((min + max) / 2)
                local model = Instance.new("Model")
                model.Name = id
                part.Parent = model
                model.WorldPivot = CFrame.new(0, 0, 0)
                return model
            end)
            if ok then
                editableMeshes[id] = editable :: EditableMesh -- preserve the content lifetime
                templates[id] = result
                succeeded += 1
                RuntimeMeshes.Ready:Fire(id)
            else
                if editable then editable:Destroy() end
                warn("[Be Dino] mesh " .. id .. " unavailable: " .. tostring(result))
                -- A permission failure should not cause repeated heavyweight failures.
                if succeeded == 0 then break end
            end
            task.wait()
        end
        workspace:SetAttribute("LocalMeshCount", succeeded)
        workspace:SetAttribute("LocalMeshStatus", if succeeded == #resourceIds then "Ready" else "Enable Mesh / Image APIs or import OBJ assets")
    end)
end
return RuntimeMeshes
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX216">
        <Properties>
          <string name="Name">Sfx</string>
          <ProtectedString name="Source">--!strict
-- Polish pass: one table of named UI/gameplay sounds. Every id is an EMPTY PROVISIONAL placeholder
-- until the owner uploads the audio pack (docs/62). Empty or malformed ids are a silent no-op, so the
-- game stays silent (never errors) until ids are filled. Honors the SOUND ON/OFF setting
-- (Theme.HatchSoundEnabled). Sound instances are pooled per name; repeats are throttled.
local Sfx = {}
-- id = "" PROVISIONAL (do not invent ids). gap = minimum seconds between plays of the same name.
Sfx.Sounds = {
    hatch_crack = {id = "", volume = .6, rate = 1, gap = .12},
    hatch_common = {id = "", volume = .6, rate = 1, gap = .2},
    hatch_rare = {id = "", volume = .7, rate = 1, gap = .2},
    hatch_legendary = {id = "", volume = .85, rate = 1, gap = .2},
    shiny_bang = {id = "", volume = .8, rate = 1, gap = .3},
    big_thud = {id = "", volume = .8, rate = 1, gap = .3},
    pickup = {id = "", volume = .35, rate = 1, gap = .06},
    run_start = {id = "", volume = .6, rate = 1, gap = .5},
    run_end = {id = "", volume = .6, rate = 1, gap = .5},
    shop_buy = {id = "", volume = .6, rate = 1, gap = .15},
    shop_refresh = {id = "", volume = .45, rate = 1, gap = .5},
    weather_start = {id = "", volume = .6, rate = 1, gap = 1},
    level_up = {id = "", volume = .7, rate = 1, gap = .5},
    fusion_reveal = {id = "", volume = .75, rate = 1, gap = .3},
    ui_click = {id = "", volume = .4, rate = 1, gap = .04},
}
Sfx.PoolSize = 3
Sfx.Group = "BeDinoSfx"

-- Pure: returns a "rbxassetid://N" string, or nil for empty/invalid ids.
function Sfx.normalizeId(id: any): string?
    if type(id) == "number" and id &gt; 0 and id % 1 == 0 then return "rbxassetid://" .. string.format("%d", id) end
    if type(id) ~= "string" then return nil end
    local digits = string.match(id, "^rbxassetid://(%d+)$") or string.match(id, "^(%d+)$")
    if not digits or tonumber(digits) == 0 then return nil end
    return "rbxassetid://" .. digits
end
-- Pure: should a play at `now` be allowed given the previous accepted play time (nil = never)?
function Sfx.throttled(entry: any, last: number?, now: number): boolean
    if type(entry) ~= "table" then return true end
    return last ~= nil and now - last &lt; (entry.gap or 0)
end
-- Pure: next round-robin slot (1..size).
function Sfx.nextSlot(current: number, size: number): number
    return current % size + 1
end
-- Pure: sound name for a hatched egg. rarity 1..3 (Common/Rare/Legendary).
function Sfx.hatchName(rarity: number?): string
    return if rarity == 3 then "hatch_legendary" elseif rarity == 2 then "hatch_rare" else "hatch_common"
end

local pools: {[string]: {sounds: {Sound}, slot: number}} = {}
local lastPlayed: {[string]: number} = {}
local folder: Instance? = nil

local function enabled(): boolean
    local ok, value = pcall(function()
        return (require((script :: any).Parent.UITheme) :: any).HatchSoundEnabled ~= false
    end)
    return not ok or value
end

-- Returns true when a sound was actually started. Never throws.
function Sfx.play(name: string): boolean
    local entry = Sfx.Sounds[name]
    if not entry then return false end
    local assetId = Sfx.normalizeId(entry.id)
    if not assetId or not enabled() then return false end
    local now = os.clock()
    if Sfx.throttled(entry, lastPlayed[name], now) then return false end
    local ok = pcall(function()
        if not folder or not folder.Parent then
            local created = Instance.new("Folder")
            created.Name = Sfx.Group
            created.Parent = game:GetService("SoundService")
            folder = created
            pools = {}
        end
        local pool = pools[name]
        if not pool then pool = {sounds = {}, slot = 0} pools[name] = pool end
        pool.slot = Sfx.nextSlot(pool.slot, Sfx.PoolSize)
        local sound = pool.sounds[pool.slot]
        if not sound or not sound.Parent then
            sound = Instance.new("Sound")
            sound.Name = name
            sound.Parent = folder
            pool.sounds[pool.slot] = sound
        end
        sound.SoundId, sound.Volume, sound.PlaybackSpeed = assetId, entry.volume, entry.rate
        sound.TimePosition = 0
        sound:Play()
    end)
    if ok then lastPlayed[name] = now end
    return ok
end
return Sfx
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX217">
        <Properties>
          <string name="Name">ShinyEffects</string>
          <ProtectedString name="Source">-- Cosmetic-only Shiny adapter. BIG scaling remains owned by Dinosaur/Config.
local Effects = {}
local active = 0
function Effects.Create(model: Model, textureId: string, reducedEffects: boolean?)
 if reducedEffects or active&gt;=8 or not model.Parent then return nil end
 assert(textureId:match("^rbxassetid://%d+$"),"Supply uploaded BeDino_Shiny_Glint_256.png asset ID")
 local root=model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart",true)
 if not root then return nil end
 local cf,size=model:GetBoundingBox()
 local attachments={}
 local points={{-.25,.35,-.45},{.35,.05,-.48},{-.3,-.2,-.45},{.1,.2,.4}}
 for i,point in points do
  local a=Instance.new("Attachment");a.Name="BeDinoShinyGlint";a.Position=root.CFrame:PointToObjectSpace(cf:PointToWorldSpace(Vector3.new(point[1]*size.X,point[2]*size.Y,point[3]*size.Z)));a.Parent=root
  local e=Instance.new("ParticleEmitter");e.Name="WarmWhiteGlint";e.Texture=textureId
  e.Color=ColorSequence.new(Color3.fromRGB(255,250,220),Color3.fromRGB(255,255,250));e.LightEmission=1
  e.Lifetime=NumberRange.new(.35,.6);e.Rate=1.5;e.Speed=NumberRange.new(0,0);e.LockedToPart=true
  e.Rotation=NumberRange.new(-12,12);e.RotSpeed=NumberRange.new(-15,15)
  local s=math.clamp(math.min(size.X,size.Y,size.Z)*.192,.192,.6)
  e.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(.45,s),NumberSequenceKeypoint.new(1,0)})
  e.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.3,.05),NumberSequenceKeypoint.new(1,1)})
  e.Parent=a;table.insert(attachments,a)
 end
 active+=1;local alive=true;local connection
 local function resize()
  if not alive or not model.Parent then return end
  local bounds,dimensions=model:GetBoundingBox()
  for i,a in attachments do
   local point=points[i]
   a.Position=root.CFrame:PointToObjectSpace(bounds:PointToWorldSpace(Vector3.new(point[1]*dimensions.X,point[2]*dimensions.Y,point[3]*dimensions.Z)))
   local size=math.clamp(math.min(dimensions.X,dimensions.Y,dimensions.Z)*.192,.192,.6)
   a.WarmWhiteGlint.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(.45,size),NumberSequenceKeypoint.new(1,0)})
  end
 end
 local function destroy()
  if not alive then return end;alive=false;active-=1
  if connection then connection:Disconnect() end
  for _,a in attachments do a:Destroy() end
 end
 connection=model.Destroying:Connect(destroy)
 return {Destroy=destroy,Resize=resize,SetReducedEffects=function(value: boolean) if value then destroy() end end}
end
return Effects
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX218">
        <Properties>
          <string name="Name">ShopOdds</string>
          <ProtectedString name="Source">--!strict
local Config=require(script.Parent.Config)
local Progression=require(script.Parent.ProgressionConfig)
local Outcomes=require(script.Parent.EggOutcomeOdds)
local Odds={}
-- Normalized condition percentages for an upgrade tier (weights are integers out of
-- ConditionWeightScale, so 0.5% stays exact). Shared by disclosure text and shop UI.
function Odds.conditionPercents(level)
    local weights=Progression.ConditionWeights[math.clamp(level or 0,0,#Progression.ConditionWeights-1)+1]
    local sum=0 for _,weight in weights do sum+=weight end
    local result={}
    for i,weight in weights do result[i]=100*weight/sum end
    return result
end
function Odds.lines(level)
    local lines={"RANDOM EGG ODDS", "Species (one purchased egg; no run-batch boost):"}
    local total=0 for _,row in Config.ChestSpeciesWeights do total+=row.weight end
    for _,row in Config.ChestSpeciesWeights do table.insert(lines,string.format("%s: %.4f%%",Config.SpeciesDisplayNames[row.speciesId],100*row.weight/total)) end
    total=0 for _,row in Config.ChestQuantityWeights do total+=row.weight end
    table.insert(lines,"Dinosaurs from a successful egg:")
    for _,row in Config.ChestQuantityWeights do table.insert(lines,string.format("%d %s: %.4f%%",row.count,if row.count==1 then "dinosaur" else "dinosaurs",100*row.weight/total)) end
    table.insert(lines,"Condition upgrade "..level.." ("..Progression.ConditionOddsVersion.."):")
    local percents=Odds.conditionPercents(level)
    for i,row in Progression.Conditions do table.insert(lines,string.format("%s: %g%%; hatch %g%%; speed/growth %gx",row.name,percents[i],row.hatchChance*100,row.stats)) end
    table.insert(lines,"Failed egg: "..Outcomes.percent(Outcomes.failure(level)).." overall; no dinosaur or crystal refund")
    table.insert(lines,"Colors (each slot independently):")
    total=0 for _,row in Progression.EggColors do total+=row.weight end
    for _,row in Progression.EggColors do table.insert(lines,string.format("%s: %.4f%% per slot",row.name,100*row.weight/total)) end
    for _,row in Progression.EggColors do if row.id=="black" then table.insert(lines,"Black / Black genes: "..Outcomes.percent((row.weight/total)^2)) end end
    local patterns=Outcomes.patterns()
    table.insert(lines,"Patterns: "..#patterns.." equally likely; "..Outcomes.percent(1/#patterns).." each")
    local mode=Outcomes.blendMode()
    table.insert(lines,if mode=="legacy" then "Primary share 0-100%: "..Outcomes.percent(1/101).." each"
        elseif mode=="uniform" then "Mixed share 1-99%: "..Outcomes.percent(1/99).." each; matching genes 100%"
        else "Mixed shares 1% and 99%: "..Outcomes.percent(2/101).." each; shares 2-98%: "..Outcomes.percent(1/101).." each; matching genes 100%")
    table.insert(lines,"Normal size: 90%; BIG: 10% (size only, 1.2x)")
    table.insert(lines,"Purchased eggs: clear-weather, Shiny 0%; event mutation 0%")
    table.insert(lines,"Earned eggs: Shiny 5% during Volcano, Northern Lights, Earthquake or Blood Moon; otherwise 0%. BIG is independent.")
    table.insert(lines,"Each combined outcome multiplies its independent probabilities; only Cracked can fail.")
    table.insert(lines,"Displayed percentages are rounded; their total may differ from 100%. Filters retain original odds, not renormalized subset odds.")
    return lines
end
return Odds
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX219">
        <Properties>
          <string name="Name">TouchLayout</string>
          <ProtectedString name="Source">--!strict
-- BD-054: pure gameplay-HUD layout math for touch phones/tablets and desktop.
-- No Roblox services are used: every number is a pixel inside the BeDinoUI ScreenGui
-- canvas, which uses ScreenInsets = CoreUISafeInsets (device notch/gesture bar and the
-- Roblox top bar are already excluded). Bootstrap.client.luau applies the result;
-- tools/verify_movement_mobile.py checks it for several viewports offline.
--
-- Each placed element is {x, y, scale, w, h}: (x, y) is the top-left corner with
-- AnchorPoint (0, 0), (w, h) is the design size before UIScale, so the rendered
-- rectangle is (x, y, w * scale, h * scale).
local Config = require(script.Parent.Config)
local TouchLayout = {}

export type Rect = {x: number, y: number, w: number, h: number}

TouchLayout.HUD = {w = 390, h = 94}
TouchLayout.CRYSTAL = {w = 260, h = 48}
TouchLayout.TIMERS_W = 286
TouchLayout.LEAP_H, TouchLayout.WEATHER_H, TouchLayout.BUFFS_H = 60, 62, 68
TouchLayout.ACTION = {w = 244, h = 60}

local function clamp(value: number, low: number, high: number): number
    return math.max(low, math.min(high, value))
end

function TouchLayout.rendered(element): Rect
    return {x = element.x, y = element.y, w = element.w * element.scale, h = element.h * element.scale}
end

function TouchLayout.overlaps(a: Rect, b: Rect): boolean
    return a.x &lt; b.x + b.w and b.x &lt; a.x + a.w and a.y &lt; b.y + b.h and b.y &lt; a.y + a.h
end

local function union(a: Rect, b: Rect?): Rect
    if not b or b.w &lt;= 0 or b.h &lt;= 0 then return a end
    local x, y = math.min(a.x, b.x), math.min(a.y, b.y)
    return {x = x, y = y, w = math.max(a.x + a.w, b.x + b.w) - x, h = math.max(a.y + a.h, b.y + b.h) - y}
end

-- Mirrors the Roblox PlayerModule defaults: DynamicThumbstickFrame covers the left 40%
-- of the lower two thirds; TouchJump is a 70 px button on small screens (shorter side
-- &lt;= 500) or 120 px otherwise. Measured rects from the live TouchGui are unioned in.
function TouchLayout.reservedZones(width: number, height: number, measuredThumb: Rect?, measuredJump: Rect?): (Rect, Rect)
    local thumb = union({x = 0, y = height / 3, w = width * 0.4, h = height * 2 / 3}, measuredThumb)
    local small = math.min(width, height) &lt;= 500
    local jump: Rect = if small then {x = width - 95, y = height - 90, w = 70, h = 70}
        else {x = width - 170, y = height - 210, w = 120, h = 120}
    jump = union(jump, measuredJump)
    -- Reserve the whole thumb-resting corner from the jump button to the screen edges.
    local m = Config.TouchSafeMargin
    local corner = {x = jump.x - m, y = jump.y - m, w = width - jump.x + m, h = height - jump.y + m}
    local thumbZone = {x = thumb.x, y = thumb.y - m, w = thumb.w + m, h = height - thumb.y + m}
    return thumbZone, corner
end

local function railButtons(count: number, columns: number, bw: number, bh: number, gap: number)
    local positions = {}
    for i = 1, count do
        local column = (i - 1) % columns
        local row = (i - 1) // columns
        positions[i] = {x = gap + column * (bw + gap), y = gap + row * (bh + gap)}
    end
    return positions
end

local function buttonContent(bw: number, bh: number)
    if bw &gt;= 120 then
        -- Wide tablets: icon left, label right (desktop style).
        local icon = math.min(bh - 12, 40)
        return {iconX = 4, iconY = (bh - icon) / 2, icon = icon, labelX = icon + 8, labelY = 0,
            labelW = bw - icon - 10, labelH = bh, textSize = clamp(math.floor((bw - icon - 10) / 4.8), 12, 17)}
    end
    -- Phones: icon above a short label.
    local icon = math.min(math.floor(bh * 0.5), bw - 12)
    return {iconX = (bw - icon) / 2, iconY = 3, icon = icon, labelX = 0, labelY = icon + 3,
        labelW = bw, labelH = bh - icon - 5, textSize = clamp(math.floor((bw - 4) / 4.7), 10, 14)}
end

local function desktop(width: number, height: number, count: number)
    local small = clamp(math.min(width / 1000, height / 800), 0.3, 1)
    local crystalScale = math.max(0.65, small)
    local hud = {x = 18, y = height - 18 - TouchLayout.HUD.h * small, scale = small, w = TouchLayout.HUD.w, h = TouchLayout.HUD.h}
    local railH = count * 62 + 10
    local action = {x = 0, y = height - 22 - TouchLayout.ACTION.h * small, scale = small, w = TouchLayout.ACTION.w, h = TouchLayout.ACTION.h}
    action.x = math.max(width / 2 - action.w * small / 2, hud.x + hud.w * small + 12)
    local crystalX = width - 20 - TouchLayout.CRYSTAL.w * crystalScale
    local noticeW = math.min(500, 2 * (crystalX - 8 - width / 2))
    return {
        touch = false,
        reserved = {},
        crystal = {x = crystalX, y = 8, scale = crystalScale, w = TouchLayout.CRYSTAL.w, h = TouchLayout.CRYSTAL.h},
        hud = hud,
        rail = {x = 14, y = height / 2 - railH * small / 2, scale = small, w = 186, h = railH,
            button = {w = 172, h = 54, iconX = 5, iconY = 6, icon = 40, labelX = 52, labelY = 0, labelW = 114, labelH = 54, textSize = 19},
            positions = railButtons(count, 1, 172, 54, 7) :: any},
        timers = {x = width - 20 - TouchLayout.TIMERS_W * small, y = height - 22 - 220 * small, scale = small, w = TouchLayout.TIMERS_W, h = 220,
            leapY = 0, weatherY = 72, weatherVisible = true, buffsY = 145, buffsH = 68, buffsVisible = true},
        action = action,
        badge = {x = width / 2 - 125, y = 36, scale = 1, w = 250, h = 24, textSize = 15},
        notice = {x = width / 2 - noticeW / 2, y = 8, scale = 1, w = noticeW, h = 25, textSize = 14},
        toastScale = math.min(1, (width - 20) / 440),
    }
end

function TouchLayout.compute(params: {width: number, height: number, touch: boolean, navCount: number, thumb: Rect?, jump: Rect?})
    local width, height, count = params.width, params.height, params.navCount
    if not params.touch then return desktop(width, height, count) end
    local target, m = Config.TouchMinTargetPx, Config.TouchSafeMargin
    local s = clamp(math.min(width / 1000, height / 560), 0.55, 1)
    local thumb, corner = TouchLayout.reservedZones(width, height, params.thumb, params.jump)

    -- Top-left status HUD: stays above the thumbstick zone.
    local hudScale = math.min(1, math.max(s, Config.TouchMinHudScale), (thumb.y - 2 * m) / TouchLayout.HUD.h)
    local crystalScale = math.max(0.65, s)
    local hud, crystal, rail
    for attempt = 1, 2 do
        if attempt == 2 then
            -- Narrow phones: compact status widgets to their floor before shrinking buttons.
            hudScale = math.min(hudScale, 0.55)
            crystalScale = 0.55
        end
        hud = {x = m, y = m, scale = hudScale, w = TouchLayout.HUD.w, h = TouchLayout.HUD.h}
        crystal = {x = width - m - TouchLayout.CRYSTAL.w * crystalScale, y = m, scale = crystalScale, w = TouchLayout.CRYSTAL.w, h = TouchLayout.CRYSTAL.h}
        local left = hud.x + hud.w * hudScale + m
        local available = crystal.x - m - left
        local gap = 4
        -- One row of navigation buttons between HUD and wallet, else a 2-row grid.
        for _, rows in {1, 2} do
            local columns = math.ceil(count / rows)
            local bh = if rows == 1 then math.max(target + 8, math.round(56 * s)) else target
            local bw = math.min(132, math.floor((available - (columns + 1) * gap) / columns))
            local railW = columns * bw + (columns + 1) * gap
            local railH = rows * bh + (rows + 1) * gap
            if bw &gt;= target and m + railH &lt;= thumb.y then
                rail = {x = left + (available - railW) / 2, y = m, scale = 1, w = railW, h = railH,
                    button = buttonContent(bw, bh), positions = railButtons(count, columns, bw, bh, gap), rows = rows}
                rail.button.w, rail.button.h = bw, bh
                break
            end
        end
        if rail then break end
    end
    if not rail then
        -- Last resort (very narrow canvas): minimum-size grid, verified by tests not to be hit.
        local columns = math.ceil(count / 2)
        local railW = columns * target + (columns + 1) * 4
        rail = {x = (width - railW) / 2, y = m, scale = 1, w = railW, h = 2 * target + 12,
            button = buttonContent(target, target), positions = railButtons(count, columns, target, target, 4), rows = 2}
        rail.button.w, rail.button.h = target, target
    end

    -- Right column above the jump corner: weather on top, LEAP nearest the right thumb.
    local timersScale = math.max(target / TouchLayout.LEAP_H, s)
    local columnX = width - m - TouchLayout.TIMERS_W * timersScale
    local top = crystal.y + crystal.h * crystal.scale + m
    if rail.x + rail.w &gt; columnX then top = math.max(top, rail.y + rail.h + m) end
    local bottom = corner.y - 1 -- 1 px guard against float rounding at the shared edge
    local designH = math.min(220, (bottom - top) / timersScale)
    local leapY = designH - TouchLayout.LEAP_H
    local weatherVisible = leapY &gt;= TouchLayout.WEATHER_H + 6
    local buffsY = TouchLayout.WEATHER_H + 6
    local buffsH = math.min(TouchLayout.BUFFS_H, leapY - 6 - buffsY)
    local timers = {x = columnX, y = bottom - designH * timersScale, scale = timersScale, w = TouchLayout.TIMERS_W, h = designH,
        leapY = leapY, weatherY = 0, weatherVisible = weatherVisible, buffsY = leapY - 6 - math.max(buffsH, 0),
        buffsH = math.max(buffsH, 0), buffsVisible = weatherVisible and buffsH &gt;= 30}

    -- Bottom-centre Home/Explore between the thumbstick zone and the jump corner.
    local actionScale = math.max(target / TouchLayout.ACTION.h, s)
    local halfSpace = math.min(width / 2 - (thumb.x + thumb.w) - m, corner.x - m - width / 2)
    local actionW = math.min(TouchLayout.ACTION.w, 2 * halfSpace / actionScale)
    local action = {x = width / 2 - actionW * actionScale / 2, y = height - m - TouchLayout.ACTION.h * actionScale,
        scale = actionScale, w = actionW, h = TouchLayout.ACTION.h}

    local badgeY = hud.y + hud.h * hud.scale + 2
    -- Studio-only preview notice: beside the build badge, or below it when the rail is in the way.
    local notice = {x = m + 154, y = badgeY, scale = 1, w = 230, h = 16, textSize = 12}
    if TouchLayout.overlaps(TouchLayout.rendered(notice), {x = rail.x, y = rail.y, w = rail.w, h = rail.h}) then
        notice.x, notice.y = m, badgeY + 18
    end
    return {
        touch = true,
        reserved = {thumb = thumb, jump = corner},
        crystal = crystal,
        hud = hud,
        rail = rail,
        timers = timers,
        action = action,
        badge = {x = m, y = badgeY, scale = 1, w = 150, h = 16, textSize = 12},
        notice = notice,
        toastScale = math.min(1, (width - 20) / 440),
    }
end

return TouchLayout
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX220">
        <Properties>
          <string name="Name">TrailArtwork</string>
          <ProtectedString name="Source">--!strict
-- Shared ribbon preview uses the catalog's real colors and taper, not a fabricated upload.
local Config=require(script.Parent.ProgressionConfig)
local Rules=require(script.Parent.ProgressionRules)
local Art={}
function Art.build(parent: GuiObject,id: string): Frame?
    local item=Rules.item(Config.Trails,id)
    if not item then return nil end
    local root=Instance.new("Frame")
    root.Name,root.BackgroundTransparency,root.Size,root.ZIndex,root.Parent="TrailArtwork_"..id,1,UDim2.fromScale(1,1),parent.ZIndex+1,parent
    for lane=1,2 do for i=1,28 do
        local t=(i-1)/27
        local part=Instance.new("Frame")
        local nextT=i/27
        local x,y=.12+t*.76,.34+(lane-1)*.2+math.sin(t*math.pi*1.5)*.14
        local dx,dy=(nextT-t)*.76,(math.sin(nextT*math.pi*1.5)-math.sin(t*math.pi*1.5))*.14
        part.AnchorPoint,part.Position=Vector2.new(.5,.5),UDim2.fromScale(x,y)
        part.Size=UDim2.fromScale(math.sqrt(dx*dx+dy*dy)*2.2,.045*(1-t*.75))
        part.Rotation=math.deg(math.atan2(dy,dx))
        part.BackgroundColor3=Color3.fromRGB(item.color[1],item.color[2],item.color[3]):Lerp(Color3.fromRGB(item.accent[1],item.accent[2],item.accent[3]),t)
        part.BackgroundTransparency,part.BorderSizePixel,part.ZIndex,part.Parent=t*.7,0,root.ZIndex,root
        local corner=Instance.new("UICorner") corner.CornerRadius,corner.Parent=UDim.new(1,0),part
    end end
    return root
end
return Art
</ProtectedString>
        </Properties>
      </Item>
