      <Item class="ModuleScript" referent="RBX200">
        <Properties>
          <string name="Name">IslandLayout</string>
          <ProtectedString name="Source">--!strict
-- Authored broad ramps and mountain masses; the center remains a readable chase meadow.
local IslandLayout = {}
IslandLayout.Peaks = {
    {x = -145, z = -140, height = 65, radius = 90},
    {x = 145, z = -130, height = 80, radius = 105},
    {x = -165, z = 125, height = 46, radius = 82},
    {x = 160, z = 140, height = 58, radius = 95},
}
function IslandLayout.height(x: number, z: number): number
    local h = 0
    for _, peak in IslandLayout.Peaks do
        local r2 = ((x-peak.x)^2 + (z-peak.z)^2) / peak.radius^2
        h += peak.height * math.exp(-r2 * 1.6)
    end
    local meadow = math.exp(-(x*x + (z-30)^2) / 5000)
    h *= 1 - meadow * .95
    local edge = math.max(math.abs(x), math.abs(z))
    h += math.max(0, edge - 190) * .55
    return h + math.noise(x / 65, z / 65, 14) * 2 * (1-meadow)
end
return IslandLayout
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX201">
        <Properties>
          <string name="Name">LegacyGenePatterns</string>
          <ProtectedString name="Source">--!strict
-- Shared authored egg patterns on the six earlier uploaded species' UV maps.
local Assets=game:GetService("AssetService")
local Http=game:GetService("HttpService")
local Bindings=require(script.Parent.GeneTextureAssets)
local Legacy={}
local cache={}
function Legacy.data(part: MeshPart)
    local id=part:GetAttribute("GeneOriginalTexture") or part.TextureID
    local asset=Bindings[string.match(id,"%d+") or ""]
    if not asset then return nil end
    part:SetAttribute("GeneOriginalTexture",id)
    if cache[asset]~=nil then return cache[asset] or nil end
    local ok,result=pcall(function()
        local source=Assets:CreateEditableImageAsync(Content.fromUri("rbxassetid://"..asset))
        assert(source,"Neutral texture unavailable")
        local size=source.Size
        local raw=source:ReadPixelsBuffer(Vector2.zero,size);source:Destroy()
        local masks=Http:JSONDecode(require(script.Parent.CreatureGenes.egg))
        local rgb={};local values={}
        for y=0,127 do for x=0,127 do
            local offset=(math.floor(y*size.Y/128)*size.X+math.floor(x*size.X/128))*4
            local p=y*128+x+1
            local value=buffer.readu8(raw,offset);values[p]=value
            table.insert(rgb,string.format("%02x%02x%02x",value,value,value))
        end end
        local patterns={}
        for name,mask in masks.patterns do
            local parts={}
            for p,value in values do table.insert(parts,if value&lt;38 then "fe" else string.sub(mask,(p-1)*2+1,p*2)) end
            patterns[name]=table.concat(parts)
        end
        return {size=128,patterns=patterns,fixedRGB=table.concat(rgb),shading=values}
    end)
    cache[asset]=if ok then result else false
    return if ok then result else nil
end
return Legacy
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX202">
        <Properties>
          <string name="Name">ModelPreview</string>
          <ProtectedString name="Source">--!strict
local Resources=require(script.Parent.ResourceModels)
local Egg=require(script.Parent.EggPreview)
local Camera=require(script.Parent.PreviewCamera)
local ModelPreview={}
function ModelPreview.add(parent: GuiObject,id: string,empty: boolean?): ViewportFrame
    local viewport=Instance.new("ViewportFrame")
    viewport.BackgroundTransparency,viewport.Size=1,UDim2.fromScale(1,1)
    viewport.Ambient,viewport.LightColor,viewport.LightDirection=Color3.fromRGB(193,211,220),Color3.fromRGB(255,246,220),Vector3.new(-1,-1,-1)
    viewport.ZIndex,viewport.Parent=parent.ZIndex+1,parent
    local model=if id=="egg" then Egg.create(empty) else Resources.clone(id)
    if model and not viewport.Parent then model:Destroy();return viewport end
    if model then
        for _,item in model:GetDescendants() do if item:IsA("BasePart") then item.Anchored=true end end
        model:PivotTo(CFrame.new())
        local world=Instance.new("WorldModel") world.Parent=viewport
        model.Parent=world
        Camera.bind(viewport,model,if id=="egg" then nil else id)
    end
    return viewport
end
return ModelPreview
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX203">
        <Properties>
          <string name="Name">MovementEnvelope</string>
          <ProtectedString name="Source">--!strict
-- Shared movement envelope. The same numbers drive the Humanoid setup (Dinosaur.luau),
-- the torso collider and every server plausibility check, so allowed traversal and
-- anti-cheat tolerance cannot drift apart (BD-053).
local Config = require(script.Parent.Config)
local MovementEnvelope = {}

local function slopeTangent(): number
    return math.tan(math.rad(Config.MaxSlopeAngle))
end

-- Fastest legitimate vertical climb while walking up the steepest allowed slope.
function MovementEnvelope.maxClimbRate(speed: number): number
    return math.max(0, speed) * slopeTangent()
end

function MovementEnvelope.plausible(delta: Vector3, dt: number, tolerance: number, burst: number, verticalVelocity: number, speed: number?): boolean
    local walk = speed or Config.WalkSpeed
    local horizontal = Vector2.new(delta.X, delta.Z).Magnitude
    local verticalSpeed = math.max(
        Config.JumpPower,
        MovementEnvelope.maxClimbRate(walk),
        math.min(Config.MovementGuardMaxVerticalSpeed, math.abs(verticalVelocity))
    )
    return horizontal &lt;= walk * dt * tolerance + burst
        and math.abs(delta.Y) &lt;= verticalSpeed * dt + workspace.Gravity * dt * dt / 2 + burst
end

-- Torso collider box for a dinosaur at `scale`, welded to the HumanoidRootPart whose
-- floor sits `groundHeight` studs below its centre. Returns width, height, length and
-- the collider centre's Y offset from the root. The footprint grows with the visual,
-- but the underside clears a plane tilted to MaxSlopeAngle in any direction (the worst
-- case is the half-diagonal), so the box never wedges into a walkable hill.
function MovementEnvelope.collider(scale: number, groundHeight: number): (number, number, number, number)
    local width = Config.DinoColliderWidth * scale
    local length = Config.DinoColliderLength * scale
    local halfDiagonal = math.sqrt(width * width + length * length) / 2
    local bottom = math.max(
        Config.DinoColliderMinClearance,
        halfDiagonal * slopeTangent() + Config.DinoColliderSlopeMargin
    )
    local top = math.max(bottom + Config.DinoColliderMinHeight, Config.DinoColliderTopPerScale * scale)
    local height = top - bottom
    return width, height, length, -groundHeight + bottom + height / 2
end

return MovementEnvelope
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX204">
        <Properties>
          <string name="Name">MutationEffects</string>
          <ProtectedString name="Source">-- Standalone client adapter. Upload BeDino_Soft_Smoke_256.png first.
-- Caller owns player-distance selection and calls Destroy on unequip/despawn.
local RunService = game:GetService("RunService")
local Effects = {}
local activeCount = 0
local colors = {
 dewdrop = {Color3.fromRGB(43,154,111),Color3.fromRGB(112,244,191)},
 charged = {Color3.fromRGB(56,66,87),Color3.fromRGB(255,207,72)},
 frost = {Color3.fromRGB(112,184,211),Color3.fromRGB(175,235,255)},
 seismic = {Color3.fromRGB(133,97,62),Color3.fromRGB(210,173,113)},
 ember = {Color3.fromRGB(99,54,34),Color3.fromRGB(255,144,51)},
 aurora = {Color3.fromRGB(109,65,150),Color3.fromRGB(81,233,187)},
 bloodmoon = {Color3.fromRGB(122,26,46),Color3.fromRGB(250,67,102)},
}
local function anchor(parent)
 local p=Instance.new("Part");p.Name="MutationFXAnchor";p.Size=Vector3.new(.1,.1,.1)
 p.Transparency=1;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false;p.Parent=parent
 return p
end
function Effects.Create(model: Model, mutationId: string, smokeTexture: string, reducedEffects: boolean?)
 local palette=colors[mutationId]
 if not palette or not model.Parent or reducedEffects or activeCount&gt;=8 then return nil end
 assert(type(smokeTexture)=="string" and smokeTexture:match("^rbxassetid://%d+$"),"Supply uploaded BeDino smoke texture asset ID")
 local folder=Instance.new("Folder");folder.Name="BeDinoMutation_"..mutationId;folder.Parent=workspace
 local center=anchor(folder);local attachments={};local beams={};local particles={};local fragments={}
 for i=1,4 do
  local a=Instance.new("Attachment");a.Parent=center;local b=Instance.new("Attachment");b.Parent=center
  local beam=Instance.new("Beam");beam.Attachment0=a;beam.Attachment1=b;beam.FaceCamera=true;beam.Segments=8
  beam.Color=ColorSequence.new(mutationId=="aurora" and ({Color3.fromRGB(81,233,187),Color3.fromRGB(101,176,255),Color3.fromRGB(189,104,240),palette[2]})[i] or palette[2])
  beam.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.25,.55),NumberSequenceKeypoint.new(.7,.6),NumberSequenceKeypoint.new(1,1)})
  beam.LightEmission=.55;beam.Parent=center;table.insert(attachments,{a,b});table.insert(beams,beam)
  local emit=Instance.new("ParticleEmitter");emit.Name="SoftMist";emit.Texture=smokeTexture
  emit.Color=ColorSequence.new(palette[1]);emit.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.25,.55),NumberSequenceKeypoint.new(.7,.72),NumberSequenceKeypoint.new(1,1)})
  emit.Lifetime=NumberRange.new(.7,1.2);emit.Rate=4;emit.Speed=NumberRange.new(.25,.6);emit.SpreadAngle=Vector2.new(25,25)
  emit.Rotation=NumberRange.new(-180,180);emit.RotSpeed=NumberRange.new(-20,20);emit.LightEmission=.12;emit.LockedToPart=false;emit.Parent=a;table.insert(particles,emit)
 end
 for i=1,(mutationId=="bloodmoon" and 1 or 4) do
  local p=Instance.new("Part");p.Name="ElementalDetail";p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false
  p.Color=palette[2];p.Material=Enum.Material.SmoothPlastic
  if mutationId=="dewdrop" or mutationId=="bloodmoon" then p.Shape=Enum.PartType.Ball end
  if mutationId=="ember" then p.Color=Color3.fromRGB(65,43,32) end
  if mutationId=="charged" then p.Material=Enum.Material.Neon end
  p.Parent=folder;table.insert(fragments,p)
 end
 activeCount+=1
 local alive=true;local elapsed=0;local accumulator=0;local connection;local lastHeight=0
 local function destroy()
  if not alive then return end;alive=false;activeCount-=1
  if connection then connection:Disconnect() end;folder:Destroy()
 end
 local function update(dt)
  if not model.Parent then destroy();return end
  elapsed+=dt;accumulator+=dt;if accumulator&lt;1/30 then return end;accumulator=0
  -- GetBoundingBox only reads the dinosaur; the FX folder is outside its bounds.
  local cf,size=model:GetBoundingBox();local rx=math.max(.8,size.X*.6);local ry=math.max(.8,size.Z*.6);local h=math.max(1,size.Y)
  center.CFrame=cf*CFrame.new(0,-size.Y*.5+.1,0)
  local resized=math.abs(h-lastHeight)&gt;.02
  for i,pair in attachments do
   local angle=(i-1)*math.pi*.5+elapsed*.65
   local start=Vector3.new(math.cos(angle)*rx,.12*h,math.sin(angle)*ry)
   local finish=Vector3.new(math.cos(angle+2.1)*rx,.85*h,math.sin(angle+2.1)*ry)
   pair[1].CFrame=CFrame.new(start)*CFrame.Angles(0,-angle,math.pi*.5)
   pair[2].CFrame=CFrame.new(finish)*CFrame.Angles(0,-angle-2.1,math.pi*.5)
   if resized then beams[i].Width0=math.clamp(h*.065,.05,.28);beams[i].Width1=.01 end
   beams[i].CurveSize0=math.max(rx,ry)*.7;beams[i].CurveSize1=-math.max(rx,ry)*.55
   if resized then
    local s=math.clamp(h*.28,.25,1.25)
    particles[i].Size=NumberSequence.new({NumberSequenceKeypoint.new(0,s*.45),NumberSequenceKeypoint.new(.6,s),NumberSequenceKeypoint.new(1,s*1.3)})
   end
  end
  lastHeight=h
  for i,p in fragments do
   local a=i*math.pi*.5+elapsed*.45;local scale=math.clamp(h*.045,.06,.22)
   p.Size=mutationId=="bloodmoon" and Vector3.one*scale*2.5 or Vector3.new(scale,scale*(mutationId=="frost" and 2 or 1),scale)
   if mutationId=="charged" then p.Size=Vector3.new(scale*.22,scale*3,scale*.22) end
   local pos=mutationId=="bloodmoon" and Vector3.new(rx*.7,h,ry*.5) or Vector3.new(math.cos(a)*rx,(.25+i*.12)*h+math.sin(elapsed*1.2+i)*h*.035,math.sin(a)*ry)
   p.CFrame=center.CFrame*CFrame.new(pos)*CFrame.Angles(elapsed*.3,i,elapsed*.2)
  end
 end
 update(1/30);connection=RunService.Heartbeat:Connect(update)
 return {Destroy=destroy, SetReducedEffects=function(value: boolean) if value then destroy() end end}
end
return Effects
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX205">
        <Properties>
          <string name="Name">NavigationArtwork</string>
          <ProtectedString name="Source">--!strict
-- Logical page IDs select shared artwork compositions, not flattened exports.
return {
    collection = "dinos",
    eggs = "egg",
    fusion = "fusion",
    home = "home",
    auras = "aura_meadow",
    potions = "potion_speed",
    settings = "shield",
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX206">
        <Properties>
          <string name="Name">NextGoal</string>
          <ProtectedString name="Source">--!strict
-- Polish pass: pure "next goal" HUD line. No Instances, services or remotes.
-- Best fusion progress across species + pattern (from the FusionAction list data) wins; when that data
-- is unavailable or nothing is in progress the line falls back to account-level XP progress.
-- Exercised by tools/verify_next_goal.py.
local NextGoal = {}
-- Mirrors FusionSelection.Stages (docs/58). Callers may pass opts.stages to stay in sync.
NextGoal.Stages = {
    {id = "gold", name = "Gold", source = "base", donorCount = 50},
    {id = "emerald", name = "Emerald", source = "gold", donorCount = 10},
    {id = "diamond", name = "Diamond", source = "emerald", donorCount = 3},
}

-- Returns the best in-progress (or ready) fusion goal, or nil.
function NextGoal.fusion(dinos: any, opts: any)
    if type(dinos) ~= "table" then return nil end
    local stages = opts.stages or NextGoal.Stages
    local counts: {[string]: number} = {}
    for _, d in dinos do
        if type(d) == "table" and not d.locked then
            local pattern = if type(d.genes) == "table" then d.genes.patternId else nil
            if type(d.speciesId) == "string" and type(pattern) == "string" and type(d.stage) == "string" then
                local key = d.stage .. "|" .. d.speciesId .. "|" .. pattern
                counts[key] = (counts[key] or 0) + 1
            end
        end
    end
    local best = nil
    for key, count in counts do
        local stageId, species, pattern = string.match(key, "^([^|]*)|([^|]*)|(.*)$")
        for _, stage in stages do
            if stage.source == stageId then
                local have = math.min(count, stage.donorCount)
                local fraction = have / stage.donorCount
                local ready = count &gt;= stage.donorCount
                -- Prefer ready, then fraction, then smaller recipe, then name (deterministic).
                local score = (if ready then 2 else 0) + fraction
                local tier = stage.donorCount
                local name = stage.name .. "|" .. species .. "|" .. pattern
                if not best or score &gt; best.score or (score == best.score and (tier &lt; best.tier or (tier == best.tier and name &lt; best.name))) then
                    best = {score = score, tier = tier, name = name, stage = stage, species = species, pattern = pattern, have = have, fraction = fraction, ready = ready}
                end
            end
        end
    end
    if not best then return nil end
    local label = if opts.speciesName then opts.speciesName(best.species) else best.species
    local patternLabel = if opts.patternName then opts.patternName(best.pattern) else best.pattern
    local text = if best.ready then string.format("%s ready: fuse %s %s", best.stage.name, label, patternLabel)
        else string.format("%s: %d/%d %s %s", best.stage.name, best.have, best.stage.donorCount, label, patternLabel)
    return {kind = "fusion", text = text, fraction = best.fraction, ready = best.ready}
end

-- Level XP progress. Level L starts at (L-1)^2 * perLevel xp (ProgressionRules.level).
function NextGoal.level(opts: any)
    local perLevel, maxLevel = opts.perLevel or 100, opts.maxLevel or 60
    local xp = math.max(0, tonumber(opts.xp) or 0)
    local level = tonumber(opts.level)
    if not level then level = math.min(maxLevel, 1 + math.floor(math.sqrt(xp / perLevel))) end
    level = math.clamp(level, 1, maxLevel)
    if level &gt;= maxLevel then return {kind = "level", text = "Level " .. level .. " (max)", fraction = 1} end
    local floorXp, nextXp = (level - 1) ^ 2 * perLevel, level ^ 2 * perLevel
    local into = math.clamp(xp - floorXp, 0, nextXp - floorXp)
    return {kind = "level", text = string.format("Level %d: %d/%d XP", level, into, nextXp - floorXp), fraction = into / (nextXp - floorXp)}
end

-- opts: dinos (list or nil), level, xp, perLevel, maxLevel, stages, speciesName(id), patternName(id)
function NextGoal.pick(opts: any)
    return NextGoal.fusion(opts.dinos, opts) or NextGoal.level(opts)
end
return NextGoal
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX207">
        <Properties>
          <string name="Name">PatternGenes</string>
          <ProtectedString name="Source">--!strict
-- Authored egg masks on creature UVs; eyes/mouth are fixed pixels, never tinted.
local Assets=game:GetService("AssetService")
local Http=game:GetService("HttpService")
local Genetics=require(script.Parent.EggGenetics)
local Pattern={}
local images=setmetatable({},{__mode="k"})
local activeImages=0
function Pattern.apply(part: MeshPart,genes): boolean
    local folder=script.Parent:FindFirstChild("CreatureGenes")
    local source=if folder then folder:FindFirstChild(part:GetAttribute("GeneSpecies") or "") else nil
    local data=if source then Http:JSONDecode(require(source)) else require(script.Parent.LegacyGenePatterns).data(part)
    if not data then return false end
    local mask=data.patterns[genes.patternId or "01_blank"] or data.patterns["01_blank"]
    local size=data.size
    local histogram=table.create(254,0);local count=0
    for i=1,#mask,2 do
        local rank=tonumber(string.sub(mask,i,i+1),16)
        if rank&lt;254 then histogram[rank+1]+=1;count+=1 end
    end
    local same=genes.primaryColorId==genes.secondaryColorId
    local target=math.floor(count*(if same then .5 else genes.blend/100))
    local threshold=253;local cumulative=0
    for rank=0,253 do
        if cumulative+histogram[rank+1]&gt;=target then threshold=rank;break end
        cumulative+=histogram[rank+1]
    end
    local remainder=target-cumulative;local tied=0
    local a,b=Genetics.color(genes.primaryColorId).rgb,Genetics.color(genes.secondaryColorId).rgb
    -- Same-family genes still show lighter and darker pattern regions.
    local pixels=buffer.create(size*size*4)
    for p=0,size*size-1 do
        local rank=tonumber(string.sub(mask,p*2+1,p*2+2),16)
        local primary=rank&lt;threshold or (rank==threshold and tied&lt;remainder)
        if rank==threshold then tied+=1 end
        local rgb=if primary then a else b
        for channel=1,3 do
            local value=rgb[channel]
            if data.shading then value*=math.max(.28,data.shading[p+1]/255) end
            if same then value=math.clamp(value*(if primary then .8 else 1.08)+(if not primary then 12 else 0),0,255) end
            if rank==254 then value=tonumber(string.sub(data.fixedRGB,p*6+(channel-1)*2+1,p*6+(channel-1)*2+2),16) end
            buffer.writeu8(pixels,p*4+channel-1,math.floor(value+.5))
        end
        buffer.writeu8(pixels,p*4+3,255)
    end
    local image=images[part]
    if not image then
        if activeImages&gt;=32 or not part.Parent then return false end
        local ok,result=pcall(function() return Assets:CreateEditableImage({Size=Vector2.new(size,size)}) end)
        if not ok or not result then return false end
        image=result;images[part]=image;activeImages+=1
        part.Destroying:Once(function() image:Destroy();images[part]=nil;activeImages-=1 end)
    end
    image:WritePixelsBuffer(Vector2.zero,Vector2.new(size,size),pixels)
    for _,child in part:GetChildren() do if child:IsA("SurfaceAppearance") then child:Destroy() end end
    part.Color=Color3.new(1,1,1);part.TextureContent=Content.fromObject(image)
    return true
end
return Pattern
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX208">
        <Properties>
          <string name="Name">PreviewCamera</string>
          <ProtectedString name="Source">--!strict
-- Fit actual geometry, excluding controller roots and invisible humanoid parts.
local RunService = game:GetService("RunService")
local Theme = require(script.Parent.UITheme)
local Geometry = require(script.Parent.ResourceGeometry)
local PreviewCamera = {}
function PreviewCamera.bind(viewport: ViewportFrame, model: Model, geometryId: string?)
    local camera=Instance.new("Camera")
    camera.FieldOfView,camera.Parent=32,viewport
    viewport.CurrentCamera=camera
    local bounds,size=model:GetBoundingBox()
    local points={}
    local data=if geometryId and not model:GetAttribute("UploadedModelId") then Geometry[geometryId] else nil
    local origin=model:GetAttribute("GeometryOrigin") or Vector3.zero
    if data then
        for _,v in data.vertices do table.insert(points,model:GetPivot():PointToWorldSpace(Vector3.new(v[1],v[2],v[3])-origin)) end
    else
        for _,x in {-1,1} do for _,y in {-1,1} do for _,z in {-1,1} do
            table.insert(points,bounds:PointToWorldSpace(Vector3.new(x*size.X/2,y*size.Y/2,z*size.Z/2)))
        end end end
    end
    local low,high=Vector3.new(math.huge,math.huge,math.huge),Vector3.new(-math.huge,-math.huge,-math.huge)
    for _,p in points do low=low:Min(p) high=high:Max(p) end
    local target=(low+high)/2
    local elapsed=0
    local function frame(dt: number)
        if Theme.MotionEnabled then elapsed+=dt end
        local direction=Vector3.new(1+math.sin(elapsed*.5)*.035,.2,-.65).Unit
        local basis=CFrame.lookAt(target+direction,target)
        local pixels=viewport.AbsoluteSize
        local aspect=if pixels.Y&gt;0 then pixels.X/pixels.Y else 1.4
        local vertical=math.tan(math.rad(camera.FieldOfView/2))
        local horizontal=vertical*math.max(.3,aspect)
        local distance=0
        for _,point in points do
            local corner=point-target
            local depth=corner:Dot(basis.ZVector)
            distance=math.max(distance,depth+math.abs(corner:Dot(basis.XVector))/horizontal,depth+math.abs(corner:Dot(basis.YVector))/vertical)
        end
        camera.CFrame=CFrame.lookAt(target+direction*math.max(1,distance*1.045),target)
    end
    frame(0)
    local resized=viewport:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() frame(0) end)
    local motion=RunService.RenderStepped:Connect(function(dt)
        if not Theme.MotionEnabled then return end
        local ancestor: Instance?=viewport
        while ancestor do
            if ancestor:IsA("GuiObject") and not ancestor.Visible then return end
            if ancestor:IsA("ScreenGui") and not ancestor.Enabled then return end
            ancestor=ancestor.Parent
        end
        -- Camera orbit does not need a full geometry fit on every rendered frame.
        elapsed+=dt
        if elapsed-(viewport:GetAttribute("LastOrbitUpdate") or 0)&lt;1/30 then return end
        viewport:SetAttribute("LastOrbitUpdate",elapsed)
        frame(0)
    end)
    local function cleanup() resized:Disconnect();motion:Disconnect();camera:Destroy() end
    viewport.Destroying:Once(cleanup)
    model.Destroying:Once(cleanup)
end
return PreviewCamera
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX209">
        <Properties>
          <string name="Name">ProgressionConfig</string>
          <ProtectedString name="Source">--!strict
-- Private-test balance. Prices scale with permanent growth bonuses and potion duration/power.
return table.freeze({
    MaxCrystals=2000000000,
    CrystalCount=64, CrystalRespawnSeconds=90, CrystalValue=3,
    LeapCooldown=60, LeapHorizontalSpeed=72, LeapVerticalSpeed=62, LeapDuration=.7,
    WeatherInterval=600, WeatherDuration=180,
    GrowthCap=8, SpeedCap=2.2,
    AccountXPPerLevel=100, AccountMaxLevel=60,
    -- BD-044 PROVISIONAL run crystals (deterministic; the random 5/15/50 crystal box is retired).
    -- Re-tuned 2026-10-13 for 40 eggs per 500 food:
    -- crystals = min(RunCrystalCap, (RunCrystalPerEggHundredths*min(eggs,RunCrystalTierEggs)
    --            + RunCrystalPerExtraEggHundredths*max(0,eggs-RunCrystalTierEggs)) // 100).
    -- 40 eggs (500 food) -&gt; 30, 400 eggs (5,000 food) -&gt; 220 (owner's illustrative 30/220), 500 eggs -&gt; 273; cap 300 bounds it.
    RunCrystalPerEggHundredths=75, RunCrystalTierEggs=40, RunCrystalPerExtraEggHundredths=53, RunCrystalCap=300,
    RandomEggPrice=150,
    ConditionUpgrades={
        {level=1,price=100,requiredLevel=3},{level=2,price=300,requiredLevel=8},
        {level=3,price=800,requiredLevel=16},{level=4,price=1800,requiredLevel=28},
        {level=5,price=4000,requiredLevel=45},{level=6,price=8500,requiredLevel=60},
    },
    Conditions={
        {id="cracked",name="Cracked",stats=.8,hatchChance=.2},
        {id="dirty",name="Dirty",stats=.8,hatchChance=1},
        {id="normal",name="Normal",stats=1,hatchChance=1},
        {id="rainbow",name="Rainbow",stats=1.2,hatchChance=1},
        {id="astra",name="Astra",stats=1.8,hatchChance=1},
    },
    -- BD-045 condition odds, integer weights out of ConditionWeightScale (10,000 = 100%).
    -- Tier 0 is the owner target 50/30/15/4.5/0.5. Tiers 1-6 are a PROVISIONAL monotonic
    -- curve (Cracked/Dirty fall, Normal/Rainbow/Astra rise every tier); not approved balance.
    -- Historical Build 020 (build020-conditions, percent): {20,25,45,9,1},{17,23,47,11,2},
    -- {14,21,48,14,3},{11,19,49,17,4},{8,17,50,20,5},{5,15,51,22,7},{2,12,51,25,10}.
    -- Eggs keep the odds they were rolled with; traitRollVersion records the version.
    ConditionOddsVersion="bd045-conditions-v1",
    ConditionWeightScale=10000,
    ConditionWeights={
        {5000,3000,1500,450,50},
        {4200,2900,2200,600,100},
        {3400,2700,2900,800,200},
        {2600,2400,3600,1050,350},
        {1800,2100,4300,1300,500},
        {1000,1800,4900,1600,700},
        {400,1500,5200,1900,1000},
    },
    EggColors={
        {id="white",name="Cream",weight=5000,rgb={247,234,196}},
        {id="blue",name="Blue",weight=2600,rgb={36,132,211}},
        {id="green",name="Green",weight=1200,rgb={29,175,75}},
        {id="teal",name="Teal",weight=400,rgb={22,170,151}},
        {id="pink",name="Pink",weight=500,rgb={215,72,147}},
        {id="gold",name="Amber",weight=250,rgb={241,160,36}},
        {id="violet",name="Purple",weight=45,rgb={158,80,203}},
        {id="red",name="Red",weight=4,rgb={237,44,33}},
        {id="black",name="Black",weight=1,rgb={29,34,41}},
    },
    RarityFactors={compy=1,triceratops=1.35,tyrannosaurus=1.75,raptor=1,stegosaurus=1.35,ankylosaurus=1.75,archaeopteryx=1,baryonyx=1.35,brachiosaurus=1.35,dimorphodon=1,elasmosaurus=1.75,gallimimus=1,ichthyosaurus=1.35,microraptor=1,mosasaurus=1.75,pachycephalosaurus=1.35,parasaurolophus=1.35,plesiosaurus=1.35,pteranodon=1.35,quetzalcoatlus=1.75,spinosaurus=1.75,therizinosaurus=1.75},
    Auras={
        {id="meadow",name="Meadow Glow",rarity="Common",price=60,growth=1.15,color={98,236,112}},
        {id="tidal",name="Tidal Halo",rarity="Rare",price=240,growth=1.35,color={80,214,255}},
        {id="royal",name="Royal Nova",rarity="Legendary",price=900,growth=1.7,color={180,106,255}},
    },
    Trails={
        {id="white",name="Normal White",rarity="Common",price=0,level=1,speed=1,color={245,247,255},accent={255,255,255},width=.35,lifetime=.6},
        {id="fern",name="Fern Drift",rarity="Common",price=100,level=3,speed=1.02,color={98,236,112},accent={225,255,190},width=.45,lifetime=.7,particles=3},
        {id="tidal",name="Tidal Wake",rarity="Common",price=250,level=6,speed=1.04,color={80,214,255},accent={195,249,255},width=.5,lifetime=.8,particles=4},
        {id="ember",name="Ember Trail",rarity="Rare",price=500,level=10,speed=1.06,color={255,116,62},accent={255,216,107},width=.55,lifetime=.85,particles=5},
        {id="violet",name="Violet Pulse",rarity="Rare",price=900,level=15,speed=1.08,color={180,106,255},accent={255,171,241},width=.6,lifetime=.9,particles=6},
        {id="electric",name="Electric Arc",rarity="Rare",price=1500,level=21,speed=1.10,color={80,243,255},accent={239,255,149},width=.65,lifetime=.95,particles=7},
        {id="frost",name="Frost Comet",rarity="Rare",price=2400,level=28,speed=1.12,color={135,233,255},accent={255,255,255},width=.7,lifetime=1,particles=8},
        {id="solar",name="Solar Flare",rarity="Legendary",price=3600,level=36,speed=1.14,color={255,213,94},accent={255,245,204},width=.75,lifetime=1.05,particles=9},
        {id="nova",name="Nova Ribbon",rarity="Legendary",price=5500,level=45,speed=1.16,color={180,106,255},accent={255,215,115},width=.8,lifetime=1.2,particles=10},
        {id="astra",name="Astra",rarity="Legendary",price=8500,level=60,speed=1.18,color={112,255,205},accent={255,130,232},width=.85,lifetime=1.3,particles=14},
    },
    -- BD-051 + docs/68 PROVISIONAL rotating Potion Shop (one block; owner-approved 2026-10-14: restock every 2 minutes).
    -- Offers derive from the window number (floor(unixSeconds/PeriodSeconds)), so every server agrees and rejoining never rerolls.
    -- Each of the OfferCount slots rolls a rarity from RarityWeights (only rarities that still have unoffered potions), then a
    -- distinct potion of that rarity; the other potions are simply not offered this window (not_offered). Stock is rolled per
    -- offer from StockWeights[rarity] (index = stock, so Epic/Legendary always stock 1). Crystals only.
    PotionShop={
        PeriodSeconds=120, OfferCount=6, MaxStock=3,
        Rarities={"Common","Uncommon","Rare","Epic","Legendary"},
        RarityWeights={Common=50,Uncommon=28,Rare=14,Epic=6,Legendary=2},
        StockWeights={Common={60,30,10},Uncommon={60,30,10},Rare={60,30,10},Epic={1},Legendary={1}},
    },
    -- Prices rise with rarity, power and duration (docs/68). The six pre-catalog ids keep their data and values.
    Potions={
        {id="speed_common",name="Swift Sip",kind="speed",rarity="Common",duration=300,multiplier=1.2,price=20},
        {id="growth_common",name="Growth Sip",kind="growth",rarity="Common",duration=300,multiplier=1.25,price=25},
        {id="loot_common",name="Lucky Sip",kind="loot",rarity="Common",duration=300,multiplier=1.1,price=30},
        {id="speed_uncommon",name="Trail Blazer",kind="speed",rarity="Uncommon",duration=450,multiplier=1.3,price=38},
        {id="growth_uncommon",name="Hearty Brew",kind="growth",rarity="Uncommon",duration=450,multiplier=1.4,price=48},
        {id="speed_rare",name="Raptor Rush",kind="speed",rarity="Rare",duration=600,multiplier=1.45,price=65},
        {id="growth_rare",name="Prime Feast",kind="growth",rarity="Rare",duration=600,multiplier=1.6,price=80},
        {id="loot_rare",name="Treasure Draught",kind="loot",rarity="Rare",duration=600,multiplier=1.25,price=95},
        {id="growth_epic",name="Behemoth Brew",kind="growth",rarity="Epic",duration=750,multiplier=1.8,price=135},
        {id="loot_epic",name="Jackpot Elixir",kind="loot",rarity="Epic",duration=750,multiplier=1.4,price=170},
        {id="speed_legendary",name="Meteor Sprint",kind="speed",rarity="Legendary",duration=900,multiplier=1.75,price=180},
        {id="growth_legendary",name="Titan Tonic",kind="growth",rarity="Legendary",duration=900,multiplier=2,price=220},
    },
    Weather={
        {id="rain",name="Rain",rarity="Common",weight=50,growth=1.25,speed=1,loot=1.1,mutation="dewdrop",chance=.02,icon="rain"},
        {id="thunder",name="Thunderstorm",rarity="Rare",weight=30,growth=1.1,speed=1.15,loot=1.4,mutation="charged",chance=.04,icon="thunder"},
        {id="blizzard",name="Blizzard",rarity="Rare",weight=20,growth=1.4,speed=1.05,loot=1.25,mutation="frost",chance=.04,icon="blizzard"},
        {id="volcano",name="Volcanic Bloom",rarity="Legendary",weight=6,growth=1.2,speed=1,loot=1.65,mutation="ember",chance=.07,icon="volcano"},
        {id="aurora",name="Northern Lights",rarity="Legendary",weight=6,growth=1.3,speed=1.1,loot=1.5,mutation="aurora",chance=.07,icon="aurora"},
        {id="quake",name="Earthquake",rarity="Rare",weight=12,growth=1.1,speed=1,loot=1.4,mutation="seismic",chance=.05,icon="quake"},
        {id="bloodmoon",name="Blood Moon",rarity="Legendary",weight=4,growth=1.15,speed=1.15,loot=1.75,mutation="bloodmoon",chance=.08,icon="bloodmoon"},
    },
    -- Provisional event mutation perks; separate from cosmetic Gold/Diamond fusion.
    EventMutations={
        {id="dewdrop",name="Dewdrop",growth=1.08,speed=1,color={85,216,176}},
        {id="charged",name="Charged",growth=1,speed=1.1,color={255,218,88}},
        {id="frost",name="Frost",growth=1.12,speed=1,color={135,233,255}},
        {id="seismic",name="Seismic",growth=1.15,speed=1,color={220,180,115}},
        {id="ember",name="Ember",growth=1.18,speed=1.04,color={255,116,62}},
        {id="aurora",name="Aurora",growth=1.12,speed=1.08,color={112,255,205}},
        {id="bloodmoon",name="Blood Moon",growth=1.1,speed=1.12,color={255,85,128}},
    },
})
</ProtectedString>
        </Properties>
