,{1044,1052,1051,3},{1044,1045,1052,3},{1045,1053,1052,3},{1045,1046,1053,3},{1046,1054,1053,3},{1046,1047,1054,3},{1047,1055,1054,3},{1047,1040,1055,3},{1040,1048,1055,3},{1048,1049,1056,3},{1049,1057,1056,3},{1049,1050,1057,3},{1050,1058,1057,3},{1050,1051,1058,3},{1051,1059,1058,3},{1051,1052,1059,3},{1052,1060,1059,3},{1052,1053,1060,3},{1053,1061,1060,3},{1053,1054,1061,3},{1054,1062,1061,3},{1054,1055,1062,3},{1055,1063,1062,3},{1055,1048,1063,3},{1048,1056,1063,3},{1056,1057,1064,3},{1057,1058,1064,3},{1058,1059,1064,3},{1059,1060,1064,3},{1060,1061,1064,3},{1061,1062,1064,3},{1062,1063,1064,3},{1063,1056,1064,3},{1065,1067,1066,3},{1065,1068,1067,3},{1065,1069,1068,3},{1065,1070,1069,3},{1065,1071,1070,3},{1065,1072,1071,3},{1065,1073,1072,3},{1065,1066,1073,3},{1066,1067,1074,3},{1067,1075,1074,3},{1067,1068,1075,3},{1068,1076,1075,3},{1068,1069,1076,3},{1069,1077,1076,3},{1069,1070,1077,3},{1070,1078,1077,3},{1070,1071,1078,3},{1071,1079,1078,3},{1071,1072,1079,3},{1072,1080,1079,3},{1072,1073,1080,3},{1073,1081,1080,3},{1073,1066,1081,3},{1066,1074,1081,3},{1074,1075,1082,3},{1075,1083,1082,3},{1075,1076,1083,3},{1076,1084,1083,3},{1076,1077,1084,3},{1077,1085,1084,3},{1077,1078,1085,3},{1078,1086,1085,3},{1078,1079,1086,3},{1079,1087,1086,3},{1079,1080,1087,3},{1080,1088,1087,3},{1080,1081,1088,3},{1081,1089,1088,3},{1081,1074,1089,3},{1074,1082,1089,3},{1082,1083,1090,3},{1083,1084,1090,3},{1084,1085,1090,3},{1085,1086,1090,3},{1086,1087,1090,3},{1087,1088,1090,3},{1088,1089,1090,3},{1089,1082,1090,3}},["colors"]={{0.81961,0.48627,0.31373},{0.94902,0.77647,0.55294},{0.50588,0.29412,0.2549},{0.94118,0.8902,0.74902},{0.98824,0.95686,0.85098},{0.07843,0.18039,0.20784},{1.0,1.0,1.0}}}}
