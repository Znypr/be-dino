      <Item class="ModuleScript" referent="RBX7">
        <Properties>
          <string name="Name">Arena</string>
          <ProtectedString name="Source">--!strict
local Arena = {}

local function block(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3): Part
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.Position = position
    part.Color = color
    part.Material = Enum.Material.SmoothPlastic
    part.Anchored = true
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = parent
    return part
end

function Arena.build()
    local world = Instance.new("Folder")
    world.Name = "BeDinoArena"
    world.Parent = workspace
    block(world, "Ground", Vector3.new(180, 4, 180), Vector3.new(0, -2, 0), Color3.fromRGB(111, 151, 93))
    for _, x in {-92, 92} do
        block(world, "Boundary", Vector3.new(4, 20, 188), Vector3.new(x, 8, 0), Color3.fromRGB(94, 113, 82))
    end
    for _, z in {-92, 92} do
        block(world, "Boundary", Vector3.new(180, 20, 4), Vector3.new(0, 8, z), Color3.fromRGB(94, 113, 82))
    end
    local spawn = Instance.new("SpawnLocation")
    spawn.Name = "PrototypeSpawn"
    spawn.Size = Vector3.new(14, 1, 14)
    spawn.Position = Vector3.new(0, 0.5, 30)
    spawn.Anchored = true
    spawn.Neutral = true
    spawn.Duration = 0
    spawn.Color = Color3.fromRGB(236, 220, 169)
    spawn.Parent = world

    -- A lane with varying obstacle widths for the fixed-collider experiment.
    for i = 1, 5 do
        block(world, "Rock", Vector3.new(4 + i, 2 + i, 6),
            Vector3.new(-50 + i * 17, (2 + i) / 2, -30), Color3.fromRGB(126, 128, 115))
    end
    local ramp = block(world, "SlopeTest", Vector3.new(16, 2, 24), Vector3.new(-48, 3, 10), Color3.fromRGB(178, 157, 120))
    ramp.CFrame = CFrame.new(-48, 3, 10) * CFrame.Angles(math.rad(12), 0, 0)


end

return Arena
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX8">
        <Properties>
          <string name="Name">Bootstrap</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Arena = require(script.Parent.Arena)
local ChestService = require(script.Parent.ChestService)
local CollectionService = require(script.Parent.CollectionService)
local Dinosaur = require(script.Parent.Dinosaur)
local MutationService = require(script.Parent.MutationService)
local ProfileRepository = require(script.Parent.ProfileRepository)
local RunLifecycle = require(script.Parent.RunLifecycle)

Players.CharacterAutoLoads = false

Lighting.ClockTime = 14
Lighting.Brightness = 2
Lighting.Ambient = Color3.fromRGB(130, 143, 148)
Arena.build()

ProfileRepository.start()
RunLifecycle.configureSettlement(function(player: Player, runId: string, catchScore: number, reason: string)
    local ok = ProfileRepository.commitRunSettlement(player, runId, catchScore)
    if not ok then
        warn(string.format("[Be Dino] settlement failed for %s (%s)", player.Name, reason))
        return false
    end

    if Config.DuplicateSettlementProbe then
        local retryOk, _, retryStatus = ProfileRepository.commitRunSettlement(player, runId, catchScore)
        if not retryOk or retryStatus ~= "duplicate" then
            player:SetAttribute("ProfileState", "SaveFailed")
            warn("[Be Dino] duplicate settlement probe failed for " .. player.Name)
            return false
        end
        player:SetAttribute("LastSettlementProbe", "duplicate-ok")
    end

    if not player.Parent then ProfileRepository.release(player) end
    return true
end)
RunLifecycle.start()
CollectionService.start(ProfileRepository, Dinosaur)
ChestService.start(ProfileRepository)
MutationService.start(ProfileRepository, Dinosaur)

local function spawnLoadedPlayer(player: Player)
    player.CanLoadCharacterAppearance = false
    local loaded = ProfileRepository.load(player)
    if not loaded or not player.Parent then
        warn("[Be Dino] profile load blocked character spawn for " .. player.Name)
        return
    end

    local ok, err = pcall(function()
        player:LoadCharacterAsync()
    end)
    if not ok then warn("[Be Dino] initial character load failed: " .. tostring(err)) end
end

local function setup(player: Player)
    player.CanLoadCharacterAppearance = false
    player.CharacterAdded:Connect(function(character)
        if player:GetAttribute("ProfileState") ~= "Loaded" then
            character:Destroy()
            return
        end
        RunLifecycle.begin(player, character)
        task.spawn(Dinosaur.attach, character, Config.WalkSpeed, player)
    end)
    task.spawn(spawnLoadedPlayer, player)
end

Players.PlayerAdded:Connect(setup)
for _, player in Players:GetPlayers() do setup(player) end

Players.PlayerRemoving:Connect(function(player)
    local status = RunLifecycle.endForDisconnect(player)
    if status ~= "busy" then ProfileRepository.release(player) end
end)

game:BindToClose(function()
    for _, player in Players:GetPlayers() do
        local status = RunLifecycle.endForDisconnect(player)
        if status ~= "busy" then ProfileRepository.release(player) end
    end
end)

local FoodService = require(script.Parent.FoodService)
FoodService.start(Dinosaur)
local PredationService = require(script.Parent.PredationService)
PredationService.start(RunLifecycle, Dinosaur)

print("[Be Dino] " .. Config.Build .. " ready. Gold mutation test.")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX9">
        <Properties>
          <string name="Name">ChestService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local ChestService = {}
local lastClaim: {[Player]: number} = {}
local lastGrant: {[Player]: number} = {}

local function getRemote(folder: Folder, name: string): RemoteEvent
    local existing = folder:FindFirstChild(name)
    if existing and existing:IsA("RemoteEvent") then return existing end
    if existing then existing:Destroy() end
    local remote = Instance.new("RemoteEvent")
    remote.Name = name
    remote.Parent = folder
    return remote
end

local function allowed(bucket: {[Player]: number}, player: Player): boolean
    local now = os.clock()
    local last = bucket[player] or -math.huge
    if now - last &lt; Config.ChestClaimRequestCooldownSeconds then return false end
    bucket[player] = now
    return true
end

function ChestService.start(profileRepository)
    local folder = ReplicatedStorage:FindFirstChild("BeDinoRemotes") :: Folder?
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "BeDinoRemotes"
        folder.Parent = ReplicatedStorage
    end

    local claimChest = getRemote(folder, "ClaimChest")
    local testGrant = getRemote(folder, "TestGrantChests")

    claimChest.OnServerEvent:Connect(function(player: Player, chestId, requestToken, ...)
        if select("#", ...) ~= 0 then return end
        if typeof(chestId) ~= "string" or #chestId &lt; 1 or #chestId &gt; 80 then
            player:SetAttribute("LastChestClaimStatus", "invalid_chest_id")
            return
        end
        if typeof(requestToken) ~= "string" or #requestToken &lt; 1 or #requestToken &gt; 80 then
            player:SetAttribute("LastChestClaimStatus", "invalid_token")
            return
        end
        if not allowed(lastClaim, player) then
            player:SetAttribute("LastChestClaimStatus", "rate_limited")
            return
        end
        local _, _, status = profileRepository.claimChest(player, chestId)
        player:SetAttribute("LastChestClaimStatus", status)
    end)

    testGrant.OnServerEvent:Connect(function(player: Player, ...)
        if select("#", ...) ~= 0 then return end
        if not Config.ChestTestGrantEnabled then return end
        if not allowed(lastGrant, player) then
            player:SetAttribute("LastChestTestGrantStatus", "rate_limited")
            return
        end
        local _, status = profileRepository.grantChestTest(player)
        player:SetAttribute("LastChestTestGrantStatus", status)
    end)

    Players.PlayerRemoving:Connect(function(player)
        lastClaim[player] = nil
        lastGrant[player] = nil
    end)
end

return ChestService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX10">
        <Properties>
          <string name="Name">CollectionService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local CollectionService = {}
local lastEquipRequest: {[Player]: number} = {}
local lastGrantRequest: {[Player]: number} = {}

local function getRemote(folder: Folder, name: string): RemoteEvent
    local existing = folder:FindFirstChild(name)
    if existing and existing:IsA("RemoteEvent") then return existing end
    if existing then existing:Destroy() end
    local remote = Instance.new("RemoteEvent")
    remote.Name = name
    remote.Parent = folder
    return remote
end

local function rateAllowed(bucket: {[Player]: number}, player: Player): boolean
    local now = os.clock()
    local last = bucket[player] or -math.huge
    if now - last &lt; Config.EquipRequestCooldownSeconds then return false end
    bucket[player] = now
    return true
end

function CollectionService.start(profileRepository, dinosaur)
    local folder = ReplicatedStorage:FindFirstChild("BeDinoRemotes")
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "BeDinoRemotes"
        folder.Parent = ReplicatedStorage
    end

    local equipSpecies = getRemote(folder :: Folder, "EquipSpecies")
    local testGrant = getRemote(folder :: Folder, "TestGrantSpecies")

    equipSpecies.OnServerEvent:Connect(function(player: Player, speciesId, requestToken, ...)
        if select("#", ...) ~= 0 then return end
        if typeof(speciesId) ~= "string" or #speciesId &lt; 1 or #speciesId &gt; 32 then
            player:SetAttribute("LastEquipStatus", "invalid_species")
            return
        end
        if typeof(requestToken) ~= "string" or #requestToken &lt; 1 or #requestToken &gt; 80 then
            player:SetAttribute("LastEquipStatus", "invalid_token")
            return
        end
        if not rateAllowed(lastEquipRequest, player) then
            player:SetAttribute("LastEquipStatus", "rate_limited")
            return
        end

        local ok, status = profileRepository.equipSpecies(player, speciesId)
        player:SetAttribute("LastEquipStatus", status)
        if not ok then return end

        local character = player.Character
        if character and character:GetAttribute("DinoAttached") then
            dinosaur.refreshForPlayer(character, player)
        end
    end)

    testGrant.OnServerEvent:Connect(function(player: Player, ...)
        if select("#", ...) ~= 0 then return end
        if not Config.CollectionTestGrantEnabled then return end
        if not rateAllowed(lastGrantRequest, player) then
            player:SetAttribute("LastCollectionGrantStatus", "rate_limited")
            return
        end
        local _, status = profileRepository.grantCollectionTestSpecies(player)
        player:SetAttribute("LastCollectionGrantStatus", status)
    end)

    Players.PlayerRemoving:Connect(function(player)
        lastEquipRequest[player] = nil
        lastGrantRequest[player] = nil
    end)
end

return CollectionService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX11">
        <Properties>
          <string name="Name">Dinosaur</string>
          <ProtectedString name="Source">--!strict
-- Cosmetic shell over Roblox's standard controller. Collider does NOT scale.
local Dinosaur = {}
local RunService = game:GetService("RunService")

local GOLD_PALETTE = {
    primary = Color3.fromRGB(239, 190, 52),
    light = Color3.fromRGB(255, 232, 132),
    dark = Color3.fromRGB(161, 111, 26),
}

local PALETTES = {
    compy = {
        primary = Color3.fromRGB(100, 178, 117),
        light = Color3.fromRGB(201, 221, 154),
        dark = Color3.fromRGB(63, 112, 80),
    },
    triceratops = {
        primary = Color3.fromRGB(104, 151, 190),
        light = Color3.fromRGB(188, 218, 226),
        dark = Color3.fromRGB(62, 96, 132),
    },
    tyrannosaurus = {
        primary = Color3.fromRGB(190, 126, 78),
        light = Color3.fromRGB(232, 190, 132),
        dark = Color3.fromRGB(121, 75, 53),
    },
}

local function scaleForScore(score: number): number
    return math.min(4, math.sqrt(1 + math.max(0, score) / 50))
end

local function normalizedSpecies(speciesId: any): string
    if typeof(speciesId) == "string" and PALETTES[speciesId] then
        return speciesId
    end
    return "compy"
end

function Dinosaur.render(character: Model, scale: number, requestedSpeciesId: string?, isGold: boolean?)
    local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return end

    local speciesId = normalizedSpecies(requestedSpeciesId or character:GetAttribute("SpeciesId"))
    local gold = isGold == true
    local palette = if gold then GOLD_PALETTE else PALETTES[speciesId]
    local old = character:FindFirstChild("DinoVisual")
    if old then old:Destroy() end
    local visual = Instance.new("Model")
    visual.Name = "DinoVisual"
    visual.Parent = character

    local groundHeight = root.Size.Y / 2 + humanoid.HipHeight
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        local leg = character:FindFirstChild("Left Leg") :: BasePart?
        groundHeight += if leg then leg.Size.Y else 2
    end
    local shift = Vector3.new(0, 3 * scale - groundHeight, 0)

    local function piece(name: string, size: Vector3, position: Vector3, color: Color3, tilt: number?)
        local part = Instance.new("Part")
        part.Name = name
        part.Size = size * scale
        part.Color = color
        part.Material = if gold then Enum.Material.Metal else Enum.Material.SmoothPlastic
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.Massless = true
        part.CastShadow = true
        local offset = CFrame.new(position * scale + shift) * CFrame.Angles(tilt or 0, 0, 0)
        part.CFrame = root.CFrame * offset
        part.Parent = visual
        local weld = Instance.new("Weld")
        weld.Name = "VisualWeld"
        weld.Part0 = root
        weld.Part1 = part
        weld.C0 = offset
        weld.Parent = part
    end

    local bodySize = Vector3.new(2.4, 1.8, 3.2)
    local headSize = Vector3.new(2.3, 1.65, 2.1)
    local snoutSize = Vector3.new(2.05, 0.75, 1.2)
    if speciesId == "triceratops" then
        bodySize = Vector3.new(3.0, 1.75, 3.5)
        headSize = Vector3.new(2.7, 1.6, 2.0)
        snoutSize = Vector3.new(2.35, 0.72, 1.05)
    elseif speciesId == "tyrannosaurus" then
        bodySize = Vector3.new(2.7, 2.0, 3.5)
        headSize = Vector3.new(2.75, 1.9, 2.4)
        snoutSize = Vector3.new(2.45, 0.9, 1.45)
    end

    piece("Body", bodySize, Vector3.new(0, -0.8, 0.2), palette.primary)
    piece("Belly", Vector3.new(1.8, 0.35, 2.6), Vector3.new(0, -1.75, 0), palette.light)
    piece("Head", headSize, Vector3.new(0, 0.3, -1.7), palette.primary)
    piece("Snout", snoutSize, Vector3.new(0, -0.1, -3), palette.light)
    piece("Tail", Vector3.new(1.25, 1.0, 2.6), Vector3.new(0, -0.65, 2.7), palette.primary, math.rad(-12))
    piece("TailTip", Vector3.new(0.65, 0.65, 1.8), Vector3.new(0, -0.15, 4.55), palette.dark, math.rad(-18))

    for _, side in {-1, 1} do
        piece("Leg" .. side, Vector3.new(0.85, 1.4, 1.0), Vector3.new(side * 0.95, -2.1, 0.5), palette.dark)
        piece("Foot" .. side, Vector3.new(1.0, 0.4, 1.6), Vector3.new(side * 0.95, -2.8, 0.1), palette.primary)
        local armSize = if speciesId == "tyrannosaurus" then Vector3.new(0.38, 0.45, 0.72) else Vector3.new(0.5, 0.6, 1.05)
        piece("Arm" .. side, armSize, Vector3.new(side * 1.3, -0.9, -1.1), palette.primary)
        piece("Eye" .. side, Vector3.new(0.13, 0.6, 0.65), Vector3.new(side * 1.18, 0.65, -2), Color3.new(1, 1, 1))
        piece("Pupil" .. side, Vector3.new(0.15, 0.32, 0.3), Vector3.new(side * 1.25, 0.65, -2.12), Color3.fromRGB(25, 35, 31))
    end

    if speciesId == "triceratops" then
        piece("Frill", Vector3.new(3.6, 2.5, 0.45), Vector3.new(0, 0.45, -0.75), palette.dark)
        piece("NoseHorn", Vector3.new(0.28, 0.28, 1.15), Vector3.new(0, 0.45, -3.85), palette.light, math.rad(-18))
        for _, side in {-1, 1} do
            piece("BrowHorn" .. side, Vector3.new(0.32, 0.32, 1.35), Vector3.new(side * 0.72, 1.1, -2.55), palette.light, math.rad(-28))
        end
    elseif speciesId == "tyrannosaurus" then
        piece("Jaw", Vector3.new(2.45, 0.45, 1.5), Vector3.new(0, -0.6, -3.05), palette.dark)
    end

    character:SetAttribute("SpeciesId", speciesId)
    character:SetAttribute("GoldVisual", gold)
    character:SetAttribute("VisualScale", scale)
end

function Dinosaur.setSpecies(character: Model, speciesId: string, isGold: boolean?)
    local scaleValue = character:GetAttribute("VisualScale")
    local scale = if typeof(scaleValue) == "number" then scaleValue else 1
    Dinosaur.render(character, scale, speciesId, isGold)
end

local function playerSpeciesCounts(player: Player, speciesId: string): (number, number)
    if speciesId == "compy" then
        return player:GetAttribute("CompyCopies") or 0, player:GetAttribute("CompyGold") or 0
    elseif speciesId == "triceratops" then
        return player:GetAttribute("TriceratopsCopies") or 0, player:GetAttribute("TriceratopsGold") or 0
    elseif speciesId == "tyrannosaurus" then
        return player:GetAttribute("TyrannosaurusCopies") or 0, player:GetAttribute("TyrannosaurusGold") or 0
    end
    return 0, 0
end

function Dinosaur.refreshForPlayer(character: Model, player: Player)
    local equipped = player:GetAttribute("EquippedSpeciesId")
    local speciesId = if typeof(equipped) == "string" then equipped else "compy"
    local baseCount, goldCount = playerSpeciesCounts(player, speciesId)
    local useGold = baseCount &lt;= 0 and goldCount &gt; 0
    Dinosaur.setSpecies(character, speciesId, useGold)
end

function Dinosaur.addGrowth(character: Model, points: number)
    if points &lt;= 0 or character:GetAttribute("RunState") ~= "Active" then return end
    local current = character:GetAttribute("GrowthScore")
    local score = (if typeof(current) == "number" then current else 0) + points
    character:SetAttribute("GrowthScore", score)
    local scale = scaleForScore(score)
    if character:GetAttribute("VisualScale") ~= scale then
        local gold = character:GetAttribute("GoldVisual") == true
        Dinosaur.render(character, scale, nil, gold)
    end
end

function Dinosaur.attach(character: Model, walkSpeed: number, player: Player)
    local deadline = os.clock() + 10
    while not character:IsDescendantOf(workspace) do
        if player.Character ~= character or not player.Parent then return end
        if os.clock() &gt;= deadline then
            warn("[Be Dino] Character never entered Workspace: " .. player.Name)
            return
        end
        RunService.Heartbeat:Wait()
    end
    local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
    local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
    if player.Character ~= character or not character:IsDescendantOf(workspace) then return end
    if not humanoid or not root then
        warn("[Be Dino] Missing Humanoid/root for " .. player.Name)
        return
    end
    if character:GetAttribute("DinoAttached") then return end

    local function hide(instance: Instance)
        if instance:FindFirstAncestor("DinoVisual") then return end
        if instance:IsA("BasePart") then instance.Transparency = 1 end
        if instance:IsA("Decal") then instance.Transparency = 1 end
    end
    for _, descendant in character:GetDescendants() do hide(descendant) end
    character.DescendantAdded:Connect(hide)

    humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    humanoid.WalkSpeed = walkSpeed
    humanoid.UseJumpPower = true
    humanoid.JumpPower = 0
    humanoid.AutoJumpEnabled = false
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)

    local equipped = player:GetAttribute("EquippedSpeciesId")
    local speciesId = if typeof(equipped) == "string" then equipped else "compy"
    local baseCount, goldCount = playerSpeciesCounts(player, speciesId)
    Dinosaur.render(character, 1, speciesId, baseCount &lt;= 0 and goldCount &gt; 0)
    character:SetAttribute("DinoAttached", true)
    print("[Be Dino] Dinosaur attached: " .. player.Name)
end

return Dinosaur
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX12">
        <Properties>
          <string name="Name">FoodService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local FoodService = {}

function FoodService.start(dinosaur)
    local folder = Instance.new("Folder")
    folder.Name = "Food"
    folder.Parent = workspace
    local foods = {}
    local groundParams = RaycastParams.new()
    groundParams.FilterType = Enum.RaycastFilterType.Include
    groundParams.FilterDescendantsInstances = {workspace.BeDinoArena}
    -- Fixed, bounded grid. Skip obstacles, spawn and slope instead of hiding food inside them.
    for x = -70, 70, 20 do
        for z = -70, 70, 20 do
            local hit = workspace:Raycast(Vector3.new(x, 30, z), Vector3.new(0, -40, 0), groundParams)
            if hit and hit.Instance.Name == "Ground" then
                local berry = Instance.new("Part")
                berry.Name = "Berry"
                berry.Shape = Enum.PartType.Ball
                berry.Size = Vector3.new(1.5, 1.5, 1.5)
                berry.Position = hit.Position + Vector3.new(0, 0.9, 0)
                berry.Color = Color3.fromRGB(255, 156, 65)
                berry.Material = Enum.Material.Neon
                berry.Anchored = true
                berry.CanCollide = false
                berry.CanTouch = false
                berry.CanQuery = false
                berry.Parent = folder
                table.insert(foods, {part = berry, readyAt = 0})
            end
        end
    end
    local previous = {}
    Players.PlayerRemoving:Connect(function(player) previous[player] = nil end)
    task.spawn(function()
        while true do
            task.wait(Config.FoodTickSeconds)
            local now = os.clock()
            local candidates = {}
            for _, player in Players:GetPlayers() do
                local character = player.Character
                local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
                local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
                if character and root and root:IsA("BasePart") and humanoid and humanoid.Health &gt; 0
                    and character:GetAttribute("DinoAttached") and character:GetAttribute("RunState") == "Active" then
                    local last = previous[player]
                    local position = root.Position
                    -- Basic teleport rejection, not a complete movement/anti-cheat system.
                    local plausible = last and last.character == character
                        and (position - last.position).Magnitude &lt;= Config.WalkSpeed * (now - last.time) * 2 + 2
                    previous[player] = {character = character, position = position, time = now}
                    if plausible then
                        table.insert(candidates, {player = player, character = character, root = root, gained = 0})
                    end
                else
                    previous[player] = nil
                end
            end
            for _, food in foods do
                if now &lt; food.readyAt then continue end
                food.part.Transparency = 0
                local winner = nil
                local nearest = math.huge
                for _, candidate in candidates do
                    local delta = food.part.Position - candidate.root.Position
                    local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
                    if horizontal &lt;= Config.FoodPickupRadius and math.abs(delta.Y) &lt; 6 then
                        -- Arena-only occlusion prevents eating through solid geometry.
                        local blocked = workspace:Raycast(candidate.root.Position, delta, groundParams)
                        if not blocked and (horizontal &lt; nearest or (horizontal == nearest and winner and candidate.player.UserId &lt; winner.player.UserId)) then
                            nearest = horizontal
                            winner = candidate
                        end
                    end
                end
                if winner then
                    -- No yield between claiming and awarding: one winner per berry.
                    food.readyAt = now + Config.FoodRespawnSeconds
                    food.part.Transparency = 1
                    winner.gained += Config.FoodPoints
                end
            end
            for _, candidate in candidates do
                if candidate.gained &gt; 0 then
                    dinosaur.addGrowth(candidate.character, candidate.gained)
                end
            end
        end
    end)
end

return FoodService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX13">
        <Properties>
          <string name="Name">MutationService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local MutationService = {}
local lastMutation: {[Player]: number} = {}
local lastSetup: {[Player]: number} = {}

local function getRemote(folder: Folder, name: string): RemoteEvent
    local existing = folder:FindFirstChild(name)
    if existing and existing:IsA("RemoteEvent") then return existing end
    if existing then existing:Destroy() end
    local remote = Instance.new("RemoteEvent")
    remote.Name = name
    remote.Parent = folder
    return remote
end

local function allowed(bucket: {[Player]: number}, player: Player): boolean
    local now = os.clock()
    local last = bucket[player] or -math.huge
    if now - last &lt; Config.MutationRequestCooldownSeconds then return false end
    bucket[player] = now
    return true
end

function MutationService.start(profileRepository, dinosaur)
    local folder = ReplicatedStorage:FindFirstChild("BeDinoRemotes") :: Folder?
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "BeDinoRemotes"
        folder.Parent = ReplicatedStorage
    end

    local mutate = getRemote(folder, "MutateSpecies")
    local setupTest = getRemote(folder, "TestSetMutationCopies")

    mutate.OnServerEvent:Connect(function(player: Player, speciesId, targetMutation, requestToken, ...)
        if select("#", ...) ~= 0 then return end
        if typeof(speciesId) ~= "string" or #speciesId &lt; 1 or #speciesId &gt; 32 then
            player:SetAttribute("LastMutationStatus", "invalid_species")
            return
        end
        if targetMutation ~= "gold" then
            player:SetAttribute("LastMutationStatus", "unknown_mutation")
            return
        end
        if typeof(requestToken) ~= "string" or #requestToken &lt; 1 or #requestToken &gt; 80 then
            player:SetAttribute("LastMutationStatus", "invalid_token")
            return
        end
        if not allowed(lastMutation, player) then
            player:SetAttribute("LastMutationStatus", "rate_limited")
            return
        end

        local ok, _, status = profileRepository.mutateSpecies(player, speciesId, targetMutation, requestToken)
        player:SetAttribute("LastMutationStatus", status)
        if ok then
            player:SetAttribute("LastMutationToken", requestToken)
            local character = player.Character
            if character and character:GetAttribute("DinoAttached") then
                dinosaur.refreshForPlayer(character, player)
            end
        end
    end)

    setupTest.OnServerEvent:Connect(function(player: Player, baseCount, ...)
        if select("#", ...) ~= 0 then return end
        if not Config.MutationTestSetupEnabled then return end
        if typeof(baseCount) ~= "number" or baseCount % 1 ~= 0 then
            player:SetAttribute("LastMutationSetupStatus", "bad_count")
            return
        end
        if not allowed(lastSetup, player) then
            player:SetAttribute("LastMutationSetupStatus", "rate_limited")
            return
        end
        local ok, status = profileRepository.setMutationTestCopies(
            player, Config.MutationTestSpeciesId, baseCount
        )
        player:SetAttribute("LastMutationSetupStatus", status)
        if ok then
            local character = player.Character
            if character and character:GetAttribute("DinoAttached") then
                dinosaur.refreshForPlayer(character, player)
            end
        end
    end)

    Players.PlayerRemoving:Connect(function(player)
        lastMutation[player] = nil
        lastSetup[player] = nil
    end)
end

return MutationService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX14">
        <Properties>
          <string name="Name">PredationService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local PredationService = {}

local function numberAttribute(instance: Instance, name: string, fallback: number): number
    local value = instance:GetAttribute(name)
    return if typeof(value) == "number" then value else fallback
end

local function canEat(attackerScore: number, targetScore: number): boolean
    return attackerScore &gt; targetScore and attackerScore &gt;= targetScore * Config.PredationScoreMultiplier
end

function PredationService.start(runLifecycle, dinosaur)
    local previous = {}
    local recentPairs: {[number]: {[number]: number}} = {}
    local arenaParams = RaycastParams.new()
    arenaParams.FilterType = Enum.RaycastFilterType.Include
    arenaParams.FilterDescendantsInstances = {workspace.BeDinoArena}

    Players.PlayerRemoving:Connect(function(player)
        previous[player] = nil
        recentPairs[player.UserId] = nil
        for _, victims in recentPairs do
            victims[player.UserId] = nil
        end
    end)

    local function awardCatch(attacker, victimUserId: number, now: number)
        local victims = recentPairs[attacker.player.UserId]
        if not victims then
            victims = {}
            recentPairs[attacker.player.UserId] = victims
        end
        local last = victims[victimUserId] or -math.huge
        if now - last &lt; Config.RepeatVictimCatchCooldownSeconds then
            return
        end
        victims[victimUserId] = now
        local catches = numberAttribute(attacker.character, "CatchScore", 0)
        if catches &lt; Config.MaxCatchScore then
            attacker.character:SetAttribute("CatchScore", catches + 1)
        end
    end

    task.spawn(function()
        while true do
            task.wait(Config.PredationTickSeconds)
            local movementNow = os.clock()
            local serverNow = workspace:GetServerTimeNow()
            local candidates = {}

            for _, player in Players:GetPlayers() do
                local character = player.Character
                local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
                local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
                if character and root and root:IsA("BasePart") and humanoid and humanoid.Health &gt; 0
                    and character:GetAttribute("DinoAttached") and runLifecycle.isActive(character) then
                    local last = previous[player]
                    local position = root.Position
                    local plausible = last and last.character == character
                        and (position - last.position).Magnitude &lt;= Config.WalkSpeed * (movementNow - last.time) * 2 + 2
                    previous[player] = {character = character, position = position, time = movementNow}
                    if plausible then
                        table.insert(candidates, {
                            player = player,
                            character = character,
                            root = root,
                            score = numberAttribute(character, "GrowthScore", 0),
                            scale = numberAttribute(character, "VisualScale", 1),
                        })
                    end
                else
                    previous[player] = nil
                end
            end

            table.sort(candidates, function(a, b)
                return a.player.UserId &lt; b.player.UserId
            end)

            for _, victim in candidates do
                if not runLifecycle.isActive(victim.character) or runLifecycle.isProtected(victim.character, serverNow) then
                    continue
                end

                local winner = nil
                local nearest = math.huge
                for _, attacker in candidates do
                    if attacker.player == victim.player or not runLifecycle.isActive(attacker.character)
                        or runLifecycle.isProtected(attacker.character, serverNow) then
                        continue
                    end
                    if not canEat(attacker.score, victim.score) then continue end

                    local delta = victim.root.Position - attacker.root.Position
                    local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
                    local radius = math.min(Config.PredationMaxRadius,
                        Config.PredationBaseRadius + math.max(0, attacker.scale - 1) * 1.25)
                    if horizontal &gt; radius or math.abs(delta.Y) &gt; Config.PredationVerticalLimit then continue end

                    local blocked = workspace:Raycast(attacker.root.Position, delta, arenaParams)
                    if blocked then continue end

                    if horizontal &lt; nearest or (horizontal == nearest and winner and attacker.player.UserId &lt; winner.player.UserId) then
                        nearest = horizontal
                        winner = attacker
                    end
                end

                if winner and runLifecycle.tryEnd(victim.player, victim.character, "Eaten", winner.player.UserId) then
                    awardCatch(winner, victim.player.UserId, serverNow)
                    dinosaur.addGrowth(winner.character, Config.PredationGrowthPoints)
                end
            end
        end
    end)
end

return PredationService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX15">
        <Properties>
          <string name="Name">ProfileRepository</string>
          <ProtectedString name="Source">--!strict
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local RewardMath = require(script.Parent.RewardMath)

local ProfileRepository = {}

local store = DataStoreService:GetDataStore(Config.ProfileDataStoreName)
local leaseId = HttpService:GenerateGUID(false)
local profiles: {[Player]: any} = {}
local renewing = false

local function keyFor(player: Player): string
    return "u:" .. tostring(player.UserId)
end

local function knownSpecies(speciesId: any): boolean
    if typeof(speciesId) ~= "string" then return false end
    for _, configuredId in Config.SpeciesOrder do
        if configuredId == speciesId then return true end
    end
    return false
end

local function defaultProfile()
    return {
        schemaVersion = Config.ProfileSchemaVersion,
        revision = 0,
        session = nil,
        equippedSpeciesId = "compy",
        collection = {
            compy = {base = 1, gold = 0},
            triceratops = {base = 0, gold = 0},
            tyrannosaurus = {base = 0, gold = 0},
        },
        pendingChestGrants = 0,
        eggs = {},
        recentOperations = {},
        lastCheckpoint = {
            committedAt = 0,
            lastSettledRunId = nil,
        },
    }
end

local function isValidProfile(profile: any): boolean
    if typeof(profile) ~= "table" then return false end
    if profile.schemaVersion ~= Config.ProfileSchemaVersion then return false end
    if typeof(profile.revision) ~= "number" or profile.revision &lt; 0 then return false end
    if typeof(profile.collection) ~= "table" then return false end
    if typeof(profile.recentOperations) ~= "table" then return false end
    if typeof(profile.eggs) ~= "table" then return false end
    if typeof(profile.pendingChestGrants) ~= "number"
        or profile.pendingChestGrants &lt; 0 or profile.pendingChestGrants % 1 ~= 0 then
        return false
    end
    if not knownSpecies(profile.equippedSpeciesId) then return false end
    for _, speciesId in Config.SpeciesOrder do
        local entry = profile.collection[speciesId]
        if typeof(entry) ~= "table"
            or typeof(entry.base) ~= "number" or entry.base &lt; 0 or entry.base % 1 ~= 0
            or typeof(entry.gold) ~= "number" or entry.gold &lt; 0 or entry.gold % 1 ~= 0 then
            return false
        end
    end
    return true
end

local function retry(label: string, fn)
    local lastError = nil
    for attempt = 1, Config.ProfileMaxAttempts do
        local ok, result = pcall(fn)
        if ok then
            return true, result
        end
        lastError = result
        warn(string.format("[Be Dino] %s attempt %d failed: %s", label, attempt, tostring(result)))
        if attempt &lt; Config.ProfileMaxAttempts then
            task.wait(0.5 * (2 ^ (attempt - 1)))
        end
    end
    return false, lastError
end

local function syncAttributes(player: Player, profile: any)
    local collection = profile.collection
    player:SetAttribute("CompyCopies", collection.compy.base)
    player:SetAttribute("CompyGold", collection.compy.gold)
    player:SetAttribute("TriceratopsCopies", collection.triceratops.base)
    player:SetAttribute("TriceratopsGold", collection.triceratops.gold)
    player:SetAttribute("TyrannosaurusCopies", collection.tyrannosaurus.base)
    player:SetAttribute("TyrannosaurusGold", collection.tyrannosaurus.gold)
    player:SetAttribute("PendingChestGrants", profile.pendingChestGrants or 0)
    player:SetAttribute("ProfileRevision", profile.revision or 0)
    player:SetAttribute("EquippedSpeciesId", profile.equippedSpeciesId)
    player:SetAttribute("ActiveChestCount", #profile.eggs)
    local nextChest = profile.eggs[1]
    if typeof(nextChest) == "table" then
        player:SetAttribute("NextChestId", nextChest.eggId)
        player:SetAttribute("NextChestReadyAt", nextChest.readyAt)
    else
        player:SetAttribute("NextChestId", "")
        player:SetAttribute("NextChestReadyAt", 0)
    end
end

local function ownSession(profile: any): boolean
    local session = profile.session
    return typeof(session) == "table" and session.leaseId == leaseId
end

local function findOperation(profile: any, operationId: string)
    for _, entry in profile.recentOperations do
        if entry.id == operationId then
            return entry
        end
    end
    return nil
end

local function trimOperations(profile: any)
    while #profile.recentOperations &gt; Config.ProfileMaxRecentOperations do
        table.remove(profile.recentOperations, 1)
    end
end

local function lastChestReadyAt(profile: any, now: number): number
    local result = now
    for _, chest in profile.eggs do
        if typeof(chest) == "table" and typeof(chest.readyAt) == "number" then
            result = math.max(result, chest.readyAt)
        end
    end
    return result
end

local function availableChestCapacity(profile: any): number
    return (Config.ChestQueueCapacity - #profile.eggs)
        + (Config.ChestOverflowCapacity - profile.pendingChestGrants)
end

local function enqueueChestIds(profile: any, chestIds: {string}, now: number)
    local nextReadyAt = lastChestReadyAt(profile, now)
    for _, chestId in chestIds do
        if #profile.eggs &lt; Config.ChestQueueCapacity then
            nextReadyAt += Config.ChestTimerSeconds
            table.insert(profile.eggs, {
                eggId = chestId,
                kind = "alpha_chest",
                readyAt = nextReadyAt,
            })
        else
            profile.pendingChestGrants += 1
        end
    end
end

function ProfileRepository.isLoaded(player: Player): boolean
    return profiles[player] ~= nil and player:GetAttribute("ProfileState") == "Loaded"
end

function ProfileRepository.load(player: Player): boolean
    if profiles[player] then return true end
    player:SetAttribute("ProfileState", "Loading")

    local blockedByLease = false
    local invalidSchema = false
    local now = os.time()

    local ok, updated = retry("profile load", function()
        return store:UpdateAsync(keyFor(player), function(current)
            local profileValue = current
            if profileValue == nil then
                profileValue = defaultProfile()
            end
            if not isValidProfile(profileValue) then
                invalidSchema = true
                return nil
            end

            local session = profileValue.session
            if typeof(session) == "table"
                and session.leaseId ~= leaseId
                and typeof(session.expiresAt) == "number"
                and session.expiresAt &gt; now then
                blockedByLease = true
                return nil
            end

            profileValue.session = {
                leaseId = leaseId,
                jobId = game.JobId,
                expiresAt = now + Config.ProfileLeaseSeconds,
            }
            profileValue.revision += 1
            return profileValue
        end)
    end)

    if not ok or updated == nil or blockedByLease or invalidSchema then
        if blockedByLease then
            player:SetAttribute("ProfileState", "SessionBusy")
        elseif invalidSchema then
            player:SetAttribute("ProfileState", "SchemaError")
        else
            player:SetAttribute("ProfileState", "LoadFailed")
        end
        return false
    end

    profiles[player] = updated
    player:SetAttribute("ProfileState", "Loaded")
    syncAttributes(player, updated)
    return true
end

function ProfileRepository.commitRunSettlement(player: Player, runId: string, catchScore: number)
    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, nil, "profile_not_loaded"
    end
    if typeof(runId) ~= "string" or #runId &lt; 1 or #runId &gt; 80 then
        return false, nil, "invalid_run_id"
    end

    local outcome = RewardMath.computeRunReward(catchScore)
    local operationId = "run:" .. runId
    local chestIds = {}
    for _ = 1, outcome.chestCount do
        table.insert(chestIds, HttpService:GenerateGUID(false))
    end
    outcome.chestIds = chestIds
    local leaseLost = false
    local queueFull = false
    local duplicateOutcome = nil
    local now = os.time()

    local ok, updated = retry("run settlement", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end

            local existing = findOperation(profileValue, operationId)
            if existing then
                duplicateOutcome = existing.outcome
                return profileValue
            end

            if outcome.chestCount &gt; availableChestCapacity(profileValue) then
                queueFull = true
                return nil
            end

            for _, stack in outcome.stacks do
                local species = profileValue.collection[stack.speciesId]
                if typeof(species) ~= "table" or typeof(species.base) ~= "number" then
                    return nil
                end
                species.base += stack.count
            end

            enqueueChestIds(profileValue, chestIds, now)
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            profileValue.lastCheckpoint = {
                committedAt = now,
                lastSettledRunId = runId,
            }
            table.insert(profileValue.recentOperations, {
                id = operationId,
                kind = "run",
                outcome = outcome,
            })
            trimOperations(profileValue)
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, nil, "lease_lost"
        end
        if queueFull then
            player:SetAttribute("LastChestClaimStatus", "queue_full")
            return false, nil, "queue_full"
        end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, nil, "save_failed"
    end

    profiles[player] = updated
    syncAttributes(player, updated)
    local committedOutcome = duplicateOutcome or outcome
    local summaryParts = {}
    for _, stack in committedOutcome.stacks do
        table.insert(summaryParts, string.format("%dx %s", stack.count, stack.speciesId))
    end
    if #summaryParts == 0 then table.insert(summaryParts, "no dinosaur copies") end
    if committedOutcome.chestCount &gt; 0 then
        table.insert(summaryParts, string.format("%d chest(s)", committedOutcome.chestCount))
    end
    player:SetAttribute("LastRewardText", table.concat(summaryParts, " | "))
    return true, committedOutcome, if duplicateOutcome then "duplicate" else "committed"
end

function ProfileRepository.equipSpecies(player: Player, speciesId: string): (boolean, string)
    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, "profile_not_loaded"
    end
    if typeof(speciesId) ~= "string" or #speciesId &lt; 1 or #speciesId &gt; 32 then
        return false, "invalid_species"
    end
    if not knownSpecies(speciesId) then return false, "unknown_species" end

    local cachedEntry = cached.collection[speciesId]
    if typeof(cachedEntry) ~= "table" or cachedEntry.base + cachedEntry.gold &lt;= 0 then
        return false, "locked"
    end
    if cached.equippedSpeciesId == speciesId then
        syncAttributes(player, cached)
        return true, "already_equipped"
    end

    local leaseLost = false
    local locked = false
    local now = os.time()
    local ok, updated = retry("equip species", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end
            local entry = profileValue.collection[speciesId]
            if typeof(entry) ~= "table" or entry.base + entry.gold &lt;= 0 then
                locked = true
                return nil
            end
            profileValue.equippedSpeciesId = speciesId
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, "lease_lost"
        end
        if locked then return false, "locked" end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, "save_failed"
    end

    profiles[player] = updated
    syncAttributes(player, updated)
    return true, "equipped"
end

function ProfileRepository.grantCollectionTestSpecies(player: Player): (boolean, string)
    if not Config.CollectionTestGrantEnabled then return false, "disabled" end
    local speciesId = Config.CollectionTestGrantSpeciesId
    if not knownSpecies(speciesId) then return false, "bad_config" end

    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, "profile_not_loaded"
    end

    local operationId = string.format("test-grant:v%d:%s", Config.CollectionTestGrantVersion, speciesId)
    local duplicate = false
    local leaseLost = false
    local now = os.time()

    local ok, updated = retry("collection test grant", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end
            if findOperation(profileValue, operationId) then
                duplicate = true
                return profileValue
            end

            profileValue.collection[speciesId].base += 1
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            table.insert(profileValue.recentOperations, {
                id = operationId,
                kind = "collection_test_grant",
                outcome = {speciesId = speciesId, count = 1},
            })
            trimOperations(profileValue)
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, "lease_lost"
        end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, "save_failed"
    end

    profiles[player] = updated
    syncAttributes(player, updated)
    return true, if duplicate then "duplicate" else "granted"
end

function ProfileRepository.grantChestTest(player: Player): (boolean, string)
    if not Config.ChestTestGrantEnabled then return false, "disabled" end
    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, "profile_not_loaded"
    end

    local operationId = string.format("test-chests:v%d", Config.ChestTestGrantVersion)
    local chestIds = {}
    for _ = 1, Config.ChestTestGrantCount do
        table.insert(chestIds, HttpService:GenerateGUID(false))
    end
    local duplicate = false
    local queueFull = false
    local leaseLost = false
    local now = os.time()

    local ok, updated = retry("chest test grant", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end
            if findOperation(profileValue, operationId) then
                duplicate = true
                return profileValue
            end
            if #chestIds &gt; availableChestCapacity(profileValue) then
                queueFull = true
                return nil
            end

            enqueueChestIds(profileValue, chestIds, now)
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            table.insert(profileValue.recentOperations, {
                id = operationId,
                kind = "chest_test_grant",
                outcome = {count = #chestIds},
            })
            trimOperations(profileValue)
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, "lease_lost"
        end
        if queueFull then return false, "queue_full" end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, "save_failed"
    end

    profiles[player] = updated
    syncAttributes(player, updated)
    return true, if duplicate then "duplicate" else "granted"
end

function ProfileRepository.claimChest(player: Player, chestId: string)
    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, nil, "profile_not_loaded"
    end
    if typeof(chestId) ~= "string" or #chestId &lt; 1 or #chestId &gt; 80 then
        return false, nil, "invalid_chest_id"
    end

    local operationId = "chest:" .. chestId
    local cachedOperation = findOperation(cached, operationId)
    if cachedOperation then
        return true, cachedOperation.outcome, "duplicate"
    end

    local cachedChest = nil
    for _, chest in cached.eggs do
        if chest.eggId == chestId then
            cachedChest = chest
            break
        end
    end
    if not cachedChest then return false, nil, "missing" end

    local now = os.time()
    if now &lt; cachedChest.readyAt then return false, nil, "not_ready" end

    -- Generate once outside UpdateAsync so retries cannot reroll the reward.
    local outcome = RewardMath.computeChestReward(Random.new())
    local refillChestId = HttpService:GenerateGUID(false)
    local duplicateOutcome = nil
    local leaseLost = false
    local notReady = false
    local missing = false

    local ok, updated = retry("chest claim", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end

            local existing = findOperation(profileValue, operationId)
            if existing then
                duplicateOutcome = existing.outcome
                return profileValue
            end

            local index = nil
            local chest = nil
            for i, candidate in profileValue.eggs do
                if candidate.eggId == chestId then
                    index = i
                    chest = candidate
                    break
                end
            end
            if not index or not chest then
                missing = true
                return nil
            end
            if now &lt; chest.readyAt then
                notReady = true
                return nil
            end

            table.remove(profileValue.eggs, index)
            local species = profileValue.collection[outcome.speciesId]
            if typeof(species) ~= "table" then return nil end
            species.base += outcome.count

            if profileValue.pendingChestGrants &gt; 0 then
                profileValue.pendingChestGrants -= 1
                local readyAt = lastChestReadyAt(profileValue, now) + Config.ChestTimerSeconds
                table.insert(profileValue.eggs, {
                    eggId = refillChestId,
                    kind = "alpha_chest",
                    readyAt = readyAt,
                })
            end

            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            table.insert(profileValue.recentOperations, {
                id = operationId,
                kind = "chest_claim",
                outcome = outcome,
            })
            trimOperations(profileValue)
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, nil, "lease_lost"
        end
        if notReady then return false, nil, "not_ready" end
        if missing then return false, nil, "missing" end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, nil, "save_failed"
    end

    profiles[player] = updated
    syncAttributes(player, updated)
    local committedOutcome = duplicateOutcome or outcome
    player:SetAttribute("LastClaimedChestId", chestId)
    player:SetAttribute("LastChestRewardText", string.format(
        "%dx %s", committedOutcome.count, committedOutcome.speciesId
    ))
    return true, committedOutcome, if duplicateOutcome then "duplicate" else "claimed"
end

function ProfileRepository.mutateSpecies(player: Player, speciesId: string, targetMutation: string, requestToken: string)
    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, nil, "profile_not_loaded"
    end
    if not knownSpecies(speciesId) then return false, nil, "unknown_species" end
    if targetMutation ~= "gold" then return false, nil, "unknown_mutation" end
    if typeof(requestToken) ~= "string" or #requestToken &lt; 1 or #requestToken &gt; 80 then
        return false, nil, "invalid_token"
    end

    local operationId = "mutation:" .. requestToken
    local cachedOperation = findOperation(cached, operationId)
    if cachedOperation then
        return true, cachedOperation.outcome, "duplicate"
    end

    local cachedEntry = cached.collection[speciesId]
    if typeof(cachedEntry) ~= "table" or cachedEntry.base &lt; Config.GoldMutationCost then
        return false, nil, "insufficient_copies"
    end

    local outcome = {
        speciesId = speciesId,
        mutationId = "gold",
        spentBase = Config.GoldMutationCost,
        gainedGold = 1,
    }
    local duplicateOutcome = nil
    local leaseLost = false
    local insufficient = false
    local now = os.time()

    local ok, updated = retry("gold mutation", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end

            local existing = findOperation(profileValue, operationId)
            if existing then
                duplicateOutcome = existing.outcome
                return profileValue
            end

            local entry = profileValue.collection[speciesId]
            if typeof(entry) ~= "table" or entry.base &lt; Config.GoldMutationCost then
                insufficient = true
                return nil
            end

            entry.base -= Config.GoldMutationCost
            entry.gold += 1
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            table.insert(profileValue.recentOperations, {
                id = operationId,
                kind = "mutation",
                outcome = outcome,
            })
            trimOperations(profileValue)
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, nil, "lease_lost"
        end
        if insufficient then return false, nil, "insufficient_copies" end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, nil, "save_failed"
    end

    profiles[player] = updated
    syncAttributes(player, updated)
    local committedOutcome = duplicateOutcome or outcome
    return true, committedOutcome, if duplicateOutcome then "duplicate" else "mutated"
end

function ProfileRepository.setMutationTestCopies(player: Player, speciesId: string, baseCount: number): (boolean, string)
    if not Config.MutationTestSetupEnabled then return false, "disabled" end
    if speciesId ~= Config.MutationTestSpeciesId then return false, "bad_species" end
    if baseCount ~= 49 and baseCount ~= 50 and baseCount ~= 51 then
        return false, "bad_count"
    end

    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, "profile_not_loaded"
    end

    local leaseLost = false
    local now = os.time()
    local ok, updated = retry("mutation test setup", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end
            local entry = profileValue.collection[speciesId]
            if typeof(entry) ~= "table" then return nil end
            entry.base = baseCount
            entry.gold = 0
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, "lease_lost"
        end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, "save_failed"
    end

    profiles[player] = updated
    syncAttributes(player, updated)
    return true, "set_" .. tostring(baseCount)
end

function ProfileRepository.renew(player: Player): boolean
    if not profiles[player] or player:GetAttribute("ProfileState") ~= "Loaded" then return false end
    local leaseLost = false
    local now = os.time()
    local ok, updated = retry("lease renew", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) or not ownSession(profileValue) then
                leaseLost = true
                return nil
            end
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            return profileValue
        end)
    end)
    if not ok or updated == nil then
        player:SetAttribute("ProfileState", if leaseLost then "LeaseLost" else "SaveFailed")
        return false
    end
    profiles[player] = updated
    return true
end

function ProfileRepository.release(player: Player)
    local cached = profiles[player]
    profiles[player] = nil
    if not cached then return end

    retry("lease release", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) or not ownSession(profileValue) then return nil end
            profileValue.session = nil
            return profileValue
        end)
    end)
end

function ProfileRepository.start()
    if renewing then return end
    renewing = true
    task.spawn(function()
        while renewing do
            task.wait(Config.ProfileRenewSeconds)
            for player in profiles do
                if player.Parent then task.spawn(ProfileRepository.renew, player) end
            end
        end
    end)
end

return ProfileRepository
</ProtectedString>
