      <Item class="ModuleScript" referent="RBX16">
        <Properties>
          <string name="Name">ResourceModels</string>
          <ProtectedString name="Source">--!strict
-- Imported meshes are optional until Studio upload; no invented asset IDs.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local RuntimeMeshes = require(script.Parent.RuntimeMeshes)
local ResourceModels = {}
function ResourceModels.clone(id: string): Model?
    local folder = ReplicatedStorage:FindFirstChild("Resources")
    local template = if folder then folder:FindFirstChild(id) else nil
    if not template then return if RunService:IsClient() then RuntimeMeshes.clone(id) else nil end
    local copy: Model
    if template:IsA("Model") then
        copy = template:Clone()
    elseif template:IsA("BasePart") then
        copy = Instance.new("Model")
        local part = template:Clone()
        part.Parent = copy
        copy.PrimaryPart = part
    else
        return nil
    end
    -- Only geometry and appearance survive import. Never execute imported code.
    for _, item in copy:GetDescendants() do
        if item:IsA("LuaSourceContainer") then item:Destroy()
        elseif item:IsA("BasePart") then
            item.CanCollide = false
            item.CanTouch = false
            item.CanQuery = false
            item.Massless = true
        end
    end
    -- Normalize the pivot to the ground under the bounding-box center. Keep imported -Z facing.
    copy.PrimaryPart = nil
    local box, size = copy:GetBoundingBox()
    copy.WorldPivot = CFrame.new(box.Position - Vector3.new(0, size.Y / 2, 0))
    copy.Name = id
    return copy
end
return ResourceModels
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX17">
        <Properties>
          <string name="Name">RuntimeMeshes</string>
          <ProtectedString name="Source">--!strict
-- Build local visual MeshParts from embedded original geometry. Server collision stays separate.
local AssetService = game:GetService("AssetService")
local RunService = game:GetService("RunService")
local Geometry = require(script.Parent.ResourceGeometry)
local RuntimeMeshes = {}
local templates: {[string]: Model} = {}
local editableMeshes: {[string]: EditableMesh} = {}
local started = false
RuntimeMeshes.Ready = Instance.new("BindableEvent")
function RuntimeMeshes.clone(id: string): Model?
    local template = templates[id]
    return if template then template:Clone() else nil
end
function RuntimeMeshes.prepare()
    if started or not RunService:IsClient() then return end
    started = true
    task.spawn(function()
        local succeeded = 0
        for _, id in {"compy", "triceratops", "tyrannosaurus", "tree", "rock", "fern", "egg", "berry", "fruit", "amber"} do
            local editable: EditableMesh? = nil
            local ok, result = pcall(function()
                local data = Geometry[id]
                local mesh = AssetService:CreateEditableMesh()
                if not mesh then error("EditableMesh memory unavailable") end
                editable = mesh
                local vertices, colors = {}, {}
                for _, position in data.vertices do
                    table.insert(vertices, mesh:AddVertex(Vector3.new(position[1], position[2], position[3])))
                end
                for _, color in data.colors do
                    table.insert(colors, mesh:AddColor(Color3.new(color[1], color[2], color[3]), 1))
                end
                for _, triangle in data.faces do
                    local face = mesh:AddTriangle(vertices[triangle[1]], vertices[triangle[2]], vertices[triangle[3]])
                    local color = colors[triangle[4]]
                    mesh:SetFaceColors(face, {color, color, color})
                    local a, b, c = data.vertices[triangle[1]], data.vertices[triangle[2]], data.vertices[triangle[3]]
                    local normal = (Vector3.new(b[1]-a[1],b[2]-a[2],b[3]-a[3])):Cross(Vector3.new(c[1]-a[1],c[2]-a[2],c[3]-a[3])).Unit
                    local normalId = mesh:AddNormal(normal)
                    mesh:SetFaceNormals(face, {normalId, normalId, normalId})
                end
                local part = AssetService:CreateMeshPartAsync(Content.fromObject(mesh))
                part.Name = id .. "Mesh"
                part.Color = Color3.new(1, 1, 1)
                part.Material = Enum.Material.SmoothPlastic
                part.Anchored = true
                part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
                part.Massless = true
                -- EditableMesh vertices are relative to mesh bounds center.
                local min, max = Vector3.new(math.huge,math.huge,math.huge), Vector3.new(-math.huge,-math.huge,-math.huge)
                for _, p in data.vertices do
                    local v = Vector3.new(p[1],p[2],p[3])
                    min = Vector3.new(math.min(min.X,v.X),math.min(min.Y,v.Y),math.min(min.Z,v.Z))
                    max = Vector3.new(math.max(max.X,v.X),math.max(max.Y,v.Y),math.max(max.Z,v.Z))
                end
                part.Size = max - min
                part.CFrame = CFrame.new((min + max) / 2)
                local model = Instance.new("Model")
                model.Name = id
                part.Parent = model
                model.WorldPivot = CFrame.new(0, 0, 0)
                return model
            end)
            if ok then
                editableMeshes[id] = editable :: EditableMesh -- preserve the content lifetime
                templates[id] = result
                succeeded += 1
                RuntimeMeshes.Ready:Fire(id)
            else
                if editable then editable:Destroy() end
                warn("[Be Dino] mesh " .. id .. " unavailable: " .. tostring(result))
                -- A permission failure should not cause ten repeated heavyweight failures.
                if succeeded == 0 then break end
            end
            task.wait()
        end
        workspace:SetAttribute("LocalMeshCount", succeeded)
        workspace:SetAttribute("LocalMeshStatus", if succeeded == 10 then "Ready" else "Enable Mesh / Image APIs or import OBJ assets")
    end)
end
return RuntimeMeshes
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX18">
        <Properties>
          <string name="Name">UITheme</string>
          <ProtectedString name="Source">--!strict
local TweenService = game:GetService("TweenService")
local AssetService = game:GetService("AssetService")
local IconRaster = require(script.Parent.IconRaster)
local imageCache = {}
local UITheme = {}
UITheme.BackgroundImageId = "" -- optional permanent upload of resources/ui/backgrounds/prehistoric-island.png
function UITheme.imageContent(id: string): Content?
    if imageCache[id] == false then return nil end
    if imageCache[id] then return Content.fromObject(imageCache[id]) end
    local runs = IconRaster[id]
    if not runs then return nil end
    local ok, image = pcall(function()
        local editable = AssetService:CreateEditableImage({Size = Vector2.new(64,64)})
        if not editable then error("Image memory unavailable") end
        local pixels = buffer.create(64*64*4)
        local offset = 0
        for i = 1, #runs, 2 do
            for _ = 1, runs[i] do buffer.writeu32(pixels,offset,runs[i+1]) offset += 4 end
        end
        editable:WritePixelsBuffer(Vector2.zero, Vector2.new(64,64), pixels)
        return editable
    end)
    if not ok then imageCache[id] = false return nil end
    imageCache[id] = image
    return Content.fromObject(image)
end
UITheme.Colors = {
    panel = Color3.fromRGB(49, 94, 110),
    card = Color3.fromRGB(55, 104, 122),
    outline = Color3.fromRGB(16, 42, 56),
    text = Color3.fromRGB(250, 248, 230),
    accent = Color3.fromRGB(102, 203, 161),
    gold = Color3.fromRGB(247, 196, 96),
}
-- Upload resources/ui/icons/*.png, then set these logical icon IDs.
UITheme.ImageIds = {home = "", dinos = "", egg = "", leaf = "", amber = "", close = "", settings = "", shop = "", play = "", lock = "", trophy = "", gift = "", bolt = "", snow = ""}
function UITheme.decorate(object: GuiObject, radius: number)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = object
    local stroke = Instance.new("UIStroke")
    stroke.Color = UITheme.Colors.outline
    stroke.Thickness = 2
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = object
    local gradient = Instance.new("UIGradient")
    gradient.Rotation = 90
    gradient.Color = ColorSequence.new(Color3.fromRGB(255,255,255), Color3.fromRGB(184,206,215))
    gradient.Parent = object
    if object:IsA("TextButton") then
        local scale = Instance.new("UIScale")
        scale.Parent = object
        object.MouseEnter:Connect(function()
            TweenService:Create(scale, TweenInfo.new(.12), {Scale = 1.03}):Play()
        end)
        object.MouseLeave:Connect(function()
            TweenService:Create(scale, TweenInfo.new(.12), {Scale = 1}):Play()
        end)
        object.MouseButton1Down:Connect(function()
            TweenService:Create(scale, TweenInfo.new(.08), {Scale = .96}):Play()
        end)
        object.MouseButton1Up:Connect(function()
            TweenService:Create(scale, TweenInfo.new(.12), {Scale = 1}):Play()
        end)
    end
end
function UITheme.icon(parent: GuiObject, id: string): ImageLabel?
    local imageId = UITheme.ImageIds[id]
    local content = if not imageId or imageId == "" then UITheme.imageContent(id) else nil
    if (not imageId or imageId == "") and not content then return nil end
    local icon = Instance.new("ImageLabel")
    icon.Size = UDim2.fromOffset(30,30)
    icon.Position = UDim2.fromOffset(8,7)
    icon.BackgroundTransparency = 1
    if content then icon.ImageContent = content else icon.Image = imageId end
    icon.ZIndex = parent.ZIndex + 1
    icon.Parent = parent
    return icon
end
return UITheme
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX19">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX20">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX21">
        <Properties>
          <string name="Name">Arena</string>
          <ProtectedString name="Source">--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Resources = require(ReplicatedStorage.Shared.ResourceModels)
local Terrain = require(script.Parent.IslandTerrain)
local Layout = require(ReplicatedStorage.Shared.IslandLayout)
local Arena = {}
local function part(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3, material: Enum.Material, solid: boolean): Part
    local p = Instance.new("Part")
    p.Name, p.Size, p.Position, p.Color, p.Material = name, size, position, color, material
    p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = true, solid, false, solid
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end
local function imported(parent: Instance, id: string, position: Vector3, scale: number, yaw: number): boolean
    local model = Resources.clone(id)
    if not model then return false end
    model:ScaleTo(scale)
    model:PivotTo(CFrame.new(position) * CFrame.Angles(0, yaw, 0))
    for _, item in model:GetDescendants() do if item:IsA("BasePart") then item.Anchored = true end end
    model.Parent = parent
    return true
end
local function group(parent: Instance, id: string, position: Vector3, scale: number, yaw: number): Model
    local model = Instance.new("Model")
    model.Name = id .. "Prop"
    model:SetAttribute("ResourceId", id)
    model:SetAttribute("SourcePosition", position)
    model:SetAttribute("SourceScale", scale)
    model:SetAttribute("SourceYaw", yaw)
    model.Parent = parent
    return model
end
local function rock(parent: Instance, position: Vector3, scale: number, yaw: number)
    parent = group(parent, "rock", position, scale, yaw)
    local collider = part(parent, "RockCollider", Vector3.new(4.7, 2.8, 4.0) * scale,
        position + Vector3.new(0, 1.4 * scale, 0), Color3.fromRGB(113, 133, 139), Enum.Material.Slate, true)
    collider.CFrame = CFrame.new(collider.Position) * CFrame.Angles(0, yaw, 0)
    if imported(parent, "rock", position, scale, yaw) then collider.Transparency = 1
    else
        collider.Shape = Enum.PartType.Ball
        local chip = part(parent, "RockChip", Vector3.new(2.6, 1.6, 2.6) * scale,
            position + Vector3.new(2, 0.8, 0.8) * scale, Color3.fromRGB(83, 109, 116), Enum.Material.Slate, true)
        chip.Shape = Enum.PartType.Ball
    end
end
local function tree(parent: Instance, position: Vector3, scale: number, yaw: number)
    parent = group(parent, "tree", position, scale, yaw)
    local trunk = part(parent, "TreeCollider", Vector3.new(1.6, 7, 1.6) * scale,
        position + Vector3.new(0, 3.5 * scale, 0), Color3.fromRGB(119, 83, 65), Enum.Material.Wood, true)
    if imported(parent, "tree", position, scale, yaw) then trunk.Transparency = 1
    else
        -- Roblox cylinders run along local X; rotate the long X dimension upright.
        trunk.Size = Vector3.new(7, 1.6, 1.6) * scale
        trunk.Shape = Enum.PartType.Cylinder
        trunk.CFrame = CFrame.new(trunk.Position) * CFrame.Angles(0, yaw, math.pi / 2)
        for _, offset in {Vector3.new(0, 9, 0), Vector3.new(2.7, 8.5, 0.4), Vector3.new(-2.3, 8.9, -0.8)} do
            local crown = part(parent, "Canopy", Vector3.new(5.5, 3.5, 5.5) * scale,
                position + offset * scale, Color3.fromRGB(64, 144, 112), Enum.Material.SmoothPlastic, false)
            crown.Shape = Enum.PartType.Ball
        end
    end
end
local function fern(parent: Instance, position: Vector3, scale: number, yaw: number)
    parent = group(parent, "fern", position, scale, yaw)
    if imported(parent, "fern", position, scale, yaw) then return end
    for i = 1, 7 do
        local angle = yaw + i * math.pi * 2 / 7
        local leaf = part(parent, "FernLeaf", Vector3.new(0.45, 0.16, 2.0) * scale,
            position + Vector3.new(math.sin(angle) * .6, .6, math.cos(angle) * .6) * scale,
            Color3.fromRGB(106, 180, 125), Enum.Material.SmoothPlastic, false)
        leaf.Shape = Enum.PartType.Ball
        leaf.CFrame = CFrame.new(leaf.Position) * CFrame.Angles(-0.28, angle, 0)
    end
end
function Arena.build()
    local old = workspace:FindFirstChild("BeDinoArena")
    if old then old:Destroy() end
    local world = Instance.new("Folder")
    world.Name, world.Parent = "BeDinoArena", workspace
    Terrain.build()
    local extent = Config.ArenaHalfWidth
    -- Simple hidden boundary; irregular rock silhouettes dress it instead of a block wall.
    for _, x in {-extent - 2, extent + 2} do
        local boundary = part(world, "Boundary", Vector3.new(4, 160, extent * 2 + 8), Vector3.new(x, 60, 0),
            Color3.fromRGB(81, 106, 116), Enum.Material.Rock, true)
        boundary.Transparency = 1
    end
    for _, z in {-extent - 2, extent + 2} do
        local boundary = part(world, "Boundary", Vector3.new(extent * 2, 160, 4), Vector3.new(0, 60, z),
            Color3.fromRGB(81, 106, 116), Enum.Material.Rock, true)
        boundary.Transparency = 1
    end
    local random = Random.new(1404)
    for side = 1, 4 do
        for i = 0, 11 do
            local t = -extent + i * extent * 2 / 11
            local position = if side == 1 then Vector3.new(t, 0, -extent - 5)
                elseif side == 2 then Vector3.new(t, 0, extent + 5)
                elseif side == 3 then Vector3.new(-extent - 5, 0, t) else Vector3.new(extent + 5, 0, t)
            rock(world, Vector3.new(position.X, Layout.height(position.X,position.Z), position.Z), random:NextNumber(2.4, 3.7), random:NextNumber(0, math.pi * 2))
        end
    end
    local spawn = Instance.new("SpawnLocation")
    spawn.Name = "PrototypeSpawn"
    spawn.Size, spawn.Position = Vector3.new(12, 1, 12), Vector3.new(0, Layout.height(0,30) + .5, 30)
    spawn.Anchored, spawn.Neutral, spawn.Duration, spawn.Transparency = true, true, 0, 1
    spawn.CanCollide, spawn.CanQuery = false, false
    spawn.Parent = world
    -- Authored landmark centers; within each, offset props avoid a uniform grid.
    for _, center in {Vector3.new(-105,0,80), Vector3.new(105,0,-80), Vector3.new(-125,0,-100), Vector3.new(128,0,102), Vector3.new(-190,0,15), Vector3.new(182,0,20), Vector3.new(0,0,-180), Vector3.new(15,0,190)} do
        for i = 1, 4 do
            local angle = i * 1.65 + random:NextNumber(-.4, .4)
            local position = center + Vector3.new(math.cos(angle) * 12, 0, math.sin(angle) * 10)
            position = Vector3.new(position.X,Layout.height(position.X,position.Z),position.Z)
            tree(world, position, random:NextNumber(1.5, 2.3), angle)
            fern(world, Vector3.new(position.X+5,Layout.height(position.X+5,position.Z+4),position.Z+4), random:NextNumber(.7,1.1), angle)
        end
        for i = 1, 3 do
            local p = center + Vector3.new(random:NextNumber(-14,14),0,random:NextNumber(-12,12))
            rock(world, Vector3.new(p.X,Layout.height(p.X,p.Z),p.Z), random:NextNumber(1.0,2.0), i)
        end
    end
    -- Scattered smaller vegetation connects landmarks while the central chase lane stays open.
    for i = 1, 65 do
        local angle, radius = i * 2.4, random:NextNumber(36,230)
        local position = Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius)
        position = Vector3.new(position.X,Layout.height(position.X,position.Z),position.Z)
        if (position - Vector3.new(0,0,30)).Magnitude &gt; 14 then fern(world, position, 1.2, angle) end
    end
    -- Stone arch landmark with an open passage.
    for _, x in {-96,-64} do
        local y = Layout.height(x,-15)
        part(world,"ArchPillar",Vector3.new(7,23,8),Vector3.new(x,y+11.5,-15),Color3.fromRGB(142,153,140),Enum.Material.Rock,true)
    end
    part(world,"ArchTop",Vector3.new(42,6,9),Vector3.new(-80,Layout.height(-80,-15)+24,-15),Color3.fromRGB(148,157,139),Enum.Material.Rock,true)
    -- Shallow decorative spring; water does not block navigation.
    local poolY = Layout.height(110,-40)+.2
    local pool = part(world,"SpringWater",Vector3.new(32,.18,25),Vector3.new(110,poolY,-40),Color3.fromRGB(77,192,200),Enum.Material.Glass,false)
    pool.Transparency = .28
    local falls = part(world,"Waterfall",Vector3.new(12,16,.3),Vector3.new(113,poolY+8,-52),Color3.fromRGB(183,236,232),Enum.Material.Glass,false)
    falls.Transparency = .4
    for i = 1, 4 do
        local x,z = 30+i*10,-30
        part(world,"JumpStone",Vector3.new(6,1.2+i*.4,6),Vector3.new(x,Layout.height(x,z)+.6+i*.2,z),Color3.fromRGB(133,147,143),Enum.Material.Slate,true)
    end
    workspace:SetAttribute("ArenaArtMode", if ReplicatedStorage.Resources:FindFirstChild("tree") then "Resource meshes" else "Import resources/models for mesh art")
end
return Arena
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX22">
        <Properties>
          <string name="Name">Bootstrap</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Arena = require(script.Parent.Arena)
local ChestService = require(script.Parent.ChestService)
local CollectionService = require(script.Parent.CollectionService)
local Dinosaur = require(script.Parent.Dinosaur)
local MutationService = require(script.Parent.MutationService)
local MovementGuard = require(script.Parent.MovementGuard)
local ProfileRepository = require(script.Parent.ProfileRepository)
local RunLifecycle = require(script.Parent.RunLifecycle)
local VisualTestService = require(script.Parent.VisualTestService)

Players.CharacterAutoLoads = false

Lighting.ClockTime = 14
Lighting.Brightness = 2
Lighting.Ambient = Color3.fromRGB(130, 143, 148)
Arena.build()

ProfileRepository.start()
RunLifecycle.configureSettlement(function(player: Player, runId: string, catchScore: number, reason: string)
    local ok = ProfileRepository.commitRunSettlement(player, runId, catchScore)
    if not ok then
        warn(string.format("[Be Dino] settlement failed for %s (%s)", player.Name, reason))
        return false
    end

    if Config.DuplicateSettlementProbe then
        local retryOk, _, retryStatus = ProfileRepository.commitRunSettlement(player, runId, catchScore)
        if not retryOk or retryStatus ~= "duplicate" then
            player:SetAttribute("ProfileState", "SaveFailed")
            warn("[Be Dino] duplicate settlement probe failed for " .. player.Name)
            return false
        end
        player:SetAttribute("LastSettlementProbe", "duplicate-ok")
    end

    if not player.Parent then ProfileRepository.release(player) end
    return true
end)
RunLifecycle.start()
CollectionService.start(ProfileRepository, Dinosaur)
ChestService.start(ProfileRepository)
MutationService.start(ProfileRepository, Dinosaur)
MovementGuard.start()
VisualTestService.start(Dinosaur)

local function spawnLoadedPlayer(player: Player)
    player.CanLoadCharacterAppearance = false
    local loaded = ProfileRepository.load(player)
    if not loaded or not player.Parent then
        warn("[Be Dino] profile load blocked character spawn for " .. player.Name)
        return
    end

    local ok, err = pcall(function()
        player:LoadCharacterAsync()
    end)
    if not ok then
        player:SetAttribute("CharacterState", "SpawnFailed")
        warn("[Be Dino] initial character load failed: " .. tostring(err))
    end
end

local function setup(player: Player)
    player.CanLoadCharacterAppearance = false
    player.CharacterAdded:Connect(function(character)
        if player:GetAttribute("ProfileState") ~= "Loaded" then
            character:Destroy()
            return
        end
        RunLifecycle.begin(player, character)
        task.spawn(Dinosaur.attach, character, Config.WalkSpeed, player)
    end)
    task.spawn(spawnLoadedPlayer, player)
end

Players.PlayerAdded:Connect(setup)
for _, player in Players:GetPlayers() do setup(player) end

Players.PlayerRemoving:Connect(function(player)
    local status = RunLifecycle.endForDisconnect(player)
    if status ~= "busy" then ProfileRepository.release(player) end
end)

game:BindToClose(function()
    for _, player in Players:GetPlayers() do
        local status = RunLifecycle.endForDisconnect(player)
        if status ~= "busy" then ProfileRepository.release(player) end
    end
end)

local FoodService = require(script.Parent.FoodService)
FoodService.start(Dinosaur)
local PredationService = require(script.Parent.PredationService)
PredationService.start(RunLifecycle, Dinosaur)

print("[Be Dino] " .. Config.Build .. " ready. Resource redesign.")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX23">
        <Properties>
          <string name="Name">ChestService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local ChestService = {}
local lastClaim: {[Player]: number} = {}
local lastGrant: {[Player]: number} = {}

local function getRemote(folder: Folder, name: string): RemoteEvent
    local existing = folder:FindFirstChild(name)
    if existing and existing:IsA("RemoteEvent") then return existing end
    if existing then existing:Destroy() end
    local remote = Instance.new("RemoteEvent")
    remote.Name = name
    remote.Parent = folder
    return remote
end

local function allowed(bucket: {[Player]: number}, player: Player): boolean
    local now = os.clock()
    local last = bucket[player] or -math.huge
    if now - last &lt; Config.ChestClaimRequestCooldownSeconds then return false end
    bucket[player] = now
    return true
end

function ChestService.start(profileRepository)
    local folder = ReplicatedStorage:FindFirstChild("BeDinoRemotes") :: Folder?
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "BeDinoRemotes"
        folder.Parent = ReplicatedStorage
    end

    local claimChest = getRemote(folder, "ClaimChest")
    local testGrant = getRemote(folder, "TestGrantChests")

    claimChest.OnServerEvent:Connect(function(player: Player, chestId, requestToken, ...)
        if select("#", ...) ~= 0 then return end
        if typeof(chestId) ~= "string" or #chestId &lt; 1 or #chestId &gt; 80 then
            player:SetAttribute("LastChestClaimStatus", "invalid_chest_id")
            return
        end
        if typeof(requestToken) ~= "string" or #requestToken &lt; 1 or #requestToken &gt; 80 then
            player:SetAttribute("LastChestClaimStatus", "invalid_token")
            return
        end
        if not allowed(lastClaim, player) then
            player:SetAttribute("LastChestClaimStatus", "rate_limited")
            return
        end
        local _, _, status = profileRepository.claimChest(player, chestId)
        player:SetAttribute("LastChestClaimStatus", status)
    end)

    testGrant.OnServerEvent:Connect(function(player: Player, ...)
        if select("#", ...) ~= 0 then return end
        if not Config.ChestTestGrantEnabled then return end
        if not allowed(lastGrant, player) then
            player:SetAttribute("LastChestTestGrantStatus", "rate_limited")
            return
        end
        local _, status = profileRepository.grantChestTest(player)
        player:SetAttribute("LastChestTestGrantStatus", status)
    end)

    Players.PlayerRemoving:Connect(function(player)
        lastClaim[player] = nil
        lastGrant[player] = nil
    end)
end

return ChestService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX24">
        <Properties>
          <string name="Name">CollectionService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local CollectionService = {}
local lastEquipRequest: {[Player]: number} = {}
local lastGrantRequest: {[Player]: number} = {}

local function getRemote(folder: Folder, name: string): RemoteEvent
    local existing = folder:FindFirstChild(name)
    if existing and existing:IsA("RemoteEvent") then return existing end
    if existing then existing:Destroy() end
    local remote = Instance.new("RemoteEvent")
    remote.Name = name
    remote.Parent = folder
    return remote
end

local function rateAllowed(bucket: {[Player]: number}, player: Player): boolean
    local now = os.clock()
    local last = bucket[player] or -math.huge
    if now - last &lt; Config.EquipRequestCooldownSeconds then return false end
    bucket[player] = now
    return true
end

function CollectionService.start(profileRepository, dinosaur)
    local folder = ReplicatedStorage:FindFirstChild("BeDinoRemotes")
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "BeDinoRemotes"
        folder.Parent = ReplicatedStorage
    end

    local equipSpecies = getRemote(folder :: Folder, "EquipSpecies")
    local testGrant = getRemote(folder :: Folder, "TestGrantSpecies")

    equipSpecies.OnServerEvent:Connect(function(player: Player, speciesId, requestToken, ...)
        if select("#", ...) ~= 0 then return end
        if typeof(speciesId) ~= "string" or #speciesId &lt; 1 or #speciesId &gt; 32 then
            player:SetAttribute("LastEquipStatus", "invalid_species")
            return
        end
        if typeof(requestToken) ~= "string" or #requestToken &lt; 1 or #requestToken &gt; 80 then
            player:SetAttribute("LastEquipStatus", "invalid_token")
            return
        end
        if not rateAllowed(lastEquipRequest, player) then
            player:SetAttribute("LastEquipStatus", "rate_limited")
            return
        end

        local ok, status = profileRepository.equipSpecies(player, speciesId)
        player:SetAttribute("LastEquipStatus", status)
        if not ok then return end

        local character = player.Character
        if character and character:GetAttribute("DinoAttached") then
            dinosaur.refreshForPlayer(character, player)
        end
    end)

    testGrant.OnServerEvent:Connect(function(player: Player, ...)
        if select("#", ...) ~= 0 then return end
        if not Config.CollectionTestGrantEnabled then return end
        if not rateAllowed(lastGrantRequest, player) then
            player:SetAttribute("LastCollectionGrantStatus", "rate_limited")
            return
        end
        local _, status = profileRepository.grantCollectionTestSpecies(player)
        player:SetAttribute("LastCollectionGrantStatus", status)
    end)

    Players.PlayerRemoving:Connect(function(player)
        lastEquipRequest[player] = nil
        lastGrantRequest[player] = nil
    end)
end

return CollectionService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX25">
        <Properties>
          <string name="Name">Dinosaur</string>
          <ProtectedString name="Source">--!strict
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PhysicsService = game:GetService("PhysicsService")
local Dinosaur = {}
local Visual = require(ReplicatedStorage.Shared.DinosaurVisual)
function Dinosaur.render(character: Model, scale: number, speciesId: string?, gold: boolean?)
    Visual.render(character, scale, speciesId, gold)
    local collider = character:FindFirstChild("DinoCollider")
    if collider and collider:IsA("BasePart") then
        -- Match the growing torso footprint; keep floor clearance and the tail visual-only.
        collider.Size = Vector3.new(2.6 * scale, 2.4, 3.2 * scale)
    end
end
local function scaleForScore(score: number): number
    return math.min(4, math.sqrt(1 + math.max(0, score) / 50))
end
if not PhysicsService:IsCollisionGroupRegistered("DinoControllers") then
    PhysicsService:RegisterCollisionGroup("DinoControllers")
end
PhysicsService:CollisionGroupSetCollidable("DinoControllers", "DinoControllers", false)

function Dinosaur.setSpecies(character: Model, speciesId: string, isGold: boolean?)
    local scaleValue = character:GetAttribute("VisualScale")
    local scale = if typeof(scaleValue) == "number" then scaleValue else 1
    Dinosaur.render(character, scale, speciesId, isGold)
end

local function playerSpeciesCounts(player: Player, speciesId: string): (number, number)
    if speciesId == "compy" then
        return player:GetAttribute("CompyCopies") or 0, player:GetAttribute("CompyGold") or 0
    elseif speciesId == "triceratops" then
        return player:GetAttribute("TriceratopsCopies") or 0, player:GetAttribute("TriceratopsGold") or 0
    elseif speciesId == "tyrannosaurus" then
        return player:GetAttribute("TyrannosaurusCopies") or 0, player:GetAttribute("TyrannosaurusGold") or 0
    end
    return 0, 0
end

function Dinosaur.refreshForPlayer(character: Model, player: Player)
    local equipped = player:GetAttribute("EquippedSpeciesId")
    local speciesId = if typeof(equipped) == "string" then equipped else "compy"
    local baseCount, goldCount = playerSpeciesCounts(player, speciesId)
    local useGold = baseCount &lt;= 0 and goldCount &gt; 0
    Dinosaur.setSpecies(character, speciesId, useGold)
end

function Dinosaur.addGrowth(character: Model, points: number)
    if points &lt;= 0 or character:GetAttribute("RunState") ~= "Active" then return end
    local current = character:GetAttribute("GrowthScore")
    local score = (if typeof(current) == "number" then current else 0) + points
    character:SetAttribute("GrowthScore", score)
    local scale = scaleForScore(score)
    if character:GetAttribute("VisualScale") ~= scale then
        local gold = character:GetAttribute("GoldVisual") == true
        Dinosaur.render(character, scale, nil, gold)
    end
end

function Dinosaur.attach(character: Model, walkSpeed: number, player: Player)
    local deadline = os.clock() + 10
    while not character:IsDescendantOf(workspace) do
        if player.Character ~= character or not player.Parent then return end
        if os.clock() &gt;= deadline then return end
        RunService.Heartbeat:Wait()
    end
    local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
    local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
    if player.Character ~= character or not character:IsDescendantOf(workspace) then return end
    if not humanoid or not root or character:GetAttribute("DinoAttached") then return end

    local function hide(instance: Instance)
        if instance:FindFirstAncestor("DinoVisual") then return end
        if instance:IsA("BasePart") then instance.Transparency = 1 end
        if instance:IsA("Decal") then instance.Transparency = 1 end
    end
    for _, descendant in character:GetDescendants() do hide(descendant) end
    character.DescendantAdded:Connect(hide)

    humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    humanoid.WalkSpeed = walkSpeed
    humanoid.UseJumpPower = true
    humanoid.JumpPower = require(ReplicatedStorage.Shared.Config).JumpPower
    humanoid.MaxSlopeAngle = require(ReplicatedStorage.Shared.Config).MaxSlopeAngle
    humanoid.AutoJumpEnabled = false
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)

    -- Explicit torso collider: decorative mesh triangles never control physics.
    for _, item in character:GetDescendants() do
        if item:IsA("BasePart") then item.CollisionGroup = "DinoControllers" end
    end
    local collider = Instance.new("Part")
    collider.Name = "DinoCollider"
    collider.Size = Vector3.new(2.6, 2.4, 3.2)
    collider.Transparency = 1
    collider.Massless = true
    collider.CanCollide = true
    collider.CanTouch = false
    collider.CollisionGroup = "DinoControllers"
    local groundHeight = root.Size.Y / 2 + humanoid.HipHeight
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        local leg = character:FindFirstChild("Left Leg")
        groundHeight += if leg and leg:IsA("BasePart") then leg.Size.Y else 2
    end
    collider.CFrame = root.CFrame * CFrame.new(0, -groundHeight + 1.4, 0)
    collider.Parent = character
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = collider
    weld.Parent = collider
    Dinosaur.refreshForPlayer(character, player)
    character:SetAttribute("DinoAttached", true)
end

return Dinosaur
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX26">
        <Properties>
          <string name="Name">FoodService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local MovementEnvelope = require(ReplicatedStorage.Shared.MovementEnvelope)
local Resources = require(ReplicatedStorage.Shared.ResourceModels)
local FoodService = {}
local TYPES = {
    {id = "berry", weight = 78, points = 1, size = 0.5, color = Color3.fromRGB(224, 99, 118)},
    {id = "fruit", weight = 15, points = 4, size = 0.85, color = Color3.fromRGB(244, 186, 83)},
    {id = "egg", weight = 5, points = 15, size = 0.95, color = Color3.fromRGB(245, 230, 187)},
    {id = "amber", weight = 2, points = 50, size = 1.3, color = Color3.fromRGB(255, 219, 139)},
}
function FoodService.start(dinosaur)
    local folder = Instance.new("Folder")
    folder.Name = "Food"
    folder.Parent = workspace
    local foods = {}
    local random = Random.new(Config.FoodSeed)
    local groundParams = RaycastParams.new()
    groundParams.FilterType = Enum.RaycastFilterType.Include
    groundParams.FilterDescendantsInstances = {workspace.BeDinoArena, workspace.Terrain}
    local extent = Config.ArenaHalfWidth - 8
    local sectorWidth = 2 * extent / Config.FoodSectorCount
    local function groundAt(x: number, z: number): Vector3?
        -- Safe spawn remains clear. Ground's top is y=0.
        if (Vector2.new(x, z) - Vector2.new(0, 30)).Magnitude &lt; 11 then return nil end
        local hit = workspace:Raycast(Vector3.new(x, Config.TerrainTop + 20, z), Vector3.new(0, -Config.TerrainTop - 60, 0), groundParams)
        if not hit or (hit.Instance ~= workspace.Terrain and hit.Instance.Name ~= "Ground")
            or hit.Material == Enum.Material.Water or hit.Normal.Y &lt; 0.62 then return nil end
        -- A second horizontal check keeps pickups away from solid rock/trunk edges.
        for _, direction in {Vector3.xAxis, -Vector3.xAxis, Vector3.zAxis, -Vector3.zAxis} do
            if workspace:Raycast(hit.Position + Vector3.new(0, 1, 0), direction * 1.25, groundParams) then
                return nil
            end
        end
        return hit.Position
    end
    local function relocate(food): boolean
        for _ = 1, 24 do
            local angle = random:NextNumber(0, 2 * math.pi)
            local radius = math.sqrt(random:NextNumber()) * Config.FoodClusterRadius
            local x = math.clamp(food.center.X + math.cos(angle) * radius, food.minX + 1, food.maxX - 1)
            local z = math.clamp(food.center.Y + math.sin(angle) * radius, food.minZ + 1, food.maxZ - 1)
            local ground = groundAt(x, z)
            if ground then
                food.part.Position = ground + Vector3.new(0, food.kind.size / 2 + 0.08, 0)
                if food.visual then food.visual:PivotTo(CFrame.new(ground)) end
                return true
            end
        end
        return false
    end
    local function show(food, visible: boolean)
        if food.visual then
            for _, item in food.visual:GetDescendants() do
                if item:IsA("BasePart") then item.Transparency = if visible then 0 else 1 end
            end
        else
            food.part.Transparency = if visible then 0 else 1
        end
    end
    for sx = 0, Config.FoodSectorCount - 1 do
        for sz = 0, Config.FoodSectorCount - 1 do
            local minX, minZ = -extent + sx * sectorWidth, -extent + sz * sectorWidth
            local center = Vector2.new(minX + sectorWidth / 2, minZ + sectorWidth / 2)
            -- Jitter cluster centers, including edge sectors; no one central food island.
            for _ = 1, 20 do
                local proposed = Vector2.new(random:NextNumber(minX + 3, minX + sectorWidth - 3), random:NextNumber(minZ + 3, minZ + sectorWidth - 3))
                if groundAt(proposed.X, proposed.Y) then center = proposed break end
            end
            for _ = 1, Config.FoodClusterItems do
                local roll, kind = random:NextInteger(1, 100), TYPES[1]
                if roll &gt; 98 then kind = TYPES[4] elseif roll &gt; 93 then kind = TYPES[3] elseif roll &gt; 78 then kind = TYPES[2] end
                local pickup = Instance.new("Part")
                pickup.Name = kind.id
                pickup.Shape = Enum.PartType.Ball
                pickup.Size = Vector3.one * kind.size
                pickup.Color = kind.color
                pickup.Material = Enum.Material.SmoothPlastic
                pickup.Anchored = true
                pickup.CanCollide = false
                pickup.CanTouch = false
                pickup.CanQuery = false
                pickup:SetAttribute("Points", kind.points)
                pickup:SetAttribute("Sector", string.format("%d:%d", sx, sz))
                local visual = Resources.clone(kind.id)
                local food = {part = pickup, visual = visual, readyAt = 0, hidden = false, kind = kind,
                    center = center, minX = minX, maxX = minX + sectorWidth, minZ = minZ, maxZ = minZ + sectorWidth}
                if relocate(food) then
                    pickup.Parent = folder
                    if visual then
                        pickup.Transparency = 1
                        for _, item in visual:GetDescendants() do
                            if item:IsA("BasePart") then item.Anchored = true end
                        end
                        visual.Parent = folder
                    end
                    table.insert(foods, food)
                else
                    pickup:Destroy()
                    if visual then visual:Destroy() end
                end
            end
        end
    end
    workspace:SetAttribute("FoodCount", #foods)
    local previous = {}
    Players.PlayerRemoving:Connect(function(player) previous[player] = nil end)
    task.spawn(function()
        while true do
            task.wait(Config.FoodTickSeconds)
            local now = os.clock()
            local candidates = {}
            for _, player in Players:GetPlayers() do
                local character = player.Character
                local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
                local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
                if character and root and root:IsA("BasePart") and humanoid and humanoid.Health &gt; 0
                    and character:GetAttribute("DinoAttached") and character:GetAttribute("RunState") == "Active" then
                    local last, position = previous[player], root.Position
                    local plausible = last and last.character == character
                        and MovementEnvelope.plausible(position - last.position, now - last.time, 2, 2, root.AssemblyLinearVelocity.Y)
                    previous[player] = {character = character, position = position, time = now}
                    if plausible then table.insert(candidates, {player = player, character = character, root = root, gained = 0}) end
                else previous[player] = nil end
            end
            for _, food in foods do
                if now &lt; food.readyAt then continue end
                if food.hidden then
                    relocate(food) -- original valid location remains if no replacement succeeds
                    show(food, true)
                    food.hidden = false
                end
                local winner, nearest = nil, math.huge
                for _, candidate in candidates do
                    local delta = food.part.Position - candidate.root.Position
                    local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
                    local scale = candidate.character:GetAttribute("VisualScale") or 1
                    local radius = math.min(5, Config.FoodPickupRadius + (scale - 1) * 0.75)
                    if horizontal &lt;= radius and math.abs(delta.Y) &lt; 6 then
                        local blocked = workspace:Raycast(candidate.root.Position, delta, groundParams)
                        if not blocked and (horizontal &lt; nearest or (horizontal == nearest and winner and candidate.player.UserId &lt; winner.player.UserId)) then
                            nearest, winner = horizontal, candidate
                        end
                    end
                end
                if winner then
                    food.readyAt = now + Config.FoodRespawnSeconds
                    food.hidden = true
                    show(food, false)
                    winner.gained += food.kind.points
                end
            end
            for _, candidate in candidates do
                if candidate.gained &gt; 0 then dinosaur.addGrowth(candidate.character, candidate.gained) end
            end
        end
    end)
end
return FoodService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX27">
        <Properties>
          <string name="Name">IslandTerrain</string>
          <ProtectedString name="Source">--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Layout = require(ReplicatedStorage.Shared.IslandLayout)
local IslandTerrain = {}
function IslandTerrain.build()
    local terrain = workspace.Terrain
    terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(96, 148, 105))
    terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(114, 133, 137))
    terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(151, 124, 91))
    local resolution = Config.TerrainResolution
    local extent = Config.ArenaHalfWidth + 8
    local region = Region3.new(Vector3.new(-extent,-16,-extent), Vector3.new(extent,Config.TerrainTop,extent)):ExpandToGrid(resolution)
    local size = region.Size / resolution
    local low = region.CFrame.Position - region.Size / 2
    local materials, occupancy = {}, {}
    for x = 1, size.X do
        materials[x], occupancy[x] = {}, {}
        local wx = low.X + (x-.5)*resolution
        for y = 1, size.Y do materials[x][y], occupancy[x][y] = {}, {} end
        for z = 1, size.Z do
            local wz = low.Z + (z-.5)*resolution
            local height = Layout.height(wx,wz)
            for y = 1, size.Y do
                local wy = low.Y + (y-.5)*resolution
                occupancy[x][y][z] = math.clamp((height-wy)/resolution+.5,0,1)
                materials[x][y][z] = if wy &lt; height - 5 then Enum.Material.Rock
                    elseif height &gt; 42 and math.noise(wx/15,wz/15,2)&gt;.1 then Enum.Material.Rock else Enum.Material.Grass
            end
        end
        if x % 24 == 0 then task.wait() end
    end
    terrain:WriteVoxels(region,resolution,materials,occupancy)
    workspace:SetAttribute("IslandTerrainReady", true)
end
return IslandTerrain
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX28">
        <Properties>
          <string name="Name">MovementGuard</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MovementEnvelope = require(ReplicatedStorage.Shared.MovementEnvelope)

local MovementGuard = {}
local states: {[Player]: {
    character: Model,
    cframe: CFrame,
    position: Vector3,
    sampleAt: number,
    blockedUntil: number,
}} = {}
local started = false

local function clear(player: Player)
    states[player] = nil
end

function MovementGuard.start()
    if started then return end
    started = true
    Players.PlayerRemoving:Connect(clear)

    task.spawn(function()
        while true do
            task.wait(Config.MovementGuardTickSeconds)
            local now = os.clock()

            for _, player in Players:GetPlayers() do
                local character = player.Character
                local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
                local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil

                if not character or not root or not root:IsA("BasePart") or not humanoid
                    or humanoid.Health &lt;= 0 or character:GetAttribute("RunState") ~= "Active" then
                    clear(player)
                    continue
                end

                local state = states[player]
                if not state or state.character ~= character then
                    states[player] = {
                        character = character,
                        cframe = root.CFrame,
                        position = root.Position,
                        sampleAt = now,
                        blockedUntil = now + Config.MovementGuardTickSeconds,
                    }
                    player:SetAttribute("MovementSecurityStatus", "WARMUP")
                    continue
                end

                local dt = math.max(now - state.sampleAt, Config.MovementGuardTickSeconds * 0.5)
                local distance = (root.Position - state.position).Magnitude
                local allowed = Config.WalkSpeed * dt * Config.MovementGuardSpeedTolerance
                    + Config.MovementGuardBurstStuds

                if not MovementEnvelope.plausible(root.Position - state.position, dt, Config.MovementGuardSpeedTolerance, Config.MovementGuardBurstStuds, root.AssemblyLinearVelocity.Y) then
                    -- Server correction: never promote the impossible location to the trusted baseline.
                    root.CFrame = state.cframe
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    state.sampleAt = now
                    state.blockedUntil = now + Config.MovementGuardRejectCooldownSeconds
                    local rejects = player:GetAttribute("MovementRejectCount")
                    player:SetAttribute(
                        "MovementRejectCount",
                        (if typeof(rejects) == "number" then rejects else 0) + 1
                    )
                    player:SetAttribute("MovementSecurityStatus", "REJECTED")
                    continue
                end

                state.cframe = root.CFrame
                state.position = root.Position
                state.sampleAt = now
                if now &gt;= state.blockedUntil then
                    player:SetAttribute("MovementSecurityStatus", "OK")
                end
            end
        end
    end)
end

return MovementGuard
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX29">
        <Properties>
          <string name="Name">MutationService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local MutationService = {}
local lastMutation: {[Player]: number} = {}
local lastSetup: {[Player]: number} = {}

local function getRemote(folder: Folder, name: string): RemoteEvent
    local existing = folder:FindFirstChild(name)
    if existing and existing:IsA("RemoteEvent") then return existing end
    if existing then existing:Destroy() end
    local remote = Instance.new("RemoteEvent")
    remote.Name = name
    remote.Parent = folder
    return remote
end

local function allowed(bucket: {[Player]: number}, player: Player): boolean
    local now = os.clock()
    local last = bucket[player] or -math.huge
    if now - last &lt; Config.MutationRequestCooldownSeconds then return false end
    bucket[player] = now
    return true
end

function MutationService.start(profileRepository, dinosaur)
    local folder = ReplicatedStorage:FindFirstChild("BeDinoRemotes") :: Folder?
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "BeDinoRemotes"
        folder.Parent = ReplicatedStorage
    end

    local mutate = getRemote(folder, "MutateSpecies")
    local setupTest = getRemote(folder, "TestSetMutationCopies")

    mutate.OnServerEvent:Connect(function(player: Player, speciesId, targetMutation, requestToken, ...)
        if select("#", ...) ~= 0 then return end
        if typeof(speciesId) ~= "string" or #speciesId &lt; 1 or #speciesId &gt; 32 then
            player:SetAttribute("LastMutationStatus", "invalid_species")
            return
        end
        if targetMutation ~= "gold" then
            player:SetAttribute("LastMutationStatus", "unknown_mutation")
            return
        end
        if typeof(requestToken) ~= "string" or #requestToken &lt; 1 or #requestToken &gt; 80 then
            player:SetAttribute("LastMutationStatus", "invalid_token")
            return
        end
        if not allowed(lastMutation, player) then
            player:SetAttribute("LastMutationStatus", "rate_limited")
            return
        end

        local ok, _, status = profileRepository.mutateSpecies(player, speciesId, targetMutation, requestToken)
        player:SetAttribute("LastMutationStatus", status)
        if ok then
            player:SetAttribute("LastMutationToken", requestToken)
            local character = player.Character
            if character and character:GetAttribute("DinoAttached") then
                dinosaur.refreshForPlayer(character, player)
            end
        end
    end)

    setupTest.OnServerEvent:Connect(function(player: Player, baseCount, ...)
        if select("#", ...) ~= 0 then return end
        if not Config.MutationTestSetupEnabled then return end
        if typeof(baseCount) ~= "number" or baseCount % 1 ~= 0 then
            player:SetAttribute("LastMutationSetupStatus", "bad_count")
            return
        end
        if not allowed(lastSetup, player) then
            player:SetAttribute("LastMutationSetupStatus", "rate_limited")
            return
        end
        local ok, status = profileRepository.setMutationTestCopies(
            player, Config.MutationTestSpeciesId, baseCount
        )
        player:SetAttribute("LastMutationSetupStatus", status)
        if ok then
            local character = player.Character
            if character and character:GetAttribute("DinoAttached") then
                dinosaur.refreshForPlayer(character, player)
            end
        end
    end)

    Players.PlayerRemoving:Connect(function(player)
        lastMutation[player] = nil
        lastSetup[player] = nil
    end)
end

return MutationService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX30">
        <Properties>
          <string name="Name">PredationService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local MovementEnvelope = require(ReplicatedStorage.Shared.MovementEnvelope)

local PredationService = {}

local function numberAttribute(instance: Instance, name: string, fallback: number): number
    local value = instance:GetAttribute(name)
    return if typeof(value) == "number" then value else fallback
end

local function canEat(attackerScore: number, targetScore: number): boolean
    return attackerScore &gt; targetScore and attackerScore &gt;= targetScore * Config.PredationScoreMultiplier
end

function PredationService.start(runLifecycle, dinosaur)
    local previous = {}
    local recentPairs: {[number]: {[number]: number}} = {}
    local arenaParams = RaycastParams.new()
    arenaParams.FilterType = Enum.RaycastFilterType.Include
    arenaParams.FilterDescendantsInstances = {workspace.BeDinoArena, workspace.Terrain}

    Players.PlayerRemoving:Connect(function(player)
        previous[player] = nil
        recentPairs[player.UserId] = nil
        for _, victims in recentPairs do
            victims[player.UserId] = nil
        end
    end)

    local function awardCatch(attacker, victimUserId: number, now: number)
        local victims = recentPairs[attacker.player.UserId]
        if not victims then
            victims = {}
            recentPairs[attacker.player.UserId] = victims
        end
        local last = victims[victimUserId] or -math.huge
        if now - last &lt; Config.RepeatVictimCatchCooldownSeconds then
            return
        end
        victims[victimUserId] = now
        local catches = numberAttribute(attacker.character, "CatchScore", 0)
        if catches &lt; Config.MaxCatchScore then
            attacker.character:SetAttribute("CatchScore", catches + 1)
        end
    end

    task.spawn(function()
        while true do
            task.wait(Config.PredationTickSeconds)
            local movementNow = os.clock()
            local serverNow = workspace:GetServerTimeNow()
            local candidates = {}

            for _, player in Players:GetPlayers() do
                local character = player.Character
                local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
                local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
                if character and root and root:IsA("BasePart") and humanoid and humanoid.Health &gt; 0
                    and character:GetAttribute("DinoAttached") and runLifecycle.isActive(character) then
                    local last = previous[player]
                    local position = root.Position
                    local plausible = last and last.character == character
                        and MovementEnvelope.plausible(position - last.position, movementNow - last.time, 2, 2, root.AssemblyLinearVelocity.Y)
                    previous[player] = {character = character, position = position, time = movementNow}
                    if plausible then
                        table.insert(candidates, {
                            player = player,
                            character = character,
                            root = root,
                            score = numberAttribute(character, "GrowthScore", 0),
                            scale = numberAttribute(character, "VisualScale", 1),
                        })
                    end
                else
                    previous[player] = nil
                end
            end

            table.sort(candidates, function(a, b)
                return a.player.UserId &lt; b.player.UserId
            end)

            for _, victim in candidates do
                if not runLifecycle.isActive(victim.character) or runLifecycle.isProtected(victim.character, serverNow) then
                    continue
                end

                local winner = nil
                local nearest = math.huge
                for _, attacker in candidates do
                    if attacker.player == victim.player or not runLifecycle.isActive(attacker.character)
                        or runLifecycle.isProtected(attacker.character, serverNow) then
                        continue
                    end
                    if not canEat(attacker.score, victim.score) then continue end

                    local delta = victim.root.Position - attacker.root.Position
                    local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
                    local radius = math.min(Config.PredationMaxRadius,
                        Config.PredationBaseRadius + math.max(0, attacker.scale - 1) * 1.25)
                    if horizontal &gt; radius or math.abs(delta.Y) &gt; Config.PredationVerticalLimit then continue end

                    local blocked = workspace:Raycast(attacker.root.Position, delta, arenaParams)
                    if blocked then continue end

                    if horizontal &lt; nearest or (horizontal == nearest and winner and attacker.player.UserId &lt; winner.player.UserId) then
                        nearest = horizontal
                        winner = attacker
                    end
                end

                if winner and runLifecycle.tryEnd(victim.player, victim.character, "Eaten", winner.player.UserId) then
                    awardCatch(winner, victim.player.UserId, serverNow)
                    dinosaur.addGrowth(winner.character, Config.PredationGrowthPoints)
                end
            end
        end
    end)
end

return PredationService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX31">
        <Properties>
          <string name="Name">ProfileRepository</string>
          <ProtectedString name="Source">--!strict
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local RewardMath = require(script.Parent.RewardMath)

local ProfileRepository = {}

local RunService = game:GetService("RunService")
local localPreview = RunService:IsStudio() and game.GameId == 0 and Config.StudioLocalProfilesEnabled
local store: any
if localPreview then
    -- Unpublished F5 sessions have no DataStore. Deep copies mirror transaction boundaries.
    local memory = {}
    store = {UpdateAsync = function(_, key, transform)
        local current = if memory[key] then HttpService:JSONDecode(HttpService:JSONEncode(memory[key])) else nil
        local updated = transform(current)
        if updated == nil then return nil end
        memory[key] = HttpService:JSONDecode(HttpService:JSONEncode(updated))
        return updated
    end}
else
    store = DataStoreService:GetDataStore(Config.ProfileDataStoreName)
end
local leaseId = HttpService:GenerateGUID(false)
local profiles: {[Player]: any} = {}
local renewing = false

local function keyFor(player: Player): string
    return "u:" .. tostring(player.UserId)
end

local function knownSpecies(speciesId: any): boolean
    if typeof(speciesId) ~= "string" then return false end
    for _, configuredId in Config.SpeciesOrder do
        if configuredId == speciesId then return true end
    end
    return false
end

local function defaultProfile()
    return {
        schemaVersion = Config.ProfileSchemaVersion,
        revision = 0,
        session = nil,
        equippedSpeciesId = "compy",
        collection = {
            compy = {base = 1, gold = 0},
            triceratops = {base = 0, gold = 0},
            tyrannosaurus = {base = 0, gold = 0},
        },
        pendingChestGrants = 0,
        eggs = {},
        recentOperations = {},
        lastCheckpoint = {
            committedAt = 0,
            lastSettledRunId = nil,
        },
    }
end

local function isValidProfile(profile: any): boolean
    if typeof(profile) ~= "table" then return false end
    if profile.schemaVersion ~= Config.ProfileSchemaVersion then return false end
    if typeof(profile.revision) ~= "number" or profile.revision &lt; 0 then return false end
    if typeof(profile.collection) ~= "table" then return false end
    if typeof(profile.recentOperations) ~= "table" then return false end
    if typeof(profile.eggs) ~= "table" then return false end
    if typeof(profile.pendingChestGrants) ~= "number"
        or profile.pendingChestGrants &lt; 0 or profile.pendingChestGrants % 1 ~= 0 then
        return false
    end
    if not knownSpecies(profile.equippedSpeciesId) then return false end
    for _, speciesId in Config.SpeciesOrder do
        local entry = profile.collection[speciesId]
        if typeof(entry) ~= "table"
            or typeof(entry.base) ~= "number" or entry.base &lt; 0 or entry.base % 1 ~= 0
            or typeof(entry.gold) ~= "number" or entry.gold &lt; 0 or entry.gold % 1 ~= 0 then
            return false
        end
    end
    return true
end

local function retry(label: string, fn)
    local lastError = nil
    for attempt = 1, Config.ProfileMaxAttempts do
        local ok, result = pcall(fn)
        if ok then
            return true, result
        end
        lastError = result
        warn(string.format("[Be Dino] %s attempt %d failed: %s", label, attempt, tostring(result)))
        if attempt &lt; Config.ProfileMaxAttempts then
            task.wait(0.5 * (2 ^ (attempt - 1)))
        end
    end
    return false, lastError
end

local function syncAttributes(player: Player, profile: any)
    local collection = profile.collection
    player:SetAttribute("CompyCopies", collection.compy.base)
    player:SetAttribute("CompyGold", collection.compy.gold)
    player:SetAttribute("TriceratopsCopies", collection.triceratops.base)
    player:SetAttribute("TriceratopsGold", collection.triceratops.gold)
    player:SetAttribute("TyrannosaurusCopies", collection.tyrannosaurus.base)
    player:SetAttribute("TyrannosaurusGold", collection.tyrannosaurus.gold)
    player:SetAttribute("PendingChestGrants", profile.pendingChestGrants or 0)
    player:SetAttribute("ProfileRevision", profile.revision or 0)
    player:SetAttribute("EquippedSpeciesId", profile.equippedSpeciesId)
    player:SetAttribute("ActiveChestCount", #profile.eggs)
    local chestSummary = {}
    for index, chest in profile.eggs do
        if index &gt; Config.ChestQueueCapacity then break end
        table.insert(chestSummary, {
            id = chest.eggId,
            readyAt = chest.readyAt,
        })
    end
    player:SetAttribute("ChestQueueJson", HttpService:JSONEncode(chestSummary))
    local nextChest = profile.eggs[1]
    if typeof(nextChest) == "table" then
        player:SetAttribute("NextChestId", nextChest.eggId)
        player:SetAttribute("NextChestReadyAt", nextChest.readyAt)
    else
        player:SetAttribute("NextChestId", "")
        player:SetAttribute("NextChestReadyAt", 0)
    end
end

local function ownSession(profile: any): boolean
    local session = profile.session
    return typeof(session) == "table" and session.leaseId == leaseId
end

local function findOperation(profile: any, operationId: string)
    for _, entry in profile.recentOperations do
        if entry.id == operationId then
            return entry
        end
    end
    return nil
end

local function trimOperations(profile: any)
    while #profile.recentOperations &gt; Config.ProfileMaxRecentOperations do
        table.remove(profile.recentOperations, 1)
    end
end

local function lastChestReadyAt(profile: any, now: number): number
    local result = now
    for _, chest in profile.eggs do
        if typeof(chest) == "table" and typeof(chest.readyAt) == "number" then
            result = math.max(result, chest.readyAt)
        end
    end
    return result
end

local function availableChestCapacity(profile: any): number
    return (Config.ChestQueueCapacity - #profile.eggs)
        + (Config.ChestOverflowCapacity - profile.pendingChestGrants)
end

local function enqueueChestIds(profile: any, chestIds: {string}, now: number)
    local nextReadyAt = lastChestReadyAt(profile, now)
    for _, chestId in chestIds do
        if #profile.eggs &lt; Config.ChestQueueCapacity then
            nextReadyAt += Config.ChestTimerSeconds
            table.insert(profile.eggs, {
                eggId = chestId,
                kind = "alpha_chest",
                readyAt = nextReadyAt,
            })
        else
            profile.pendingChestGrants += 1
        end
    end
end

function ProfileRepository.isLoaded(player: Player): boolean
    return profiles[player] ~= nil and player:GetAttribute("ProfileState") == "Loaded"
end

function ProfileRepository.load(player: Player): boolean
    if profiles[player] then return true end
    player:SetAttribute("ProfileMode", if localPreview then "Studio preview (not saved)" else "Persistent")
    player:SetAttribute("ProfileState", "Loading")

    local blockedByLease = false
    local invalidSchema = false
    local now = os.time()

    local ok, updated = retry("profile load", function()
        return store:UpdateAsync(keyFor(player), function(current)
            local profileValue = current
            if profileValue == nil then
                profileValue = defaultProfile()
            end
            if not isValidProfile(profileValue) then
                invalidSchema = true
                return nil
            end

            local session = profileValue.session
            if typeof(session) == "table"
                and session.leaseId ~= leaseId
                and typeof(session.expiresAt) == "number"
                and session.expiresAt &gt; now then
                blockedByLease = true
                return nil
            end

            profileValue.session = {
                leaseId = leaseId,
                jobId = game.JobId,
                expiresAt = now + Config.ProfileLeaseSeconds,
            }
            profileValue.revision += 1
            return profileValue
        end)
    end)

    if not ok or updated == nil or blockedByLease or invalidSchema then
        if blockedByLease then
            player:SetAttribute("ProfileState", "SessionBusy")
        elseif invalidSchema then
            player:SetAttribute("ProfileState", "SchemaError")
        else
            player:SetAttribute("ProfileState", "LoadFailed")
        end
        return false
    end

    profiles[player] = updated
    player:SetAttribute("ProfileState", "Loaded")
    syncAttributes(player, updated)
    return true
end

function ProfileRepository.commitRunSettlement(player: Player, runId: string, catchScore: number)
    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, nil, "profile_not_loaded"
    end
    if typeof(runId) ~= "string" or #runId &lt; 1 or #runId &gt; 80 then
        return false, nil, "invalid_run_id"
    end

    local outcome = RewardMath.computeRunReward(catchScore)
    local operationId = "run:" .. runId
    local chestIds = {}
    for _ = 1, outcome.chestCount do
        table.insert(chestIds, HttpService:GenerateGUID(false))
    end
    outcome.chestIds = chestIds
    local leaseLost = false
    local queueFull = false
    local duplicateOutcome = nil
    local now = os.time()

    local ok, updated = retry("run settlement", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end

            local existing = findOperation(profileValue, operationId)
            if existing then
                duplicateOutcome = existing.outcome
                return profileValue
            end

            if outcome.chestCount &gt; availableChestCapacity(profileValue) then
                queueFull = true
                return nil
            end

            for _, stack in outcome.stacks do
                local species = profileValue.collection[stack.speciesId]
                if typeof(species) ~= "table" or typeof(species.base) ~= "number" then
                    return nil
                end
                species.base += stack.count
            end

            enqueueChestIds(profileValue, chestIds, now)
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            profileValue.lastCheckpoint = {
                committedAt = now,
                lastSettledRunId = runId,
            }
            table.insert(profileValue.recentOperations, {
                id = operationId,
                kind = "run",
                outcome = outcome,
            })
            trimOperations(profileValue)
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, nil, "lease_lost"
        end
        if queueFull then
            player:SetAttribute("LastChestClaimStatus", "queue_full")
            return false, nil, "queue_full"
        end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, nil, "save_failed"
    end

    profiles[player] = updated
    syncAttributes(player, updated)
    local committedOutcome = duplicateOutcome or outcome
    local summaryParts = {}
    for _, stack in committedOutcome.stacks do
        table.insert(summaryParts, string.format("%dx %s", stack.count, stack.speciesId))
    end
    if #summaryParts == 0 then table.insert(summaryParts, "no dinosaur copies") end
    if committedOutcome.chestCount &gt; 0 then
        table.insert(summaryParts, string.format("%d chest(s)", committedOutcome.chestCount))
    end
    player:SetAttribute("LastRewardText", table.concat(summaryParts, " | "))
    return true, committedOutcome, if duplicateOutcome then "duplicate" else "committed"
end

function ProfileRepository.equipSpecies(player: Player, speciesId: string): (boolean, string)
    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, "profile_not_loaded"
    end
    if typeof(speciesId) ~= "string" or #speciesId &lt; 1 or #speciesId &gt; 32 then
        return false, "invalid_species"
    end
    if not knownSpecies(speciesId) then return false, "unknown_species" end

    local cachedEntry = cached.collection[speciesId]
    if typeof(cachedEntry) ~= "table" or cachedEntry.base + cachedEntry.gold &lt;= 0 then
        return false, "locked"
    end
    if cached.equippedSpeciesId == speciesId then
        syncAttributes(player, cached)
        return true, "already_equipped"
    end

    local leaseLost = false
    local locked = false
    local now = os.time()
    local ok, updated = retry("equip species", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end
            local entry = profileValue.collection[speciesId]
            if typeof(entry) ~= "table" or entry.base + entry.gold &lt;= 0 then
                locked = true
                return nil
            end
            profileValue.equippedSpeciesId = speciesId
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, "lease_lost"
        end
        if locked then return false, "locked" end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, "save_failed"
    end

    profiles[player] = updated
    syncAttributes(player, updated)
    return true, "equipped"
end

function ProfileRepository.grantCollectionTestSpecies(player: Player): (boolean, string)
    if not Config.CollectionTestGrantEnabled then return false, "disabled" end
    local speciesId = Config.CollectionTestGrantSpeciesId
    if not knownSpecies(speciesId) then return false, "bad_config" end

    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, "profile_not_loaded"
    end

    local operationId = string.format("test-grant:v%d:%s", Config.CollectionTestGrantVersion, speciesId)
    local duplicate = false
    local leaseLost = false
    local now = os.time()

    local ok, updated = retry("collection test grant", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end
            if findOperation(profileValue, operationId) then
                duplicate = true
                return profileValue
            end

            profileValue.collection[speciesId].base += 1
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            table.insert(profileValue.recentOperations, {
                id = operationId,
                kind = "collection_test_grant",
                outcome = {speciesId = speciesId, count = 1},
            })
            trimOperations(profileValue)
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, "lease_lost"
        end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, "save_failed"
    end

    profiles[player] = updated
    syncAttributes(player, updated)
    return true, if duplicate then "duplicate" else "granted"
end

function ProfileRepository.grantChestTest(player: Player): (boolean, string)
    if not Config.ChestTestGrantEnabled then return false, "disabled" end
    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, "profile_not_loaded"
    end

    local operationId = string.format("test-chests:v%d", Config.ChestTestGrantVersion)
    local chestIds = {}
    for _ = 1, Config.ChestTestGrantCount do
        table.insert(chestIds, HttpService:GenerateGUID(false))
    end
    local duplicate = false
    local queueFull = false
    local leaseLost = false
    local now = os.time()

    local ok, updated = retry("chest test grant", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end
            if findOperation(profileValue, operationId) then
                duplicate = true
                return profileValue
            end
            if #chestIds &gt; availableChestCapacity(profileValue) then
                queueFull = true
                return nil
            end

            enqueueChestIds(profileValue, chestIds, now)
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            table.insert(profileValue.recentOperations, {
                id = operationId,
                kind = "chest_test_grant",
                outcome = {count = #chestIds},
            })
            trimOperations(profileValue)
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, "lease_lost"
        end
        if queueFull then return false, "queue_full" end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, "save_failed"
    end

    profiles[player] = updated
    syncAttributes(player, updated)
    return true, if duplicate then "duplicate" else "granted"
end

function ProfileRepository.claimChest(player: Player, chestId: string)
    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, nil, "profile_not_loaded"
    end
    if typeof(chestId) ~= "string" or #chestId &lt; 1 or #chestId &gt; 80 then
        return false, nil, "invalid_chest_id"
    end

    local operationId = "chest:" .. chestId
    local cachedOperation = findOperation(cached, operationId)
    if cachedOperation then
        return true, cachedOperation.outcome, "duplicate"
    end

    local cachedChest = nil
    for _, chest in cached.eggs do
        if chest.eggId == chestId then
            cachedChest = chest
            break
        end
    end
    if not cachedChest then return false, nil, "missing" end

    local now = os.time()
    if now &lt; cachedChest.readyAt then return false, nil, "not_ready" end

    -- Generate once outside UpdateAsync so retries cannot reroll the reward.
    local outcome = RewardMath.computeChestReward(Random.new())
    local refillChestId = HttpService:GenerateGUID(false)
    local duplicateOutcome = nil
    local leaseLost = false
    local notReady = false
    local missing = false

    local ok, updated = retry("chest claim", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end

            local existing = findOperation(profileValue, operationId)
            if existing then
                duplicateOutcome = existing.outcome
                return profileValue
            end

            local index = nil
            local chest = nil
            for i, candidate in profileValue.eggs do
                if candidate.eggId == chestId then
                    index = i
                    chest = candidate
                    break
                end
            end
            if not index or not chest then
                missing = true
                return nil
            end
            if now &lt; chest.readyAt then
                notReady = true
                return nil
            end

            table.remove(profileValue.eggs, index)
            local species = profileValue.collection[outcome.speciesId]
            if typeof(species) ~= "table" then return nil end
            species.base += outcome.count

            if profileValue.pendingChestGrants &gt; 0 then
                profileValue.pendingChestGrants -= 1
                local readyAt = lastChestReadyAt(profileValue, now) + Config.ChestTimerSeconds
                table.insert(profileValue.eggs, {
                    eggId = refillChestId,
                    kind = "alpha_chest",
                    readyAt = readyAt,
                })
            end

            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            table.insert(profileValue.recentOperations, {
                id = operationId,
                kind = "chest_claim",
                outcome = outcome,
            })
            trimOperations(profileValue)
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, nil, "lease_lost"
        end
        if notReady then return false, nil, "not_ready" end
        if missing then return false, nil, "missing" end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, nil, "save_failed"
    end

    profiles[player] = updated
    syncAttributes(player, updated)
    local committedOutcome = duplicateOutcome or outcome
    player:SetAttribute("LastClaimedChestId", chestId)
    player:SetAttribute("LastChestRewardText", string.format(
        "%dx %s", committedOutcome.count, committedOutcome.speciesId
    ))
    return true, committedOutcome, if duplicateOutcome then "duplicate" else "claimed"
end

function ProfileRepository.mutateSpecies(player: Player, speciesId: string, targetMutation: string, requestToken: string)
    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, nil, "profile_not_loaded"
    end
    if not knownSpecies(speciesId) then return false, nil, "unknown_species" end
    if targetMutation ~= "gold" then return false, nil, "unknown_mutation" end
    if typeof(requestToken) ~= "string" or #requestToken &lt; 1 or #requestToken &gt; 80 then
        return false, nil, "invalid_token"
    end

    local operationId = "mutation:" .. requestToken
    local cachedOperation = findOperation(cached, operationId)
    if cachedOperation then
        return true, cachedOperation.outcome, "duplicate"
    end

    local cachedEntry = cached.collection[speciesId]
    if typeof(cachedEntry) ~= "table" or cachedEntry.base &lt; Config.GoldMutationCost then
        return false, nil, "insufficient_copies"
    end

    local outcome = {
        speciesId = speciesId,
        mutationId = "gold",
        spentBase = Config.GoldMutationCost,
        gainedGold = 1,
    }
    local duplicateOutcome = nil
    local leaseLost = false
    local insufficient = false
    local now = os.time()

    local ok, updated = retry("gold mutation", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end

            local existing = findOperation(profileValue, operationId)
            if existing then
                duplicateOutcome = existing.outcome
                return profileValue
            end

            local entry = profileValue.collection[speciesId]
            if typeof(entry) ~= "table" or entry.base &lt; Config.GoldMutationCost then
                insufficient = true
                return nil
            end

            entry.base -= Config.GoldMutationCost
            entry.gold += 1
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            table.insert(profileValue.recentOperations, {
                id = operationId,
                kind = "mutation",
                outcome = outcome,
            })
            trimOperations(profileValue)
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, nil, "lease_lost"
        end
        if insufficient then return false, nil, "insufficient_copies" end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, nil, "save_failed"
    end

    profiles[player] = updated
    syncAttributes(player, updated)
    local committedOutcome = duplicateOutcome or outcome
    return true, committedOutcome, if duplicateOutcome then "duplicate" else "mutated"
end

function ProfileRepository.setMutationTestCopies(player: Player, speciesId: string, baseCount: number): (boolean, string)
    if not Config.MutationTestSetupEnabled then return false, "disabled" end
    if speciesId ~= Config.MutationTestSpeciesId then return false, "bad_species" end
    if baseCount ~= 49 and baseCount ~= 50 and baseCount ~= 51 then
        return false, "bad_count"
    end

    local cached = profiles[player]
    if not cached or player:GetAttribute("ProfileState") ~= "Loaded" then
        return false, "profile_not_loaded"
    end

    local leaseLost = false
    local now = os.time()
    local ok, updated = retry("mutation test setup", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) then return nil end
            if not ownSession(profileValue) then
                leaseLost = true
                return nil
            end
            local entry = profileValue.collection[speciesId]
            if typeof(entry) ~= "table" then return nil end
            entry.base = baseCount
            entry.gold = 0
            profileValue.revision += 1
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            return profileValue
        end)
    end)

    if not ok or updated == nil then
        if leaseLost then
            player:SetAttribute("ProfileState", "LeaseLost")
            return false, "lease_lost"
        end
        player:SetAttribute("ProfileState", "SaveFailed")
        return false, "save_failed"
    end

    profiles[player] = updated
    syncAttributes(player, updated)
    return true, "set_" .. tostring(baseCount)
end

function ProfileRepository.renew(player: Player): boolean
    if not profiles[player] or player:GetAttribute("ProfileState") ~= "Loaded" then return false end
    local leaseLost = false
    local now = os.time()
    local ok, updated = retry("lease renew", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) or not ownSession(profileValue) then
                leaseLost = true
                return nil
            end
            profileValue.session.expiresAt = now + Config.ProfileLeaseSeconds
            return profileValue
        end)
    end)
    if not ok or updated == nil then
        player:SetAttribute("ProfileState", if leaseLost then "LeaseLost" else "SaveFailed")
        return false
    end
    profiles[player] = updated
    return true
end

function ProfileRepository.release(player: Player)
    local cached = profiles[player]
    profiles[player] = nil
    if not cached then return end

    retry("lease release", function()
        return store:UpdateAsync(keyFor(player), function(profileValue)
            if not isValidProfile(profileValue) or not ownSession(profileValue) then return nil end
            profileValue.session = nil
            return profileValue
        end)
    end)
end

function ProfileRepository.start()
    if renewing then return end
    renewing = true
    task.spawn(function()
        while renewing do
            task.wait(Config.ProfileRenewSeconds)
            for player in profiles do
                if player.Parent then task.spawn(ProfileRepository.renew, player) end
            end
        end
    end)
end

return ProfileRepository
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX32">
        <Properties>
          <string name="Name">RewardMath</string>
          <ProtectedString name="Source">--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local RewardMath = {}

local function validateScore(catchScore: number)
    if catchScore ~= catchScore or catchScore == math.huge or catchScore == -math.huge then
        error("catchScore must be finite")
    end
    if catchScore % 1 ~= 0 or catchScore &lt; 0 or catchScore &gt; Config.MaxCatchScore then
        error("catchScore outside supported integer range")
    end
end

local function eligibleTierCount(catchScore: number): number
    local count = 0
    for _, threshold in Config.AlphaTierThresholds do
        if catchScore &gt;= threshold then
            count += 1
        end
    end
    return count
end

function RewardMath.allocateTiers(catchScore: number): {number}
    validateScore(catchScore)
    local tierCount = eligibleTierCount(catchScore)
    if catchScore == 0 or tierCount == 0 then
        return {}
    end

    local allocated = table.create(tierCount, 0)
    local weights = table.create(tierCount, 0)
    for tier = 1, tierCount do
        weights[tier] = Config.RarityQ ^ (tier - 1)
    end

    for _ = 1, catchScore do
        local bestTier = 1
        local bestValue = -math.huge
        for tier = 1, tierCount do
            local value = weights[tier] / (allocated[tier] + 1)
            if value &gt; bestValue then
                bestValue = value
                bestTier = tier
            end
        end
        allocated[bestTier] += 1
    end

    return allocated
end

function RewardMath.earnedChests(catchScore: number): number
    validateScore(catchScore)
    local result = 0
    for _, row in Config.ChestThresholds do
        if catchScore &gt;= row.score then
            result = row.count
        end
    end
    return result
end

function RewardMath.computeRunReward(catchScore: number)
    local tierCounts = RewardMath.allocateTiers(catchScore)
    local stacks = {}
    for tier, count in tierCounts do
        if count &gt; 0 then
            table.insert(stacks, {
                speciesId = Config.AlphaSpeciesByTier[tier],
                mutationId = "base",
                count = count,
            })
        end
    end
    return {
        rewardConfigVersion = 1,
        catchScore = catchScore,
        stacks = stacks,
        chestCount = RewardMath.earnedChests(catchScore),
    }
end

local function weightedChoice(rows, rng: Random)
    local total = 0
    for _, row in rows do total += row.weight end
    local roll = rng:NextNumber(0, total)
    local cumulative = 0
    for _, row in rows do
        cumulative += row.weight
        if roll &lt;= cumulative then return row end
    end
    return rows[#rows]
end

function RewardMath.computeChestReward(rng: Random?)
    local random = rng or Random.new()
    local speciesRow = weightedChoice(Config.ChestSpeciesWeights, random)
    local quantityRow = weightedChoice(Config.ChestQuantityWeights, random)
    return {
        rewardConfigVersion = 1,
        speciesId = speciesRow.speciesId,
        mutationId = "base",
        count = quantityRow.count,
    }
end

return RewardMath
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX33">
        <Properties>
          <string name="Name">RunLifecycle</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Config = require(ReplicatedStorage.Shared.Config)

local RunLifecycle = {}
local lastExitRequest: {[Player]: number} = {}
local requestEndRun: RemoteEvent? = nil
local settleRun = nil

local function activeCharacter(player: Player): Model?
    local character = player.Character
    if not character or character:GetAttribute("RunState") ~= "Active" then return nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health &lt;= 0 then return nil end
    return character
end

function RunLifecycle.configureSettlement(callback)
    settleRun = callback
end

function RunLifecycle.begin(player: Player, character: Model)
    if player:GetAttribute("ProfileState") ~= "Loaded" then return end
    if character:GetAttribute("RunId") ~= nil then return end
    character:SetAttribute("RunId", HttpService:GenerateGUID(false))
    character:SetAttribute("RunState", "Active")
    character:SetAttribute("GrowthScore", 0)
    character:SetAttribute("CatchScore", 0)
    character:SetAttribute("SpawnProtectionEndsAt", workspace:GetServerTimeNow() + Config.SpawnProtectionSeconds)
    character:SetAttribute("ExitChannelEndsAt", 0)

    task.spawn(function()
        local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
        if not humanoid or player.Character ~= character then return end
        humanoid.Died:Connect(function()
            RunLifecycle.tryEnd(player, character, "Death")
        end)
    end)
end

function RunLifecycle.isActive(character: Model): boolean
    return character:GetAttribute("RunState") == "Active"
end

function RunLifecycle.isProtected(character: Model, now: number?): boolean
    local raw = character:GetAttribute("SpawnProtectionEndsAt")
    local endsAt = if typeof(raw) == "number" then raw else 0
    return endsAt &gt; (now or workspace:GetServerTimeNow())
end

local function settlementSnapshot(character: Model)
    local runId = character:GetAttribute("RunId")
    local catchScore = character:GetAttribute("CatchScore")
    if typeof(runId) ~= "string" then return nil end
    if typeof(catchScore) ~= "number" or catchScore % 1 ~= 0 then return nil end
    return {
        runId = runId,
        catchScore = math.clamp(catchScore, 0, Config.MaxCatchScore),
    }
end

local function respawnAfterSettlement(player: Player, character: Model, snapshot, reason: string)
    task.spawn(function()
        local ok = true
        if settleRun then
            ok = settleRun(player, snapshot.runId, snapshot.catchScore, reason)
        end
        if not ok then
            if player.Parent and player:GetAttribute("ProfileState") == "Loaded" then
                player:SetAttribute("ProfileState", "SaveFailed")
            end
            return
        end

        character:SetAttribute("RunState", "Settled")
        if not player.Parent then return end
        task.wait(Config.RespawnDelaySeconds)
        if player.Parent and player:GetAttribute("ProfileState") == "Loaded" then
            local loaded, err = pcall(function()
                player:LoadCharacterAsync()
            end)
            if not loaded then
                warn("[Be Dino] respawn failed: " .. tostring(err))
            end
        end
    end)
end

function RunLifecycle.tryEnd(player: Player, character: Model, reason: string, sourceUserId: number?): boolean
    if player.Character ~= character or character:GetAttribute("RunState") ~= "Active" then
        return false
    end
    local snapshot = settlementSnapshot(character)
    if not snapshot then
        return false
    end

    character:SetAttribute("RunState", "Ending")
    character:SetAttribute("ExitChannelEndsAt", 0)
    player:SetAttribute("LastRunEndReason", reason)
    player:SetAttribute("LastRunCatchScore", snapshot.catchScore)
    local growthScore = character:GetAttribute("GrowthScore")
    player:SetAttribute("LastRunGrowthScore", if typeof(growthScore) == "number" then growthScore else 0)
    player:SetAttribute("LastRunId", snapshot.runId)
    player:SetAttribute("LastRunEndAt", workspace:GetServerTimeNow())
    player:SetAttribute("LastPredatorUserId", sourceUserId or 0)

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health &gt; 0 then
        humanoid.Health = 0
    end

    respawnAfterSettlement(player, character, snapshot, reason)
    return true
end

function RunLifecycle.endForDisconnect(player: Player): string
    local character = player.Character
    if not character then return "none" end
    if character:GetAttribute("RunState") == "Ending" then
        return "busy"
    end
    if character:GetAttribute("RunState") ~= "Active" then
        return "none"
    end
    local snapshot = settlementSnapshot(character)
    if not snapshot then return "none" end

    character:SetAttribute("RunState", "Ending")
    character:SetAttribute("ExitChannelEndsAt", 0)
    player:SetAttribute("LastRunEndReason", "Disconnect")
    player:SetAttribute("LastRunCatchScore", snapshot.catchScore)
    local growthScore = character:GetAttribute("GrowthScore")
    player:SetAttribute("LastRunGrowthScore", if typeof(growthScore) == "number" then growthScore else 0)
    if settleRun then
        local ok = settleRun(player, snapshot.runId, snapshot.catchScore, "Disconnect")
        return if ok then "settled" else "failed"
    end
    return "settled"
end

local function cancelExit(character: Model)
    if character:GetAttribute("RunState") == "Active" then
        character:SetAttribute("ExitChannelEndsAt", 0)
    end
end

local function startExitChannel(player: Player, character: Model)
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root or not root:IsA("BasePart") then return end
    local currentEnd = character:GetAttribute("ExitChannelEndsAt")
    if typeof(currentEnd) == "number" and currentEnd &gt; workspace:GetServerTimeNow() then return end

    local origin = root.Position
    character:SetAttribute("ExitChannelEndsAt", workspace:GetServerTimeNow() + Config.ExitChannelSeconds)
    task.spawn(function()
        local deadline = os.clock() + Config.ExitChannelSeconds
        while os.clock() &lt; deadline do
            task.wait(0.1)
            if player.Character ~= character or character:GetAttribute("RunState") ~= "Active" then
                return
            end
            local currentRoot = character:FindFirstChild("HumanoidRootPart")
            if not currentRoot or not currentRoot:IsA("BasePart") then
                cancelExit(character)
                return
            end
            if (currentRoot.Position - origin).Magnitude &gt; Config.ExitMoveCancelDistance then
                cancelExit(character)
                return
            end
        end
        RunLifecycle.tryEnd(player, character, "ManualExit")
    end)
end

function RunLifecycle.start()
    local folder = ReplicatedStorage:FindFirstChild("BeDinoRemotes")
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "BeDinoRemotes"
        folder.Parent = ReplicatedStorage
    end

    local existing = folder:FindFirstChild("RequestEndRun")
    if existing and existing:IsA("RemoteEvent") then
        requestEndRun = existing
    else
        if existing then existing:Destroy() end
        local remote = Instance.new("RemoteEvent")
        remote.Name = "RequestEndRun"
        remote.Parent = folder
        requestEndRun = remote
    end

    local remote = requestEndRun :: RemoteEvent
    remote.OnServerEvent:Connect(function(player: Player, ...)
        if select("#", ...) ~= 0 then return end
        if player:GetAttribute("ProfileState") ~= "Loaded" then return end
        local now = os.clock()
        local last = lastExitRequest[player] or -math.huge
        if now - last &lt; Config.ExitRequestCooldownSeconds then return end
        lastExitRequest[player] = now
        local character = activeCharacter(player)
        if not character then return end
        startExitChannel(player, character)
    end)

    Players.PlayerRemoving:Connect(function(player)
        lastExitRequest[player] = nil
    end)
end

return RunLifecycle
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX34">
        <Properties>
          <string name="Name">VisualTestService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local VisualTestService = {}
local lastRequest: {[Player]: number} = {}

local function validSpecies(speciesId: any): boolean
    if typeof(speciesId) ~= "string" then return false end
    for _, id in Config.SpeciesOrder do
        if id == speciesId then return true end
    end
    return false
end

function VisualTestService.start(dinosaur)
    if not Config.ArtTestHarnessEnabled then return end

    local folder = ReplicatedStorage:FindFirstChild("BeDinoRemotes") :: Folder?
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "BeDinoRemotes"
        folder.Parent = ReplicatedStorage
    end

    local preview = Instance.new("RemoteEvent")
    preview.Name = "PreviewDinosaurArt"
    preview.Parent = folder

    preview.OnServerEvent:Connect(function(player: Player, speciesId, gold, restore, ...)
        if select("#", ...) ~= 0 then return end
        if typeof(restore) ~= "boolean" then return end

        local now = os.clock()
        local last = lastRequest[player] or -math.huge
        if now - last &lt; Config.ArtPreviewRequestCooldownSeconds then return end
        lastRequest[player] = now

        local character = player.Character
        if not character or not character:GetAttribute("DinoAttached")
            or character:GetAttribute("RunState") ~= "Active" then
            return
        end

        if restore then
            dinosaur.refreshForPlayer(character, player)
            player:SetAttribute("ArtPreviewStatus", "SAVED EQUIP")
            return
        end
        if not validSpecies(speciesId) or typeof(gold) ~= "boolean" then return end

        dinosaur.setSpecies(character, speciesId, gold)
        player:SetAttribute("ArtPreviewStatus",
            (if gold then "GOLD " else "") .. string.upper(speciesId))
    end)

    Players.PlayerRemoving:Connect(function(player)
        lastRequest[player] = nil
    end)
end

return VisualTestService
