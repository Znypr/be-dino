          <ProtectedString name="Source">--!strict
-- Movement spike only. None of these values are final economy tuning.
return table.freeze({
    Build = "movement-spike-003",
    WalkSpeed = 18,
    ArenaHalfWidth = 90,
    CameraMinZoom = 12,
    CameraMaxZoom = 80,
    TestScales = {1, 2, 4},
})
