      <Item class="ModuleScript" referent="RBX7">
        <Properties>
          <string name="Name">Arena</string>
          <ProtectedString name="Source">--!strict
local Arena = {}

local function block(parent: Instance, name: string, size: Vector3, position: Vector3, color: Color3): Part
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.Position = position
    part.Color = color
    part.Material = Enum.Material.SmoothPlastic
    part.Anchored = true
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = parent
    return part
end

function Arena.build()
    local world = Instance.new("Folder")
    world.Name = "BeDinoArena"
    world.Parent = workspace
    block(world, "Ground", Vector3.new(180, 4, 180), Vector3.new(0, -2, 0), Color3.fromRGB(111, 151, 93))
    for _, x in {-92, 92} do
        block(world, "Boundary", Vector3.new(4, 20, 188), Vector3.new(x, 8, 0), Color3.fromRGB(94, 113, 82))
    end
    for _, z in {-92, 92} do
        block(world, "Boundary", Vector3.new(180, 20, 4), Vector3.new(0, 8, z), Color3.fromRGB(94, 113, 82))
    end
    local spawn = Instance.new("SpawnLocation")
    spawn.Name = "PrototypeSpawn"
    spawn.Size = Vector3.new(14, 1, 14)
    spawn.Position = Vector3.new(0, 0.5, 30)
    spawn.Anchored = true
    spawn.Neutral = true
    spawn.Duration = 0
    spawn.Color = Color3.fromRGB(236, 220, 169)
    spawn.Parent = world

    -- A lane with varying obstacle widths for the fixed-collider experiment.
    for i = 1, 5 do
        block(world, "Rock", Vector3.new(4 + i, 2 + i, 6),
            Vector3.new(-50 + i * 17, (2 + i) / 2, -30), Color3.fromRGB(126, 128, 115))
    end
    local ramp = block(world, "SlopeTest", Vector3.new(16, 2, 24), Vector3.new(-48, 3, 10), Color3.fromRGB(178, 157, 120))
    ramp.CFrame = CFrame.new(-48, 3, 10) * CFrame.Angles(math.rad(12), 0, 0)


end

return Arena
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX8">
        <Properties>
          <string name="Name">Bootstrap</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Arena = require(script.Parent.Arena)
local Dinosaur = require(script.Parent.Dinosaur)
local RunLifecycle = require(script.Parent.RunLifecycle)

Lighting.ClockTime = 14
Lighting.Brightness = 2
Lighting.Ambient = Color3.fromRGB(130, 143, 148)
-- Keep the place's default destroy height; this setting is protected at runtime.
Arena.build()
RunLifecycle.start()

local function setup(player: Player)
    player.CanLoadCharacterAppearance = false
    player.CharacterAdded:Connect(function(character)
        RunLifecycle.begin(player, character)
        task.spawn(Dinosaur.attach, character, Config.WalkSpeed, player)
    end)
    if player.Character then
        RunLifecycle.begin(player, player.Character)
        task.spawn(Dinosaur.attach, player.Character, Config.WalkSpeed, player)
    end
end
Players.PlayerAdded:Connect(setup)
for _, player in Players:GetPlayers() do setup(player) end

local FoodService = require(script.Parent.FoodService)
FoodService.start(Dinosaur)
local PredationService = require(script.Parent.PredationService)
PredationService.start(RunLifecycle, Dinosaur)
print("[Be Dino] " .. Config.Build .. " ready. PvP/run-ending test; no progression saves.")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX9">
        <Properties>
          <string name="Name">Dinosaur</string>
          <ProtectedString name="Source">--!strict
-- Cosmetic shell over Roblox's standard controller. Collider does NOT scale.
local Dinosaur = {}
local RunService = game:GetService("RunService")
local GREEN = Color3.fromRGB(100, 178, 117)
local LIGHT = Color3.fromRGB(201, 221, 154)
local DARK = Color3.fromRGB(63, 112, 80)

local function scaleForScore(score: number): number
    return math.min(4, math.sqrt(1 + math.max(0, score) / 50))
end

function Dinosaur.render(character: Model, scale: number)
    local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return end
    local old = character:FindFirstChild("DinoVisual")
    if old then old:Destroy() end
    local visual = Instance.new("Model")
    visual.Name = "DinoVisual"
    visual.Parent = character

    -- Match cosmetic feet to the standard R6/R15 ground height.
    local groundHeight = root.Size.Y / 2 + humanoid.HipHeight
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        local leg = character:FindFirstChild("Left Leg") :: BasePart?
        groundHeight += if leg then leg.Size.Y else 2
    end
    local shift = Vector3.new(0, 3 * scale - groundHeight, 0)
    local function piece(name: string, size: Vector3, position: Vector3, color: Color3, tilt: number?)
        local part = Instance.new("Part")
        part.Name = name
        part.Size = size * scale
        part.Color = color
        part.Material = Enum.Material.SmoothPlastic
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.Massless = true
        part.CastShadow = true
        local offset = CFrame.new(position * scale + shift) * CFrame.Angles(tilt or 0, 0, 0)
        part.CFrame = root.CFrame * offset
        part.Parent = visual
        local weld = Instance.new("Weld")
        weld.Name = "VisualWeld"
        weld.Part0 = root
        weld.Part1 = part
        weld.C0 = offset
        weld.Parent = part
    end
    piece("Body", Vector3.new(2.4, 1.8, 3.2), Vector3.new(0, -0.8, 0.2), GREEN)
    piece("Belly", Vector3.new(1.8, 0.35, 2.6), Vector3.new(0, -1.75, 0), LIGHT)
    piece("Head", Vector3.new(2.3, 1.65, 2.1), Vector3.new(0, 0.3, -1.7), GREEN)
    piece("Snout", Vector3.new(2.05, 0.75, 1.2), Vector3.new(0, -0.1, -3), LIGHT)
    piece("Tail", Vector3.new(1.25, 1.0, 2.6), Vector3.new(0, -0.65, 2.7), GREEN, math.rad(-12))
    piece("TailTip", Vector3.new(0.65, 0.65, 1.8), Vector3.new(0, -0.15, 4.55), DARK, math.rad(-18))
    for _, side in {-1, 1} do
        piece("Leg" .. side, Vector3.new(0.85, 1.4, 1.0), Vector3.new(side * 0.95, -2.1, 0.5), DARK)
        piece("Foot" .. side, Vector3.new(1.0, 0.4, 1.6), Vector3.new(side * 0.95, -2.8, 0.1), GREEN)
        piece("Arm" .. side, Vector3.new(0.5, 0.6, 1.05), Vector3.new(side * 1.3, -0.9, -1.1), GREEN)
        piece("Eye" .. side, Vector3.new(0.13, 0.6, 0.65), Vector3.new(side * 1.18, 0.65, -2), Color3.new(1, 1, 1))
        piece("Pupil" .. side, Vector3.new(0.15, 0.32, 0.3), Vector3.new(side * 1.25, 0.65, -2.12), Color3.fromRGB(25, 35, 31))
    end
    character:SetAttribute("VisualScale", scale)
end

function Dinosaur.addGrowth(character: Model, points: number)
    if points &lt;= 0 or character:GetAttribute("RunState") ~= "Active" then return end
    local current = character:GetAttribute("GrowthScore")
    local score = (if typeof(current) == "number" then current else 0) + points
    character:SetAttribute("GrowthScore", score)
    local scale = scaleForScore(score)
    if character:GetAttribute("VisualScale") ~= scale then
        Dinosaur.render(character, scale)
    end
end

function Dinosaur.attach(character: Model, walkSpeed: number, player: Player)
    -- CharacterAdded can arrive before the model is parented to Workspace.
    -- Do not silently abandon that spawn; also stop if a newer spawn replaces it.
    local deadline = os.clock() + 10
    while not character:IsDescendantOf(workspace) do
        if player.Character ~= character or not player.Parent then return end
        if os.clock() &gt;= deadline then
            warn("[Be Dino] Character never entered Workspace: " .. player.Name)
            return
        end
        RunService.Heartbeat:Wait()
    end
    local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
    local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
    if player.Character ~= character or not character:IsDescendantOf(workspace) then return end
    if not humanoid or not root then
        warn("[Be Dino] Missing Humanoid/root for " .. player.Name)
        return
    end
    if character:GetAttribute("DinoAttached") then return end
    local function hide(instance: Instance)
        if instance:FindFirstAncestor("DinoVisual") then return end
        if instance:IsA("BasePart") then instance.Transparency = 1 end
        if instance:IsA("Decal") then instance.Transparency = 1 end
    end
    for _, descendant in character:GetDescendants() do hide(descendant) end
    character.DescendantAdded:Connect(hide)
    humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    humanoid.WalkSpeed = walkSpeed
    humanoid.UseJumpPower = true
    humanoid.JumpPower = 0
    humanoid.AutoJumpEnabled = false
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
    Dinosaur.render(character, 1)
    character:SetAttribute("DinoAttached", true)
    print("[Be Dino] Dinosaur attached: " .. player.Name)
end

return Dinosaur
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX10">
        <Properties>
          <string name="Name">FoodService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local FoodService = {}

function FoodService.start(dinosaur)
    local folder = Instance.new("Folder")
    folder.Name = "Food"
    folder.Parent = workspace
    local foods = {}
    local groundParams = RaycastParams.new()
    groundParams.FilterType = Enum.RaycastFilterType.Include
    groundParams.FilterDescendantsInstances = {workspace.BeDinoArena}
    -- Fixed, bounded grid. Skip obstacles, spawn and slope instead of hiding food inside them.
    for x = -70, 70, 20 do
        for z = -70, 70, 20 do
            local hit = workspace:Raycast(Vector3.new(x, 30, z), Vector3.new(0, -40, 0), groundParams)
            if hit and hit.Instance.Name == "Ground" then
                local berry = Instance.new("Part")
                berry.Name = "Berry"
                berry.Shape = Enum.PartType.Ball
                berry.Size = Vector3.new(1.5, 1.5, 1.5)
                berry.Position = hit.Position + Vector3.new(0, 0.9, 0)
                berry.Color = Color3.fromRGB(255, 156, 65)
                berry.Material = Enum.Material.Neon
                berry.Anchored = true
                berry.CanCollide = false
                berry.CanTouch = false
                berry.CanQuery = false
                berry.Parent = folder
                table.insert(foods, {part = berry, readyAt = 0})
            end
        end
    end
    local previous = {}
    Players.PlayerRemoving:Connect(function(player) previous[player] = nil end)
    task.spawn(function()
        while true do
            task.wait(Config.FoodTickSeconds)
            local now = os.clock()
            local candidates = {}
            for _, player in Players:GetPlayers() do
                local character = player.Character
                local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
                local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
                if character and root and root:IsA("BasePart") and humanoid and humanoid.Health &gt; 0
                    and character:GetAttribute("DinoAttached") and character:GetAttribute("RunState") == "Active" then
                    local last = previous[player]
                    local position = root.Position
                    -- Basic teleport rejection, not a complete movement/anti-cheat system.
                    local plausible = last and last.character == character
                        and (position - last.position).Magnitude &lt;= Config.WalkSpeed * (now - last.time) * 2 + 2
                    previous[player] = {character = character, position = position, time = now}
                    if plausible then
                        table.insert(candidates, {player = player, character = character, root = root, gained = 0})
                    end
                else
                    previous[player] = nil
                end
            end
            for _, food in foods do
                if now &lt; food.readyAt then continue end
                food.part.Transparency = 0
                local winner = nil
                local nearest = math.huge
                for _, candidate in candidates do
                    local delta = food.part.Position - candidate.root.Position
                    local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
                    if horizontal &lt;= Config.FoodPickupRadius and math.abs(delta.Y) &lt; 6 then
                        -- Arena-only occlusion prevents eating through solid geometry.
                        local blocked = workspace:Raycast(candidate.root.Position, delta, groundParams)
                        if not blocked and (horizontal &lt; nearest or (horizontal == nearest and winner and candidate.player.UserId &lt; winner.player.UserId)) then
                            nearest = horizontal
                            winner = candidate
                        end
                    end
                end
                if winner then
                    -- No yield between claiming and awarding: one winner per berry.
                    food.readyAt = now + Config.FoodRespawnSeconds
                    food.part.Transparency = 1
                    winner.gained += Config.FoodPoints
                end
            end
            for _, candidate in candidates do
                if candidate.gained &gt; 0 then
                    dinosaur.addGrowth(candidate.character, candidate.gained)
                end
            end
        end
    end)
end

return FoodService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX11">
        <Properties>
          <string name="Name">PredationService</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local PredationService = {}

local function numberAttribute(instance: Instance, name: string, fallback: number): number
    local value = instance:GetAttribute(name)
    return if typeof(value) == "number" then value else fallback
end

local function canEat(attackerScore: number, targetScore: number): boolean
    return attackerScore &gt; targetScore and attackerScore &gt;= targetScore * Config.PredationScoreMultiplier
end

function PredationService.start(runLifecycle, dinosaur)
    local previous = {}
    local arenaParams = RaycastParams.new()
    arenaParams.FilterType = Enum.RaycastFilterType.Include
    arenaParams.FilterDescendantsInstances = {workspace.BeDinoArena}

    Players.PlayerRemoving:Connect(function(player)
        previous[player] = nil
    end)

    task.spawn(function()
        while true do
            task.wait(Config.PredationTickSeconds)
            local movementNow = os.clock()
            local serverNow = workspace:GetServerTimeNow()
            local candidates = {}

            for _, player in Players:GetPlayers() do
                local character = player.Character
                local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
                local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
                if character and root and root:IsA("BasePart") and humanoid and humanoid.Health &gt; 0
                    and character:GetAttribute("DinoAttached") and runLifecycle.isActive(character) then
                    local last = previous[player]
                    local position = root.Position
                    local plausible = last and last.character == character
                        and (position - last.position).Magnitude &lt;= Config.WalkSpeed * (movementNow - last.time) * 2 + 2
                    previous[player] = {character = character, position = position, time = movementNow}
                    if plausible then
                        table.insert(candidates, {
                            player = player,
                            character = character,
                            root = root,
                            score = numberAttribute(character, "GrowthScore", 0),
                            scale = numberAttribute(character, "VisualScale", 1),
                        })
                    end
                else
                    previous[player] = nil
                end
            end

            table.sort(candidates, function(a, b)
                return a.player.UserId &lt; b.player.UserId
            end)

            for _, victim in candidates do
                if not runLifecycle.isActive(victim.character) or runLifecycle.isProtected(victim.character, serverNow) then
                    continue
                end

                local winner = nil
                local nearest = math.huge
                for _, attacker in candidates do
                    if attacker.player == victim.player or not runLifecycle.isActive(attacker.character)
                        or runLifecycle.isProtected(attacker.character, serverNow) then
                        continue
                    end
                    if not canEat(attacker.score, victim.score) then continue end

                    local delta = victim.root.Position - attacker.root.Position
                    local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
                    local radius = math.min(Config.PredationMaxRadius,
                        Config.PredationBaseRadius + math.max(0, attacker.scale - 1) * 1.25)
                    if horizontal &gt; radius or math.abs(delta.Y) &gt; Config.PredationVerticalLimit then continue end

                    local blocked = workspace:Raycast(attacker.root.Position, delta, arenaParams)
                    if blocked then continue end

                    if horizontal &lt; nearest or (horizontal == nearest and winner and attacker.player.UserId &lt; winner.player.UserId) then
                        nearest = horizontal
                        winner = attacker
                    end
                end

                if winner and runLifecycle.tryEnd(victim.player, victim.character, "Eaten", winner.player.UserId) then
                    local catches = numberAttribute(winner.character, "CatchScore", 0)
                    winner.character:SetAttribute("CatchScore", catches + 1)
                    dinosaur.addGrowth(winner.character, Config.PredationGrowthPoints)
                end
            end
        end
    end)
end

return PredationService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX12">
        <Properties>
          <string name="Name">RewardMath</string>
          <ProtectedString name="Source">--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local RewardMath = {}

local function validateScore(catchScore: number)
    if catchScore ~= catchScore or catchScore == math.huge or catchScore == -math.huge then
        error("catchScore must be finite")
    end
    if catchScore % 1 ~= 0 or catchScore &lt; 0 or catchScore &gt; Config.MaxCatchScore then
        error("catchScore outside supported integer range")
    end
end

local function eligibleTierCount(catchScore: number): number
    local count = 0
    for _, threshold in Config.AlphaTierThresholds do
        if catchScore &gt;= threshold then
            count += 1
        end
    end
    return count
end

function RewardMath.allocateTiers(catchScore: number): {number}
    validateScore(catchScore)
    local tierCount = eligibleTierCount(catchScore)
    if catchScore == 0 or tierCount == 0 then
        return {}
    end

    local allocated = table.create(tierCount, 0)
    local weights = table.create(tierCount, 0)
    for tier = 1, tierCount do
        weights[tier] = Config.RarityQ ^ (tier - 1)
    end

    for _ = 1, catchScore do
        local bestTier = 1
        local bestValue = -math.huge
        for tier = 1, tierCount do
            local value = weights[tier] / (allocated[tier] + 1)
            if value &gt; bestValue then
                bestValue = value
                bestTier = tier
            end
        end
        allocated[bestTier] += 1
    end

    return allocated
end

function RewardMath.earnedChests(catchScore: number): number
    validateScore(catchScore)
    local result = 0
    for _, row in Config.ChestThresholds do
        if catchScore &gt;= row.score then
            result = row.count
        end
    end
    return result
end

function RewardMath.computeRunReward(catchScore: number)
    local tierCounts = RewardMath.allocateTiers(catchScore)
    local stacks = {}
    for tier, count in tierCounts do
        if count &gt; 0 then
            table.insert(stacks, {
                speciesId = Config.AlphaSpeciesByTier[tier],
                mutationId = "base",
                count = count,
            })
        end
    end
    return {
        rewardConfigVersion = 1,
        catchScore = catchScore,
        stacks = stacks,
        chestCount = RewardMath.earnedChests(catchScore),
    }
end

return RewardMath
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX13">
        <Properties>
          <string name="Name">RunLifecycle</string>
          <ProtectedString name="Source">--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Config = require(ReplicatedStorage.Shared.Config)

local RunLifecycle = {}
local lastExitRequest: {[Player]: number} = {}
local requestEndRun: RemoteEvent? = nil

local function activeCharacter(player: Player): Model?
    local character = player.Character
    if not character or character:GetAttribute("RunState") ~= "Active" then return nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health &lt;= 0 then return nil end
    return character
end

function RunLifecycle.begin(player: Player, character: Model)
    if character:GetAttribute("RunId") ~= nil then return end
    character:SetAttribute("RunId", HttpService:GenerateGUID(false))
    character:SetAttribute("RunState", "Active")
    character:SetAttribute("GrowthScore", 0)
    character:SetAttribute("CatchScore", 0)
    character:SetAttribute("SpawnProtectionEndsAt", workspace:GetServerTimeNow() + Config.SpawnProtectionSeconds)
    character:SetAttribute("ExitChannelEndsAt", 0)

    task.spawn(function()
        local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
        if not humanoid or player.Character ~= character then return end
        humanoid.Died:Connect(function()
            RunLifecycle.tryEnd(player, character, "Death")
        end)
    end)
end

function RunLifecycle.isActive(character: Model): boolean
    return character:GetAttribute("RunState") == "Active"
end

function RunLifecycle.isProtected(character: Model, now: number?): boolean
    local raw = character:GetAttribute("SpawnProtectionEndsAt")
    local endsAt = if typeof(raw) == "number" then raw else 0
    return endsAt &gt; (now or workspace:GetServerTimeNow())
end

function RunLifecycle.tryEnd(player: Player, character: Model, reason: string, sourceUserId: number?): boolean
    if player.Character ~= character or character:GetAttribute("RunState") ~= "Active" then
        return false
    end

    -- The state flip happens before any yield/death signal, so competing terminal paths lose deterministically.
    character:SetAttribute("RunState", "Ending")
    character:SetAttribute("ExitChannelEndsAt", 0)
    player:SetAttribute("LastRunEndReason", reason)
    player:SetAttribute("LastRunId", character:GetAttribute("RunId"))
    player:SetAttribute("LastRunEndAt", workspace:GetServerTimeNow())
    player:SetAttribute("LastPredatorUserId", sourceUserId or 0)

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health &gt; 0 then
        humanoid.Health = 0
    end
    return true
end

local function cancelExit(character: Model)
    if character:GetAttribute("RunState") == "Active" then
        character:SetAttribute("ExitChannelEndsAt", 0)
    end
end

local function startExitChannel(player: Player, character: Model)
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root or not root:IsA("BasePart") then return end
    local currentEnd = character:GetAttribute("ExitChannelEndsAt")
    if typeof(currentEnd) == "number" and currentEnd &gt; workspace:GetServerTimeNow() then return end

    local origin = root.Position
    character:SetAttribute("ExitChannelEndsAt", workspace:GetServerTimeNow() + Config.ExitChannelSeconds)
    task.spawn(function()
        local deadline = os.clock() + Config.ExitChannelSeconds
        while os.clock() &lt; deadline do
            task.wait(0.1)
            if player.Character ~= character or character:GetAttribute("RunState") ~= "Active" then
                return
            end
            local currentRoot = character:FindFirstChild("HumanoidRootPart")
            if not currentRoot or not currentRoot:IsA("BasePart") then
                cancelExit(character)
                return
            end
            if (currentRoot.Position - origin).Magnitude &gt; Config.ExitMoveCancelDistance then
                cancelExit(character)
                return
            end
        end
        RunLifecycle.tryEnd(player, character, "ManualExit")
    end)
end

function RunLifecycle.start()
    local folder = ReplicatedStorage:FindFirstChild("BeDinoRemotes")
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "BeDinoRemotes"
        folder.Parent = ReplicatedStorage
    end

    local existing = folder:FindFirstChild("RequestEndRun")
    if existing and existing:IsA("RemoteEvent") then
        requestEndRun = existing
    else
        if existing then existing:Destroy() end
        local remote = Instance.new("RemoteEvent")
        remote.Name = "RequestEndRun"
        remote.Parent = folder
        requestEndRun = remote
    end

    local remote = requestEndRun :: RemoteEvent
    remote.OnServerEvent:Connect(function(player: Player, ...)
        -- This remote has no payload. Reject unexpected arguments rather than expanding the trust boundary.
        if select("#", ...) ~= 0 then return end
        local now = os.clock()
        local last = lastExitRequest[player] or -math.huge
        if now - last &lt; Config.ExitRequestCooldownSeconds then return end
        lastExitRequest[player] = now
        local character = activeCharacter(player)
        if not character then return end
        startExitChannel(player, character)
    end)

    Players.PlayerRemoving:Connect(function(player)
        lastExitRequest[player] = nil
    end)
end

return RunLifecycle
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX14">
