{
 "rules": [
  {
   "id": "R1",
   "short": "cream",
   "text": "Surfaces are cream panels / plates / chips with an ink outline; no dark navy or slate plates, boxes or loading screens"
  },
  {
   "id": "R2",
   "short": "text",
   "text": "Two text kinds only: dark ink on cream, white with outline on colour or the world; never text on studs"
  },
  {
   "id": "R3",
   "short": "buttons",
   "text": "One green main button per screen, every other button grey, red only for the X"
  },
  {
   "id": "R4",
   "short": "rarity",
   "text": "Rarity colours only on rarity things (cards, rarity words, hatch rays)"
  },
  {
   "id": "R5",
   "short": "real art",
   "text": "Real art only: no code-drawn icons, stand-ins or empty boxes"
  },
  {
   "id": "R6",
   "short": "font+copy",
   "text": "One font and the 28/20/16/14 scale; kid copy (no 36.4000%, no 5m 0s)"
  },
  {
   "id": "R7",
   "short": "frame",
   "text": "Windows: stud frame, glossy header in the place colour, X inside the strip; the hatch is a full stage, not a window"
  },
  {
   "id": "R8",
   "short": "fits",
   "text": "Everything sits inside its screen/window; nothing clipped, floating outside or overlapping"
  }
 ],
