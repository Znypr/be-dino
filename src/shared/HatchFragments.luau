--!strict
-- Jagged shared boundaries partition the original artwork without new bitmaps.
local F={}
F.Polygons={
{{140,90},{372,90},{372,199},{349,189},{321,206},{293,194},{271,211},{247,192},{222,206},{200,185},{172,204},{140,196}},
{{140,196},{172,204},{200,185},{222,206},{247,192},{257,216},{242,234},{258,253},{244,282},{220,269},{194,283},{167,265},{140,277}},
{{247,192},{271,211},{293,194},{321,206},{349,189},{372,199},{372,273},{345,281},{322,268},{292,284},{269,265},{244,282},{258,253},{242,234},{257,216}},
{{140,277},{167,265},{194,283},{204,302},{191,323},{201,347},{175,330},{140,338}},
{{194,283},{220,269},{244,282},{269,265},{292,284},{284,303},{309,321},{302,344},{276,329},{251,344},{225,330},{201,347},{191,323},{204,302}},
{{292,284},{322,268},{345,281},{372,273},{372,334},{349,343},{327,333},{302,344},{309,321},{284,303}},
{{140,338},{175,330},{201,347},{225,330},{251,344},{276,329},{302,344},{327,333},{349,343},{372,334},{372,400},{140,400}},
}
function F.spans(polygon,y: number)
    local crossings={}
    for i,a in polygon do
        local b=polygon[i%#polygon+1]
        if (a[2]<=y and b[2]>y) or (b[2]<=y and a[2]>y) then table.insert(crossings,a[1]+(y-a[2])*(b[1]-a[1])/(b[2]-a[2])) end
    end
    table.sort(crossings)
    local spans={}
    for i=1,#crossings-1,2 do
        local left,right=math.max(140,math.floor(crossings[i])),math.min(372,math.ceil(crossings[i+1]))
        if right>left then table.insert(spans,{left,right}) end
    end
    return spans
end
return F
