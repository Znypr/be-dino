-- value of one channel at time t (keys {{t, v}, ...} sorted, first and last value 0): cubic Hermite, monotone-clamped tangents (no overshoot)
local function hermite(keys: {{number}}, t: number): number
	local n = #keys
	if n == 0 or t <= keys[1][1] or t >= keys[n][1] then return 0 end
	local i = 1
	while i < n - 1 and keys[i + 1][1] <= t do i += 1 end
	local function slope(j: number): number
		if j <= 1 or j >= n then return 0 end
		local ta, va, tb, vb, tc, vc = keys[j - 1][1], keys[j - 1][2], keys[j][1], keys[j][2], keys[j + 1][1], keys[j + 1][2]
		if (vb - va) * (vc - vb) <= 0 then return 0 end -- local extremum: flat tangent
		-- monotone clamp (Fritsch-Carlson): never steeper than 3x the gentler neighbouring secant, so no segment overshoots its keys
		local cap = 3 * math.min(math.abs((vb - va) / (tb - ta)), math.abs((vc - vb) / (tc - tb)))
		return math.clamp((vc - va) / (tc - ta), -cap, cap)
	end
	local t0, v0, t1, v1 = keys[i][1], keys[i][2], keys[i + 1][1], keys[i + 1][2]
	local h = t1 - t0
	if h <= 0 then return v0 end
	local m0, m1 = slope(i), slope(i + 1)
	local u = (t - t0) / h
	local u2, u3 = u * u, u * u * u
	return (2 * u3 - 3 * u2 + 1) * v0 + (u3 - 2 * u2 + u) * h * m0 + (-2 * u3 + 3 * u2) * v1 + (u3 - u2) * h * m1
end

function Clips.length(name: string): number
	local clip = Clips.Data[name]
	return if clip then clip.length else 0
end

export type Out = {pitch: number, yaw: number, roll: number, bob: number, fwd: number}
function Clips.new(): Out return {pitch = 0, yaw = 0, roll = 0, bob = 0, fwd = 0} end

-- Writes the clip offsets of one part (role, side -1 / 1) at time t into out; all zero for an unknown clip, a missing track or t outside the clip.
-- "neck" uses its own track when the clip has one, otherwise the head track at NeckShare. bob comes from the root track for every role.
function Clips.sample(name: string, role: string, side: number, t: number, out: Out): Out
	out.pitch, out.yaw, out.roll, out.bob, out.fwd = 0, 0, 0, 0, 0
	local clip = Clips.Data[name]
	if not clip or t ~= t then return out end
	local tracks = clip.tracks :: any
	if tracks.root and tracks.root.bob then out.bob = hermite(tracks.root.bob, t) end
	local track, k = tracks[role], 1
	if not track and role == "neck" then track, k = tracks.head, Clips.NeckShare end
	if not track or role == "root" then return out end
	local d = math.pi / 180 * k
	if track.pitch then out.pitch = hermite(track.pitch, t) * d end
	if track.yaw then out.yaw = hermite(track.yaw, t) * d end
	if track.roll then out.roll = hermite(track.roll, t) * d * (if Clips.SideRoll[role] and side < 0 then -1 else 1) end
	if track.fwd and role == "head" then out.fwd = hermite(track.fwd, t) end
	return out
end

return Clips
